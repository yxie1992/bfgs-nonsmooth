BfgsVerification.DEmbedding.review20ParameterIndependence {n : ℕ} (hn : 1 ≤ n) (c₁ c₂ d₁ d₂ : ℝ) (hc₁ : 0 < c₁)
  (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (hd₁ : 0 < d₁) (hd₁' : d₁ ≤ 1 / 3) (hd : d₁ < d₂) (hd₂ : d₂ < 1) :
  let R := BfgsVerification.DEmbedding.run hn c₁ c₂ hc₁ hc₁' hc hc₂;
  let S := BfgsVerification.DEmbedding.run hn d₁ d₂ hd₁ hd₁' hd hd₂;
  R.x = S.x ∧ R.H = S.H ∧ R.g = S.g ∧ R.α = S.α
'BfgsVerification.DEmbedding.review20ParameterIndependence' depends on axioms: [propext, Classical.choice, Quot.sound]
