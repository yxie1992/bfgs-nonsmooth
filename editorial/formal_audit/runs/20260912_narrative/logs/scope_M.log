          (4 * G ^ 2 / c ^ 2 / ((∑' (i : ℕ), R.d (J + i)) / c)) (BfgsVerification.principalSum (R.H J)),
        ⟨fun m hm =>
          ⟨BfgsVerification.SharpPotentialDegree.principal_optimized_polynomial (R.H J) (4 * G ^ 2 / c ^ 2)
              (∑' (i : ℕ), R.d (J + i)) c m,
            BfgsVerification.SharpPotentialDegree.run_optimized_bound R G c hc hd J m hm⟩,
          BfgsVerification.SharpPotentialDegree.run_optimized_root_tendsto R G c hc hd J⟩⟩)
