                      Polynomial.eval (↑m - 1) p ∧
                    ∑ j ∈ Finset.range n,
                        (K / (D / (c * (↑m - 1)))) ^ j * BfgsVerification.principalSum (R.H J) (j + 1) ≤
                      (∑ j ∈ Finset.range n, (K / (D / c)) ^ j * BfgsVerification.principalSum (R.H J) (j + 1)) *
                        (↑m - 1) ^ (n - 1)) ∧
