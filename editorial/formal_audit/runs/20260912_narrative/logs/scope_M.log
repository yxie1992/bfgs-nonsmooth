∀ {n : ℕ} (H : BfgsVerification.Mat n),
  PosDef H →
    ∃ U lam,
      Uᵀ * U = 1 ∧
        U * Uᵀ = 1 ∧
          Uᵀ * H * U = diagonal lam ∧
            (∀ (i : Fin n), 0 < lam i) ∧
              ∀ (y : BfgsVerification.Vec n) (j : ℕ),
                ∑ I ∈ Finset.powersetCard j Finset.univ,
                    (BfgsVerification.metricGram H
                        ((replicateCol Unit y).fromCols (U * BfgsVerification.coordinateMatrix I))).det =
                  ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ, (∏ i ∈ J, lam i) * ∑ k ∈ J, (Uᵀ *ᵥ y) k ^ 2
