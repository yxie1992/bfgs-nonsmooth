  "changes": [
    {
      "id": "determinant",
      "location": "paper/sections/local.tex:341-354",
      "outcome": "Correct clarification",
      "reason": "For augmented gradient columns (1+2u,v,1), (u,1+3v,1), (-1+3u,-1+2v,1), subtracting the third column gives determinant (2-u)(2+v)-(1-2u)(1-v)=3(1+v-uv). The prior coefficient and basin proof is unchanged.",
      "formal_support": [
        "bfgs_lean_stage1/BfgsVerification/PlanarQuadraticCoefficients.lean:64 (gradient_affineIndependent; uses the same determinant identity)",
        "bfgs_lean_stage1/BfgsVerification/PlanarQuadraticConvergence.lean:63 (fullBFGS_explicit_basin)"
      ]
    },
    {
      "id": "physical_preimages",
      "location": "paper/appendices/lower_curvature.tex:151-179",
      "outcome": "Correct quantifier clarification",
      "reason": "All phase and candidate maps are continuous at the zero-scale normalized seed and vanish there. Their finite preimage intersection is a neighborhood of the seed even when prescribed V is merely a neighborhood, and a local stable orbit can be chosen inside it. The forward-orbit containment is constructed after choosing the neighborhood, not presumed for an arbitrary stable point.",
      "formal_support": [
        "bfgs_lean_stage1/BfgsVerification/LFlattenNeighborhood.lean:12 (physical_neighborhood; all three physical phases and all nine queries)",
        "bfgs_lean_stage1/BfgsVerification/LReturnStableOrbit.lean:29 (source_oracle_orbit)",
        "bfgs_lean_stage1/BfgsVerification/LGlobalFailure.lean:11 (actual_orbit_data)",
        "bfgs_lean_stage1/BfgsVerification/LGlobalFailure.lean:27 (actual_global_failure)"
      ],
      "minor_precision": "The finite map family should be read as including phase points as well as the nine trial candidates, matching physical_neighborhood. The separate physical-iterate argument already covers the phases."
    },
    {
      "id": "branch_restriction",
      "location": "paper/appendices/lower_curvature.tex:250-254",
      "outcome": "Correct; literal branch and combined failure statements now compiled and audited",
      "reason": "b_i=q_i·c_*>17/10 implies q_i is nonzero; v_i=c_*/b_i gives q_i·v_i=1. Then f_i(tv_i)-mu*t^2*||v_i||^2/2=psi_bi(t). Differentiability at zero of the branch derivative would transfer to differentiability of psi_bi prime, contradicting the two unequal node limits. Invertible precomposition preserves the fderiv-based second-differentiability convention.",
      "formal_support": [
        "bfgs_lean_stage1/BfgsVerification/LEmbeddingObjective.lean:44 (parameter_bounds), :55 (residualBranch_old)",
        "bfgs_lean_stage1/BfgsVerification/LScalarRegularity.lean:102 (phi_not_twice_differentiable_zero)",
