                                                        (x ℓ k + a • BfgsVerification.bfgsStep (H ℓ k) (g ℓ k) 1)) ∧
                                                  (∀ (k : ℕ), (hist ℓ k).length ≤ 5) ∧
                                                    ∀ (m : ℕ),
                                                      α ℓ (3 * m) = 1 ∧
                                                        α ℓ (3 * m + 1) = 1 / 4 ∧ α ℓ (3 * m + 2) = 1 / 16) ∧
                              (∀ (ℓ : ℕ),
                                  BddAbove
                                    {r |
                                      ∃ k,
