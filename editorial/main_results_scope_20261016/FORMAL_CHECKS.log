BfgsCoverage.Article.Energy.minor_hierarchy {n : ℕ} (H Hplus : BfgsVerification.Mat n) (g y s : BfgsVerification.Vec n)
  (α q β : ℝ) (hH : Matrix.PosDef H) (hs : s = -α • Matrix.mulVec H g) (hα : 0 < α)
  (hq_def : q = BfgsVerification.dot g (Matrix.mulVec H g)) (hq : 0 < q)
  (hβ_def : β = -BfgsVerification.dot y (Matrix.mulVec H g) / q) (hβ : 0 < β)
  (hHplus : Hplus = BfgsVerification.inverseBFGS H s y) :
  (∀ (j : ℕ),
      1 ≤ j →
        j ≤ n →
          BfgsVerification.principalSum Hplus j ≤
            BfgsVerification.sqNorm y / (β ^ 2 * q) * BfgsVerification.principalSum H (j + 1) +
              α / β * BfgsVerification.principalSum H j) ∧
    Matrix.det Hplus = α / β * Matrix.det H
