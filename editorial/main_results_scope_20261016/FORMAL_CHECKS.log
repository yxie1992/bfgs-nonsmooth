      (∀ (i : Fin 4) (x : BfgsVerification.Vec 2),
          Matrix.PosSemidef (BfgsVerification.RadialHessian.matrix (f i) x) ∧
            Matrix.PosSemidef (64 • 1 - BfgsVerification.RadialHessian.matrix (f i) x)) ∧
        ∀ (F : BfgsVerification.Vec 2 → ℝ),
          (∀ (x : BfgsVerification.Vec 2), F x = Finset.univ.sup' ⋯ fun i => f i x) →
            (∀ (a : ℝ), IsCompact {x | F x ≤ a}) ∧
              (∀ (x : BfgsVerification.Vec 2), F 0 ≤ F x) ∧
                (∀ (x : BfgsVerification.Vec 2), F x = F 0 → x = 0) ∧
                  ¬DifferentiableAt ℝ F 0 ∧
                    ∃ x H g α hist xbar,
                      Filter.Tendsto (fun ℓ => x ℓ 0) Filter.atTop (nhds 0) ∧
                        (∀ (ℓ : ℕ), H ℓ 0 = 1) ∧
                          (∀ (c₁ c₂ : ℝ),
                              0 < c₁ →
                                c₁ ≤ 1 / 3 →
                                  c₁ < c₂ →
                                    c₂ < 1 →
                                      ∀ (ℓ : ℕ),
                                        1 ≤ ℓ →
                                          ∃ R,
                                            R.c₁ = c₁ ∧
                                              R.c₂ = c₂ ∧
                                                R.x = x ℓ ∧
                                                  R.H = H ℓ ∧
                                                    R.g = g ℓ ∧
                                                      R.α = α ℓ ∧
                                                        ∀ (k N : ℕ),
                                                          5 ≤ N →
                                                            BfgsVerification.NonStrictLineSearch.fromMetric F (x ℓ k)
                                                                (H ℓ k) c₁ c₂ N =
                                                              (some (α ℓ k), hist ℓ k)) ∧
                            (∀ (ℓ : ℕ),
                                1 ≤ ℓ →
                                  Filter.Tendsto (x ℓ) Filter.atTop (nhds (xbar ℓ)) ∧
                                    xbar ℓ ≠ 0 ∧
                                      (∀ (k : ℕ), F (x ℓ (k + 1)) < F (x ℓ k)) ∧
                                        Filter.Tendsto (fun k => F (x ℓ k)) Filter.atTop (nhds (F (xbar ℓ))) ∧
                                          F 0 < F (xbar ℓ) ∧
                                            F 0 = 0 ∧
                                              0 ∉ BfgsVerification.ConvexSubdifferential.subdifferential F (xbar ℓ) ∧
                                                (∀ (k : ℕ),
                                                    ∀ a ∈ hist ℓ k,
