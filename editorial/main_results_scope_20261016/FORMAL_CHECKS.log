  (hxU : xstar ∈ U) {ι : Type u_1} [Fintype ι] (m : ι → ℕ) (a : (i : ι) → Fin (m i) → BfgsVerification.Vec n)
  (b : (i : ι) → Fin (m i) → ℝ) (P : ι → Set (BfgsVerification.Vec n))
  (hP : ∀ (i : ι), P i = {x | ∀ (j : Fin (m i)), BfgsVerification.dot (a i j) x ≤ b i j})
  (_hfull : ∀ (i : ι), (interior (P i)).Nonempty) (hcover : U ⊆ ⋃ i, P i) (V : ι → Set (BfgsVerification.Vec n))
  (hV : ∀ (i : ι), IsOpen (V i)) (hUV : ∀ (i : ι), U ∩ P i ⊆ V i) (f : ι → BfgsVerification.Vec n → ℝ)
