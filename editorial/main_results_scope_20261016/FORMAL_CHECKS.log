                                                        (R ℓ).x = x ℓ ∧
                                                          (R ℓ).H = H ℓ ∧
                                                            (∀ (k N : ℕ),
                                                                5 ≤ N →
                                                                  BfgsVerification.NonStrictLineSearch.fromMetric F
                                                                      ((R ℓ).x k) ((R ℓ).H k) c₁ c₂ N =
                                                                    (some ((R ℓ).α k),
                                                                      BfgsVerification.SeedOrbit.trialHistory
                                                                        (BfgsVerification.SeedOrbit.phase k))) ∧
                                                              ∀ (m : ℕ),
                                                                (R ℓ).α (3 * m) = 1 ∧
                                                                  (R ℓ).α (3 * m + 1) = 1 / 4 ∧
                                                                    (R ℓ).α (3 * m + 2) = 1 / 16) ∧
                (∃ f,
                    (∀ (x : BfgsVerification.Vec 2), F x = Finset.univ.sup' ⋯ fun i => f i x) ∧
                      (∀ (i : Fin 4), ContDiff ℝ 1 (f i)) ∧
                        (∃ L,
                            ∀ (i : Fin 4) (y z : BfgsVerification.Vec 2),
                              ‖BfgsVerification.euclideanVector
                                    (BfgsVerification.coordinateGradient (f i) y -
                                      BfgsVerification.coordinateGradient (f i) z)‖ ≤
                                L * ‖BfgsVerification.euclideanVector (y - z)‖) ∧
                          (∃ κ,
                              0 < κ ∧
                                ∀ (i : Fin 4), BfgsVerification.FixedNormal.EuclideanStrongConvexOn Set.univ κ (f i)) ∧
                            ∀ (i : Fin 3), ¬DifferentiableAt ℝ (fderiv ℝ (f i.castSucc)) 0) ∧
                  ∃ μl Lu,
                    0 < μl ∧
                      μl ≤ Lu ∧
                        ∀ (x : BfgsVerification.Vec 2),
                          (∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, DifferentiableAt ℝ F z) →
                            DifferentiableAt ℝ (fderiv ℝ F) x →
                              Matrix.IsSymm (BfgsVerification.RadialHessian.matrix F x) ∧
                                ∀ (v : BfgsVerification.Vec 2),
                                  μl * BfgsVerification.sqNorm v ≤
                                      BfgsVerification.dot v
                                        (Matrix.mulVec (BfgsVerification.RadialHessian.matrix F x) v) ∧
                                    BfgsVerification.dot v
                                        (Matrix.mulVec (BfgsVerification.RadialHessian.matrix F x) v) ≤
                                      Lu * BfgsVerification.sqNorm v
BfgsCoverage.Article.LowerCurvature.quadratic_failure_initial_point (μ : ℝ) (hμ : 0 < μ)
  (V : Set (BfgsVerification.Vec 2)) (hV : V ∈ nhds 0) :
  ∃ x₀ H₀,
    Matrix.PosDef H₀ ∧
      ∃ x H,
        x 0 = x₀ ∧
          H 0 = H₀ ∧
            Filter.Tendsto x Filter.atTop (nhds 0) ∧
              (∀ (k : ℕ), 0 < BfgsVerification.LQuadraticSeed.objective μ (x k)) ∧
                (StrictAnti fun k => BfgsVerification.LQuadraticSeed.objective μ (x k)) ∧
                  Filter.Tendsto (fun k => BfgsVerification.LQuadraticSeed.objective μ (x k)) Filter.atTop (nhds 0) ∧
                    (DifferentiableAt ℝ (BfgsVerification.LQuadraticSeed.objective μ) x₀ ∧ x₀ ∈ V) ∧
                      (∀ (k : ℕ),
                          ∀ a ∈ BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k),
                            DifferentiableAt ℝ (BfgsVerification.LQuadraticSeed.objective μ)
                                (x k +
                                  a •
                                    BfgsVerification.bfgsStep (H k)
                                      (BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective μ)
                                        (x k))
                                      1) ∧
                              x k +
                                  a •
                                    BfgsVerification.bfgsStep (H k)
                                      (BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective μ)
                                        (x k))
                                      1 ∈
                                V) ∧
                        ∀ (c₁ c₂ : ℝ),
                          0 < c₁ →
                            c₁ ≤ 1 / 3 →
                              c₁ < c₂ →
                                c₂ < 1 →
                                  ∃ R,
                                    R.c₁ = c₁ ∧
                                      R.c₂ = c₂ ∧
                                        R.x = x ∧
                                          R.H = H ∧
                                            (∀ (k N : ℕ),
                                                5 ≤ N →
                                                  BfgsVerification.NonStrictLineSearch.fromMetric
                                                      (BfgsVerification.LQuadraticSeed.objective μ) (R.x k) (R.H k) c₁
                                                      c₂ N =
                                                    (some (R.α k),
                                                      BfgsVerification.SeedOrbit.trialHistory
                                                        (BfgsVerification.SeedOrbit.phase k))) ∧
                                              ∀ (m : ℕ),
                                                R.α (3 * m) = 1 ∧ R.α (3 * m + 1) = 1 / 4 ∧ R.α (3 * m + 2) = 1 / 16
BfgsVerification.FivePieceObstruction.no_differentiable_armijo_wolfe {τ α : ℝ} (hτ : 0 < τ) (hα : 0 < α)
  (g : BfgsVerification.Vec 3)
  (hg :
    HasFDerivAt BfgsVerification.FivePieceObstruction.objective (BfgsVerification.gradientFunctional g)
      (BfgsVerification.FivePieceObstruction.ray τ α))
  (ha :
    BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ α) ≤
      BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ 0) +
        1 / 4 *
          BfgsVerification.dot BfgsVerification.FivePieceObstruction.initialGradient
            (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
              BfgsVerification.FivePieceObstruction.initialGradient α))
  (hw :
    1 / 2 *
        BfgsVerification.dot BfgsVerification.FivePieceObstruction.initialGradient
          (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
            BfgsVerification.FivePieceObstruction.initialGradient α) ≤
      BfgsVerification.dot g
        (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
          BfgsVerification.FivePieceObstruction.initialGradient α)) :
  False
BfgsCoverage.Companion.Ch07H.maxLinear_line_no_run {n m : ℕ} (a : Fin m → BfgsVerification.Vec n)
  (F : BfgsVerification.Vec n → ℝ)
  (hF_def : ∀ (x : BfgsVerification.Vec n), IsGreatest (Set.range fun i => BfgsVerification.dot (a i) x) (F x))
  (c d : BfgsVerification.Vec n) (β : Fin m → ℝ) (ha : ∀ (i : Fin m), a i = c + β i • d)
  (hcd : LinearIndependent ℝ ![c, d]) : IsEmpty (BfgsVerification.AdmissibleBFGSRun n F)
BfgsCoverage.Companion.Ch07H.maxLinear_affine_free_no_run {n m : ℕ} (hn : n ≤ 2) (a : Fin m → BfgsVerification.Vec n)
