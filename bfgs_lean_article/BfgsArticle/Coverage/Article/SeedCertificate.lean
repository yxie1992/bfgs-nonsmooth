        10 ^ 4 * trialValueExpr c d r q < (tableTrial q).2) ∧
      ∀ q : Fin 9,
        (tableCurrent q).1 < 10 ^ 4 * SeedOrbit.objective seedC seedD
            (SeedOrbit.point seedC seedD seedRatio (trialPhase q)) ∧
        10 ^ 4 * SeedOrbit.objective seedC seedD
            (SeedOrbit.point seedC seedD seedRatio (trialPhase q)) < (tableCurrent q).2 ∧
        (tableTrial q).1 < 10 ^ 4 * SeedOrbit.objective seedC seedD (queryPoint seedC seedD seedRatio q) ∧
        10 ^ 4 * SeedOrbit.objective seedC seedD (queryPoint seedC seedD seedRatio q) < (tableTrial q).2 := by
  have hbox : ∀ c d r : ℝ, Bounds (318481/1000000) c (318482/1000000) →
      Bounds (-1025233/1000000) d (-1025232/1000000) → Bounds (6019/100000) r (6021/100000) →
      ∀ q : Fin 9, (tableCurrent q).1 < 10 ^ 4 * currentValueExpr c d r q ∧
        10 ^ 4 * currentValueExpr c d r q < (tableCurrent q).2 ∧
        (tableTrial q).1 < 10 ^ 4 * trialValueExpr c d r q ∧
        10 ^ 4 * trialValueExpr c d r q < (tableTrial q).2 := by
    intro c d r hc hd hr q
    fin_cases q
    · exact valueBounds0 hc hd hr
    · exact valueBounds1 hc hd hr
    · exact valueBounds2 hc hd hr
    · exact valueBounds3 hc hd hr
    · exact valueBounds4 hc hd hr
    · exact valueBounds5 hc hd hr
    · exact valueBounds6 hc hd hr
    · exact valueBounds7 hc hd hr
    · exact valueBounds8 hc hd hr
  refine ⟨hbox, fun q => ?_⟩
  have h := hbox seedC seedD seedRatio root_tight_box.1 root_tight_box.2
    (tight_ratio root_tight_box.1 root_tight_box.2) q
  rw [objective_of_active (source_base_certificate (trialPhase q)).active,
    show queryPoint seedC seedD seedRatio q = SeedOrbit.trial seedC seedD seedRatio (trialPhase q)
      (trialLength q) from rfl, objective_of_active (source_trial_certificate q).active]
  exact h


/-! ### The remaining claims of the query section -/

/-- At the root, the actual gradient of $G$ at the base point of phase $j$ is $g_j$. -/
theorem base_gradient (j : Fin 3) :
    coordinateGradient (SeedOrbit.objective seedC seedD) (SeedOrbit.point seedC seedD seedRatio j) =
      SeedOrbit.gradient seedC seedD j :=
  DeterministicLineSearch.actual_coordinateGradient (source_base_hasGradient j)

/-- At the root, the actual gradient of $G$ at the query of row `q` is $g_i$, `i` active. -/
theorem query_gradient (q : Fin 9) :
    coordinateGradient (SeedOrbit.objective seedC seedD) (queryPoint seedC seedD seedRatio q) =
      SeedOrbit.gradient seedC seedD (trialActive q) :=
  DeterministicLineSearch.actual_coordinateGradient (source_trial_hasGradient q)

/-- Item `A/seed_certificate/prose/008` (`paper/appendices/seed_certificate.tex:145-146`): "A
positive derivative at each accepted query supplies weak Wolfe for every permitted curvature
constant." At each accepted row the derivative of $G$ at the query along $p_j$ is positive,
and the weak Wolfe test of `art:failure_tests` holds for every $c_2>0$. -/
theorem positive_slope_wolfe (q : Fin 9) (hq : trialAccept q = true) :
    0 < dot (coordinateGradient (SeedOrbit.objective seedC seedD) (queryPoint seedC seedD seedRatio q))
        (SeedOrbit.direction seedC seedD seedRatio (trialPhase q)) ∧
      ∀ c₂ : ℝ, 0 < c₂ → NonStrictLineSearch.Wolfe (SeedOrbit.objective seedC seedD)
        (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
        (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
        (coordinateGradient (SeedOrbit.objective seedC seedD)
          (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₂ (trialLength q) := by
  have h := source_trial_certificate q
  have hl := source_trial_length_pos q
  have hd := h.descent
  have hw := h.wolfe hq
  rw [dot_smul_right] at hd hw
  have hd' : dot (SeedOrbit.gradient seedC seedD (trialPhase q))
      (SeedOrbit.direction seedC seedD seedRatio (trialPhase q)) < 0 := by
    by_contra hc
    nlinarith
  have hw' : 0 < dot (SeedOrbit.gradient seedC seedD (trialActive q))
      (SeedOrbit.direction seedC seedD seedRatio (trialPhase q)) := by
    by_contra hc
    nlinarith
  rw [query_gradient]
  refine ⟨hw', fun c₂ hc₂ => ?_⟩
  unfold NonStrictLineSearch.Wolfe
  rw [base_gradient, show SeedOrbit.point seedC seedD seedRatio (trialPhase q) + trialLength q •
    SeedOrbit.direction seedC seedD seedRatio (trialPhase q) = queryPoint seedC seedD seedRatio q from rfl,
    query_gradient]
  nlinarith

/-- Item `A/seed_certificate/prose/009` (`paper/appendices/seed_certificate.tex:146-148`):
"Strict value increase at each rejected query makes Armijo fail, so the routine reaches exactly
the next displayed bisection." At each rejected row, $G$ at the query exceeds $G(z_j)$, the
Armijo test of `art:failure_tests` fails for every $c_1>0$, and the search therefore records
the rejected length and continues with the bisection $(\alpha_{\rm lo}+\alpha)/2$ and upper
bracket $\alpha$ (`NonStrictLineSearch.search`, for any remaining fuel and lower bracket). -/
theorem increase_rejects_armijo (q : Fin 9) (hq : trialAccept q = false) :
    SeedOrbit.objective seedC seedD (SeedOrbit.point seedC seedD seedRatio (trialPhase q)) <
        SeedOrbit.objective seedC seedD (queryPoint seedC seedD seedRatio q) ∧
      ∀ c₁ c₂ : ℝ, 0 < c₁ →
        ¬ NonStrictLineSearch.Armijo (SeedOrbit.objective seedC seedD)
          (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
          (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
          (coordinateGradient (SeedOrbit.objective seedC seedD)
            (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₁ (trialLength q) ∧
        ∀ (fuel : ℕ) (l : ℝ) (h : Option ℝ),
          NonStrictLineSearch.search (SeedOrbit.objective seedC seedD)
              (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
              (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
              (coordinateGradient (SeedOrbit.objective seedC seedD)
                (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₁ c₂ (fuel + 1) l h
              (trialLength q) =
            ((NonStrictLineSearch.search (SeedOrbit.objective seedC seedD)
              (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
              (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
              (coordinateGradient (SeedOrbit.objective seedC seedD)
                (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₁ c₂ fuel l
              (some (trialLength q)) ((l + trialLength q) / 2)).1,
              trialLength q :: (NonStrictLineSearch.search (SeedOrbit.objective seedC seedD)
              (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
              (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
              (coordinateGradient (SeedOrbit.objective seedC seedD)
                (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₁ c₂ fuel l
              (some (trialLength q)) ((l + trialLength q) / 2)).2) := by
  have h := source_trial_certificate q
  have hl := source_trial_length_pos q
  have hdec := h.decision
  rw [hq] at hdec
  simp only [Bool.false_eq_true, ite_false] at hdec
  have hbase := (source_base_certificate (trialPhase q)).active
  have hinc : SeedOrbit.objective seedC seedD (SeedOrbit.point seedC seedD seedRatio (trialPhase q)) <
      SeedOrbit.objective seedC seedD (queryPoint seedC seedD seedRatio q) := by
    rw [objective_of_active hbase, show queryPoint seedC seedD seedRatio q =
      SeedOrbit.trial seedC seedD seedRatio (trialPhase q) (trialLength q) from rfl,
      objective_of_active h.active]
    exact hdec
  have hd := h.descent
  rw [dot_smul_right] at hd
  refine ⟨hinc, fun c₁ c₂ hc₁ => ?_⟩
  have hna : ¬ NonStrictLineSearch.Armijo (SeedOrbit.objective seedC seedD)
      (SeedOrbit.point seedC seedD seedRatio (trialPhase q))
      (SeedOrbit.direction seedC seedD seedRatio (trialPhase q))
      (coordinateGradient (SeedOrbit.objective seedC seedD)
        (SeedOrbit.point seedC seedD seedRatio (trialPhase q))) c₁ (trialLength q) := by
    unfold NonStrictLineSearch.Armijo
    rw [base_gradient]
    intro ha
    have hneg : c₁ * trialLength q * dot (SeedOrbit.gradient seedC seedD (trialPhase q))
        (SeedOrbit.direction seedC seedD seedRatio (trialPhase q)) < 0 := by
      have := mul_neg_of_pos_of_neg hc₁ hd
      linarith [this]
    change SeedOrbit.objective seedC seedD (queryPoint seedC seedD seedRatio q) ≤ _ at ha
    linarith
  exact ⟨hna, fun fuel l hh => NonStrictLineSearch.search_armijo_reject fuel hna⟩

/-- The conditions certified at a base point or query `x` with designated active index `i`:
positive active gaps, $3\pm g_k^Tx>0$ for every $k$, $2-x_2>0$ and a positive active value. -/
def CertifiedPoint (x : Vec 2) (i : Fin 3) : Prop :=
  (∀ k, k ≠ i → 0 < dot (SeedOrbit.gradient seedC seedD i - SeedOrbit.gradient seedC seedD k) x) ∧
    (∀ k, 0 < 3 + dot (SeedOrbit.gradient seedC seedD k) x ∧
      0 < 3 - dot (SeedOrbit.gradient seedC seedD k) x) ∧
    0 < 2 - x 1 ∧ 0 < dot (SeedOrbit.gradient seedC seedD i) x

theorem certifiedPoint_of_certificate {x : Vec 2} {i : Fin 3}
    (h : PointCertificate seedC seedD x i) : CertifiedPoint x i := by
  refine ⟨fun k hk => ?_, fun k => ?_, by linarith [h.vertical], h.value_pos⟩
  · have := h.active k hk
    rw [show dot (SeedOrbit.gradient seedC seedD i - SeedOrbit.gradient seedC seedD k) x =
      dot (SeedOrbit.gradient seedC seedD i) x - dot (SeedOrbit.gradient seedC seedD k) x from
      sub_dotProduct _ _ _]
    linarith
  · have := abs_lt.mp (h.branch_bounds k)
    exact ⟨by linarith, by linarith⟩

/-- Item `A/seed_certificate/prose/010` (`paper/appendices/seed_certificate.tex:192-196`): "For
the three base points, the designated active gaps are positive as well. Evaluating $3\pm g_i^Tq$
for every $i$, $2-q_2$, and the designated active value $g_i^Tq$ gives positive lower bounds for
all base points and all nine queries. This proves \eqref{art:seed_query_bounds}." The
positivity of these quantities at the three base points and the nine queries, and
\eqref{art:seed_query_bounds}: $|g_i^Tz|<3$, $[z]_2<2$, $G(z)>0$. -/
theorem seed_query_bounds_certificate :
    (∀ j : Fin 3, CertifiedPoint (SeedOrbit.point seedC seedD seedRatio j) j) ∧
      (∀ q : Fin 9, CertifiedPoint (queryPoint seedC seedD seedRatio q) (trialActive q)) ∧
      ∀ z : Vec 2, ((∃ j, z = SeedOrbit.point seedC seedD seedRatio j) ∨
          ∃ q, z = queryPoint seedC seedD seedRatio q) →
        (∀ i, |dot (SeedOrbit.gradient seedC seedD i) z| < 3) ∧ z 1 < 2 ∧
          0 < SeedOrbit.objective seedC seedD z := by
  refine ⟨fun j => certifiedPoint_of_certificate (source_base_certificate j),
    fun q => certifiedPoint_of_certificate (source_trial_certificate q).toPointCertificate, ?_⟩
  rintro z (⟨j, rfl⟩ | ⟨q, rfl⟩)
  · have h := source_base_certificate j
    exact ⟨h.branch_bounds, h.vertical, by rw [objective_of_active h.active]; exact h.value_pos⟩
  · have h := (source_trial_certificate q).toPointCertificate
    exact ⟨h.branch_bounds, h.vertical, by
      rw [show queryPoint seedC seedD seedRatio q =
        SeedOrbit.trial seedC seedD seedRatio (trialPhase q) (trialLength q) from rfl,
        objective_of_active h.active]
      exact h.value_pos⟩

/-- Item `A/seed_certificate/prose/011` (`paper/appendices/seed_certificate.tex:197-199`): "The
strict active gaps also give differentiability on a neighborhood of each query." Near each
query $G$ is differentiable with gradient $g_i$, `i` the active index. -/
theorem query_differentiable_near (q : Fin 9) :
    ∀ᶠ z in 𝓝 (queryPoint seedC seedD seedRatio q),
      HasFDerivAt (SeedOrbit.objective seedC seedD)
        (gradientFunctional (SeedOrbit.gradient seedC seedD (trialActive q))) z := by
  have hact := (source_trial_certificate q).active
  have hev : ∀ᶠ z in 𝓝 (queryPoint seedC seedD seedRatio q),
      StrictActive seedC seedD z (trialActive q) := by
    have hk : ∀ k : Fin 3, ∀ᶠ z in 𝓝 (queryPoint seedC seedD seedRatio q),
        k ≠ trialActive q → dot (SeedOrbit.gradient seedC seedD k) z <
          dot (SeedOrbit.gradient seedC seedD (trialActive q)) z := by
      intro k
      by_cases hki : k = trialActive q
      · exact Eventually.of_forall fun _ h => absurd hki h
      · have hc : Continuous fun z : Vec 2 =>
            dot (SeedOrbit.gradient seedC seedD (trialActive q)) z -
              dot (SeedOrbit.gradient seedC seedD k) z := by
          have h1 := (gradientFunctional (SeedOrbit.gradient seedC seedD (trialActive q))).continuous
          have h2 := (gradientFunctional (SeedOrbit.gradient seedC seedD k)).continuous
          simpa only [gradientFunctional_apply] using h1.sub h2
        have hpos : 0 < dot (SeedOrbit.gradient seedC seedD (trialActive q))
              (queryPoint seedC seedD seedRatio q) -
            dot (SeedOrbit.gradient seedC seedD k) (queryPoint seedC seedD seedRatio q) :=
          sub_pos.mpr (hact k hki)
        filter_upwards [hc.continuousAt.eventually (eventually_gt_nhds hpos)] with z hz _
        linarith
    filter_upwards [eventually_all.mpr hk] with z hz
    exact fun k hk' => hz k hk'
  filter_upwards [hev] with z hz
  exact hasGradient_of_active hz


/-! ### Non-vacuity -/

/-- The standing assumptions of this file hold at once at the root: the positive factors and
$P=0$ (`closure_identity`, `rho_closure`, `beta_gamma_root`), Jacobian and adjugate matrices
$D$, $A$ with their defining equations (`root_arithmetic`, `residual_expansion`,
`residual_bound`), and the query box (`query_lower_bounds_box`, `table_value_enclosures`). -/
example : (0 < U seedC seedD ∧ 0 < V seedC seedD ∧ 0 < R seedC seedD ∧ 0 < K seedC seedD ∧
      0 < T seedC seedD ∧ 0 < Y seedC seedD ∧ 0 < U seedC seedD + 129 ∧ P ![seedC, seedD] = 0) ∧
    (∃ D A : Mat 2, (∀ i j, D i j = fderiv ℝ P AlgebraicSeed.center (Pi.single j 1) i) ∧
      A = (D.det)⁻¹ • D.adjugate) ∧
    Bounds (318481/1000000) seedC (318482/1000000) ∧
    Bounds (-1025233/1000000) seedD (-1025232/1000000) ∧ Bounds (6019/100000) seedRatio (6021/100000) := by
  obtain ⟨hU, hV, hR, hK, hT, hY, hA, -, -⟩ := box_denominators_and_ratio root_spec.1
  have hroot : (![seedC, seedD] : Vec 2) = root := by
    ext i; fin_cases i <;> rfl
  refine ⟨⟨hU, hV, hR, hK, hT, hY, hA, by rw [hroot]; exact root_spec.2⟩,
    ⟨fun i j => fderiv ℝ P AlgebraicSeed.center (Pi.single j 1) i, _, fun _ _ => rfl, rfl⟩,
    root_tight_box.1, root_tight_box.2, tight_ratio root_tight_box.1 root_tight_box.2⟩

end BfgsCoverage.Article.SeedCertificate
