BfgsVerification.PlanarObjectiveField.exists_buffered_visible_comparison_field {F : BfgsVerification.Vec 2 → ℝ}
  (hF : ConvexOn ℝ Set.univ F) {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ} (hK : IsCompact K) (hlevel : ∀ x ∈ K, F x = ℓ)
  (hstrict : ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y)
  (hregular : ∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F x)
  (hnoncritical : ∀ x ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F x) :
  ∃ W V Q N,
    IsOpen V ∧
      K ⊆ V ∧
        closure V ⊆ Q ∧
          IsCompact Q ∧
            Q ⊆ N ∧
              IsOpen N ∧
                ∃ η,
                  0 < η ∧
                    ∃ M ρ,
                      0 < ρ ∧
                        ∃ G,
                          0 < G ∧
                            (∀ p ∈ Q, Metric.ball p ρ ⊆ N ∧ LipschitzOnWith M W (Metric.ball p ρ)) ∧
                              (∀ p ∈ Q, BfgsVerification.sqNorm (W p) ≤ G ^ 2) ∧
                                (∀ p ∈ Q, ‖fderiv ℝ W p‖ ≤ ↑M) ∧
                                  (∀ p ∈ N,
                                      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,
                                        η ≤ BfgsVerification.dot g (W p)) ∧
                                    ∀ p ∈ K,
                                      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,
                                        ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,
                                          BfgsVerification.dot g (W p) = BfgsVerification.dot h (W p)
