BfgsVerification.PlanarObjectiveField.exists_compact_uniform_field_buffer {n : ℕ}
  {W : BfgsVerification.Vec n → BfgsVerification.Vec n} {K N : Set (BfgsVerification.Vec n)} (hK : IsCompact K)
  (hN : IsOpen N) (hKN : K ⊆ N) (hLip : ∀ p ∈ N, ∃ L, ∃ U ∈ nhds p, LipschitzOnWith L W U) :
  ∃ V Q,
    IsOpen V ∧
      K ⊆ V ∧
        closure V ⊆ Q ∧
          IsCompact Q ∧
            Q ⊆ N ∧
              ∃ M ρ,
                0 < ρ ∧
                  ∃ G,
                    0 < G ∧
                      (∀ p ∈ Q, Metric.ball p ρ ⊆ N ∧ LipschitzOnWith M W (Metric.ball p ρ)) ∧
                        (∀ p ∈ Q, BfgsVerification.sqNorm (W p) ≤ G ^ 2) ∧ ∀ p ∈ Q, ‖fderiv ℝ W p‖ ≤ ↑M
