              (BfgsVerification.LWhitening.failureFamily D m).x k +
                  BfgsVerification.SeedOrbit.trialLength q •
                    BfgsVerification.bfgsStep ((BfgsVerification.LWhitening.failureFamily D m).H k)
                      ((BfgsVerification.LWhitening.failureFamily D m).g k) 1 ∈
                U
