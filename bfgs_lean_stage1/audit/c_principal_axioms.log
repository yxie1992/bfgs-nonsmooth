        ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p)
  (hcorrect : ∀ p ∈ Ω, BfgsVerification.AffineCriticalObjective.AffineCorrectAt F p) {b : ℝ} (hb : F star < b)
