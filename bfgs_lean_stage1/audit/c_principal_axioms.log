BfgsVerification.PlanarObjectiveField.exists_secant_structured_visible_field {F : BfgsVerification.Vec 2 → ℝ}
  (hF : ConvexOn ℝ Set.univ F) {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ} (hK : IsCompact K) (hlevel : ∀ x ∈ K, F x = ℓ)
  (hstrict : ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y)
  (hregular : ∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F x)
  (hnoncritical : ∀ x ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F x) {σ : ℝ} (hσ : 0 < σ) :
  ∃ m χ v,
    (∀ (i : Fin m), ContDiff ℝ (↑⊤) (χ i)) ∧
      ∃ N η,
        0 < η ∧
          IsOpen N ∧
            K ⊆ N ∧
              (∀ x ∈ N, ∃ L, ∃ U ∈ nhds x, LipschitzOnWith L (BfgsVerification.PlanarObjectiveField.field hF χ v) U) ∧
                (∀ x ∈ N,
                    ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,
                      η ≤ BfgsVerification.dot g (BfgsVerification.PlanarObjectiveField.field hF χ v x)) ∧
                  (∀ x ∈ N, ∀ (i : Fin m), ContDiffAt ℝ 1 (v i) (F x)) ∧
                    (∀ x ∈ N,
                        ContDiffAt ℝ 2 F x ∨
                          ∃ i,
                            ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,
                              BfgsVerification.PlanarObjectiveField.field hF χ v z = v i (F z)) ∧
                      (∀ x ∈ K,
                          ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,
                            ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,
                              BfgsVerification.dot g (BfgsVerification.PlanarObjectiveField.field hF χ v x) =
                                BfgsVerification.dot h (BfgsVerification.PlanarObjectiveField.field hF χ v x)) ∧
                        ∀ p ∈ K,
                          BfgsVerification.PlanarCrossing.LocalSecantControl F
                            (BfgsVerification.PlanarObjectiveField.field hF χ v) σ p
