@BfgsVerification.RealAlgebraicGeometry.planar_low_basin_of_finite_critical_values : ∀ {F : BfgsVerification.Vec 2 → ℝ},
  ConvexOn ℝ Set.univ F →
    (F '' {x | BfgsVerification.AffineCriticalObjective.IsAffineCritical F x}).Finite →
      ∀ (star : BfgsVerification.Vec 2),
        (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →
          ∀ {b : ℝ},
            F star < b →
              IsCompact {x | F x ≤ b} →
                (∀ (ℓ : ℝ),
                    F star < ℓ →
                      ℓ ≤ b → ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →
                  (∀ (p : BfgsVerification.Vec 2),
                      F p ≤ b →
                        ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →
                          ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p) →
                    ∃ ε,
                      0 < ε ∧
                        ∀ (R : BfgsVerification.AdmissibleBFGSRun 2 F),
                          F (R.x 0) ≤ F star + ε →
                            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop
                                  (nhds 0) ∧
                                Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k))
                                    Filter.atTop (nhds 0) ∧
                                  ((∀ (z : BfgsVerification.Vec 2), F z = F star → z = star) →
                                    Filter.Tendsto R.x Filter.atTop (nhds star))
'BfgsVerification.RealAlgebraicGeometry.planar_low_basin_of_finite_critical_values' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
