                (∀ (ℓ : ℝ), F star < ℓ → ℓ ≤ b → ∀ (x y : Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →
                  (∀ (p : Vec 2), F p ≤ b → ¬IsAffineCritical F p → ContDiffAt ℝ 2 F p ∨ ConvexTwoBranchRegularAt F p) →
                    ∃ ε,
                      0 < ε ∧
                        ∀ (R : AdmissibleBFGSRun 2 F),
                          F (R.x 0) ≤ F star + ε →
                            Tendsto (fun k => F (R.x k)) atTop (𝓝 (F star)) ∧
                              Tendsto (fun k => Metric.infDist (R.x k) (argmin F)) atTop (𝓝 0) ∧
                                Tendsto (fun k => euclideanSolutionDistance F (R.x k)) atTop (𝓝 0) ∧
                                  ((∀ (z : Vec 2), F z = F star → z = star) → Tendsto R.x atTop (𝓝 star))
