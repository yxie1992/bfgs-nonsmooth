GeometryClaimReview20.raw_C_cluster_and_convergence : ∀ (F : Vec 2 → ℝ),
  ConvexOn ℝ univ F →
    ∀ (x : ℕ → Vec 2) (H : ℕ → Mat 2) (g : ℕ → Vec 2) (α : ℕ → ℝ) (c₁ c₂ : ℝ),
      0 < c₁ →
        c₁ < c₂ →
          c₂ < 1 →
            PosDef (H 0) →
              (∀ (k : ℕ), 0 < α k) →
                (∀ (k : ℕ), g k ≠ 0) →
                  (∀ (k : ℕ), HasFDerivAt F (∑ i, g k i • ContinuousLinearMap.proj i) (x k)) →
                    (∀ (k : ℕ), x (k + 1) = x k + -α k • H k *ᵥ g k) →
                      (∀ (k : ℕ),
                          let s := -α k • H k *ᵥ g k;
                          let y := g (k + 1) - g k;
                          let t := dot y s;
                          H (k + 1) =
                            (1 - t⁻¹ • of fun i j => s i * y j) * H k * (1 - t⁻¹ • of fun i j => y i * s j) +
                              t⁻¹ • of fun i j => s i * s j) →
                        (∀ (k : ℕ), F (x (k + 1)) ≤ F (x k) + c₁ * dot (g k) (-α k • H k *ᵥ g k)) →
                          (∀ (k : ℕ), c₂ * dot (g k) (-α k • H k *ᵥ g k) ≤ dot (g (k + 1)) (-α k • H k *ᵥ g k)) →
                            ∀ (star : Vec 2),
                              (∀ (z : Vec 2), F star ≤ F z) →
                                ∀ (b : ℝ),
                                  IsCompact {z | F z ≤ b} →
                                    F (x 0) ≤ b →
                                      (∀ (ℓ : ℝ),
                                          F star < ℓ →
                                            ℓ ≤ b → ∀ (u v : Vec 2), segment ℝ u v ⊆ frontier {w | F w ≤ ℓ} → u = v) →
                                        (∀ (p : Vec 2),
                                            F p ≤ b →
                                              0 ∉ affineSpan ℝ {v | ∀ (z : Vec 2), dot v (z - p) ≤ F z - F p} →
                                                ContDiffAt ℝ 2 F p ∨
                                                  ∃ f U,
                                                    IsOpen U ∧
                                                      p ∈ U ∧
                                                        (∀ (i : Fin 2), ConvexOn ℝ U (f i) ∧ ContDiffOn ℝ 2 (f i) U) ∧
                                                          (∀ z ∈ U, IsGreatest (range fun i => f i z) (F z)) ∧
                                                            (∀ (i : Fin 2), f i p = F p) ∧
                                                              pairDet (coordinateGradient (f 0) p)
                                                                  (coordinateGradient (f 1) p) ≠
                                                                0) →
                                          (∃ p,
                                              MapClusterPt p atTop x ∧
                                                F p ≤ b ∧
                                                  0 ∈ affineSpan ℝ {v | ∀ (z : Vec 2), dot v (z - p) ≤ F z - F p}) ∧
                                            ((∀ (p : Vec 2),
                                                F p ≤ b →
                                                  0 ∈ affineSpan ℝ {v | ∀ (z : Vec 2), dot v (z - p) ≤ F z - F p} →
                                                    ∀ (z : Vec 2), F p ≤ F z) →
                                              Tendsto (fun k => F (x k)) atTop (𝓝 (F star)) ∧
                                                Tendsto
                                                    (fun k =>
                                                      Metric.infDist (euclideanVector (x k))
                                                        (euclideanVector '' {z | ∀ (w : Vec 2), F z ≤ F w}))
                                                    atTop (𝓝 0) ∧
                                                  ((∀ (z : Vec 2), F z = F star → z = star) → Tendsto x atTop (𝓝 star)))
