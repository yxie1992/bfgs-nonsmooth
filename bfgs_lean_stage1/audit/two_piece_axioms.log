def BfgsVerification.TwoPieceBudget.TwoPieceTerminationTarget : Prop :=
ConvexOn ℝ Set.univ BfgsVerification.TwoPieceBudget.objective ∧
  ∀ (c₁ c₂ : ℝ),
    0 < c₁ →
      c₁ < c₂ →
        c₂ < 1 →
          (WellFounded fun T S => BfgsVerification.TwoPieceBudget.Step c₁ c₂ S T) ∧
            ∀ (S : BfgsVerification.TwoPieceBudget.State),
              ∃ T,
                Relation.ReflTransGen (BfgsVerification.TwoPieceBudget.Step c₁ c₂) S T ∧
                  (¬∃ U, BfgsVerification.TwoPieceBudget.Step c₁ c₂ T U) ∧
                    Filter.Tendsto
                      (fun t => BfgsVerification.TwoPieceBudget.objective (T.x + BfgsVerification.bfgsStep T.H T.g t))
                      Filter.atTop Filter.atBot
EXACT_TARGET_OK BfgsVerification.TwoPieceBudget.twoPieceTermination BfgsVerification.TwoPieceBudget.TwoPieceTerminationTarget
def BfgsVerification.TwoPieceBudget.TwoPieceLinearImageTarget : Prop :=
(∀ {n : ℕ} (Q : Matrix (Fin 2) (Fin n) ℝ),
    BfgsVerification.AffineProjection.FullRowRank Q →
      (BfgsVerification.AdmissibleBFGSRun n fun x => BfgsVerification.TwoPieceBudget.objective (Q.mulVec x)) → False) ∧
  ∀ {n : ℕ} (u v : BfgsVerification.Vec n),
    LinearIndependent ℝ ![u, v] →
      (BfgsVerification.AdmissibleBFGSRun n fun x => |BfgsVerification.dot u x| + BfgsVerification.dot v x) → False
EXACT_TARGET_OK BfgsVerification.TwoPieceBudget.twoPieceLinearImage BfgsVerification.TwoPieceBudget.TwoPieceLinearImageTarget
