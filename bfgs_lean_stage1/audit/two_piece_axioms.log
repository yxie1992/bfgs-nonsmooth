      let B := BfgsVerification.TwoPieceBudget.cross a b σ;
      let D := BfgsVerification.TwoPieceBudget.determinant a b c;
      let a' := α * B / 2;
      let b' := σ * α * (A - B) / 2;
      let c' := D * A / B ^ 2 + α * (A - B) ^ 2 / (2 * B);
