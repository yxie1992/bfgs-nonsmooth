BfgsVerification.RealAlgebraicGeometry.planar_low_basin_of_finite_critical_values {F : Vec 2 → ℝ}
  (hF : ConvexOn ℝ univ F) (hfinite : (F '' {x | IsAffineCritical F x}).Finite) (star : Vec 2)
  (hmin : ∀ (z : Vec 2), F star ≤ F z) {b : ℝ} (hb : F star < b) (hK : IsCompact {x | F x ≤ b})
  (hstrict : ∀ (ℓ : ℝ), F star < ℓ → ℓ ≤ b → ∀ (x y : Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y)
  (hregular : ∀ (p : Vec 2), F p ≤ b → ¬IsAffineCritical F p → ContDiffAt ℝ 2 F p ∨ ConvexTwoBranchRegularAt F p) :
  ∃ ε,
    0 < ε ∧
      ∀ (R : AdmissibleBFGSRun 2 F),
        F (R.x 0) ≤ F star + ε →
          Tendsto (fun k => F (R.x k)) atTop (𝓝 (F star)) ∧
            Tendsto (fun k => Metric.infDist (R.x k) (argmin F)) atTop (𝓝 0) ∧
              Tendsto (fun k => euclideanSolutionDistance F (R.x k)) atTop (𝓝 0) ∧
                ((∀ (z : Vec 2), F z = F star → z = star) → Tendsto R.x atTop (𝓝 star))
'BfgsVerification.RealAlgebraicGeometry.planar_low_basin_of_finite_critical_values' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
BfgsVerification.RealAlgebraicGeometry.planar_local_basin_of_finite_critical_values {F : Vec 2 → ℝ}
  (hF : ConvexOn ℝ univ F) (hfinite : (F '' {x | IsAffineCritical F x}).Finite) (star : Vec 2)
  (hmin : ∀ (z : Vec 2), F star ≤ F z) (hunique : ∀ (z : Vec 2), F z = F star → z = star) {Ω : Set (Vec 2)}
  (hΩ : IsOpen Ω) (hstar : star ∈ Ω)
  (hregular : ∀ p ∈ Ω, ¬IsAffineCritical F p → ContDiffAt ℝ 2 F p ∨ ConvexTwoBranchRegularAt F p) {b : ℝ}
  (hb : F star < b)
  (hstrict : ∀ (ℓ : ℝ), F star < ℓ → ℓ ≤ b → ∀ (x y : Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) :
  ∃ ε,
    0 < ε ∧
