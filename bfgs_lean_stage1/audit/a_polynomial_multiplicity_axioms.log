                  ∀ (t : ℝ),
                    dist t b < δ →
                      BfgsVerification.RealAlgebraicGeometry.parameterPoint x t ∈
                          BfgsVerification.RealAlgebraicGeometry.multiplicityStratum p m →
                        t = g x) ∧
