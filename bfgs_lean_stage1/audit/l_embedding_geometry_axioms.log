BfgsVerification.LEmbedding.actual_hessian_bounds {x : BfgsVerification.Vec 2}
  (hfirst : ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, DifferentiableAt ℝ BfgsVerification.LEmbedding.objective z)
  (hsecond : DifferentiableAt ℝ (fderiv ℝ BfgsVerification.LEmbedding.objective) x) :
  Matrix.IsSymm (BfgsVerification.RadialHessian.matrix BfgsVerification.LEmbedding.objective x) ∧
    ∀ (v : BfgsVerification.Vec 2),
      BfgsVerification.LEmbedding.mu * BfgsVerification.sqNorm v ≤
          BfgsVerification.dot v
            (Matrix.mulVec (BfgsVerification.RadialHessian.matrix BfgsVerification.LEmbedding.objective x) v) ∧
        BfgsVerification.dot v
            (Matrix.mulVec (BfgsVerification.RadialHessian.matrix BfgsVerification.LEmbedding.objective x) v) ≤
          512 * BfgsVerification.sqNorm v
