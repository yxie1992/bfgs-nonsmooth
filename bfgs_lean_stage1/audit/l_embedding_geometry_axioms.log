BfgsVerification.LEmbedding.local_upper_taylor {x g : BfgsVerification.Vec 2}
  (hg : HasFDerivAt BfgsVerification.LEmbedding.objective (BfgsVerification.gradientFunctional g) x) :
  ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,
    BfgsVerification.LEmbedding.objective z ≤
      BfgsVerification.LEmbedding.objective x + BfgsVerification.dot g (z - x) + 256 * BfgsVerification.sqNorm (z - x)
