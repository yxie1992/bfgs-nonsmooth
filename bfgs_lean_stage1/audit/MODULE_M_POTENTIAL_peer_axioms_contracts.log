BfgsVerification.SharpPrincipalPotentialTarget : Prop
'BfgsVerification.SharpPrincipalPotentialTarget' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.sharpPrincipalPotential : BfgsVerification.SharpPrincipalPotentialTarget
'BfgsVerification.sharpPrincipalPotential' depends on axioms: [propext, Classical.choice, Quot.sound]
def BfgsVerification.SharpPrincipalPotentialTarget : Prop :=
∀ (n : ℕ) (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < c →
    Summable R.d →
      ∀ (J : ℕ),
        let D := ∑' (i : ℕ), R.d (J + i);
        let K := 4 * G ^ 2 / c ^ 2;
        ∃ p,
          p.natDegree ≤ n - 1 ∧
            (∀ (m : ℕ),
                2 ≤ m →
                  BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / (c * (↑m - 1))))
                        (BfgsVerification.principalSum (R.H J)) =
                      Polynomial.eval (↑m - 1) p ∧
                    BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / (c * (↑m - 1))))
                        (BfgsVerification.principalSum (R.H J)) ≤
                      BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / c))
                          (BfgsVerification.principalSum (R.H J)) *
                        (↑m - 1) ^ (n - 1)) ∧
              Filter.Tendsto
                (fun m =>
                  BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / (c * (↑m - 1))))
                      (BfgsVerification.principalSum (R.H J)) ^
                    (1 / ↑m))
                Filter.atTop (nhds 1)
EXACT_TARGET_OK BfgsVerification.sharpPrincipalPotential
