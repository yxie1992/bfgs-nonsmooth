BfgsVerification.ObjectiveValueScalingTarget : Prop
'BfgsVerification.ObjectiveValueScalingTarget' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.objectiveValueScaling : BfgsVerification.ObjectiveValueScalingTarget
'BfgsVerification.objectiveValueScaling' depends on axioms: [propext, Classical.choice, Quot.sound]
def BfgsVerification.ObjectiveValueScalingTarget : Prop :=
∀ (n : Nat) (F : BfgsVerification.Vec n → Real) (a b : Real),
  LT.lt.{0} 0 a →
    ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
      ∃ S,
        And (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.c₁ S) (BfgsVerification.AdmissibleBFGSRun.c₁ R))
          (And (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.c₂ S) (BfgsVerification.AdmissibleBFGSRun.c₂ R))
            (∀ (k : Nat),
              And (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.x S k) (BfgsVerification.AdmissibleBFGSRun.x R k))
                (And
                  (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.H S k)
                    (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} a) (BfgsVerification.AdmissibleBFGSRun.H R k)))
                  (And
                    (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.g S k)
                      (HSMul.hSMul.{0, 0, 0} a (BfgsVerification.AdmissibleBFGSRun.g R k)))
                    (And (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.α S k) (BfgsVerification.AdmissibleBFGSRun.α R k))
                      (And
                        (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.d S k)
                          (HMul.hMul.{0, 0, 0} a (BfgsVerification.AdmissibleBFGSRun.d R k)))
                        (Eq.{1} (BfgsVerification.AdmissibleBFGSRun.curvature S k)
                          (HMul.hMul.{0, 0, 0} a (BfgsVerification.AdmissibleBFGSRun.curvature R k)))))))))
EXACT_TARGET_OK BfgsVerification.objectiveValueScaling
