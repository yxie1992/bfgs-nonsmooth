def BfgsVerification.ReconstructedFourPieceFailureTarget : Prop :=
ConvexOn ℝ Set.univ BfgsVerification.ReconstructedFourPiece.objective ∧
  (∀ (b : ℝ), IsCompact {z | BfgsVerification.ReconstructedFourPiece.objective z ≤ b}) ∧
    BfgsVerification.ReconstructedFourPiece.optimizer = ![-1, 5] ∧
      BfgsVerification.ReconstructedFourPiece.objective BfgsVerification.ReconstructedFourPiece.optimizer = -1 ∧
        (∀ (z : BfgsVerification.Vec 2), -1 ≤ BfgsVerification.ReconstructedFourPiece.objective z) ∧
          (∀ (z : BfgsVerification.Vec 2),
              BfgsVerification.ReconstructedFourPiece.objective z = -1 →
                z = BfgsVerification.ReconstructedFourPiece.optimizer) ∧
            (∀ (i : Fin 3),
                BfgsVerification.ReconstructedFourPiece.family.branch i.castSucc
                    BfgsVerification.ReconstructedFourPiece.optimizer =
                  ![-1, -1, -29 / 4] i) ∧
              0 ∉
                  BfgsVerification.ConvexSubdifferential.subdifferential
                    BfgsVerification.ReconstructedFourPiece.objective 0 ∧
                ∀ (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1),
                  let R := BfgsVerification.ReconstructedFourPiece.run hc₁ hc₁' hc hc₂;
                  R.c₁ = c₁ ∧
                    R.c₂ = c₂ ∧
                      (∀ (k : ℕ),
                          R.x k =
                            BfgsVerification.AffineWhitening.point BfgsVerification.ReconstructedFourPiece.coordinate
                              (BfgsVerification.SeedOrbit.orbitPoint k)) ∧
                        (∀ (k : ℕ),
                            R.H k =
                              BfgsVerification.ReconstructedFourPiece.valueScale⁻¹ •
                                BfgsVerification.AffineWhitening.metric
                                  BfgsVerification.ReconstructedFourPiece.coordinate
                                  (BfgsVerification.SeedOrbit.orbitMetric k)) ∧
                          (∀ (k : ℕ),
                              R.g k =
                                BfgsVerification.ReconstructedFourPiece.valueScale •
                                  BfgsVerification.AffineWhitening.gradient
                                    BfgsVerification.ReconstructedFourPiece.coordinate
                                    (BfgsVerification.SeedOrbit.orbitGradient k)) ∧
                            (∀ (k : ℕ), R.α k = BfgsVerification.SeedOrbit.orbitLength k) ∧
                              Filter.Tendsto R.x Filter.atTop (nhds 0) ∧
                                Filter.Tendsto (fun k => BfgsVerification.ReconstructedFourPiece.objective (R.x k))
                                    Filter.atTop (nhds (BfgsVerification.ReconstructedFourPiece.valueScale - 1)) ∧
                                  -1 < BfgsVerification.ReconstructedFourPiece.valueScale - 1 ∧
                                    (∀ (k : ℕ),
                                        BfgsVerification.ReconstructedFourPiece.valueScale - 1 <
                                          BfgsVerification.ReconstructedFourPiece.objective (R.x k)) ∧
                                      ∀ (k : ℕ),
                                        BfgsVerification.ReconstructedFourPiece.objective (R.x (k + 1)) <
                                          BfgsVerification.ReconstructedFourPiece.objective (R.x k)
EXACT_TARGET_OK BfgsVerification.reconstructedFourPieceFailure
def BfgsVerification.ReconstructedSupportingPlaneTarget : Prop :=
(∀ (m : ℕ) (j : Fin 3),
    BfgsVerification.RadialCertificate.optimizerIntercept BfgsVerification.ReconstructedFourPiece.objective
        BfgsVerification.ReconstructedFourPiece.optimizer (BfgsVerification.ReconstructedFourPiece.point (3 * m + ↑j))
        (BfgsVerification.ReconstructedFourPiece.gradient (3 * m + ↑j)) =
      ![0, 0, 25 / 4] j) ∧
  (∀ (k : ℕ),
      HasFDerivAt BfgsVerification.ReconstructedFourPiece.objective
        (BfgsVerification.gradientFunctional (BfgsVerification.ReconstructedFourPiece.gradient k))
        (BfgsVerification.ReconstructedFourPiece.point k)) ∧
    (∀ (k : ℕ),
        0 <
          BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.ReconstructedFourPiece.point k)
            (BfgsVerification.ReconstructedFourPiece.point (k + 1)) (BfgsVerification.ReconstructedFourPiece.gradient k)
            (BfgsVerification.ReconstructedFourPiece.gradient (k + 1))) ∧
      Filter.Tendsto
          (fun k =>
            BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.ReconstructedFourPiece.point k)
              (BfgsVerification.ReconstructedFourPiece.point (k + 1))
              (BfgsVerification.ReconstructedFourPiece.gradient k)
              (BfgsVerification.ReconstructedFourPiece.gradient (k + 1)))
          Filter.atTop (nhds 0) ∧
        ¬BfgsVerification.RadialCertificate.HasInterceptBounds BfgsVerification.ReconstructedFourPiece.objective
              {z |
                BfgsVerification.ReconstructedFourPiece.objective z ≤
                  BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point 0)}
              BfgsVerification.ReconstructedFourPiece.optimizer ∧
          ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.ReconstructedFourPiece.objective
              {z |
                BfgsVerification.ReconstructedFourPiece.objective z ≤
                  BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point 0)}
              BfgsVerification.ReconstructedFourPiece.optimizer
EXACT_TARGET_OK BfgsVerification.reconstructedSupportingPlane
