BfgsVerification.ConstantRankFields.source_common_rate_and_secant {n m : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (hF : ConvexOn ℝ Set.univ F) (f : Fin m → BfgsVerification.Vec n → ℝ) {K : Set (BfgsVerification.Vec n)}
  (hK : IsCompact K) (hrep : ∀ p ∈ K, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f p)
  (hC2 : ∀ p ∈ K, ∀ (j : Fin m), ContDiffAt ℝ 2 (f j) p)
  (hconv : ∀ p ∈ K, ∃ V, IsOpen V ∧ p ∈ V ∧ ∀ (j : Fin m), ConvexOn ℝ V (f j))
  (hnc : ∀ p ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p)
  (hrank : ∀ p ∈ K, BfgsVerification.ConstantRankFields.LocallyConstantActiveRank F f p) :
  ∃ v,
    ContDiff ℝ 1 v ∧
      ∃ V Q,
        IsOpen V ∧
          K ⊆ V ∧
            closure V ⊆ Q ∧
              IsCompact Q ∧
                ∃ G δ C,
                  0 < G ∧
                    0 < δ ∧
                      0 ≤ C ∧
                        (∀ x ∈ Q, BfgsVerification.sqNorm (v x) ≤ G ^ 2) ∧
                          (∀ x ∈ Q,
                              ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,
                                BfgsVerification.dot g (v x) = 1) ∧
                            ∀ (x z g h : BfgsVerification.Vec n),
                              x ∈ Q →
