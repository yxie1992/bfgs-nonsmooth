  (hconv : ∀ p ∈ K, ∃ V, IsOpen V ∧ p ∈ V ∧ ∀ (j : Fin m), ConvexOn ℝ V (f j))
  (hnc : ∀ p ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p)
  (hrank : ∀ p ∈ K, BfgsVerification.ConstantRankFields.LocallyConstantActiveRank F f p) {c₁ c₂ : ℝ} (hc₂ : c₂ < 1) :
