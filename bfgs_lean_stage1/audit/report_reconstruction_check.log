    {
      "theorem": "BfgsVerification.sum_transformed_coordinate_grams",
      "signature": "\u2200 {n : \u2115} (H U : BfgsVerification.Mat n),\n  Matrix.transpose U * U = 1 \u2192\n    \u2200 (j : \u2115),\n      \u2211 I \u2208 Finset.powersetCard j Finset.univ,\n          (BfgsVerification.metricGram H (U * BfgsVerification.coordinateMatrix I)).det =\n        BfgsVerification.principalSum H j",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/PrincipalHierarchy.lean"
    },
