    {
      "theorem": "BfgsVerification.sqNorm_difference_le_four",
      "signature": "\u2200 {n : \u2115} (x y : BfgsVerification.Vec n) (A : \u211d),\n  BfgsVerification.sqNorm x \u2264 A ^ 2 \u2192 BfgsVerification.sqNorm y \u2264 A ^ 2 \u2192 BfgsVerification.sqNorm (x - y) \u2264 (2 * A) ^ 2",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/EuclideanEstimates.lean"
    },
    {
      "theorem": "BfgsVerification.sqNorm_nonneg",
      "signature": "\u2200 {n : \u2115} (g : BfgsVerification.Vec n), 0 \u2264 BfgsVerification.sqNorm g",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/Normalization.lean"
    },
    {
      "theorem": "BfgsVerification.sqNorm_orthogonal_coordinates",
      "signature": "\u2200 {n : \u2115} (U : BfgsVerification.Mat n),\n  U * Matrix.transpose U = 1 \u2192\n    \u2200 (y : BfgsVerification.Vec n), BfgsVerification.sqNorm ((Matrix.transpose U).mulVec y) = BfgsVerification.sqNorm y",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/OrthogonalCoordinates.lean"
    },
    {
      "theorem": "BfgsVerification.sqNorm_sub_le",
      "signature": "\u2200 {n : \u2115} (g h : BfgsVerification.Vec n),\n  BfgsVerification.sqNorm (g - h) \u2264 2 * BfgsVerification.sqNorm g + 2 * BfgsVerification.sqNorm h",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/Normalization.lean"
    },
