      "signature": "\u2200 {\u03bc : \u211d},\n  0 < \u03bc \u2192\n    \u2200 U \u2208 nhds 0,\n      \u2203 R,\n        R.c\u2081 = 1 / 10000 \u2227\n          R.c\u2082 = 1 / 2 \u2227\n            Filter.Tendsto R.x Filter.atTop (nhds 0) \u2227\n              Filter.Tendsto R.H Filter.atTop (nhds 0) \u2227\n                Filter.Tendsto (fun k => BfgsVerification.LQuadraticSeed.objective \u03bc (R.x k)) Filter.atTop (nhds 0) \u2227\n                  (\u2200 (k : \u2115), 0 < BfgsVerification.LQuadraticSeed.objective \u03bc (R.x k)) \u2227\n                    (\u2200 (k : \u2115),\n                        BfgsVerification.LQuadraticSeed.objective \u03bc (R.x (k + 1)) <\n                          BfgsVerification.LQuadraticSeed.objective \u03bc (R.x k)) \u2227\n                      (\u2200 (k : \u2115), R.\u03b1 k = BfgsVerification.SeedOrbit.length (BfgsVerification.SeedOrbit.phase k)) \u2227\n                        (\u2200 (k : \u2115),\n                            BfgsVerification.DeterministicLineSearch.fromMetric\n                                (BfgsVerification.LQuadraticSeed.objective \u03bc) (R.x k) (R.H k) (1 / 10000) (1 / 2) 5 =\n                              (some (R.\u03b1 k),\n                                BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k))) \u2227\n                          (\u2200 (k : \u2115), R.x k \u2208 U) \u2227\n                            (\u2200 (k : \u2115) (q : Fin 9),\n                                BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k \u2192\n                                  DifferentiableAt \u211d (BfgsVerification.LQuadraticSeed.objective \u03bc)\n                                      (R.x k +\n                                        BfgsVerification.SeedOrbit.trialLength q \u2022\n                                          BfgsVerification.bfgsStep (R.H k) (R.g k) 1) \u2227\n                                    0 <\n                                        BfgsVerification.LQuadraticSeed.objective \u03bc\n                                          (R.x k +\n                                            BfgsVerification.SeedOrbit.trialLength q \u2022\n                                              BfgsVerification.bfgsStep (R.H k) (R.g k) 1) \u2227\n                                      R.x k +\n                                          BfgsVerification.SeedOrbit.trialLength q \u2022\n                                            BfgsVerification.bfgsStep (R.H k) (R.g k) 1 \u2208\n                                        U) \u2227\n                              (\u2200 (q : \u2115 \u2192 Fin 9),\n                                  (\u2200 (k : \u2115),\n                                      BfgsVerification.SeedOrbit.trialPhase (q k) =\n                                        BfgsVerification.SeedOrbit.phase k) \u2192\n                                    Filter.Tendsto\n                                      (fun k =>\n                                        R.x k +\n                                          BfgsVerification.SeedOrbit.trialLength (q k) \u2022\n                                            BfgsVerification.bfgsStep (R.H k) (R.g k) 1)\n                                      Filter.atTop (nhds 0)) \u2227\n                                (\u2200 (k : \u2115),\n                                    BfgsVerification.LQuadraticSeed.objective \u03bc (R.x (k + 1)) <\n                                        BfgsVerification.LQuadraticSeed.objective \u03bc (R.x k) +\n                                          1 / 10000 *\n                                            BfgsVerification.dot (R.g k)\n                                              (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.\u03b1 k)) \u2227\n                                      1 / 2 *\n                                          BfgsVerification.dot (R.g k)\n                                            (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.\u03b1 k)) <\n                                        BfgsVerification.dot (R.g (k + 1))\n                                          (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.\u03b1 k))) \u2227\n                                  0 \u2209\n                                    BfgsVerification.ConvexSubdifferential.subdifferential\n                                      (BfgsVerification.LQuadraticSeed.objective \u03bc) 0",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
