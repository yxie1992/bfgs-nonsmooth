    {
      "theorem": "BfgsVerification.supporting_limit",
      "signature": "\u2200 {n : \u2115} {F : BfgsVerification.Vec n \u2192 \u211d},\n  Continuous F \u2192\n    \u2200 {x g : \u2115 \u2192 BfgsVerification.Vec n} {xlim glim : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds xlim) \u2192\n        Filter.Tendsto g Filter.atTop (nhds glim) \u2192\n          (\u2200 (k : \u2115) (z : BfgsVerification.Vec n), BfgsVerification.dot (g k) (z - x k) \u2264 F z - F (x k)) \u2192\n            \u2200 (z : BfgsVerification.Vec n), BfgsVerification.dot glim (z - xlim) \u2264 F z - F xlim",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/ConvexGradientLimits.lean"
    },
    {
      "theorem": "BfgsVerification.supporting_vector_eq_gradient",
      "signature": "\u2200 {n : \u2115} {F : BfgsVerification.Vec n \u2192 \u211d} {x a g : BfgsVerification.Vec n},\n  (\u2200 (z : BfgsVerification.Vec n), BfgsVerification.dot a (z - x) \u2264 F z - F x) \u2192\n    HasFDerivAt F (BfgsVerification.gradientFunctional g) x \u2192 a = g",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/ConvexGradientLimits.lean"
    },
    {
      "theorem": "BfgsVerification.supporting_vectors_tendsto_at_differentiable",
      "signature": "\u2200 {n : \u2115} {F : BfgsVerification.Vec n \u2192 \u211d},\n  ConvexOn \u211d Set.univ F \u2192\n    \u2200 {x a : \u2115 \u2192 BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds star) \u2192\n        (\u2200 (k : \u2115) (z : BfgsVerification.Vec n), BfgsVerification.dot (a k) (z - x k) \u2264 F z - F (x k)) \u2192\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) star \u2192 Filter.Tendsto a Filter.atTop (nhds g)",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/ConvexGradientLimits.lean"
    },
