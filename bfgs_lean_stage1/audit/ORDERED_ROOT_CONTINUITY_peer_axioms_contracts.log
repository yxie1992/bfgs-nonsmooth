                            (Polynomial.map (MvPolynomial.eval a) p) k) <
                        ε ∧
                      Polynomial.rootMultiplicity
                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot
                            (Polynomial.map (MvPolynomial.eval x) p) k)
                          (Polynomial.map (MvPolynomial.eval x) p) =
                        Polynomial.rootMultiplicity
                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot
                            (Polynomial.map (MvPolynomial.eval a) p) k)
                          (Polynomial.map (MvPolynomial.eval a) p)
