BfgsVerification.PlanarObjectiveField.field_structural_neighborhood {F : BfgsVerification.Vec 2 → ℝ}
  (hF : ConvexOn ℝ Set.univ F) {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ} (hlevel : ∀ x ∈ K, F x = ℓ) {m : ℕ}
  {points : Fin m → BfgsVerification.Vec 2} {v : Fin m → ℝ → BfgsVerification.Vec 2}
  {W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2} (hv : ∀ (i : Fin m), ContDiffAt ℝ 1 (v i) ℓ)
  (hcorner : ∀ (i : Fin m), ∀ᶠ (z : BfgsVerification.Vec 2) in nhds (points i), W z = v i (F z))
  (hcover : ∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ ∃ i, x = points i) :
  ∃ N,
    IsOpen N ∧
      K ⊆ N ∧
        ∀ x ∈ N,
          (∀ (i : Fin m), ContDiffAt ℝ 1 (v i) (F x)) ∧
            (ContDiffAt ℝ 2 F x ∨ ∃ i, ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, W z = v i (F z))
