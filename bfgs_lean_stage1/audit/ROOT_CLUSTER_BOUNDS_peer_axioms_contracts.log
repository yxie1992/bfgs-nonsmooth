                      (Polynomial.map (MvPolynomial.eval a) p).natDegree →
                    (∀ (t : ℝ),
                        (Polynomial.map (MvPolynomial.eval x) p).IsRoot t →
                          ∃ b ∈ (Polynomial.map (MvPolynomial.eval a) p).roots.toFinset, t ∈ Set.Ioo (b - δ) (b + δ)) ∧
                      ∀ b ∈ (Polynomial.map (MvPolynomial.eval a) p).roots.toFinset,
                        BfgsVerification.RealAlgebraicGeometry.rootWeightIn (Polynomial.map (MvPolynomial.eval x) p)
                            (Set.Icc (b - δ) (b + δ)) ≤
                          Polynomial.rootMultiplicity b (Polynomial.map (MvPolynomial.eval a) p)
