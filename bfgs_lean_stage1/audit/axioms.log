BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.mk.inj","signature":"∀ {f : ℝ → ℝ} {convex : ConvexOn ℝ Set.univ f} {x g metric α : ℕ → ℝ} {c₁ c₂ : ℝ} {c₁_pos : 0 < c₁} {c₁_lt_c₂ : c₁ < c₂}\n  {c₂_lt_one : c₂ < 1} {metric_pos : ∀ (k : ℕ), 0 < metric k} {alpha_pos : ∀ (k : ℕ), 0 < α k}\n  {gradient_ne : ∀ (k : ℕ), g k ≠ 0} {hasDeriv : ∀ (k : ℕ), HasDerivAt f (g k) (x k)}\n  {step : ∀ (k : ℕ), x (k + 1) = x k - α k * metric k * g k}\n  {armijo : ∀ (k : ℕ), f (x (k + 1)) ≤ f (x k) + c₁ * g k * (x (k + 1) - x k)}\n  {weak_wolfe : ∀ (k : ℕ), c₂ * g k * (x (k + 1) - x k) ≤ g (k + 1) * (x (k + 1) - x k)}\n  {convex_1 : ConvexOn ℝ Set.univ f} {x_1 g_1 metric_1 α_1 : ℕ → ℝ} {c₁_1 c₂_1 : ℝ} {c₁_pos_1 : 0 < c₁_1}\n  {c₁_lt_c₂_1 : c₁_1 < c₂_1} {c₂_lt_one_1 : c₂_1 < 1} {metric_pos_1 : ∀ (k : ℕ), 0 < metric_1 k}\n  {alpha_pos_1 : ∀ (k : ℕ), 0 < α_1 k} {gradient_ne_1 : ∀ (k : ℕ), g_1 k ≠ 0}\n  {hasDeriv_1 : ∀ (k : ℕ), HasDerivAt f (g_1 k) (x_1 k)}\n  {step_1 : ∀ (k : ℕ), x_1 (k + 1) = x_1 k - α_1 k * metric_1 k * g_1 k}\n  {armijo_1 : ∀ (k : ℕ), f (x_1 (k + 1)) ≤ f (x_1 k) + c₁_1 * g_1 k * (x_1 (k + 1) - x_1 k)}\n  {weak_wolfe_1 : ∀ (k : ℕ), c₂_1 * g_1 k * (x_1 (k + 1) - x_1 k) ≤ g_1 (k + 1) * (x_1 (k + 1) - x_1 k)},\n  { convex := convex, x := x, g := g, metric := metric, α := α, c₁ := c₁, c₂ := c₂, c₁_pos := c₁_pos,\n        c₁_lt_c₂ := c₁_lt_c₂, c₂_lt_one := c₂_lt_one, metric_pos := metric_pos, alpha_pos := alpha_pos,\n        gradient_ne := gradient_ne, hasDeriv := hasDeriv, step := step, armijo := armijo, weak_wolfe := weak_wolfe } =\n      { convex := convex_1, x := x_1, g := g_1, metric := metric_1, α := α_1, c₁ := c₁_1, c₂ := c₂_1,\n        c₁_pos := c₁_pos_1, c₁_lt_c₂ := c₁_lt_c₂_1, c₂_lt_one := c₂_lt_one_1, metric_pos := metric_pos_1,\n        alpha_pos := alpha_pos_1, gradient_ne := gradient_ne_1, hasDeriv := hasDeriv_1, step := step_1,\n        armijo := armijo_1, weak_wolfe := weak_wolfe_1 } →\n    x = x_1 ∧ g = g_1 ∧ metric = metric_1 ∧ α = α_1 ∧ c₁ = c₁_1 ∧ c₂ = c₂_1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_gradients_tendsto_at_differentiable","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x a : ℕ → BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds star) →\n        (∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (a k)) (x k)) →\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) star → Filter.Tendsto a Filter.atTop (nhds g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  [inst : (a : BfgsVerification.Vec n) → SizeOf (K a)] (W : BfgsVerification.Vec n → BfgsVerification.Mat n)\n  (Ψ : BfgsVerification.Vec n → ℝ) (m C L δ ψlo ψhi : ℝ) (m_pos : 0 < m) (L_nonneg : 0 ≤ L) (delta_pos : 0 < δ)\n  (potential_bounds : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, ψlo ≤ Ψ x ∧ Ψ x ≤ ψhi)\n  (positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))\n  (visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)\n  (secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)\n  (transport :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              (Real.exp (L * BfgsVerification.TransportedCertificate.pairDecrease x z g + Ψ x - Ψ z) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef),\n  sizeOf\n      { W := W, Ψ := Ψ, m := m, C := C, L := L, δ := δ, ψlo := ψlo, ψhi := ψhi, m_pos := m_pos, L_nonneg := L_nonneg,\n        delta_pos := delta_pos, potential_bounds := potential_bounds, positive_semidefinite := positive_semidefinite,\n        visibility := visibility, secant := secant, transport := transport } =\n    1 + sizeOf m + sizeOf C + sizeOf L + sizeOf δ + sizeOf ψlo + sizeOf ψhi + sizeOf m_pos + sizeOf L_nonneg +\n      sizeOf delta_pos","axioms":["propext","Quot.sound","Classical.choice"]}
