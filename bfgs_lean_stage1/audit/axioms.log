BFGS_AUDIT {"theorem":"BfgsVerification.gradientFunctional.eq_1","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n), BfgsVerification.gradientFunctional g = ∑ i, g i • ContinuousLinearMap.proj i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift_d","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  (R.shift J).d k = R.d (J + k)","axioms":["propext","Quot.sound","Classical.choice"]}
