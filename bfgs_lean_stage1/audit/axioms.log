BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.hasBandCertificates_iff_zero_budget","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ : ℝ},\n  0 < c₁ →\n    c₂ < 1 →\n      ∀ (b : ℝ),\n        (∀ x ∈ K, F x ≤ b) →\n          (BfgsVerification.TransportedCertificate.HasBandCertificates F K fstar c₁ c₂ ↔\n            ∀ (η : ℝ),\n              0 < η → (BfgsVerification.TransportedCertificate.positiveBand F K fstar η).Nonempty → ∃ C, C.L = 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.coefficient_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k j : ℕ), 0 ≤ E k j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η)\n  (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          BfgsVerification.metricEnergy (self.W z) (h - g) ≤\n            self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
