BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.RateChart.one_sided_bounds","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ} {f : Fin m → BfgsVerification.Vec n → ℝ} {p : BfgsVerification.Vec n}\n  (c : BfgsVerification.ConstantRankFields.RateChart F f p) (i : Fin m),\n  ∃ L,\n    0 < L ∧\n      ∀ x ∈ Metric.closedBall p (c.radius / 2),\n        ∀ z ∈ Metric.closedBall p (c.radius / 2),\n          BfgsVerification.sqNorm\n              (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) ≤\n            2 * L * (f i z - f i x - BfgsVerification.dot (BfgsVerification.coordinateGradient (f i) x) (z - x))","axioms":["propext","Classical.choice","Quot.sound"]}
