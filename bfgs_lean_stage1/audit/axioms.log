BFGS_AUDIT {"theorem":"BfgsVerification.curvature_ge_of_weakWolfe","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g gnext : BfgsVerification.Vec n) (α c₂ : ℝ),\n  c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ≤\n      BfgsVerification.dot gnext (BfgsVerification.bfgsStep H g α) →\n    (1 - c₂) * (α * BfgsVerification.metricEnergy H g) ≤\n      BfgsVerification.dot (gnext - g) (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
