BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.radial_implies_band_certificates","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n) {c₁ c₂ : ℝ},\n      0 < c₁ →\n        c₂ < 1 →\n          BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star →\n            BfgsVerification.TransportedCertificate.HasBandCertificates F K (F star) c₁ c₂","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.projected_transport_trace","signature":"∀ {n : ℕ} (M : BfgsVerification.Mat n),\n  Matrix.PosSemidef M →\n    ∀ (s : BfgsVerification.Vec n),\n      Matrix.mulVec M s = 0 →\n        ∀ (W Z : BfgsVerification.Mat n) (a : ℝ),\n          (a •\n                  (BfgsVerification.TransportedCertificate.stepProjector s * W *\n                    BfgsVerification.TransportedCertificate.stepProjector s) -\n                BfgsVerification.TransportedCertificate.stepProjector s * Z *\n                  BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef →\n            (M * Z).trace ≤ a * (M * W).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.certificate_trace_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {K : Set (BfgsVerification.Vec n)} {fstar η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar R.c₁ R.c₂ η) (k : ℕ),\n  R.x k ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    R.x (k + 1) ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      R.d k ≤ C.δ →\n        R.certificateEnergy C.W (k + 1) ≤ (1 + C.L * R.d k) * (R.certificateEnergy C.W k - C.m / R.q k) + C.C","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.curvature_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (1 - R.c₂) * R.d k ≤ BfgsVerification.dot (R.g (k + 1) - R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.diagonal_coordinate_gram_det","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 < lam i) →\n    ∀ (y : BfgsVerification.Vec n) (I : Finset (Fin n)),\n      (BfgsVerification.metricGram (Matrix.diagonal lam)\n            ((Matrix.replicateCol Unit y).fromCols (BfgsVerification.coordinateMatrix I))).det =\n        (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \\ I, lam k * y k ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.radialNumerator_eq_error_intercepts","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (star x z g h : BfgsVerification.Vec n),\n  BfgsVerification.RadialCertificate.radialNumerator star z g h =\n    BfgsVerification.RadialCertificate.supportingError F x g z +\n        BfgsVerification.RadialCertificate.optimizerIntercept F star z h -\n      BfgsVerification.RadialCertificate.optimizerIntercept F star x g","axioms":["propext","Quot.sound","Classical.choice"]}
