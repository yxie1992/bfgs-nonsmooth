BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.scalar_convergence","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 1 F),\n  IsCompact R.initialSublevel →\n    ∀ (xStar : BfgsVerification.Vec 1),\n      (∀ (x : BfgsVerification.Vec 1), F xStar ≤ F x) →\n        (∀ (x : BfgsVerification.Vec 1), F x = F xStar → x = xStar) →\n          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xStar)) ∧\n            Filter.Tendsto R.x Filter.atTop (nhds xStar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.inverse_update","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  (R.H (k + 1))⁻¹ =\n    (R.H k)⁻¹ - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k) +\n      (BfgsVerification.dot (R.g (k + 1) - R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)))⁻¹ •\n        BfgsVerification.outer (R.g (k + 1) - R.g k) (R.g (k + 1) - R.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.distance_to_argmin_of_values","signature":"∀ {E : Type u_1} [inst : MetricSpace E] {F : E → ℝ},\n  Continuous F →\n    ∀ (xStar : E),\n      (∀ (y : E), F xStar ≤ F y) →\n        ∀ {K : Set E},\n          IsCompact K →\n            ∀ {x : ℕ → E},\n              (∀ (k : ℕ), x k ∈ K) →\n                Filter.Tendsto (fun k => F (x k)) Filter.atTop (nhds (F xStar)) →\n                  Filter.Tendsto (fun k => Metric.infDist (x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.span_le_vectorSpan_of_affine_zero","signature":"∀ {n : ℕ} {S : Set (BfgsVerification.Vec n)}, 0 ∈ affineSpan ℝ S → Submodule.span ℝ S ≤ vectorSpan ℝ S","axioms":["propext","Quot.sound","Classical.choice"]}
