BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.parameter_ordered_root_eventually_near","signature":"∀ {n : ℕ} (p : Polynomial (MvPolynomial (Fin n) ℝ)) (a : BfgsVerification.Vec n),\n  Polynomial.map (MvPolynomial.eval a) p ≠ 0 →\n    ∀ {k : ℕ},\n      k < (Polynomial.map (MvPolynomial.eval a) p).roots.toFinset.card →\n        ∀ {ε : ℝ},\n          0 < ε →\n            ∀ᶠ (x : Fin n → ℝ) in nhds a,\n              (Polynomial.map (MvPolynomial.eval x) p).natDegree ≤ (Polynomial.map (MvPolynomial.eval a) p).natDegree →\n                (Polynomial.map (MvPolynomial.eval x) p).roots.toFinset.card =\n                    (Polynomial.map (MvPolynomial.eval a) p).roots.toFinset.card →\n                  (Polynomial.map (MvPolynomial.eval x) p).roots.card =\n                      (Polynomial.map (MvPolynomial.eval a) p).roots.card →\n                    dist\n                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot\n                            (Polynomial.map (MvPolynomial.eval x) p) k)\n                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot\n                            (Polynomial.map (MvPolynomial.eval a) p) k) <\n                        ε ∧\n                      Polynomial.rootMultiplicity\n                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot\n                            (Polynomial.map (MvPolynomial.eval x) p) k)\n                          (Polynomial.map (MvPolynomial.eval x) p) =\n                        Polynomial.rootMultiplicity\n                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot\n                            (Polynomial.map (MvPolynomial.eval a) p) k)\n                          (Polynomial.map (MvPolynomial.eval a) p)","axioms":["propext","Classical.choice","Quot.sound"]}
