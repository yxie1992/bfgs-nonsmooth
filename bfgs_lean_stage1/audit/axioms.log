BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.scalar_frame_energy","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ)\n  (w z : BfgsVerification.Vec n) (a b : ℝ),\n  z = a • w + b • R.displacement k →\n    BfgsVerification.metricEnergy (R.hessian (k + 1)) z =\n      a ^ 2 * (BfgsVerification.metricEnergy (R.hessian k) w - BfgsVerification.dot (R.g k) w ^ 2 / R.q k) +\n        BfgsVerification.dot (R.gradientChange k) z ^ 2 / R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
