BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.planar_affineCritical_cluster_on_sublevel","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 2 F) (star : BfgsVerification.Vec 2),\n  (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →\n    ∀ (b : ℝ),\n      IsCompact {x | F x ≤ b} →\n        F (R.x 0) ≤ b →\n          (∀ (ℓ : ℝ),\n              F star < ℓ → ℓ ≤ b → ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n            (∀ (p : BfgsVerification.Vec 2),\n                F p ≤ b →\n                  ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →\n                    ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p) →\n              ∃ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                F p ≤ b ∧ BfgsVerification.AffineCriticalObjective.IsAffineCritical F p","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.local_matrix_euclidean_residual_basin","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (A : (i : ι) → Matrix (Fin (m i)) (Fin n) ℝ) (b : (i : ι) → BfgsVerification.Vec (m i))\n      {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        ∀ {star : BfgsVerification.Vec n},\n          star ∈ U →\n            BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n              (∀ x ∈ U, F x = ψ x + ∑ i, ‖BfgsVerification.euclideanVector ((A i).mulVec x - b i)‖) →\n                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                  (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                    ∃ δ,\n                      0 < δ ∧\n                        ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                          F (R.x 0) ≤ F star + δ →\n                            (∀ (k : ℕ), R.x k ∈ U) ∧\n                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_bounded_below_convergence","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ),\n      (∀ (x : BfgsVerification.Vec n), L ≤ F x) →\n        (∀ (x : BfgsVerification.Vec n), F 0 ≤ F x) ∧\n          F 0 = 0 ∧ Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MaxAffine.Family.local_active_identity","signature":"∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m) (star : BfgsVerification.Vec n),\n  P.objective =ᶠ[nhds star] fun x => P.objective star + P.activeGauge star (x - star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.semialgebraic_affine_critical_component_constant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    BfgsVerification.RealAlgebraicGeometry.IsSemialgebraicObjective F →\n      ∀ {x p q : BfgsVerification.Vec n},\n        p ∈ connectedComponentIn {z | BfgsVerification.AffineCriticalObjective.IsAffineCritical F z} x →\n          q ∈ connectedComponentIn {z | BfgsVerification.AffineCriticalObjective.IsAffineCritical F z} x → F p = F q","axioms":["propext","Classical.choice","Quot.sound"]}
