BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.mk.injEq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r : ℕ)\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r) (m K L C : ℝ)\n  (m_pos : 0 < m) (K_pos : 0 < K) (L_nonneg : 0 ≤ L) (invertible : ∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0)\n  (product : ∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k)\n  (transport :\n    ∀ (k : ℕ), J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k))\n  (visible : ∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k)))\n  (correction :\n    ∀ (k : ℕ), J ≤ k → BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C)\n  (product_bound :\n    ∀ (k : ℕ),\n      J ≤ k →\n        ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v)\n  (inverse_bound :\n    ∀ (k : ℕ),\n      J ≤ k → ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v)\n  (J_1 r_1 : ℕ) (V_1 : ℕ → Matrix (Fin n) (Fin r_1) ℝ) (T_1 P_1 : ℕ → BfgsVerification.Mat r_1)\n  (b_1 : ℕ → BfgsVerification.Vec r_1) (m_1 K_1 L_1 C_1 : ℝ) (m_pos_1 : 0 < m_1) (K_pos_1 : 0 < K_1)\n  (L_nonneg_1 : 0 ≤ L_1) (invertible_1 : ∀ (k : ℕ), J_1 ≤ k → Matrix.det (P_1 k) ≠ 0)\n  (product_1 : ∀ (k : ℕ), J_1 ≤ k → P_1 (k + 1) = P_1 k * T_1 k)\n  (transport_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k → V_1 (k + 1) = V_1 k * T_1 k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b_1 k))\n  (visible_1 : ∀ (k : ℕ), J_1 ≤ k → m_1 ≤ BfgsVerification.sqNorm ((V_1 k).transpose.mulVec (R.g k)))\n  (correction_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k → BfgsVerification.sqNorm ((V_1 (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C_1)\n  (product_bound_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k →\n        ∀ (v : Fin r_1 → ℝ),\n          BfgsVerification.sqNorm ((Matrix.transpose (P_1 k)).mulVec v) ≤ K_1 * BfgsVerification.sqNorm v)\n  (inverse_bound_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k →\n        ∀ (v : Fin r_1 → ℝ), BfgsVerification.sqNorm ((P_1 k)⁻¹.transpose.mulVec v) ≤ L_1 * BfgsVerification.sqNorm v),\n  ({ J := J, r := r, V := V, T := T, P := P, b := b, m := m, K := K, L := L, C := C, m_pos := m_pos, K_pos := K_pos,\n        L_nonneg := L_nonneg, invertible := invertible, product := product, transport := transport, visible := visible,\n        correction := correction, product_bound := product_bound, inverse_bound := inverse_bound } =\n      { J := J_1, r := r_1, V := V_1, T := T_1, P := P_1, b := b_1, m := m_1, K := K_1, L := L_1, C := C_1,\n        m_pos := m_pos_1, K_pos := K_pos_1, L_nonneg := L_nonneg_1, invertible := invertible_1, product := product_1,\n        transport := transport_1, visible := visible_1, correction := correction_1, product_bound := product_bound_1,\n        inverse_bound := inverse_bound_1 }) =\n    (J = J_1 ∧ r = r_1 ∧ HEq V V_1 ∧ HEq T T_1 ∧ HEq P P_1 ∧ HEq b b_1 ∧ m = m_1 ∧ K = K_1 ∧ L = L_1 ∧ C = C_1)","axioms":["propext","Quot.sound","Classical.choice"]}
