BFGS_AUDIT {"theorem":"BfgsVerification.AnalyticStableGraph.exists_smooth_invariant_graph_of_splitting","signature":"∀ {S : Type u_1} {U : Type u_2} {X : Type u_3} [inst : NormedAddCommGroup S] [inst_1 : NormedSpace ℝ S]\n  [inst_2 : CompleteSpace S] [inst_3 : NormedAddCommGroup U] [inst_4 : NormedSpace ℝ U] [inst_5 : CompleteSpace U]\n  [inst_6 : NormedAddCommGroup X] [inst_7 : NormedSpace ℝ X] [inst_8 : CompleteSpace X] {T : X → X} {P : X}\n  {F : X →L[ℝ] X},\n  AnalyticAt ℝ T P →\n    T P = P →\n      HasFDerivAt T F P →\n        ∀ (E : (S × U) ≃L[ℝ] X) (A : S →L[ℝ] S) (L : U ≃L[ℝ] U),\n          ‖A‖ < 1 →\n            ‖↑L.symm‖ < 1 →\n              F.comp ↑E = (↑E).comp (A.prodMap ↑L) →\n                ∀ W ∈ nhds P,\n                  ∃ h V,\n                    IsOpen V ∧\n                      0 ∈ V ∧\n                        h 0 = 0 ∧\n                          ContDiffOn ℝ (↑⊤) h V ∧\n                            HasFDerivAt h 0 0 ∧\n                              ContDiffOn ℝ (↑⊤) (BfgsVerification.AnalyticStableGraph.chart P E h) V ∧\n                                HasFDerivAt (BfgsVerification.AnalyticStableGraph.chart P E h)\n                                    ((↑E).comp (ContinuousLinearMap.inl ℝ S U)) 0 ∧\n                                  (∀ a ∈ V,\n                                      ∃ w,\n                                        w 0 = BfgsVerification.AnalyticStableGraph.chart P E h a ∧\n                                          (∀ (n : ℕ), w n ∈ W) ∧\n                                            Filter.Tendsto w Filter.atTop (nhds P) ∧ ∀ (n : ℕ), w (n + 1) = T (w n)) ∧\n                                    ∃ V₀,\n                                      IsOpen V₀ ∧\n                                        0 ∈ V₀ ∧\n                                          V₀ ⊆ V ∧\n                                            ∀ a ∈ V₀,\n                                              ∃ b ∈ V,\n                                                T (BfgsVerification.AnalyticStableGraph.chart P E h a) =\n                                                  BfgsVerification.AnalyticStableGraph.chart P E h b","axioms":["propext","Classical.choice","Quot.sound"]}
