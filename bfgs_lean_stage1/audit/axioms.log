BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.energy_gap_tendsto_zero_of_quadratic_corrections","signature":"∀ {E q a R gap : ℕ → ℝ} {C : ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ gap k) →\n        Antitone gap →\n          (∀ (k : ℕ), gap k ≤ a k) →\n            (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop →\n                (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R k ≤ C * ↑N ^ 2) →\n                  Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.cluster_pair_segment_constant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (ℓ : ℝ),\n  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n    ∀ {φ : ℕ → ℕ},\n      StrictMono φ →\n        ∀ {x z : BfgsVerification.Vec n},\n          Filter.Tendsto (fun k => R.x (φ k)) Filter.atTop (nhds x) →\n            Filter.Tendsto (fun k => R.x (φ k + 1)) Filter.atTop (nhds z) → ∀ w ∈ segment ℝ x z, F w = ℓ","axioms":["propext","Quot.sound","Classical.choice"]}
