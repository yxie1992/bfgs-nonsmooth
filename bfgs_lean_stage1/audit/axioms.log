BFGS_AUDIT {"theorem":"BfgsVerification.LNormalizedOracle.Conditions.actual_matrix_update","signature":"∀ {μ c₁ c₂ : ℝ} {w : BfgsVerification.LNormalizedReturn.State},\n  BfgsVerification.LNormalizedOracle.Conditions μ c₁ c₂ w →\n    0 < BfgsVerification.LNormalizedReturn.scale w →\n      ∀ (j : Fin 3),\n        BfgsVerification.inverseBFGS (BfgsVerification.LNormalizedOracle.physicalMetric μ w j)\n            (BfgsVerification.LNormalizedReturn.scale w • (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).1 -\n              BfgsVerification.LNormalizedOracle.physicalPoint μ w j)\n            (BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective μ)\n                (BfgsVerification.LNormalizedReturn.scale w •\n                  (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).1) -\n              BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective μ)\n                (BfgsVerification.LNormalizedOracle.physicalPoint μ w j)) =\n          BfgsVerification.LNormalizedReturn.scale w • (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).2","axioms":["propext","Classical.choice","Quot.sound"]}
