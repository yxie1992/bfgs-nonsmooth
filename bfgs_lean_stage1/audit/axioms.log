BFGS_AUDIT {"theorem":"BfgsVerification.AffineProjection.objective_minimum_iff_fiber","signature":"∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ),\n  BfgsVerification.AffineProjection.FullRowRank A →\n    ∀ (F : BfgsVerification.Vec r → ℝ) (zstar : BfgsVerification.Vec r),\n      (∀ (z : BfgsVerification.Vec r), F zstar ≤ F z) →\n        (∀ (z : BfgsVerification.Vec r), F z = F zstar → z = zstar) →\n          ∀ (x : BfgsVerification.Vec n),\n            (∀ (y : BfgsVerification.Vec n), F (A.mulVec x) ≤ F (A.mulVec y)) ↔ A.mulVec x = zstar","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.eventually_planar_segment_transverse_length","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n  IsCompact R.initialSublevel →\n    Filter.Tendsto R.displacement Filter.atTop (nhds 0) →\n      ∀ (W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2),\n        (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x, ContinuousAt W p) →\n          (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n              ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p, 0 < BfgsVerification.dot g (W p)) →\n            (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                  ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                    BfgsVerification.dot g (W p) = BfgsVerification.dot h (W p)) →\n              ∃ κ,\n                0 < κ ∧\n                  ∃ J,\n                    ∀ (k : ℕ),\n                      J ≤ k →\n                        ∀ θ ∈ Set.Icc 0 1,\n                          κ * ‖BfgsVerification.euclideanVector (R.displacement k)‖ ≤\n                            |BfgsVerification.HomogeneousPlanar.pairDet (R.displacement k)\n                                (W (R.x k + θ • R.displacement k))|","axioms":["propext","Quot.sound","Classical.choice"]}
