BFGS_AUDIT {"theorem":"BfgsVerification.curvature_eq_alpha_beta_q","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  BfgsVerification.metricEnergy H g ≠ 0 →\n    BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) =\n      α * (-BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g) *\n        BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.update","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  self.H (k + 1) =\n    BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))\n      (self.g (k + 1) - self.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.mul_outer","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n),\n  A * BfgsVerification.outer a b = BfgsVerification.outer (Matrix.mulVec A a) b","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.sum_log_le_of_sum_le","signature":"∀ (x : ℕ → ℝ) (m : ℕ) (B : ℝ),\n  (∀ (i : ℕ), 0 < x i) →\n    0 < B → ∑ i ∈ Finset.range m, x i ≤ ↑m * B → ∑ i ∈ Finset.range m, Real.log (x i) ≤ ↑m * Real.log B","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_nonneg","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  0 ≤ r → (∀ (j : ℕ), 0 ≤ e j) → 0 ≤ BfgsVerification.ScalarHierarchy.weightedPotential n r e","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.gram_numerator_identity","signature":"∀ (Δ q u r z κ w : ℝ), q * (Δ * (r - z)) - Δ * ((q - u) * (r - z) - (κ - w) ^ 2) = Δ * ((κ - w) ^ 2 + u * (r - z))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.compressed_inverseBFGS_bound_generic","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (H : BfgsVerification.Mat n)\n  (Z : Matrix (Fin n) ι ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.PosDef H →\n    Function.Injective Z.mulVec →\n      0 < α →\n        0 < BfgsVerification.metricEnergy H g →\n          0 < -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g →\n            let q := BfgsVerification.metricEnergy H g;\n            let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n            (BfgsVerification.metricGram (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) Z).det ≤\n              (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det / (β ^ 2 * q) +\n                α / β * (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.outer.eq_1","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n) (i j : Fin n), BfgsVerification.outer x y i j = x i * y j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.outer_mul","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n),\n  BfgsVerification.outer a b * A = BfgsVerification.outer a ((Matrix.transpose A).mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
