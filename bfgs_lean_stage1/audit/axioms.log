BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.bounded_gradients_of_compact_set","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (K : Set (BfgsVerification.Vec n)),\n  IsCompact K → (∀ (k : ℕ), R.x k ∈ K) → ∃ G, 0 < G ∧ ∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.positive_sphere_lower_gap","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (xStar : E),\n      (∀ (x : E), F xStar ≤ F x) →\n        (∀ (x : E), F x = F xStar → x = xStar) →\n          ∀ {r : ℝ}, 0 < r → ∃ ω, 0 < ω ∧ ∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar","axioms":["propext","Quot.sound","Classical.choice"]}
