BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r : ℕ)\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r) (m K L C : ℝ)\n  (m_pos : 0 < m) (K_pos : 0 < K) (L_nonneg : 0 ≤ L) (invertible : ∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0)\n  (product : ∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k)\n  (transport :\n    ∀ (k : ℕ), J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k))\n  (visible : ∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k)))\n  (correction :\n    ∀ (k : ℕ), J ≤ k → BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C)\n  (product_bound :\n    ∀ (k : ℕ),\n      J ≤ k →\n        ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v)\n  (inverse_bound :\n    ∀ (k : ℕ),\n      J ≤ k → ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v),\n  sizeOf\n      { J := J, r := r, V := V, T := T, P := P, b := b, m := m, K := K, L := L, C := C, m_pos := m_pos, K_pos := K_pos,\n        L_nonneg := L_nonneg, invertible := invertible, product := product, transport := transport, visible := visible,\n        correction := correction, product_bound := product_bound, inverse_bound := inverse_bound } =\n    1 + sizeOf J + sizeOf r + sizeOf m + sizeOf K + sizeOf L + sizeOf C + sizeOf m_pos + sizeOf K_pos + sizeOf L_nonneg","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.projection_expansion","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (v y : BfgsVerification.Vec n) (κ : ℝ),\n  Matrix.IsSymm H →\n    (1 - κ⁻¹ • BfgsVerification.outer v y) * H * (1 - κ⁻¹ • BfgsVerification.outer v y).transpose =\n      H - κ⁻¹ • (BfgsVerification.outer v (Matrix.mulVec H y) + BfgsVerification.outer (Matrix.mulVec H y) v) +\n        (BfgsVerification.dot y (Matrix.mulVec H y) / κ ^ 2) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_boundedBelow_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F → ∀ {K : Set (BfgsVerification.Vec n)}, IsCompact K → ∃ b, ∀ x ∈ K, b ≤ F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.det_rank_two","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (t v : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a)) =\n        Matrix.det A *\n          ((1 + v * BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)) ^ 2 +\n            BfgsVerification.dot a (Matrix.mulVec A⁻¹ a) * (t - v ^ 2 * BfgsVerification.dot b (Matrix.mulVec A⁻¹ b)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.commonTilt_value_escape","signature":"∀ {n : ℕ} (B : Finset (BfgsVerification.Vec n)) (hB : B.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun (n + 1) (BfgsVerification.Homogeneous.commonTilt B hB)),\n  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.commonTilt B hB (R.x k)) Filter.atTop Filter.atBot","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.IncomingJump.metricEnergy_gram","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (v : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy (Matrix.transpose A * A) v = BfgsVerification.sqNorm (Matrix.mulVec A v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.common_component_incompatible._proof_2","signature":"∀ (J N : ℕ), J + 1 ≤ N → ¬1 ≤ N → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.energy_gap_tendsto_zero","signature":"∀ {E q a R gap : ℕ → ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ gap k) →\n        Antitone gap →\n          (∀ (k : ℕ), gap k ≤ a k) →\n            (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n              Filter.Tendsto (fun N => ∑ k ∈ Finset.range N, (q k)⁻¹) Filter.atTop Filter.atTop →\n                Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, R k) / ∑ k ∈ Finset.range N, (q k)⁻¹) Filter.atTop\n                    (nhds 0) →\n                  Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_fixed_tail_lower_eventually._proof_3","signature":"∀ (J M N : ℕ), N ≥ J + (max M 1 + 1) → 0 < N - (J + 1) → ¬M ≤ N - (J + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.sum_compressed_bounds","signature":"∀ {ι : Type u_1} [inst : Fintype ι] (Dplus Dy Δ : ι → ℝ) (α β q normY2 eNext eCurrent : ℝ),\n  0 < β →\n    0 < q →\n      (∀ (i : ι), Dplus i ≤ Dy i / (β ^ 2 * q) + α / β * Δ i) →\n        ∑ i, Dy i ≤ normY2 * eNext →\n          ∑ i, Δ i = eCurrent → ∑ i, Dplus i ≤ normY2 / (β ^ 2 * q) * eNext + α / β * eCurrent","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_le","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (J N : ℕ), ∑ i ∈ Finset.range N, d (J + i) ≤ (f J - f (J + N)) / c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} {J r p : ℕ}\n  {U : Matrix (Fin n) (Fin r) ℝ} {orthonormal : U.transpose * U = 1} {L m C₀ C_T C_R : ℝ} {m_pos : 0 < m}\n  {V Z : ℕ → Matrix (Fin n) (Fin p) ℝ} {T : ℕ → BfgsVerification.Mat p} {b : ℕ → BfgsVerification.Vec p}\n  {smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k}\n  {visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))}\n  {correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k}\n  {transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k}\n  {operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)}\n  {residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k}\n  {residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k} {J_1 r_1 p_1 : ℕ}\n  {U_1 : Matrix (Fin n) (Fin r_1) ℝ} {orthonormal_1 : U_1.transpose * U_1 = 1} {L_1 m_1 C₀_1 C_T_1 C_R_1 : ℝ}\n  {m_pos_1 : 0 < m_1} {V_1 Z_1 : ℕ → Matrix (Fin n) (Fin p_1) ℝ} {T_1 : ℕ → BfgsVerification.Mat p_1}\n  {b_1 : ℕ → BfgsVerification.Vec p_1}\n  {smooth_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U_1.transpose.mulVec ((R.shift J_1).gradientChange k)) ≤ L_1 * (R.shift J_1).curvature k}\n  {visible_1 : ∀ (k : ℕ), m_1 ≤ BfgsVerification.sqNorm ((V_1 k).transpose.mulVec ((R.shift J_1).g k))}\n  {correction_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V_1 (k + 1)).transpose.mulVec ((R.shift J_1).gradientChange k)) ≤\n        C₀_1 * (R.shift J_1).curvature k}\n  {transport_1 :\n    ∀ (k : ℕ),\n      V_1 (k + 1) =\n        V_1 k * T_1 k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J_1).displacement k) (b_1 k) + Z_1 k}\n  {operator_bound_1 : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T_1 k) (1 + C_T_1 * (R.shift J_1).d k)}\n  {residual_range_1 : ∀ (k : ℕ), U_1 * U_1.transpose * Z_1 k = Z_1 k}\n  {residual_size_1 : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z_1 k) ≤ C_R_1 * (R.shift J_1).d k},\n  { J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n      { J := J_1, r := r_1, p := p_1, U := U_1, orthonormal := orthonormal_1, L := L_1, m := m_1, C₀ := C₀_1,\n        C_T := C_T_1, C_R := C_R_1, m_pos := m_pos_1, V := V_1, Z := Z_1, T := T_1, b := b_1, smooth := smooth_1,\n        visible := visible_1, correction := correction_1, transport := transport_1, operator_bound := operator_bound_1,\n        residual_range := residual_range_1, residual_size := residual_size_1 } →\n    J = J_1 ∧\n      r = r_1 ∧\n        p = p_1 ∧\n          HEq U U_1 ∧\n            L = L_1 ∧ m = m_1 ∧ C₀ = C₀_1 ∧ C_T = C_T_1 ∧ C_R = C_R_1 ∧ HEq V V_1 ∧ HEq Z Z_1 ∧ HEq T T_1 ∧ HEq b b_1","axioms":["propext","Quot.sound","Classical.choice"]}
