BFGS_AUDIT {"theorem":"BfgsVerification.FrameBounds.gram_trace_transport_le","signature":"∀ {n r : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.PosSemidef M →\n    ∀ (V : Matrix (Fin n) (Fin r) ℝ) (T : BfgsVerification.Mat r) (a : ℝ),\n      BfgsVerification.FrameBounds.OperatorSqBound T a →\n        (BfgsVerification.metricGram M (V * T)).trace ≤ a * (BfgsVerification.metricGram M V).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.objectiveLowerBoundGrowth","signature":"BfgsVerification.ObjectiveLowerBoundGrowthTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frame_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (k : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (V W Z : Matrix (Fin n) (Fin p) ℝ) (T : BfgsVerification.Mat p) (b : BfgsVerification.Vec p)\n          (m C₀ C_T C_R : ℝ),\n          0 ≤ C_T →\n            m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)) →\n              BfgsVerification.sqNorm (W.transpose.mulVec (R.gradientChange k)) ≤ C₀ * R.curvature k →\n                W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b + Z →\n                  BfgsVerification.FrameBounds.OperatorSqBound T (1 + C_T * R.d k) →\n                    U * U.transpose * Z = Z →\n                      BfgsVerification.SmoothSubspace.frobSq Z ≤ C_R * R.d k →\n                        (BfgsVerification.metricGram (R.hessian (k + 1)) W).trace ≤\n                          (1 + R.d k) * (1 + C_T * R.d k) *\n                                ((BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k) +\n                              (1 + (R.d k)⁻¹) *\n                                (C_R * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)) +\n                            C₀","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.outer_mulVec","signature":"∀ {n : ℕ} (u v x : BfgsVerification.Vec n), Matrix.mulVec (BfgsVerification.outer u v) x = BfgsVerification.dot v x • u","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.hessianUpdate","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (y : BfgsVerification.Vec n) {α : ℝ},\n          0 < α →\n            0 < BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) →\n              (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y)⁻¹ =\n                H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g +\n                  (BfgsVerification.dot y (BfgsVerification.bfgsStep H g α))⁻¹ • BfgsVerification.outer y y","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.weak_wolfe","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  self.c₂ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k)) ≤\n    BfgsVerification.dot (self.g (k + 1)) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.sublevel_bounded","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (xStar : E),\n      (∀ (x : E), F xStar ≤ F x) → (∀ (x : E), F x = F xStar → x = xStar) → ∀ (a : ℝ), Bornology.IsBounded {x | F x ≤ a}","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.inverse_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ),\n  self.J ≤ k →\n    ∀ (v : Fin self.r → ℝ),\n      BfgsVerification.sqNorm ((self.P k)⁻¹.transpose.mulVec v) ≤ self.L * BfgsVerification.sqNorm v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift_displacement","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  (R.shift J).displacement k = R.displacement (J + k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameBounds.gram_trace_nonneg","signature":"∀ {n r : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B → ∀ (V : Matrix (Fin n) (Fin r) ℝ), 0 ≤ (BfgsVerification.metricGram B V).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.normalized_frame_trace_recurrence","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), P (k + 1) = P k * T k) →\n      (∀ (k : ℕ), V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (k : ℕ),\n          R.normalizedFrameEnergy V P (k + 1) =\n            R.normalizedFrameEnergy V P k -\n                BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec ((V k).transpose.mulVec (R.g k))) / R.q k +\n              BfgsVerification.sqNorm\n                  ((P (k + 1))⁻¹.transpose.mulVec ((V (k + 1)).transpose.mulVec (R.gradientChange k))) /\n                R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_8","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  R.c₂ * BfgsVerification.dot (R.g (J + k)) (BfgsVerification.bfgsStep (R.H (J + k)) (R.g (J + k)) (R.α (J + k))) ≤\n    BfgsVerification.dot (R.g (J + k + 1)) (BfgsVerification.bfgsStep (R.H (J + k)) (R.g (J + k)) (R.α (J + k)))","axioms":["propext","Quot.sound","Classical.choice"]}
