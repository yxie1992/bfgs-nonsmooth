BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.radial_gradient_difference","signature":"∀ {n : ℕ} (a x : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.dot\n      (BfgsVerification.NormalSpike.positiveGradient a x -\n        BfgsVerification.NormalSpike.positiveGradient a ((1 - t) • x))\n      x =\n    t * BfgsVerification.sqNorm x +\n      (BfgsVerification.NormalSpike.seriesMass (BfgsVerification.dot a x) -\n          BfgsVerification.NormalSpike.seriesMass ((1 - t) * BfgsVerification.dot a x)) *\n        BfgsVerification.dot a x","axioms":["propext","Quot.sound","Classical.choice"]}
