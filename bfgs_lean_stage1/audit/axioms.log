BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.printed_radial_hessian_peak","signature":"∀ (n : ℕ) (u : ℝ) (N : ℕ),\n  BfgsVerification.dot (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N))\n      (Matrix.mulVec\n        (BfgsVerification.RadialHessian.matrix\n          (BfgsVerification.NormalSpike.objective (BfgsVerification.NormalSpike.normal n))\n          (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N)))\n        (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N))) =\n    u ^ 2 + BfgsVerification.NormalSpike.scale N ^ 2 + (BfgsVerification.NormalSpike.scale N)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
