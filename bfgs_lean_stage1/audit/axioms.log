def BfgsVerification.SpatialQuadraticRadialTarget : Prop :=
(∀ (x : BfgsVerification.Vec 3),
    BfgsVerification.dot (BfgsVerification.SpatialQuadraticWarning.gradient x) x =
      2 * BfgsVerification.SpatialQuadraticWarning.objective x) ∧
  (∀ (ε : ℝ),
      BfgsVerification.SpatialQuadraticWarning.next ε =
        BfgsVerification.SpatialQuadraticWarning.base + BfgsVerification.SpatialQuadraticWarning.step ε) ∧
    (∀ (b : ℝ),
        BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.SpatialQuadraticWarning.objective
          {x | BfgsVerification.SpatialQuadraticWarning.objective x ≤ b} 0) ∧
      ∀ (R : BfgsVerification.AdmissibleBFGSRun 3 BfgsVerification.SpatialQuadraticWarning.objective),
        Filter.Tendsto (fun k => BfgsVerification.SpatialQuadraticWarning.objective (R.x k)) Filter.atTop (nhds 0) ∧
          Filter.Tendsto R.x Filter.atTop (nhds 0)
