BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.exists_uniform_supports_visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {W : BfgsVerification.Vec n → BfgsVerification.Vec n} {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        (∀ x ∈ K,\n            (∃ L, ∃ U ∈ nhds x, LipschitzOnWith L W U) ∧\n              ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x, 0 < BfgsVerification.dot g (W x)) →\n          ∃ η,\n            0 < η ∧\n              ∃ N,\n                IsOpen N ∧\n                  K ⊆ N ∧\n                    ∀ x ∈ N,\n                      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x, η ≤ BfgsVerification.dot g (W x)","axioms":["propext","Classical.choice","Quot.sound"]}
