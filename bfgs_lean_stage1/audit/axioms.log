 - c)) * (1 - r)⁻¹ - 1 + 1 / 4 * (127 / 256)) +\n                            d * ((r * d - 1 / 64) * (1 - r)⁻¹ + 1 / 4 * (1 / 16)) +\n                          3 ∧\n                      0 <\n                          3 -\n                            (c * ((897 / 1024 - r * (1 - c)) * (1 - r)⁻¹ - 1 + 1 / 4 * (127 / 256)) +\n                              d * ((r * d - 1 / 64) * (1 - r)⁻¹ + 1 / 4 * (1 / 16))) ∧\n                        0 < 2 - ((r * d - 1 / 64) * (1 - r)⁻¹ + 1 / 4 * (1 / 16)) ∧\n                          0 <\n                              c * ((897 / 1024 - r * (1 - c)) * (1 - r)⁻¹ - 1 + 1 / 4 * (127 / 256)) +\n                                d * ((r * d - 1 / 64) * (1 - r)⁻¹ + 1 / 4 * (1 / 16)) ∧\n                            0 <\n                                -1 * ((897 / 1024 - r * (1 - c)) * (1 - r)⁻¹ - 1) +\n                                      -1 / 8 * ((r * d - 1 / 64) * (1 - r)⁻¹) +\n                                    1 / 3 * (1 / 4 * (-1 * (127 / 256) + -1 / 8 * (1 / 16))) -\n                                  (c * ((897 / 1024 - r * (1 - c)) * (1 - r)⁻¹ - 1 + 1 / 4 * (127 / 256)) +\n                                    d * ((r * d - 1 / 64) * (1 - r)⁻¹ + 1 / 4 * (1 / 16))) ∧\n                              0 < -(1 / 4 * (-1 * (127 / 256) + -1 / 8 * (1 / 16))) ∧\n                                0 < 1 / 4 * (c * (127 / 256) + d * (1 / 16))","axioms":["propext","Quot.sound","Classical.choice"]}
