BFGS_AUDIT {"theorem":"BfgsVerification.PlanarConvergence.local_convergence_basin","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 2),\n      (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →\n        (∀ (z : BfgsVerification.Vec 2), F z = F star → z = star) →\n          ∀ {Ω : Set (BfgsVerification.Vec 2)},\n            IsOpen Ω →\n              star ∈ Ω →\n                (∀ p ∈ Ω,\n                    ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →\n                      ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p) →\n                  (∀ p ∈ Ω, BfgsVerification.AffineCriticalObjective.AffineCorrectAt F p) →\n                    ∀ {b : ℝ},\n                      F star < b →\n                        (∀ (ℓ : ℝ),\n                            F star < ℓ →\n                              ℓ ≤ b →\n                                ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n                          ∃ ε,\n                            0 < ε ∧\n                              ∀ (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n                                F (R.x 0) < F star + ε →\n                                  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                    Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.exists_smooth_root_box","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n × ℝ → ℝ} {a : BfgsVerification.Vec n} {b : ℝ},\n  ContDiffAt ℝ ⊤ F (a, b) →\n    F (a, b) = 0 →\n      (fderiv ℝ F (a, b)) (0, 1) ≠ 0 →\n        ∃ g r δ,\n          0 < r ∧\n            0 < δ ∧\n              g a = b ∧\n                ContDiffOn ℝ (↑⊤) g (Metric.ball a r) ∧\n                  ∀ x ∈ Metric.ball a r, dist (g x) b < δ ∧ ∀ (t : ℝ), dist t b < δ → (F (x, t) = 0 ↔ t = g x)","axioms":["propext","Classical.choice","Quot.sound"]}
