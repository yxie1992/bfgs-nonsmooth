BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_old_pairing_nonpos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F → ∀ (k : ℕ), BfgsVerification.dot (R.gradientChange k) (R.x k) ≤ 0","axioms":["propext","Quot.sound","Classical.choice"]}
