BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.FiniteRatePatch.mk.inj","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ} {f : Fin m → BfgsVerification.Vec n → ℝ} {Q : Set (BfgsVerification.Vec n)}\n  {size : ℕ} {center : Fin size → BfgsVerification.Vec n}\n  {chart : (i : Fin size) → BfgsVerification.ConstantRankFields.RateChart F f (center i)}\n  {cutoff :\n    SmoothPartitionOfUnity (Fin size) (modelWithCornersSelf ℝ (BfgsVerification.Vec n)) (BfgsVerification.Vec n) Q}\n  {subordinate : cutoff.IsSubordinate fun i => Metric.ball (center i) ((chart i).radius / 4)} {size_1 : ℕ}\n  {center_1 : Fin size_1 → BfgsVerification.Vec n}\n  {chart_1 : (i : Fin size_1) → BfgsVerification.ConstantRankFields.RateChart F f (center_1 i)}\n  {cutoff_1 :\n    SmoothPartitionOfUnity (Fin size_1) (modelWithCornersSelf ℝ (BfgsVerification.Vec n)) (BfgsVerification.Vec n) Q}\n  {subordinate_1 : cutoff_1.IsSubordinate fun i => Metric.ball (center_1 i) ((chart_1 i).radius / 4)},\n  { size := size, center := center, chart := chart, cutoff := cutoff, subordinate := subordinate } =\n      { size := size_1, center := center_1, chart := chart_1, cutoff := cutoff_1, subordinate := subordinate_1 } →\n    size = size_1 ∧ HEq center center_1 ∧ HEq chart chart_1 ∧ HEq cutoff cutoff_1","axioms":["propext","Classical.choice","Quot.sound"]}
