BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.absolute_fullBFGS_step_exists","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ},\n  Differentiable ℝ ψ →\n    ∀ (a : ι → BfgsVerification.Vec n) (b : ι → ℝ),\n      (∀ (z : BfgsVerification.Vec n), F z = ψ z + ∑ i, |BfgsVerification.dot (a i) z - b i|) →\n        ConvexOn ℝ Set.univ F →\n          ∀ (x g : BfgsVerification.Vec n) (H : BfgsVerification.Mat n),\n            Matrix.PosDef H →\n              g ≠ 0 →\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                  ∀ {c₁ c₂ : ℝ},\n                    0 < c₁ →\n                      c₁ < c₂ →\n                        c₂ < 1 →\n                          ∀ (L : ℝ),\n                            (∀ (t : ℝ), 0 ≤ t → L ≤ F (x + BfgsVerification.bfgsStep H g t)) →\n                              ∃ α h,\n                                0 < α ∧\n                                  HasFDerivAt F (BfgsVerification.gradientFunctional h)\n                                      (x + BfgsVerification.bfgsStep H g α) ∧\n                                    F (x + BfgsVerification.bfgsStep H g α) <\n                                        F x + c₁ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ∧\n                                      c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) <\n                                        BfgsVerification.dot h (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
