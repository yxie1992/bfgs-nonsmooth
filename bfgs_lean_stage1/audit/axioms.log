BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.incoming_jump_no_band_certificate","signature":"∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {n r : ℕ} {F : BfgsVerification.Vec n → ℝ}\n  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin r → BfgsVerification.Vec n) (coeff : ι → Fin r → ℝ),\n      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n        (∀ (a : ι) (j : Fin r), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →\n            (∀ (a : ι) (j : Fin r),\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →\n              (∀ (j : Fin r),\n                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l\n                    (nhds 0)) →\n                (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • (h a - g a j)) →\n                  Filter.Tendsto\n                      (fun a =>\n                        ∑ j,\n                          |coeff a j| *\n                            √(BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)))\n                      l (nhds 0) →\n                    ¬Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η)","axioms":["Quot.sound","propext","Classical.choice"]}
