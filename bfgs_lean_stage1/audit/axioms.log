theorem BfgsVerification.LNormalizedOracle.actual_implementation_neighborhood : ∀ (μ c₁ c₂ : ℝ),
  0 < c₁ →
    c₁ ≤ 1 / 3 →
      0 < c₂ →
        ∃ U,
          IsOpen U ∧
            BfgsVerification.LNormalizedReturn.seed ∈ U ∧
              AnalyticOnNhd ℝ (BfgsVerification.LNormalizedReturn.returnMap μ) U ∧
                ∀ w ∈ U,
