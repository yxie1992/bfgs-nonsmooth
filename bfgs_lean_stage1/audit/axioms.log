BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_positive_band_margin","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star x g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n        ∀ (G R η : ℝ),\n          0 < G →\n            0 < R →\n              BfgsVerification.sqNorm g ≤ G ^ 2 →\n                BfgsVerification.sqNorm (x - star) ≤ R ^ 2 →\n                  F star + η ≤ F x →\n                    ∀ {t : ℝ},\n                      0 ≤ t →\n                        t ≤ η / (4 * G * R) →\n                          F star + 3 * η / 4 ≤ F (BfgsVerification.RadialCertificate.inwardPoint star x t)","axioms":["propext","Classical.choice","Quot.sound"]}
