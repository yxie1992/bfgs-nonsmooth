BFGS_AUDIT {"theorem":"BfgsVerification.PlanarScalarTransport.convex_log_determinant_budget","signature":"∀ {φ D D' : ℝ → ℝ} {C d : ℝ},\n  0 ≤ C →\n    0 ≤ d →\n      ConvexOn ℝ Set.univ φ →\n        HasDerivAt φ (-d) 0 →\n          ContinuousOn D (Set.Icc 0 1) →\n            (∀ t ∈ Set.Icc 0 1, D t ≠ 0) →\n              (∀ t ∈ Set.Ico 0 1, HasDerivWithinAt D (D' t) (Set.Ici t) t) →\n                (∀ t ∈ Set.Ico 0 1, |D' t / D t| ≤ C * |derivWithin φ (Set.Ioi t) t|) →\n                  φ 1 ≤ φ 0 → 0 < D 1 / D 0 ∧ |Real.log (D 1 / D 0)| ≤ 2 * C * d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.coerciveSecantFactor.eq_1","signature":"∀ (j : Fin 3),\n  BfgsVerification.SeedOrbit.coerciveSecantFactor j =\n    BfgsVerification.dot\n      (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n          (BfgsVerification.SeedOrbit.nextPhase j) -\n        BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD j)\n      (BfgsVerification.SeedOrbit.length j •\n        BfgsVerification.SeedOrbit.direction BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n          BfgsVerification.SeedOrbit.seedRatio j)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.UnexcitedMetric.run._proof_10","signature":"∀ (A v₀ ρ c₁ c₂ : ℝ),\n  0 < v₀ →\n    0 < ρ →\n      0 < c₁ →\n        c₁ < c₂ →\n          c₂ < 1 →\n            ∀ (k : ℕ),\n              c₂ *\n                  BfgsVerification.dot\n                    (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign k))\n                    (BfgsVerification.bfgsStep\n                      (BfgsVerification.UnexcitedMetric.diagonal A\n                        ((1 + ρ) / (2 * ρ) * BfgsVerification.UnexcitedMetric.radius ρ v₀ k))\n                      (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign k)) (2 * ρ)) ≤\n                BfgsVerification.dot\n                  (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign (k + 1)))\n                  (BfgsVerification.bfgsStep\n                    (BfgsVerification.UnexcitedMetric.diagonal A\n                      ((1 + ρ) / (2 * ρ) * BfgsVerification.UnexcitedMetric.radius ρ v₀ k))\n                    (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign k)) (2 * ρ))","axioms":["propext","Quot.sound","Classical.choice"]}
