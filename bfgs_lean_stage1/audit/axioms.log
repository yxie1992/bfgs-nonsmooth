BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.scalar_log_transport_tail_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  IsCompact R.initialSublevel →\n    ∀ (J : ℕ) (w : ℕ → BfgsVerification.Vec n) (a b : ℕ → ℝ),\n      (∀ (k : ℕ), J ≤ k → w (k + 1) = a k • w k + b k • R.displacement k) →\n        ∀ (η C C0 : ℝ),\n          0 < η →\n            0 ≤ C →\n              0 ≤ C0 →\n                (∀ (k : ℕ), J ≤ k → η ≤ BfgsVerification.dot (R.g k) (w k)) →\n                  (∀ (k : ℕ), J ≤ k → 0 < a k) →\n                    (∀ (k : ℕ), J ≤ k → |Real.log (a k)| ≤ C * R.d k) →\n                      (∀ (k : ℕ),\n                          J ≤ k → BfgsVerification.dot (R.gradientChange k) (w (k + 1)) ^ 2 / R.curvature k ≤ C0) →\n                        False","axioms":["propext","Classical.choice","Quot.sound"]}
