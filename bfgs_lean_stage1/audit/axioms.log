BFGS_AUDIT {"theorem":"BfgsVerification.RadialSingularCurvature.crossing_radial_numerator","signature":"∀ (ε : ℝ),\n  BfgsVerification.RadialCertificate.radialNumerator (BfgsVerification.OneDimensional.embed (-1))\n      (BfgsVerification.ScalarCounterexamples.crossingZ ε) (BfgsVerification.ScalarCounterexamples.crossingG ε)\n      (BfgsVerification.ScalarCounterexamples.crossingH ε) =\n    (1 - ε / 2 - (3 + ε)) * (1 - ε / 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.HomogeneousBlock.positive_parallel_supports_eq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (x z g h : BfgsVerification.Vec n),\n      BfgsVerification.Homogeneous.Supports F x g →\n        BfgsVerification.Homogeneous.Supports F z h → 0 < F x → 0 < F z → ∀ (c : ℝ), 0 < c → h = c • g → h = g","axioms":["propext","Quot.sound","Classical.choice"]}
