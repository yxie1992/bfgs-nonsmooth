BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.polynomial_simple_root_chart","signature":"∀ {n : ℕ} (p : MvPolynomial (Option (Fin n)) ℝ) (a : BfgsVerification.Vec n) (b : ℝ),\n  Polynomial.eval b (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p a) = 0 →\n    Polynomial.eval b (Polynomial.derivative (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p a)) ≠ 0 →\n      ∃ g r δ,\n        0 < r ∧\n          0 < δ ∧\n            g a = b ∧\n              ContDiffOn ℝ (↑⊤) g (Metric.ball a r) ∧\n                (∀ x ∈ Metric.ball a r,\n                    dist (g x) b < δ ∧\n                      ∀ (t : ℝ),\n                        dist t b < δ → (BfgsVerification.RealAlgebraicGeometry.parameterEval p (x, t) = 0 ↔ t = g x)) ∧\n                  BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n                    {v | (fun i => v (some i)) ∈ Metric.ball a r ∧ v none = g fun i => v (some i)}","axioms":["propext","Classical.choice","Quot.sound"]}
