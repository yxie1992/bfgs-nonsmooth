BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.sum_compressed_bounds._proof_1","signature":"∀ {ι : Type u_1} {α : Type u_3} [inst : NonUnitalNonAssocSemiring α] (s : Finset ι) (f : ι → α) (a : α),\n  ∑ i ∈ s, a * f i = a * ∑ i ∈ s, f i","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.mapped_distance_to_argmin_of_values","signature":"∀ {E : Type u_1} {Y : Type u_2} [inst : MetricSpace E] [inst_1 : MetricSpace Y] {F : E → ℝ},\n  Continuous F →\n    ∀ (ψ : E → Y),\n      Continuous ψ →\n        ∀ (xStar : E),\n          (∀ (y : E), F xStar ≤ F y) →\n            ∀ {K : Set E},\n              IsCompact K →\n                ∀ {x : ℕ → E},\n                  (∀ (k : ℕ), x k ∈ K) →\n                    Filter.Tendsto (fun k => F (x k)) Filter.atTop (nhds (F xStar)) →\n                      Filter.Tendsto (fun k => Metric.infDist (ψ (x k)) (ψ '' BfgsVerification.argmin F)) Filter.atTop\n                        (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
