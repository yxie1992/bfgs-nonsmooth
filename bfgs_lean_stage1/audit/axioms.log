BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_two","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        let a := Z.transpose.mulVec (Matrix.mulVec H g);\n        let b := Z.transpose.mulVec (Matrix.mulVec H y);\n        let A := BfgsVerification.metricGram H Z;\n        (BfgsVerification.metricGram H (Matrix.fromCols (fun i k => ![g i, y i] k) Z)).det =\n          A.det *\n            ((BfgsVerification.metricEnergy H g - BfgsVerification.dot a (A⁻¹.mulVec a)) *\n                (BfgsVerification.metricEnergy H y - BfgsVerification.dot b (A⁻¹.mulVec b)) -\n              (BfgsVerification.dot g (Matrix.mulVec H y) - BfgsVerification.dot a (A⁻¹.mulVec b)) ^ 2)","axioms":["propext","Classical.choice","Quot.sound"]}
