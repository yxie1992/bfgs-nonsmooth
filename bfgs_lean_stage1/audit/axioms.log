BFGS_AUDIT {"theorem":"BfgsVerification.SeedEmbedding.NonStrict.search_two","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {p : BfgsVerification.Vec 2} {t A c₁ c₂ : ℝ},\n  BfgsVerification.SeedEmbedding.OracleData F p t A →\n    0 < t →\n      0 < c₁ →\n        c₁ ≤ 1 / 3 →\n          0 < c₂ →\n            ∀ (k : ℕ),\n              BfgsVerification.SeedOrbit.phase k = 2 →\n                BfgsVerification.NonStrictLineSearch.search F (BfgsVerification.SeedEmbedding.point p t k)\n                    (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                      (BfgsVerification.SeedEmbedding.gradient t k) 1)\n                    (BfgsVerification.SeedEmbedding.gradient t k) c₁ c₂ 5 0 none 1 =\n                  (some (1 / 16), [1, 1 / 2, 1 / 4, 1 / 8, 1 / 16])","axioms":["propext","Classical.choice","Quot.sound"]}
