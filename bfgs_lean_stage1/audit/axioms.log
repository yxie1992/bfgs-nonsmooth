BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic._proof_1","signature":"∀ {m : Type u_2} {n : Type u_3} {α : Type v} {ι : Type u_6} [inst : Fintype n] [inst_1 : NonUnitalNonAssocSemiring α]\n  (M : Matrix m n α) (v : n → α), M * Matrix.replicateCol ι v = Matrix.replicateCol ι (M.mulVec v)","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.d_eq_neg_dot_step","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  R.d k = -BfgsVerification.dot (R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.transport_cancel","signature":"∀ {r : ℕ} (P Q T : BfgsVerification.Mat r), Matrix.det P ≠ 0 → Matrix.det Q ≠ 0 → Q = P * T → T * Q⁻¹ = P⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.armijo_decrease","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  R.c₁ * R.d k ≤ F (R.x k) - F (R.x (k + 1))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_trace_update","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ) (k : ℕ),\n  (BfgsVerification.metricGram (R.hessian (k + 1)) U).trace =\n    (BfgsVerification.metricGram (R.hessian k) U).trace - BfgsVerification.sqNorm (U.transpose.mulVec (R.g k)) / R.q k +\n      BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) / R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_nonneg","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n), 0 ≤ BfgsVerification.sqNorm g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.frobSq_nonneg","signature":"∀ {n r : ℕ} (W : Matrix (Fin n) (Fin r) ℝ), 0 ≤ BfgsVerification.SmoothSubspace.frobSq W","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_le_initial","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ}, 0 < c₁ → (∀ (k : ℕ), 0 ≤ d k) → (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (k : ℕ), f k ≤ f 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.iterates_tendsto_unique_min_of_values","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xStar : BfgsVerification.Vec n),\n  (∀ (x : BfgsVerification.Vec n), F xStar ≤ F x) →\n    (∀ (x : BfgsVerification.Vec n), F x = F xStar → x = xStar) →\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xStar)) → Filter.Tendsto R.x Filter.atTop (nhds xStar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_2","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ), 0 < R.α (J + k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix.eq_1","signature":"∀ {n : ℕ} (I : Finset (Fin n)), BfgsVerification.coordinateMatrix I = Matrix.submatrix 1 id Subtype.val","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.objective_antitone","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F), Antitone fun k => F (R.x k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_step_det_beta","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (y : BfgsVerification.Vec n) {α : ℝ},\n          0 < α →\n            0 < BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) →\n              Matrix.det (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) =\n                α / (-BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g) * Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_entry","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (V : Matrix (Fin n) (Fin r) ℝ) (i j : Fin r),\n  BfgsVerification.metricGram B V i j = BfgsVerification.dot (fun k => V k i) (Matrix.mulVec B fun k => V k j)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ObjectiveFiniteHorizonBound._proof_1","signature":"(2 + 2).AtLeastTwo","axioms":[]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_det","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (s y : BfgsVerification.Vec n),\n      BfgsVerification.dot y s ≠ 0 →\n        Matrix.det (BfgsVerification.inverseBFGS H s y) =\n          BfgsVerification.dot s (Matrix.mulVec H⁻¹ s) / BfgsVerification.dot y s * Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.tail_budget_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → ∀ (J : ℕ), ∑' (i : ℕ), R.d (J + i) ≤ (F (R.x J) - L) / R.c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_bfgsStep","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n) (α : ℝ),\n  BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) = -(α * BfgsVerification.metricEnergy H g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_mul_le","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ},\n  (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (J N : ℕ), c₁ * ∑ i ∈ Finset.range N, d (J + i) ≤ f J - f (J + N)","axioms":["propext","Quot.sound","Classical.choice"]}
