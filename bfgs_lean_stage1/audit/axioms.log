BFGS_AUDIT {"theorem":"BfgsVerification.RadialPower.inward_error_decomposition","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ} {Γ : ι → BfgsVerification.Vec n → ℝ},\n  (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (Γ j)) →\n    (∀ (j : ι) (x : BfgsVerification.Vec n), 0 ≤ Γ j x) →\n      ∀ (p : ι → ℝ) (star : BfgsVerification.Vec n) {U : Set (BfgsVerification.Vec n)},\n        IsOpen U →\n          (∀ x ∈ U, F x = ψ x + BfgsVerification.RadialPower.sumObjective Γ p star x) →\n            ∀ {x g : BfgsVerification.Vec n},\n              x ∈ U →\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                  DifferentiableAt ℝ ψ x →\n                    ∀ {t : ℝ},\n                      t ≤ 1 →\n                        BfgsVerification.RadialCertificate.inwardPoint star x t ∈ U →\n                          BfgsVerification.RadialCertificate.supportingError F x g\n                              (BfgsVerification.RadialCertificate.inwardPoint star x t) =\n                            ψ (BfgsVerification.RadialCertificate.inwardPoint star x t) - ψ x +\n                                t * (fderiv ℝ ψ x) (x - star) +\n                              ∑ j,\n                                ((1 - t) ^ p j - 1 + p j * t) *\n                                  BfgsVerification.RadialPower.powered (Γ j) (p j) (x - star)","axioms":["propext","Classical.choice","Quot.sound"]}
