BFGS_AUDIT {"theorem":"BfgsVerification.PlanarNormalGeometry.normalSector_uniform_pairing","signature":"∀ (a b v : BfgsVerification.Vec 2),\n  BfgsVerification.dot a v = 1 →\n    BfgsVerification.dot b v = 1 →\n      ∃ η, 0 < η ∧ ∀ w ∈ BfgsVerification.PlanarNormalGeometry.normalSector a b, η ≤ BfgsVerification.dot w v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarRamp.rampDerivative_inside_bound","signature":"∀ {b x : ℝ},\n  BfgsVerification.DScalarRamp.center b - BfgsVerification.DScalarRamp.epsilon < x →\n    x < BfgsVerification.DScalarRamp.center b + BfgsVerification.DScalarRamp.epsilon →\n      |4096 * (6 - 12 * BfgsVerification.DScalarRamp.rampCoordinate b x)| ≤ 24576","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.TrialCertificate.actual_reject","signature":"∀ {c d r : ℝ} {j i : Fin 3} {a c₁ : ℝ},\n  BfgsVerification.SeedOrbit.StrictActive c d (BfgsVerification.SeedOrbit.point c d r j) j →\n    BfgsVerification.SeedOrbit.TrialCertificate c d r j a i false →\n      0 < c₁ →\n        BfgsVerification.SeedOrbit.objective c d (BfgsVerification.SeedOrbit.point c d r j) +\n            c₁ *\n              BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j)\n                (a • BfgsVerification.SeedOrbit.direction c d r j) <\n          BfgsVerification.SeedOrbit.objective c d (BfgsVerification.SeedOrbit.trial c d r j a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarCounterexamples.crossing_band","signature":"∀ {ε : ℝ},\n  0 < ε →\n    ε ≤ 1 / 8 →\n      BfgsVerification.ScalarCounterexamples.crossingX ε ∈\n          BfgsVerification.TransportedCertificate.positiveBand BfgsVerification.ScalarCounterexamples.shiftedObjective\n            {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3}\n            (BfgsVerification.ScalarCounterexamples.shiftedObjective (BfgsVerification.OneDimensional.embed (-1)))\n            (1 / 4) ∧\n        BfgsVerification.ScalarCounterexamples.crossingZ ε ∈\n          BfgsVerification.TransportedCertificate.positiveBand BfgsVerification.ScalarCounterexamples.shiftedObjective\n            {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3}\n            (BfgsVerification.ScalarCounterexamples.shiftedObjective (BfgsVerification.OneDimensional.embed (-1)))\n            (1 / 4)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialHessian.ray_second_derivative_matrix","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {x : BfgsVerification.Vec n},\n  ContDiffAt ℝ 2 F x →\n    ∀ (v : BfgsVerification.Vec n),\n      deriv (deriv fun t => F (BfgsVerification.RadialHessian.ray x v t)) 0 =\n        BfgsVerification.dot v (Matrix.mulVec (BfgsVerification.RadialHessian.matrix F x) v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.source_accepted_inequalities","signature":"∀ {c₁ c₂ : ℝ},\n  0 < c₁ →\n    c₁ ≤ 1 / 3 →\n      0 < c₂ →\n        ∀ (j : Fin 3),\n          BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                (BfgsVerification.SeedOrbit.trial BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  BfgsVerification.SeedOrbit.seedRatio j (BfgsVerification.SeedOrbit.length j)) <\n              BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (BfgsVerification.SeedOrbit.point BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    BfgsVerification.SeedOrbit.seedRatio j) +\n                c₁ *\n                  BfgsVerification.dot\n                    (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC\n                      BfgsVerification.SeedOrbit.seedD j)\n                    (BfgsVerification.bfgsStep\n                      (BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC\n                        BfgsVerification.SeedOrbit.seedD j)\n                      (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC\n                        BfgsVerification.SeedOrbit.seedD j)\n                      (BfgsVerification.SeedOrbit.length j)) ∧\n            c₂ *\n                BfgsVerification.dot\n                  (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    j)\n                  (BfgsVerification.bfgsStep\n                    (BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                      j)\n                    (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC\n                      BfgsVerification.SeedOrbit.seedD j)\n                    (BfgsVerification.SeedOrbit.length j)) <\n              BfgsVerification.dot\n                (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (BfgsVerification.SeedOrbit.nextPhase j))\n                (BfgsVerification.bfgsStep\n                  (BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    j)\n                  (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    j)\n                  (BfgsVerification.SeedOrbit.length j))","axioms":["propext","Quot.sound","Classical.choice"]}
