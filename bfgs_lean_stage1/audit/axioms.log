BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.maximum_deriv_lipschitzOn","signature":"∀ {ι : Type u_1} {s : Finset ι} (hne : s.Nonempty) {f d : ι → ℝ → ℝ} {U : Set ℝ},\n  IsOpen U →\n    Convex ℝ U →\n      ∀ {L : NNReal},\n        (∀ i ∈ s, ∀ x ∈ U, HasDerivAt (f i) (d i x) x) →\n          (∀ x ∈ U,\n              ∀ i ∈ s,\n                ∀ j ∈ s,\n                  f i x = BfgsVerification.FiniteMaxRadial.maximum s hne f x →\n                    f j x = BfgsVerification.FiniteMaxRadial.maximum s hne f x → d i x = d j x) →\n            (∀ i ∈ s, LipschitzOnWith L (d i) U) →\n              LipschitzOnWith L (deriv (BfgsVerification.FiniteMaxRadial.maximum s hne f)) U","axioms":["propext","Quot.sound","Classical.choice"]}
