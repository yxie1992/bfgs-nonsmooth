BFGS_AUDIT {"theorem":"BfgsVerification.CenteredSmoothSublinear.local_centered_basin","signature":"∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n          ∀ {U : Set (BfgsVerification.Vec n)},\n            IsOpen U →\n              star ∈ U →\n                ConvexOn ℝ U ψ →\n                  BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n                    ConvexOn ℝ Set.univ γ →\n                      BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n                        (∀ x ∈ U, F x = ψ x + γ (x - star)) →\n                          ∃ δ,\n                            0 < δ ∧\n                              ∀ (A : BfgsVerification.AdmissibleBFGSRun n F),\n                                F (A.x 0) ≤ F star + δ →\n                                  (∀ (k : ℕ), A.x k ∈ U) ∧\n                                    Filter.Tendsto (fun k => F (A.x k)) Filter.atTop (nhds (F star)) ∧\n                                      Filter.Tendsto A.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
