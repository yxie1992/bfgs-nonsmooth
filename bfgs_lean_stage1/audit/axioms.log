BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.operator_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ResidualFrameCertificate R) (k : ℕ),\n  BfgsVerification.FrameBounds.OperatorSqBound (self.T k) (1 + self.C_T * (R.shift self.J).d k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_tsum_le","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), 0 ≤ d k) →\n      (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → (∀ (k : ℕ), L ≤ f k) → ∑' (k : ℕ), d k ≤ (f 0 - L) / c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.beta_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), 1 - R.c₂ ≤ R.beta k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_tail_tsum_le","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), 0 ≤ d k) →\n      (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → (∀ (k : ℕ), L ≤ f k) → ∀ (J : ℕ), ∑' (i : ℕ), d (J + i) ≤ (f J - L) / c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.hessian_update","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  R.hessian (k + 1) =\n    R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k) +\n      (R.curvature k)⁻¹ • BfgsVerification.outer (R.gradientChange k) (R.gradientChange k)","axioms":["propext","Quot.sound","Classical.choice"]}
