BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.predicted_decreases_tendsto_zero_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → Filter.Tendsto R.d Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
