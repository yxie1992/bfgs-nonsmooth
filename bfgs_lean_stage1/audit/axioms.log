BFGS_AUDIT {"theorem":"BfgsVerification.PlanarAllPairs.compact_pair_transversality_length","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {c₁ c₂ : ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {Q : Set (BfgsVerification.Vec 2)},\n      IsCompact Q →\n        c₂ < 1 →\n          ∀ (W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2),\n            (∀ p ∈ Q, ContinuousAt W p) →\n              (∀ p ∈ Q,\n                  ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p, 0 < BfgsVerification.dot a (W p)) →\n                (∀ p ∈ Q,\n                    ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                      ∀ b ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                        BfgsVerification.dot a (W p) = BfgsVerification.dot b (W p)) →\n                  ∃ κ,\n                    0 < κ ∧\n                      ∃ δ,\n                        0 < δ ∧\n                          ∀ x ∈ Q,\n                            ∀ z ∈ Q,\n                              ∀ (g h : BfgsVerification.Vec 2),\n                                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                                  ‖z - x‖ < δ →\n                                    ∀ θ ∈ Set.Icc 0 1,\n                                      κ * ‖BfgsVerification.euclideanVector (z - x)‖ ≤\n                                        |BfgsVerification.HomogeneousPlanar.pairDet (z - x) (W (x + θ • (z - x)))|","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.quadraticGauge_finite_sqrt_bound","signature":"∀ {m p : ℕ} (Q : BfgsVerification.Mat m),\n  Matrix.PosSemidef Q →\n    ∀ (γ : BfgsVerification.Vec p → ℝ),\n      BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n        ∀ (μ Λ : ℝ),\n          0 < μ →\n            (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →\n              (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →\n                ∀ (R : BfgsVerification.AdmissibleBFGSRun (m + p) (BfgsVerification.QuadraticGauge.objective Q γ))\n                  {N : ℕ},\n                  0 < N →\n                    BfgsVerification.QuadraticGauge.objective Q γ (R.x N) ≤\n                      √((R.referenceEnergy 0 0 +\n                            BfgsVerification.QuadraticGauge.correctionConstant μ Λ *\n                              ∑ k ∈ Finset.range N, BfgsVerification.QuadraticGauge.objective Q γ (R.x (k + 1))) /\n                          ∑ k ∈ Finset.range N, (R.q k)⁻¹)","axioms":["propext","Classical.choice","Quot.sound"]}
