:= region_open, point_mem := point_mem,\n        branch_convex := branch_convex, branch_C2 := branch_C2, representation := representation,\n        independent := independent, inverse := inverse } =\n      { toCornerChart := toCornerChart_1, region := region_1, region_open := region_open_1, point_mem := point_mem_1,\n        branch_convex := branch_convex_1, branch_C2 := branch_C2_1, representation := representation_1,\n        independent := independent_1, inverse := inverse_1 } →\n    toCornerChart = toCornerChart_1 ∧ region = region_1","axioms":["propext","Classical.choice","Quot.sound"]}
