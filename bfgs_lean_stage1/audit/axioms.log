BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.toScalarMetricRun.eq_1","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 1 F),\n  R.toScalarMetricRun =\n    { convex := ⋯, x := fun k => R.x k 0, g := fun k => R.g k 0, metric := fun k => R.H k 0 0, α := R.α, c₁ := R.c₁,\n      c₂ := R.c₂, c₁_pos := ⋯, c₁_lt_c₂ := ⋯, c₂_lt_one := ⋯, metric_pos := ⋯, alpha_pos := ⋯, gradient_ne := ⋯,\n      hasDeriv := ⋯, step := ⋯, armijo := ⋯, weak_wolfe := ⋯ }","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_projection_trace_update","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (k : ℕ),\n      (U * U.transpose * R.hessian (k + 1)).trace =\n        (U * U.transpose * R.hessian k).trace - BfgsVerification.sqNorm ((U * U.transpose).mulVec (R.g k)) / R.q k +\n          BfgsVerification.sqNorm ((U * U.transpose).mulVec (R.gradientChange k)) / R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
