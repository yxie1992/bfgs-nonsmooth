BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.actual_ordered_root_matching","signature":"∀ (p q : Polynomial ℝ),\n  p ≠ 0 →\n    ∀ (δ : ℝ),\n      (∀ b ∈ p.roots.toFinset,\n          ∀ c ∈ p.roots.toFinset, b ≠ c → Disjoint (Set.Icc (b - δ) (b + δ)) (Set.Icc (c - δ) (c + δ))) →\n        (∀ t ∈ q.roots.toFinset, ∃ b ∈ p.roots.toFinset, t ∈ Set.Icc (b - δ) (b + δ)) →\n          (∀ b ∈ p.roots.toFinset,\n              BfgsVerification.RealAlgebraicGeometry.rootWeightIn q (Set.Icc (b - δ) (b + δ)) ≤\n                Polynomial.rootMultiplicity b p) →\n            ∀ (hcard : q.roots.toFinset.card = p.roots.toFinset.card),\n              q.roots.card = p.roots.card →\n                ∀ (i : Fin p.roots.toFinset.card),\n                  (q.roots.toFinset.orderEmbOfFin hcard) i ∈\n                      Set.Icc ((p.roots.toFinset.orderEmbOfFin ⋯) i - δ) ((p.roots.toFinset.orderEmbOfFin ⋯) i + δ) ∧\n                    Polynomial.rootMultiplicity ((q.roots.toFinset.orderEmbOfFin hcard) i) q =\n                      Polynomial.rootMultiplicity ((p.roots.toFinset.orderEmbOfFin ⋯) i) p","axioms":["propext","Classical.choice","Quot.sound"]}
