BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.restrict._proof_6","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ K' ⊆ K,\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → C.m ≤ BfgsVerification.metricEnergy (C.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  [inst : (a : BfgsVerification.Vec n) → SizeOf (K a)] (W : BfgsVerification.Vec n → BfgsVerification.Mat n) (m C δ : ℝ)\n  (m_pos : 0 < m) (delta_pos : 0 < δ)\n  (positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))\n  (visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)\n  (secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h),\n  sizeOf\n      { W := W, m := m, C := C, δ := δ, m_pos := m_pos, delta_pos := delta_pos,\n        positive_semidefinite := positive_semidefinite, visibility := visibility, secant := secant } =\n    1 + sizeOf m + sizeOf C + sizeOf δ + sizeOf m_pos + sizeOf delta_pos","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.compressed_inverseBFGS_bound_generic","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (H : BfgsVerification.Mat n)\n  (Z : Matrix (Fin n) ι ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.PosDef H →\n    Function.Injective Z.mulVec →\n      0 < α →\n        0 < BfgsVerification.metricEnergy H g →\n          0 < -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g →\n            let q := BfgsVerification.metricEnergy H g;\n            let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n            (BfgsVerification.metricGram (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) Z).det ≤\n              (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det / (β ^ 2 * q) +\n                α / β * (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
