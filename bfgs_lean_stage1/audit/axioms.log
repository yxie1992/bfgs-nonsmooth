BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.sqNorm_mulVec_orthonormal","signature":"∀ {n r : ℕ} (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 → ∀ (v : BfgsVerification.Vec r), BfgsVerification.sqNorm (U.mulVec v) = BfgsVerification.sqNorm v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.fixed_reference","signature":"∀ {n : ℕ} (B : BfgsVerification.Mat n) (g y s r : BfgsVerification.Vec n) (q t : ℝ),\n  Matrix.IsSymm (B - q⁻¹ • BfgsVerification.outer g g) →\n    Matrix.mulVec (B - q⁻¹ • BfgsVerification.outer g g) s = 0 →\n      BfgsVerification.metricEnergy (B - q⁻¹ • BfgsVerification.outer g g + t⁻¹ • BfgsVerification.outer y y) (r + s) =\n        BfgsVerification.metricEnergy B r - BfgsVerification.dot g r ^ 2 / q + BfgsVerification.dot y (r + s) ^ 2 / t","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.radial_certificate_convergence_on_sublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),\n  IsCompact {x | F x ≤ b} →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        F (R.x 0) ≤ b →\n          BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧\n                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                  Filter.Tendsto R.x Filter.atTop (nhds star))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.convex","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}, BfgsVerification.AdmissibleBFGSRun n F → ConvexOn ℝ Set.univ F","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.moving_frame","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (g y s : BfgsVerification.Vec n) (q t : ℝ),\n  Matrix.IsSymm (B - q⁻¹ • BfgsVerification.outer g g) →\n    Matrix.mulVec (B - q⁻¹ • BfgsVerification.outer g g) s = 0 →\n      ∀ (V W : Matrix (Fin n) (Fin r) ℝ) (T : BfgsVerification.Mat r) (b : BfgsVerification.Vec r),\n        W = V * T + BfgsVerification.EnergyIdentities.rectOuter s b →\n          BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g + t⁻¹ • BfgsVerification.outer y y) W =\n            Matrix.transpose T *\n                  (BfgsVerification.metricGram B V -\n                    q⁻¹ • BfgsVerification.outer (V.transpose.mulVec g) (V.transpose.mulVec g)) *\n                T +\n              t⁻¹ • BfgsVerification.outer (W.transpose.mulVec y) (W.transpose.mulVec y)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.curvature_pos","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  0 < BfgsVerification.dot (self.g (k + 1) - self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.armijo","signature":"∀ {f : ℝ → ℝ} (self : BfgsVerification.ScalarMetricRun f) (k : ℕ),\n  f (self.x (k + 1)) ≤ f (self.x k) + self.c₁ * self.g k * (self.x (k + 1) - self.x k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.global_supporting_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    BfgsVerification.Homogeneous.PositiveDegreeOne F →\n      ∃ G,\n        0 < G ∧\n          ∀ (x g : BfgsVerification.Vec n),\n            BfgsVerification.Homogeneous.Supports F x g → BfgsVerification.sqNorm g ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.trace_mul_mono","signature":"∀ {n : ℕ} {M A B : BfgsVerification.Mat n},\n  Matrix.PosSemidef M → Matrix.PosSemidef (B - A) → (M * A).trace ≤ (M * B).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_energy","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (k : ℕ)\n  (V W : Matrix (Fin n) (Fin r) ℝ) (T : BfgsVerification.Mat r) (b : BfgsVerification.Vec r),\n  W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b →\n    BfgsVerification.metricGram (R.hessian (k + 1)) W =\n      Matrix.transpose T *\n            (BfgsVerification.metricGram (R.hessian k) V -\n              (R.q k)⁻¹ • BfgsVerification.outer (V.transpose.mulVec (R.g k)) (V.transpose.mulVec (R.g k))) *\n          T +\n        (R.curvature k)⁻¹ •\n          BfgsVerification.outer (W.transpose.mulVec (R.gradientChange k)) (W.transpose.mulVec (R.gradientChange k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.band_certificate_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {K : Set (BfgsVerification.Vec n)} {fstar η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar R.c₁ R.c₂ η),\n  (∀ (k : ℕ), R.x k ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n    (∀ (k : ℕ), R.d k ≤ C.δ) →\n      ∀ (G : ℝ), 0 < G → (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) → Summable R.d → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.operatorSqBound_iff_opNorm_sq","signature":"∀ {r : ℕ} (T : BfgsVerification.Mat r) (a : ℝ),\n  0 ≤ a → (BfgsVerification.FrameBounds.OperatorSqBound T a ↔ BfgsVerification.FrameNorms.euclideanOpNorm T ^ 2 ≤ a)","axioms":["propext","Quot.sound","Classical.choice"]}
