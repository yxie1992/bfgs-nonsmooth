BFGS_AUDIT {"theorem":"BfgsVerification.diagonal_coordinate_gram_det","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 < lam i) →\n    ∀ (y : BfgsVerification.Vec n) (I : Finset (Fin n)),\n      (BfgsVerification.metricGram (Matrix.diagonal lam)\n            ((Matrix.replicateCol Unit y).fromCols (BfgsVerification.coordinateMatrix I))).det =\n        (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \\ I, lam k * y k ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_fixed_tail_lower_eventually._proof_2","signature":"∀ (J M N : ℕ), N ≥ J + (max M 1 + 1) → ¬0 < N - (J + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.coefficient_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k j : ℕ), 0 ≤ E k j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.reciprocal_sum_ge_exp","signature":"∀ (q : ℕ → ℝ) (m : ℕ) (L : ℝ),\n  0 < m →\n    (∀ (i : ℕ), 0 < q i) →\n      ∑ i ∈ Finset.range m, Real.log (q i) ≤ L → ↑m * Real.exp (-L / ↑m) ≤ ∑ i ∈ Finset.range m, (q i)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_normalized_lower","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (D : ℝ),\n            0 < D →\n              ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                BfgsVerification.QuantitativeGrowth.normalizedLower\n                    (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / D) (E J)) D n m ≤\n                  (∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹) / (↑m + 1) ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
