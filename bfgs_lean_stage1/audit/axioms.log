BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.gap_tendsto_zero_of_normalized_budget","signature":"∀ {gap S T : ℕ → ℝ} {E₀ : ℝ},\n  (∀ (k : ℕ), 0 ≤ gap k) →\n    (∀ (N : ℕ), gap N ^ 2 * S N ≤ E₀ + T N) →\n      Filter.Tendsto S Filter.atTop Filter.atTop →\n        Filter.Tendsto (fun N => T N / S N) Filter.atTop (nhds 0) → Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
