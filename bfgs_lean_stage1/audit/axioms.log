BFGS_AUDIT {"theorem":"BfgsVerification.curvature_eq_alpha_beta_q","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  BfgsVerification.metricEnergy H g ≠ 0 →\n    BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) =\n      α * (-BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g) *\n        BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
