BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxHessian.branch_upper_taylor","signature":"∀ {n : ℕ} {f : BfgsVerification.Vec n → ℝ} {g : BfgsVerification.Vec n → BfgsVerification.Vec n} {L : ℝ},\n  0 ≤ L →\n    (∀ (z : BfgsVerification.Vec n), HasFDerivAt f (BfgsVerification.gradientFunctional (g z)) z) →\n      (∀ (z w : BfgsVerification.Vec n),\n          BfgsVerification.sqNorm (g z - g w) ≤ L ^ 2 * BfgsVerification.sqNorm (z - w)) →\n        ∀ (x z : BfgsVerification.Vec n),\n          f z ≤ f x + BfgsVerification.dot (g x) (z - x) + L / 2 * BfgsVerification.sqNorm (z - x)","axioms":["propext","Classical.choice","Quot.sound"]}
