BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.restrictMaxLinear._proof_10","signature":"∀ {n : ℕ} (A B : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty) (hB : B.Nonempty),\n  B ⊆ A →\n    ∀ (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n      (∀ (k : ℕ), R.g k ∈ B) →\n        ∀ (k : ℕ),\n          BfgsVerification.Homogeneous.finiteMaxLinear B hB (R.x (k + 1)) ≤\n            BfgsVerification.Homogeneous.finiteMaxLinear B hB (R.x k) +\n              R.c₁ * BfgsVerification.dot (R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
