BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.primitive.eq_1","signature":"∀ (t : ℝ),\n  BfgsVerification.NormalSpike.primitive t =\n    if t ≤ -1 then 0 else if t ≤ 1 then BfgsVerification.NormalSpike.primitivePoly t else 16 / 15 * t","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineProjection.inverseBFGS_annihilator","signature":"∀ {n r p : ℕ} (A : Matrix (Fin r) (Fin n) ℝ) (D : Matrix (Fin p) (Fin n) ℝ) (H : BfgsVerification.Mat n)\n  (s : BfgsVerification.Vec n) (y : BfgsVerification.Vec r),\n  D * H * A.transpose = 0 →\n    D.mulVec s = 0 → D * BfgsVerification.inverseBFGS H s (A.transpose.mulVec y) * A.transpose = 0","axioms":["propext","Quot.sound","Classical.choice"]}
