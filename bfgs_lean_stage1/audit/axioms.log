BFGS_AUDIT {"theorem":"BfgsVerification.QuadraticGauge.pair_correction_bound","signature":"∀ {m p : ℕ} (Q : BfgsVerification.Mat m),\n  Matrix.PosSemidef Q →\n    ∀ (γ : BfgsVerification.Vec p → ℝ),\n      BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n        ∀ (μ Λ : ℝ),\n          0 < μ →\n            (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →\n              (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →\n                ∀ (x z g h : BfgsVerification.Vec (m + p)),\n                  BfgsVerification.Homogeneous.Supports (BfgsVerification.QuadraticGauge.objective Q γ) x g →\n                    BfgsVerification.Homogeneous.Supports (BfgsVerification.QuadraticGauge.objective Q γ) z h →\n                      0 < BfgsVerification.dot (h - g) (z - x) →\n                        BfgsVerification.dot (h - g) z ^ 2 / BfgsVerification.dot (h - g) (z - x) ≤\n                          BfgsVerification.QuadraticGauge.correctionConstant μ Λ *\n                            BfgsVerification.QuadraticGauge.objective Q γ z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MaxAffine.Family.threshold_convergence","signature":"∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m) {ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ ψ →\n    BfgsVerification.CenteredSmoothSublinear.LocallyC11On Set.univ ψ →\n      ∀ (star : BfgsVerification.Vec n),\n        (∀ (x : BfgsVerification.Vec n), ψ star + P.objective star ≤ ψ x + P.objective x) →\n          (∀ (x : BfgsVerification.Vec n), ψ x + P.objective x = ψ star + P.objective star → x = star) →\n            ∀ (R : BfgsVerification.AdmissibleBFGSRun n fun x => ψ x + P.objective x),\n              ↑(ψ (R.x 0) + P.objective (R.x 0)) < P.threshold (fun x => ψ x + P.objective x) star →\n                Filter.Tendsto (fun k => ψ (R.x k) + P.objective (R.x k)) Filter.atTop\n                    (nhds (ψ star + P.objective star)) ∧\n                  Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.local_basin_of_unique_minimizer","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xStar : BfgsVerification.Vec n),\n  (∀ (x : BfgsVerification.Vec n), F xStar ≤ F x) →\n    (∀ (x : BfgsVerification.Vec n), F x = F xStar → x = xStar) →\n      ∀ {U : Set (BfgsVerification.Vec n)},\n        U ∈ nhds xStar → ∃ δ, 0 < δ ∧ (F (R.x 0) ≤ F xStar + δ → ∀ (k : ℕ), R.x k ∈ U)","axioms":["propext","Quot.sound","Classical.choice"]}
