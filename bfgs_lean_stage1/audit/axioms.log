@BfgsVerification.ReciprocalGrowth.hierarchy_reciprocal_growth : ∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},
  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →
    BfgsVerification.ScalarHierarchy.UpperNull δ →
      Filter.Tendsto (BfgsVerification.reciprocalGeometricMean q) Filter.atTop Filter.atTop ∧
        Filter.Tendsto (BfgsVerification.reciprocalMean q) Filter.atTop Filter.atTop
def BfgsVerification.PrincipalMinorHierarchyTarget : Prop :=
∀ (n : ℕ) (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),
  Matrix.PosDef H →
    0 < α →
      let q := BfgsVerification.metricEnergy H g;
      let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;
      0 < q →
        0 < β →
          ∀ (j : ℕ),
            1 ≤ j →
              j ≤ n →
                BfgsVerification.principalSum (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) j ≤
                  BfgsVerification.sqNorm y / (β ^ 2 * q) * BfgsVerification.principalSum H (j + 1) +
                    α / β * BfgsVerification.principalSum H j
def BfgsVerification.ReciprocalGrowthTarget : Prop :=
∀ (n : ℕ) (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Filter.Tendsto R.d Filter.atTop (nhds 0) →
            Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
              Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop
def BfgsVerification.SuperquadraticReciprocalTarget : Prop :=
∀ (n : ℕ) (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Summable R.d → Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
structure BfgsVerification.FullBFGSRun (n : ℕ) : Type
number of parameters: 1
fields:
  BfgsVerification.FullBFGSRun.H : ℕ → BfgsVerification.Mat n
  BfgsVerification.FullBFGSRun.g : ℕ → BfgsVerification.Vec n
  BfgsVerification.FullBFGSRun.α : ℕ → ℝ
  BfgsVerification.FullBFGSRun.positive_definite : ∀ (k : ℕ), Matrix.PosDef (self.H k)
  BfgsVerification.FullBFGSRun.alpha_pos : ∀ (k : ℕ), 0 < self.α k
  BfgsVerification.FullBFGSRun.energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (self.H k) (self.g k)
  BfgsVerification.FullBFGSRun.curvature_pos : ∀ (k : ℕ),
      0 < BfgsVerification.dot (self.g (k + 1) - self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
  BfgsVerification.FullBFGSRun.update : ∀ (k : ℕ),
      self.H (k + 1) =
        BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
          (self.g (k + 1) - self.g k)
constructor:
  BfgsVerification.FullBFGSRun.mk {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)
    (positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)) (alpha_pos : ∀ (k : ℕ), 0 < α k)
    (energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k))
    (curvature_pos :
      ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))
    (update :
      ∀ (k : ℕ),
        H (k + 1) =
          BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)) :
    BfgsVerification.FullBFGSRun n
def BfgsVerification.principalSum : {n : ℕ} → BfgsVerification.Mat n → ℕ → ℝ :=
fun {n} H j => ∑ I ∈ Finset.powersetCard j Finset.univ, (Matrix.submatrix H (fun i => ↑i) fun i => ↑i).det
def BfgsVerification.inverseBFGS : {n : ℕ} →
  BfgsVerification.Mat n → BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Mat n :=
fun {n} H s y =>
  let t := BfgsVerification.dot y s;
  (1 - t⁻¹ • BfgsVerification.outer s y) * H * (1 - t⁻¹ • BfgsVerification.outer y s) + t⁻¹ • BfgsVerification.outer s s
def BfgsVerification.FullBFGSRun.q : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => BfgsVerification.metricEnergy (R.H k) (R.g k)
def BfgsVerification.FullBFGSRun.d : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => R.α k * R.q k
def BfgsVerification.FullBFGSRun.beta : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => -BfgsVerification.dot (R.g (k + 1) - R.g k) (Matrix.mulVec (R.H k) (R.g k)) / R.q k
@BfgsVerification.finiteHorizon : ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Summable R.d →
            ∀ (J m : ℕ),
              0 < m →
                ∀ (η : ℝ),
                  0 < η →
                    let D := ∑' (i : ℕ), R.d (J + i);
                    let V :=
                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)
                        (BfgsVerification.principalSum (R.H J));
                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤
                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹
@BfgsVerification.fullBFGS_normalizedHierarchy : ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          BfgsVerification.ScalarHierarchy.NormalizedHierarchy n (fun k => BfgsVerification.principalSum (R.H k)) R.q
            (fun k => R.d k / c) (4 * G ^ 2 / c ^ 2) (G ^ 2)
def BfgsVerification.gradientFunctional : {n : ℕ} → BfgsVerification.Vec n → BfgsVerification.Vec n →L[ℝ] ℝ :=
fun {n} g => ∑ i, g i • ContinuousLinearMap.proj i
structure BfgsVerification.AdmissibleBFGSRun (n : ℕ) (F : BfgsVerification.Vec n → ℝ) : Type
number of parameters: 2
fields:
  BfgsVerification.AdmissibleBFGSRun.convex : ConvexOn ℝ Set.univ F
  BfgsVerification.AdmissibleBFGSRun.x : ℕ → BfgsVerification.Vec n
  BfgsVerification.AdmissibleBFGSRun.H : ℕ → BfgsVerification.Mat n
  BfgsVerification.AdmissibleBFGSRun.g : ℕ → BfgsVerification.Vec n
  BfgsVerification.AdmissibleBFGSRun.α : ℕ → ℝ
  BfgsVerification.AdmissibleBFGSRun.c₁ : ℝ
  BfgsVerification.AdmissibleBFGSRun.c₂ : ℝ
  BfgsVerification.AdmissibleBFGSRun.c₁_pos : 0 < self.c₁
  BfgsVerification.AdmissibleBFGSRun.c₁_lt_c₂ : self.c₁ < self.c₂
  BfgsVerification.AdmissibleBFGSRun.c₂_lt_one : self.c₂ < 1
  BfgsVerification.AdmissibleBFGSRun.initial_posDef : Matrix.PosDef (self.H 0)
  BfgsVerification.AdmissibleBFGSRun.alpha_pos : ∀ (k : ℕ), 0 < self.α k
  BfgsVerification.AdmissibleBFGSRun.gradient_nonzero : ∀ (k : ℕ), self.g k ≠ 0
  BfgsVerification.AdmissibleBFGSRun.hasGradient : ∀ (k : ℕ),
      HasFDerivAt F (BfgsVerification.gradientFunctional (self.g k)) (self.x k)
  BfgsVerification.AdmissibleBFGSRun.step : ∀ (k : ℕ),
      self.x (k + 1) = self.x k + BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k)
  BfgsVerification.AdmissibleBFGSRun.update : ∀ (k : ℕ),
      self.H (k + 1) =
        BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
          (self.g (k + 1) - self.g k)
  BfgsVerification.AdmissibleBFGSRun.armijo : ∀ (k : ℕ),
      F (self.x (k + 1)) ≤
        F (self.x k) +
          self.c₁ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
  BfgsVerification.AdmissibleBFGSRun.weak_wolfe : ∀ (k : ℕ),
      self.c₂ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k)) ≤
        BfgsVerification.dot (self.g (k + 1)) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
constructor:
  BfgsVerification.AdmissibleBFGSRun.mk {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (convex : ConvexOn ℝ Set.univ F)
    (x : ℕ → BfgsVerification.Vec n) (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)
    (c₁ c₂ : ℝ) (c₁_pos : 0 < c₁) (c₁_lt_c₂ : c₁ < c₂) (c₂_lt_one : c₂ < 1) (initial_posDef : Matrix.PosDef (H 0))
    (alpha_pos : ∀ (k : ℕ), 0 < α k) (gradient_nonzero : ∀ (k : ℕ), g k ≠ 0)
    (hasGradient : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g k)) (x k))
    (step : ∀ (k : ℕ), x (k + 1) = x k + BfgsVerification.bfgsStep (H k) (g k) (α k))
    (update :
      ∀ (k : ℕ),
        H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k))
    (armijo :
      ∀ (k : ℕ),
        F (x (k + 1)) ≤ F (x k) + c₁ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))
    (weak_wolfe :
      ∀ (k : ℕ),
        c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤
          BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))) :
    BfgsVerification.AdmissibleBFGSRun n F
def BfgsVerification.AdmissibleBFGSRun.q : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → ℝ :=
fun {n} {F} R k => BfgsVerification.metricEnergy (R.H k) (R.g k)
def BfgsVerification.AdmissibleBFGSRun.d : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → ℝ :=
fun {n} {F} R k => R.α k * R.q k
def BfgsVerification.AdmissibleBFGSRun.beta : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → ℝ :=
fun {n} {F} R k => -BfgsVerification.dot (R.g (k + 1) - R.g k) (Matrix.mulVec (R.H k) (R.g k)) / R.q k
def BfgsVerification.AdmissibleBFGSRun.initialSublevel : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → Set (BfgsVerification.Vec n) :=
fun {n} {F} R => {z | F z ≤ F (R.x 0)}
def BfgsVerification.ObjectiveReciprocalGrowthTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F) (G : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      Filter.Tendsto R.d Filter.atTop (nhds 0) →
        Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
          Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop
def BfgsVerification.ObjectiveLowerBoundGrowthTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F) (G L : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      (∀ (k : ℕ), L ≤ F (R.x k)) →
        Summable R.d ∧
          Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
            Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop ∧
              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
def BfgsVerification.CompactObjectiveGrowthTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F),
  IsCompact R.initialSublevel →
    (∃ G, 0 < G ∧ ∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) ∧
      Summable R.d ∧
        Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
          Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop ∧
            Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
def BfgsVerification.ObjectiveFiniteHorizonBound : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℝ → Prop :=
fun {n} {F} R G =>
  ∀ (J m : ℕ),
    0 < m →
      ∀ (η : ℝ),
        0 < η →
          let c := 1 - R.c₂;
          let D := ∑' (i : ℕ), R.d (J + i);
          let V := ∑ j ∈ Finset.range n, (4 * G ^ 2 / c ^ 2 / η) ^ j * BfgsVerification.principalSum (R.H J) (j + 1);
          ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤
            ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹
def BfgsVerification.CompactObjectiveFiniteHorizonTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F),
  IsCompact R.initialSublevel →
    ∃ G, 0 < G ∧ (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) ∧ BfgsVerification.ObjectiveFiniteHorizonBound R G
@BfgsVerification.fullBFGS_positive_invariants : ∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n)
  (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ) (c₂ : ℝ),
  Matrix.PosDef (H 0) →
    (∀ (k : ℕ), g k ≠ 0) →
      (∀ (k : ℕ), 0 < α k) →
        c₂ < 1 →
          (∀ (k : ℕ),
              c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤
                BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))) →
            (∀ (k : ℕ),
                H (k + 1) =
                  BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)) →
              ∀ (k : ℕ),
                Matrix.PosDef (H k) ∧
                  0 < BfgsVerification.metricEnergy (H k) (g k) ∧
                    0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k))
@BfgsVerification.AdmissibleBFGSRun.toFullBFGSRun : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.FullBFGSRun n
@BfgsVerification.convex_gradient_bound_on_compact : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {K : Set (BfgsVerification.Vec n)},
      IsCompact K →
        ∃ G,
          0 < G ∧
            ∀ x ∈ K,
              ∀ (g : BfgsVerification.Vec n),
                HasFDerivAt F (BfgsVerification.gradientFunctional g) x → BfgsVerification.sqNorm g ≤ G ^ 2
@BfgsVerification.AdmissibleBFGSRun.summable_predicted_decreases_of_lower_bound : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),
  (∀ (k : ℕ), L ≤ F (R.x k)) → Summable R.d
@BfgsVerification.objectiveFiniteHorizon_of_lower_bound : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) (G L : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      (∀ (k : ℕ), L ≤ F (R.x k)) → BfgsVerification.ObjectiveFiniteHorizonBound R G
@BfgsVerification.objectiveGrowth_of_value_limit : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) (G ℓ : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →
        Summable R.d ∧
          Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
            Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop ∧
              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
def BfgsVerification.AdmissibleBFGSRun.hessian : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Mat n :=
fun {n} {F} R k => (R.H k)⁻¹
def BfgsVerification.AdmissibleBFGSRun.displacement : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Vec n :=
fun {n} {F} R k => BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)
def BfgsVerification.AdmissibleBFGSRun.gradientChange : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Vec n :=
fun {n} {F} R k => R.g (k + 1) - R.g k
def BfgsVerification.AdmissibleBFGSRun.curvature : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → ℝ :=
fun {n} {F} R k => BfgsVerification.dot (R.gradientChange k) (R.displacement k)
def BfgsVerification.AdmissibleBFGSRun.referenceEnergy : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.metricEnergy (R.hessian k) (R.x k - xstar)
def BfgsVerification.AdmissibleBFGSRun.referencePairing : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.dot (R.g k) (R.x k - xstar)
def BfgsVerification.AdmissibleBFGSRun.referenceCorrection : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.dot (R.gradientChange k) (R.x (k + 1) - xstar) ^ 2 / R.curvature k
def BfgsVerification.EnergyIdentities.rectOuter : {n r : ℕ} →
  BfgsVerification.Vec n → BfgsVerification.Vec r → Matrix (Fin n) (Fin r) ℝ :=
fun {n r} s b i j => s i * b j
def BfgsVerification.FrameBounds.OperatorSqBound : {r : ℕ} → BfgsVerification.Mat r → ℝ → Prop :=
fun {r} T a =>
  ∀ (v : BfgsVerification.Vec r),
    BfgsVerification.sqNorm ((Matrix.transpose T).mulVec v) ≤ a * BfgsVerification.sqNorm v
def BfgsVerification.FrameNorms.euclideanOpNorm : {r : ℕ} → BfgsVerification.Mat r → ℝ :=
fun {r} T => ‖Matrix.toEuclideanCLM T‖
def BfgsVerification.SmoothSubspace.frobSq : {n r : ℕ} → Matrix (Fin n) (Fin r) ℝ → ℝ :=
fun {n r} W => ∑ i, ∑ j, W i j ^ 2
structure BfgsVerification.ExactFrameCertificate {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) : Type
number of parameters: 3
fields:
  BfgsVerification.ExactFrameCertificate.J : ℕ
  BfgsVerification.ExactFrameCertificate.r : ℕ
  BfgsVerification.ExactFrameCertificate.V : ℕ → Matrix (Fin n) (Fin self.r) ℝ
  BfgsVerification.ExactFrameCertificate.T : ℕ → BfgsVerification.Mat self.r
  BfgsVerification.ExactFrameCertificate.P : ℕ → BfgsVerification.Mat self.r
  BfgsVerification.ExactFrameCertificate.b : ℕ → BfgsVerification.Vec self.r
  BfgsVerification.ExactFrameCertificate.m : ℝ
  BfgsVerification.ExactFrameCertificate.K : ℝ
  BfgsVerification.ExactFrameCertificate.L : ℝ
  BfgsVerification.ExactFrameCertificate.C : ℝ
  BfgsVerification.ExactFrameCertificate.m_pos : 0 < self.m
  BfgsVerification.ExactFrameCertificate.K_pos : 0 < self.K
  BfgsVerification.ExactFrameCertificate.L_nonneg : 0 ≤ self.L
