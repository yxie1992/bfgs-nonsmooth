BFGS_AUDIT {"theorem":"BfgsVerification.ConvexCellRadial.local_cells_basin","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (P V : ι → Set (BfgsVerification.Vec n)) (f : ι → BfgsVerification.Vec n → ℝ),\n      (∀ (i : ι), IsClosed (P i)) →\n        (∀ (i : ι), Convex ℝ (P i)) →\n          (∀ (i : ι), IsOpen (V i)) →\n            (∀ (i : ι), BfgsVerification.CenteredSmoothSublinear.LocallyC11On (V i) (f i)) →\n              ∀ {U : Set (BfgsVerification.Vec n)},\n                IsOpen U →\n                  ∀ {star : BfgsVerification.Vec n},\n                    star ∈ U →\n                      (∀ (i : ι), U ∩ P i ⊆ V i) →\n                        (∀ x ∈ U, ∃ i, x ∈ P i) →\n                          (∀ (i : ι), ∀ x ∈ U, x ∈ P i → F x = f i x) →\n                            (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                              (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                                ∃ δ,\n                                  0 < δ ∧\n                                    ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                                      F (R.x 0) ≤ F star + δ →\n                                        (∀ (k : ℕ), R.x k ∈ U) ∧\n                                          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                            Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
