BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.variable_printed_radial_hessian_peak","signature":"∀ (n : ℕ) {c : BfgsVerification.Vec (n + 2)},\n  BfgsVerification.dot (BfgsVerification.NormalSpike.normal n) c = 0 →\n    ∀ (u : ℝ),\n      0 ≤ c 1 * u →\n        ∀ (N : ℕ),\n          BfgsVerification.dot (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N))\n              (Matrix.mulVec\n                (BfgsVerification.RadialHessian.matrix\n                  (BfgsVerification.NormalSpike.variableObjective (BfgsVerification.NormalSpike.normal n) c)\n                  (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N)))\n                (BfgsVerification.NormalSpike.sample n u (BfgsVerification.NormalSpike.scale N))) =\n            u ^ 2 + BfgsVerification.NormalSpike.scale N ^ 2 + 2 * (c 1 * u) * BfgsVerification.NormalSpike.scale N +\n              (BfgsVerification.NormalSpike.scale N)⁻¹","axioms":["propext","Classical.choice","Quot.sound"]}
