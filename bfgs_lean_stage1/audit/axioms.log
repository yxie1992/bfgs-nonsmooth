BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_trace_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ) (L : ℝ),\n  (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n    ∀ (k : ℕ),\n      (BfgsVerification.metricGram (R.hessian k) U).trace ≤ (BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k","axioms":["propext","Quot.sound","Classical.choice"]}
