BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.field_from_actual_cornerCharts","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (hF : ConvexOn ℝ Set.univ F) {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ},\n  (∀ x ∈ K, F x = ℓ) →\n    (∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n      (∀ x ∈ K, DifferentiableAt ℝ F x → BfgsVerification.coordinateGradient F x ≠ 0) →\n        ∀ {m : ℕ} (points : Fin m → BfgsVerification.Vec 2)\n          (charts : (i : Fin m) → BfgsVerification.PlanarCornerCharts.CornerChart F (points i)),\n          Function.Injective points →\n            (∀ (i : Fin m), points i ∈ K) →\n              (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ ∃ i, x = points i) →\n                ∃ χ,\n                  (∀ (i : Fin m), ContDiff ℝ (↑⊤) (χ i)) ∧\n                    (∀ (i : Fin m) (w : BfgsVerification.Vec 2), χ i w ∈ Set.Icc 0 1) ∧\n                      (Pairwise fun i j => Disjoint (tsupport (χ i)) (tsupport (χ j))) ∧\n                        (∀ (i : Fin m),\n                            ∀ᶠ (z : BfgsVerification.Vec 2) in nhds (points i),\n                              BfgsVerification.PlanarObjectiveField.field hF χ (fun j => deriv (charts j).curve) z =\n                                deriv (charts i).curve (F z)) ∧\n                          ∀ x ∈ K,\n                            (∃ L,\n                                ∃ U ∈ nhds x,\n                                  LipschitzOnWith L\n                                    (BfgsVerification.PlanarObjectiveField.field hF χ fun j => deriv (charts j).curve)\n                                    U) ∧\n                              ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                0 <\n                                  BfgsVerification.dot g\n                                    (BfgsVerification.PlanarObjectiveField.field hF χ (fun j => deriv (charts j).curve)\n                                      x)","axioms":["propext","Quot.sound","Classical.choice"]}
