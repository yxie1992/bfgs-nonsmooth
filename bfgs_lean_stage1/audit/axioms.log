                  C * BfgsVerification.TransportedCertificate.pairCurvature x z g h) :
    BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η
structure BfgsVerification.TransportedCertificate.PotentialBandCertificate {n : ℕ} (F : BfgsVerification.Vec n → ℝ)
  (K : Set (BfgsVerification.Vec n)) (fstar c₁ c₂ η : ℝ) : Type
number of parameters: 7
fields:
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.W : BfgsVerification.Vec n → BfgsVerification.Mat n
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.Ψ : BfgsVerification.Vec n → ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.m : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.C : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.L : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.δ : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.ψlo : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.ψhi : ℝ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.m_pos : 0 < self.m
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.L_nonneg : 0 ≤ self.L
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.delta_pos : 0 < self.δ
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.potential_bounds : ∀
      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, self.ψlo ≤ self.Ψ x ∧ self.Ψ x ≤ self.ψhi
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.positive_semidefinite : ∀
      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,
      DifferentiableAt ℝ F x → Matrix.PosSemidef (self.W x)
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.visibility : ∀
      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,
      ∀ (g : BfgsVerification.Vec n),
        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g
  BfgsVerification.TransportedCertificate.PotentialBandCertificate.secant : ∀ (x z g h : BfgsVerification.Vec n),
      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →
              BfgsVerification.metricEnergy (self.W z) (h - g) ≤
                self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h
