BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.positive_semidefinite","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    DifferentiableAt ℝ F x → Matrix.PosSemidef (self.W x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarRamp.primitive_linear_upper_bound","signature":"∀ {b : ℝ}, 2 ≤ b → b ≤ 34 → ∀ (x : ℝ), BfgsVerification.DScalarRamp.primitive b x ≤ max 0 x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ShiftedAbsAccessibility.identityCertificate_field","signature":"∀ {K : Set (BfgsVerification.Vec 1)} (hK : IsCompact K) {η : ℝ} (hη : 0 < η) {c₁ : ℝ} (hc₁ : 0 < c₁),\n  (BfgsVerification.ShiftedAbsAccessibility.identityCertificate hK hη hc₁).W = fun x => 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_bfgsStep","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n) (α : ℝ),\n  BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) = -(α * BfgsVerification.metricEnergy H g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarRamp.rampDerivative_hasDerivAt_inside","signature":"∀ {b x : ℝ},\n  BfgsVerification.DScalarRamp.center b - BfgsVerification.DScalarRamp.epsilon < x →\n    x < BfgsVerification.DScalarRamp.center b + BfgsVerification.DScalarRamp.epsilon →\n      HasDerivAt (BfgsVerification.DScalarRamp.rampDerivative b)\n        (4096 * (6 - 12 * BfgsVerification.DScalarRamp.rampCoordinate b x)) x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedCycle.last_curvature_norm","signature":"∀ (c d : ℝ),\n  BfgsVerification.dot (BfgsVerification.SeedCycle.g0 - BfgsVerification.SeedCycle.g2 c d)\n      (BfgsVerification.SeedCycle.g0 - BfgsVerification.SeedCycle.g2 c d) =\n    BfgsVerification.AlgebraicSeed.Y c d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.ratPrimitive.eq_1","signature":"∀ (t : ℚ),\n  BfgsVerification.NormalSpike.ratPrimitive t =\n    if t ≤ -1 then 0\n    else\n      if t ≤ 1 then\n        t * (BfgsVerification.NormalSpike.ratMassPoly t + 8 / 15) - BfgsVerification.NormalSpike.ratMomentPoly t + 1 / 6\n      else 16 / 15 * t","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_mul_le","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ},\n  (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (J N : ℕ), c₁ * ∑ i ∈ Finset.range N, d (J + i) ≤ f J - f (J + N)","axioms":["propext","Quot.sound","Classical.choice"]}
