BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace_update","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (q t : ℝ) (U : Matrix (Fin n) (Fin r) ℝ),\n  (BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g + t⁻¹ • BfgsVerification.outer y y) U).trace =\n    (BfgsVerification.metricGram B U).trace - BfgsVerification.sqNorm (U.transpose.mulVec g) / q +\n      BfgsVerification.sqNorm (U.transpose.mulVec y) / t","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.certificateOfScalarQuotient._proof_5","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)} {fstar η : ℝ},\n  (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec 1), HasFDerivAt F (BfgsVerification.gradientFunctional g) x → g 0 ≠ 0) →\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec 1),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n          1 ≤\n            BfgsVerification.metricEnergy\n              ((BfgsVerification.TransportedCertificate.scalarGradient F x ^ 2)⁻¹ •\n                BfgsVerification.outer (fun x => 1) fun x => 1)\n              g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_value_dichotomy","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) ∨\n    Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop Filter.atBot","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.energy_smul_matrix","signature":"∀ {n : ℕ} (a : ℝ) (B : BfgsVerification.Mat n) (x : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy (a • B) x = a * BfgsVerification.metricEnergy B x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.curvature_ge_of_weakWolfe","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g gnext : BfgsVerification.Vec n) (α c₂ : ℝ),\n  c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ≤\n      BfgsVerification.dot gnext (BfgsVerification.bfgsStep H g α) →\n    (1 - c₂) * (α * BfgsVerification.metricEnergy H g) ≤\n      BfgsVerification.dot (gnext - g) (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.restrict._proof_7","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ K' ⊆ K,\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n              BfgsVerification.metricEnergy (C.W z) (h - g) ≤\n                C.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.transported_shell_certificate_values","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (K : Set (BfgsVerification.Vec n)),\n  IsCompact K →\n    (∀ (k : ℕ), R.x k ∈ K) →\n      ∀ (star : BfgsVerification.Vec n),\n        (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n          BfgsVerification.TransportedCertificate.HasShellCertificates F K (F star) R.c₁ R.c₂ →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclideanOpNorm._proof_2","signature":"∀ {r : ℕ}, SMulCommClass ℝ ℝ (WithLp 2 (Fin r → ℝ))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.gradientFunctional.eq_1","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n), BfgsVerification.gradientFunctional g = ∑ i, g i • ContinuousLinearMap.proj i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalar_gradient_ne_zero","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 1) {K : Set (BfgsVerification.Vec 1)} {η : ℝ},\n      0 < η →\n        ∀ {x g : BfgsVerification.Vec 1},\n          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K (F star) η →\n            HasFDerivAt F (BfgsVerification.gradientFunctional g) x → g 0 ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb._proof_16","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η),\n  c₂ < 1 →\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ min C.δ (C.L + 1)⁻¹ →\n              BfgsVerification.metricEnergy (Real.exp (C.Ψ z) • C.W z) (h - g) ≤\n                Real.exp C.ψhi * max C.C 0 * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.common_component_incompatible._proof_3","signature":"∀ (J N : ℕ), J + 1 ≤ N → ¬N = J + (N - J) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift_d","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  (R.shift J).d k = R.d (J + k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.bounded_zero_sublevel_of_coercive._proof_2","signature":"∀ {α : Type u_1} [inst : LinearOrder α] {a b : α}, (¬a < b) = (b ≤ a)","axioms":["propext"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_gram","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (I : Finset (Fin n)),\n  BfgsVerification.metricGram H (BfgsVerification.coordinateMatrix I) = Matrix.submatrix H Subtype.val Subtype.val","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_residual_energy_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (W : Matrix (Fin n) (Fin p) ℝ),\n      U * U.transpose * W = W →\n        ∀ (k : ℕ),\n          (BfgsVerification.metricGram (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) W).trace ≤\n            BfgsVerification.SmoothSubspace.frobSq W * (BfgsVerification.metricGram (R.hessian k) U).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.rescale._proof_4","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  c₂ < 1 →\n    ∀ (w : BfgsVerification.Vec n → ℝ) (lo hi : ℝ),\n      0 < lo →\n        (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, lo ≤ w x ∧ w x ≤ hi) →\n          ∀ (x z g h : BfgsVerification.Vec n),\n            x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n              z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                  BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n                    BfgsVerification.metricEnergy (w z • C.W z) (h - g) ≤\n                      hi * max C.C 0 * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_sub_left","signature":"∀ {n : ℕ} (x y z : BfgsVerification.Vec n),\n  BfgsVerification.dot (x - y) z = BfgsVerification.dot x z - BfgsVerification.dot y z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_apply","signature":"∀ {n : ℕ} {ι : Type u_1} (H : BfgsVerification.Mat n) (X : Matrix (Fin n) ι ℝ) (i j : ι),\n  BfgsVerification.metricGram H X i j = BfgsVerification.dot (fun k => X k i) (Matrix.mulVec H fun k => X k j)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.update","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  self.H (k + 1) =\n    BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))\n      (self.g (k + 1) - self.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.toFullBFGSRun_beta","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F), R.toFullBFGSRun.beta = R.beta","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.trace_outer_mul","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n) (W : BfgsVerification.Mat n),\n  (BfgsVerification.outer g g * W).trace = BfgsVerification.metricEnergy W g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_gradient_bound_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        ∃ G,\n          0 < G ∧\n            ∀ x ∈ K,\n              ∀ (g : BfgsVerification.Vec n),\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x → BfgsVerification.sqNorm g ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.incomingJumpObstruction","signature":"BfgsVerification.IncomingJumpObstructionTarget","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalar_quotient_iff_lipschitz_of_bounds","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)} {fstar c₁ c₂ η : ℝ} (m G : ℝ),\n  0 < m →\n    0 < G →\n      (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n          ∀ (g : BfgsVerification.Vec 1),\n            HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ |g 0| ∧ |g 0| ≤ G) →\n        (BfgsVerification.TransportedCertificate.ScalarQuotientBound F K fstar c₁ c₂ η ↔\n          BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz F K fstar c₁ c₂ η)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.log_potential_telescope","signature":"∀ (q V : ℕ → ℝ) (A : ℝ) (J : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n          ∀ (m : ℕ),\n            ∑ k ∈ Finset.range m, Real.log (q (J + k)) + Real.log (V (J + m)) ≤ Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_coeff._proof_1","signature":"∀ {α : Sort u_1} {a b : α}, (a = b) = (b = a)","axioms":["propext"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.neighborhood_basin","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (xStar : E),\n      (∀ (x : E), F xStar ≤ F x) →\n        (∀ (x : E), F x = F xStar → x = xStar) →\n          ∀ {U : Set E}, U ∈ nhds xStar → ∃ δ, 0 < δ ∧ {x | F x ≤ F xStar + δ} ⊆ U","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.annihilated_hessian_posSemidef","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  Matrix.PosSemidef (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.compressed_inverseBFGS_bound","signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.PosDef H →\n    Function.Injective Z.mulVec →\n      0 < α →\n        0 < BfgsVerification.metricEnergy H g →\n          0 < -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g →\n            let q := BfgsVerification.metricEnergy H g;\n            let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n            (BfgsVerification.metricGram (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) Z).det ≤\n              (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det / (β ^ 2 * q) +\n                α / β * (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_one","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n), BfgsVerification.principalSum H 1 = Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb._proof_12","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η), 0 ≤ 2 * C.L","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.normalized_frame_step","signature":"∀ {n r : ℕ} (V W : Matrix (Fin n) (Fin r) ℝ) (P Q T : BfgsVerification.Mat r) (s : BfgsVerification.Vec n)\n  (b : BfgsVerification.Vec r),\n  Matrix.det P ≠ 0 →\n    Matrix.det Q ≠ 0 →\n      Q = P * T →\n        W = V * T + BfgsVerification.EnergyIdentities.rectOuter s b →\n          W * Q⁻¹ = V * P⁻¹ + BfgsVerification.EnergyIdentities.rectOuter s (Q⁻¹.transpose.mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.basis_limit_no_visibility_secant","signature":"∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {n : ℕ} {F : BfgsVerification.Vec n → ℝ}\n  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin n → BfgsVerification.Vec n),\n      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n        (∀ (a : ι) (j : Fin n), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →\n            (∀ (a : ι) (j : Fin n),\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →\n              (∀ (j : Fin n),\n                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l\n                    (nhds 0)) →\n                ∀ (b : Basis (Fin n) ℝ (BfgsVerification.Vec n)),\n                  (∀ (j : Fin n), Filter.Tendsto (fun a => h a - g a j) l (nhds (b j))) →\n                    (∀ (j : Fin n),\n                        Filter.Tendsto\n                          (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)) l\n                          (nhds 0)) →\n                      ∀ (B : ℝ),\n                        (∀ᶠ (a : ι) in l, ‖h a‖ ≤ B) →\n                          ¬Nonempty\n                              (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.tendsto_unique_minimizer_of_values","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (xStar : E),\n      (∀ (x : E), F xStar ≤ F x) →\n        (∀ (x : E), F x = F xStar → x = xStar) →\n          ∀ {ι : Type u_2} {l : Filter ι} {x : ι → E},\n            Filter.Tendsto (fun i => F (x i)) l (nhds (F xStar)) → Filter.Tendsto x l (nhds xStar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.armijo","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    c₁ * BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ F x - F z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.hessian_trace_update","signature":"∀ {n : ℕ} (B W : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (q t : ℝ),\n  ((B - q⁻¹ • BfgsVerification.outer g g + t⁻¹ • BfgsVerification.outer y y) * W).trace =\n    (B * W).trace - BfgsVerification.metricEnergy W g / q + BfgsVerification.metricEnergy W y / t","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weightedPotential.eq_1","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.weightedPotential n r e = ∑ j ∈ Finset.range n, r ^ j * e (j + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.energy_telescope","signature":"∀ {E q a R : ℕ → ℝ},\n  (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n    ∀ (N : ℕ), ∑ k ∈ Finset.range N, a k ^ 2 / q k = E 0 - E N + ∑ k ∈ Finset.range N, R k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.StrictContours.level_mem_frontier","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F → Continuous F → ∀ {ℓ : ℝ}, (∃ y, F y < ℓ) → ∀ {x : E}, F x = ℓ → x ∈ frontier {z | F z ≤ ℓ}","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_continuous","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}, ConvexOn ℝ Set.univ F → Continuous F","axioms":["propext","Quot.sound","Classical.choice"]}
