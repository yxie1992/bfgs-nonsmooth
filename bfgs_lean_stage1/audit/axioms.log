BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_linear_zero_fiber_limit","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n  (∀ (x : BfgsVerification.Vec n), 0 ≤ BfgsVerification.Homogeneous.finiteMaxLinear A hA x) →\n    ∀ (S : Submodule ℝ (BfgsVerification.Vec n)),\n      (∀ (x : BfgsVerification.Vec n), BfgsVerification.Homogeneous.finiteMaxLinear A hA x = 0 ↔ x ∈ S) →\n        ∃ xstar,\n          Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧\n            xstar ∈ S ∧\n              ∀ x ∈ S,\n                BfgsVerification.metricEnergy (R.H 0)⁻¹ (xstar - R.x 0) ≤\n                    BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) ∧\n                  (BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) =\n                      BfgsVerification.metricEnergy (R.H 0)⁻¹ (xstar - R.x 0) ↔\n                    x = xstar)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.LQuadraticSeed.quadratic_seed_contract","signature":"∀ {μ : ℝ},\n  0 < μ →\n    (∀ (x : BfgsVerification.Vec 2),\n        BfgsVerification.LQuadraticSeed.objective μ x =\n          μ / 2 * BfgsVerification.sqNorm x +\n            BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD x) ∧\n      (∀ (x : BfgsVerification.Vec 2),\n          BfgsVerification.LQuadraticSeed.objective μ x =\n            Finset.univ.sup' ⋯ fun i => BfgsVerification.LQuadraticSeed.branch μ i x) ∧\n        BfgsVerification.FixedNormal.EuclideanStrongConvexOn Set.univ μ (BfgsVerification.LQuadraticSeed.objective μ) ∧\n          (StrongConvexOn Set.univ μ fun x => BfgsVerification.LQuadraticSeed.objective μ fun i => x i) ∧\n            (∀ (i : Fin 3),\n                ConvexOn ℝ Set.univ (BfgsVerification.LQuadraticSeed.branch μ i) ∧\n                  ContDiff ℝ 2 (BfgsVerification.LQuadraticSeed.branch μ i)) ∧\n              (∀ (i : Fin 3) (x : BfgsVerification.Vec 2),\n                  BfgsVerification.RadialHessian.matrix (BfgsVerification.LQuadraticSeed.branch μ i) x = μ • 1) ∧\n                Filter.Tendsto (BfgsVerification.LQuadraticSeed.objective μ) (Filter.cocompact (BfgsVerification.Vec 2))\n                    Filter.atTop ∧\n                  (∀ (a : ℝ), IsCompact {x | BfgsVerification.LQuadraticSeed.objective μ x ≤ a}) ∧\n                    BfgsVerification.LQuadraticSeed.gbar =\n                        (129 / 257) • BfgsVerification.SeedCycle.g0 + (128 / 257) • BfgsVerification.SeedCycle.g1 ∧\n                      BfgsVerification.LQuadraticSeed.gbar ∈ (convexHull ℝ) BfgsVerification.LQuadraticSeed.slopes ∧\n                        (∀ g ∈ (convexHull ℝ) BfgsVerification.LQuadraticSeed.slopes,\n                            ‖BfgsVerification.euclideanVector BfgsVerification.LQuadraticSeed.gbar‖ ≤\n                              ‖BfgsVerification.euclideanVector g‖) ∧\n                          BfgsVerification.LQuadraticSeed.minimizer μ = -μ⁻¹ • BfgsVerification.LQuadraticSeed.gbar ∧\n                            BfgsVerification.LQuadraticSeed.minimizer μ ≠ 0 ∧\n                              BfgsVerification.LQuadraticSeed.objective μ\n                                    (BfgsVerification.LQuadraticSeed.minimizer μ) =\n                                  -1 / (514 * μ) ∧\n                                (∀ (x : BfgsVerification.Vec 2),\n                                    BfgsVerification.LQuadraticSeed.objective μ\n                                        (BfgsVerification.LQuadraticSeed.minimizer μ) ≤\n                                      BfgsVerification.LQuadraticSeed.objective μ x) ∧\n                                  (∀ (x : BfgsVerification.Vec 2),\n                                      BfgsVerification.LQuadraticSeed.objective μ x =\n                                          BfgsVerification.LQuadraticSeed.objective μ\n                                            (BfgsVerification.LQuadraticSeed.minimizer μ) →\n                                        x = BfgsVerification.LQuadraticSeed.minimizer μ) ∧\n                                    (∀ (i : Fin 3),\n                                        BfgsVerification.LQuadraticSeed.branch μ i\n                                              (BfgsVerification.LQuadraticSeed.minimizer μ) =\n                                            BfgsVerification.LQuadraticSeed.objective μ\n                                              (BfgsVerification.LQuadraticSeed.minimizer μ) ↔\n                                          i = 0 ∨ i = 1) ∧\n                                      ¬DifferentiableAt ℝ (BfgsVerification.LQuadraticSeed.objective μ)\n                                            (BfgsVerification.LQuadraticSeed.minimizer μ) ∧\n                                        BfgsVerification.LQuadraticSeed.objective μ 0 = 0 ∧\n                                          BfgsVerification.ConvexSubdifferential.subdifferential\n                                                (BfgsVerification.LQuadraticSeed.objective μ) 0 =\n                                              (convexHull ℝ) BfgsVerification.LQuadraticSeed.slopes ∧\n                                            0 ∉\n                                              BfgsVerification.ConvexSubdifferential.subdifferential\n                                                (BfgsVerification.LQuadraticSeed.objective μ) 0","axioms":["propext","Classical.choice","Quot.sound"]}
