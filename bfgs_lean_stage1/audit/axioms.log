BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.active_gap_forbids_central_bound","signature":"∀ {n : ℕ} {F f h : BfgsVerification.Vec n → ℝ} {U : Set (BfgsVerification.Vec n)},\n  IsOpen U →\n    ConvexOn ℝ U f →\n      ConvexOn ℝ U h →\n        (∀ x ∈ U, f x ≤ F x) →\n          (∀ x ∈ U, h x ≤ F x) →\n            ∀ {star w : BfgsVerification.Vec n},\n              w ∈ U →\n                f w = F w →\n                  h w = F w →\n                    ∀ {g q : BfgsVerification.Vec n →L[ℝ] ℝ},\n                      HasFDerivAt f g w →\n                        HasFDerivAt h q w →\n                          q (w - star) < g (w - star) →\n                            ¬∃ C ε,\n                                0 < ε ∧\n                                  ∀ (t : ℝ),\n                                    0 ≤ t →\n                                      t ≤ ε →\n                                        BfgsVerification.RadialCertificate.centralDifference F star w t ≤ C * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
