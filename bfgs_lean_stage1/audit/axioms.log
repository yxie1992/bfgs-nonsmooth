BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_schur_entry","signature":"∀ {n j : ℕ} {ι : Type u_1} [inst : Fintype ι] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (Y : Matrix (Fin n) ι ℝ) (Z : Matrix (Fin n) (Fin j) ℝ) (i k : ι),\n      (BfgsVerification.metricGram H Y -\n            Y.transpose * H * Z * (BfgsVerification.metricGram H Z)⁻¹ * (Z.transpose * H * Y))\n          i k =\n        BfgsVerification.dot (fun l => Y l i) (Matrix.mulVec H fun l => Y l k) -\n          BfgsVerification.dot (Z.transpose.mulVec (Matrix.mulVec H fun l => Y l i))\n            ((BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H fun l => Y l k)))","axioms":["propext","Quot.sound","Classical.choice"]}
