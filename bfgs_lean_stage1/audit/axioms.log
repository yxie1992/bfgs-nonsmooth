BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (convex : ConvexOn ℝ Set.univ F) (x : ℕ → BfgsVerification.Vec n)\n  (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ) (c₁ c₂ : ℝ) (c₁_pos : 0 < c₁)\n  (c₁_lt_c₂ : c₁ < c₂) (c₂_lt_one : c₂ < 1) (initial_posDef : Matrix.PosDef (H 0)) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (gradient_nonzero : ∀ (k : ℕ), g k ≠ 0)\n  (hasGradient : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g k)) (x k))\n  (step : ∀ (k : ℕ), x (k + 1) = x k + BfgsVerification.bfgsStep (H k) (g k) (α k))\n  (update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k))\n  (armijo :\n    ∀ (k : ℕ), F (x (k + 1)) ≤ F (x k) + c₁ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (weak_wolfe :\n    ∀ (k : ℕ),\n      c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤\n        BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))),\n  sizeOf\n      { convex := convex, x := x, H := H, g := g, α := α, c₁ := c₁, c₂ := c₂, c₁_pos := c₁_pos, c₁_lt_c₂ := c₁_lt_c₂,\n        c₂_lt_one := c₂_lt_one, initial_posDef := initial_posDef, alpha_pos := alpha_pos,\n        gradient_nonzero := gradient_nonzero, hasGradient := hasGradient, step := step, update := update,\n        armijo := armijo, weak_wolfe := weak_wolfe } =\n    1 + sizeOf convex + sizeOf c₁ + sizeOf c₂ + sizeOf c₁_pos + sizeOf c₁_lt_c₂ + sizeOf c₂_lt_one +\n      sizeOf initial_posDef","axioms":["propext","Classical.choice","Quot.sound"]}
