BFGS_AUDIT {"theorem":"BfgsVerification.LBlockSplitting.inverseMap._proof_21","signature":"∀ (a b ls lu : ℝ) (vs vr vu x y : BfgsVerification.LBlockSplitting.State),\n  (![BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr (x + y), (x + y) 4],\n      ![(x + y) 0 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr (x + y) * vs 0 - (x + y) 4 * vr 0 -\n          BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr (x + y) * vu 0,\n        (x + y) 1 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr (x + y) * vs 1 - (x + y) 4 * vr 1 -\n          BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr (x + y) * vu 1,\n        BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr (x + y)]) =\n    (![BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr x, x 4],\n        ![x 0 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr x * vs 0 - x 4 * vr 0 -\n            BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr x * vu 0,\n          x 1 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr x * vs 1 - x 4 * vr 1 -\n            BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr x * vu 1,\n          BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr x]) +\n      (![BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr y, y 4],\n        ![y 0 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr y * vs 0 - y 4 * vr 0 -\n            BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr y * vu 0,\n          y 1 - BfgsVerification.LBlockSplitting.shapeStable a b ls lu vr y * vs 1 - y 4 * vr 1 -\n            BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr y * vu 1,\n          BfgsVerification.LBlockSplitting.shapeUnstable a b ls lu vr y])","axioms":["propext","Classical.choice","Quot.sound"]}
