BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.exists_visible_comparison_field_on_compact_level","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ},\n      IsCompact K →\n        (∀ x ∈ K, F x = ℓ) →\n          (∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n            (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F x) →\n              (∀ x ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F x) →\n                ∃ W,\n                  (∀ x ∈ K,\n                      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                        ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                          BfgsVerification.dot g (W x) = BfgsVerification.dot h (W x)) ∧\n                    ∃ η,\n                      0 < η ∧\n                        ∃ N,\n                          IsOpen N ∧\n                            K ⊆ N ∧\n                              (∀ x ∈ N, ∃ L, ∃ U ∈ nhds x, LipschitzOnWith L W U) ∧\n                                ∀ x ∈ N,\n                                  ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                    η ≤ BfgsVerification.dot g (W x)","axioms":["propext","Classical.choice","Quot.sound"]}
