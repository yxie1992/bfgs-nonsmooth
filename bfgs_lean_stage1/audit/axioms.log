BFGS_AUDIT {"theorem":"BfgsVerification.LScalar.later_component_affine","signature":"∀ {b x : ℝ},\n  17 / 10 ≤ b →\n    b ≤ 34 →\n      ∀ {m n : ℕ},\n        m < n →\n          b * BfgsVerification.LScalarGeometric.theta * BfgsVerification.LScalarGeometric.scale m ≤ x →\n            BfgsVerification.LScalar.component b n x =\n              (1 - BfgsVerification.LScalarGeometric.theta ^ 1) * BfgsVerification.LScalarGeometric.scale n ^ 1 * x +\n                (1 - b) * (1 - BfgsVerification.LScalarGeometric.theta ^ 2) *\n                  BfgsVerification.LScalarGeometric.scale n ^ 2","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.maximum_eventually_eq_active","signature":"∀ {ι : Type u_1} {s : Finset ι} (hne : s.Nonempty) {f : ι → ℝ → ℝ} {x : ℝ},\n  (∀ i ∈ s, ContinuousAt (f i) x) →\n    BfgsVerification.FiniteMaxRadial.maximum s hne f =ᶠ[nhds x]\n      BfgsVerification.FiniteMaxRadial.maximum (BfgsVerification.FiniteMaxRadial.activeIndices s hne f x) ⋯ f","axioms":["propext","Classical.choice","Quot.sound"]}
