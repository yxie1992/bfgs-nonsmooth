def BfgsVerification.TransformedGauge.objective : {n : ℕ} →
  (ℝ → ℝ) → (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → BfgsVerification.Vec n → ℝ :=
fun {n} Φ γ star x => Φ (γ (x - star))
def BfgsVerification.TransformedGauge.inverse : (ℝ → ℝ) → ℝ → ℝ :=
fun Φ => Function.invFunOn Φ (Set.Ici 0)
def BfgsVerification.TransformedGauge.theta : (ℝ → ℝ) → ℝ → ℝ :=
fun Φ t => BfgsVerification.TransformedGauge.inverse Φ t * deriv Φ (BfgsVerification.TransformedGauge.inverse Φ t)
def BfgsVerification.Homogeneous.RelativeInteriorZero : {n : ℕ} → Finset (BfgsVerification.Vec n) → Prop :=
