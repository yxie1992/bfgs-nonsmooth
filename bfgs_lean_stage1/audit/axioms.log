BFGS_AUDIT {"theorem":"BfgsVerification.AffineProjection.compress.eq_1","signature":"∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ) (H : BfgsVerification.Mat n),\n  BfgsVerification.AffineProjection.compress A H = A * H * A.transpose","axioms":["propext","Quot.sound","Classical.choice"]}
