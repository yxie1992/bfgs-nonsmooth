BFGS_AUDIT {"theorem":"BfgsVerification.AffineWhitening.hessian_quadratic","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 →\n    ∀ (F : BfgsVerification.Vec n → ℝ) (x v : BfgsVerification.Vec n),\n      DifferentiableAt ℝ (fderiv ℝ F) (Matrix.mulVec A x) →\n        BfgsVerification.metricEnergy\n            (BfgsVerification.RadialHessian.matrix (BfgsVerification.AffineWhitening.objective A F) x) v =\n          BfgsVerification.metricEnergy (BfgsVerification.RadialHessian.matrix F (Matrix.mulVec A x))\n            (Matrix.mulVec A v)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.normalized_frame_trace_recurrence","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), P (k + 1) = P k * T k) →\n      (∀ (k : ℕ), V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (k : ℕ),\n          R.normalizedFrameEnergy V P (k + 1) =\n            R.normalizedFrameEnergy V P k -\n                BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec ((V k).transpose.mulVec (R.g k))) / R.q k +\n              BfgsVerification.sqNorm\n                  ((P (k + 1))⁻¹.transpose.mulVec ((V (k + 1)).transpose.mulVec (R.gradientChange k))) /\n                R.curvature k","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.LWhitening.smooth_actual_hessian","signature":"∀ {x : BfgsVerification.Vec 2},\n  (∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, DifferentiableAt ℝ BfgsVerification.LWhitening.smoothObjective z) →\n    DifferentiableAt ℝ (fderiv ℝ BfgsVerification.LWhitening.smoothObjective) x →\n      Matrix.IsSymm (BfgsVerification.RadialHessian.matrix BfgsVerification.LWhitening.smoothObjective x) ∧\n        ∀ (v : BfgsVerification.Vec 2),\n          BfgsVerification.LWhitening.lowerConstant * BfgsVerification.sqNorm v ≤\n              BfgsVerification.dot v\n                (Matrix.mulVec (BfgsVerification.RadialHessian.matrix BfgsVerification.LWhitening.smoothObjective x)\n                  v) ∧\n            BfgsVerification.dot v\n                (Matrix.mulVec (BfgsVerification.RadialHessian.matrix BfgsVerification.LWhitening.smoothObjective x)\n                  v) ≤\n              BfgsVerification.LWhitening.upperConstant * BfgsVerification.sqNorm v","axioms":["propext","Classical.choice","Quot.sound"]}
