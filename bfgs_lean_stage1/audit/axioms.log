BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.finiteMaxLinear_active_eq_gradient","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty) {x a g : BfgsVerification.Vec n},\n  a ∈ A →\n    BfgsVerification.Homogeneous.finiteMaxLinear A hA x = BfgsVerification.dot a x →\n      HasFDerivAt (BfgsVerification.Homogeneous.finiteMaxLinear A hA) (BfgsVerification.gradientFunctional g) x → a = g","axioms":["propext","Quot.sound","Classical.choice"]}
