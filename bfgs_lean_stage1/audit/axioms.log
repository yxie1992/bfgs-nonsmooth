BFGS_AUDIT {"theorem":"BfgsVerification.DEmbedding.all_actual_trial_values","signature":"∀ {n : ℕ} (hn : 1 ≤ n) {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ) (q : Fin 9),\n  BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n    let R := BfgsVerification.DEmbedding.run hn c₁ c₂ hc₁ hc₁' hc hc₂;\n    BfgsVerification.DEmbedding.objective\n        (R.x k + BfgsVerification.SeedOrbit.trialLength q • BfgsVerification.bfgsStep (R.H k) (R.g k) 1) =\n      BfgsVerification.DScalarGeometric.scale n ^ 3 +\n        BfgsVerification.DScalarGeometric.scale n ^ 4 *\n          BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n            (BfgsVerification.SeedEmbedding.trialPoint k q)","axioms":["propext","Classical.choice","Quot.sound"]}
