BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_planar_zero_branch_iterates","signature":"∀ (A : Finset (BfgsVerification.Vec 2)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun 2 (BfgsVerification.Homogeneous.finiteMaxLinear A hA))\n  (w : BfgsVerification.Vec 2),\n  BfgsVerification.Homogeneous.finiteMaxLinear A hA w < 0 →\n    Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) →\n      Filter.Tendsto R.x Filter.atTop (nhds 0)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          BfgsVerification.metricEnergy (self.W z) (h - g) ≤\n            self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarGeometric.tsum_scale_power","signature":"∀ {p : ℕ},\n  0 < p →\n    ∑' (n : ℕ), BfgsVerification.DScalarGeometric.scale n ^ p = (1 - BfgsVerification.DScalarGeometric.theta ^ p)⁻¹","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.inward_curve_mem_ball","signature":"∀ {n : ℕ} {star x : BfgsVerification.Vec n} {ρ : ℝ},\n  0 < ρ →\n    x ∈ Metric.ball star (ρ / 4) →\n      ∀ {t : ℝ},\n        t ∈ Set.Ioo (-1 / 2) (3 / 4) → BfgsVerification.RadialCertificate.inwardPoint star x t ∈ Metric.ball star ρ","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DeterministicLineSearch.search.eq_def","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (x p g : BfgsVerification.Vec n) (c₁ c₂ : ℝ) (fuel : ℕ) (l : ℝ)\n  (h : Option ℝ) (a : ℝ),\n  BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel l h a =\n    match fuel with\n    | 0 => (none, [])\n    | fuel.succ =>\n      if BfgsVerification.DeterministicLineSearch.Armijo F x p g c₁ a then\n        if BfgsVerification.DeterministicLineSearch.Wolfe F x p g c₂ a then (some a, [a])\n        else\n          let r :=\n            BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel a h\n              (BfgsVerification.DeterministicLineSearch.nextTrial a h);\n          (r.1, a :: r.2)\n      else\n        let r :=\n          BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel l (some a)\n            (BfgsVerification.DeterministicLineSearch.nextTrial l (some a));\n        (r.1, a :: r.2)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.formula_semialgebraic_path_cover_on_boundary_refinement","signature":"∀ {n m : ℕ},\n  BfgsVerification.RealAlgebraicGeometry.SemialgebraicPathCoverDimension n →\n    ∀ (f : BfgsVerification.RealAlgebraicGeometry.PolynomialFormula (Option (Fin n)))\n      (P : Fin m → MvPolynomial (Option (Fin n)) ℝ),\n      (∀ p ∈ f.atomPolynomials, ∃ j, P j = p) →\n        ∀ (Z : Finset (Fin m)) (a : BfgsVerification.Vec n) (S : Set (BfgsVerification.Vec n)),\n          BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic S →\n            S ⊆ BfgsVerification.RealAlgebraicGeometry.zeroFiberPattern P Z →\n              S ⊆\n                  BfgsVerification.RealAlgebraicGeometry.rootSignatureStratum\n                    ((MvPolynomial.optionEquivLeft ℝ (Fin n))\n                      (BfgsVerification.RealAlgebraicGeometry.survivingPolynomialProduct P Z))\n                    a →\n                ∀\n                  (signs :\n                    Fin m →\n                      Fin\n                          (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial\n                                  (BfgsVerification.RealAlgebraicGeometry.survivingPolynomialProduct P Z)\n                                  a).roots.toFinset.card →\n                        SignType),\n                  (∀ x ∈ S,\n                      ∀ (j : Fin m)\n                        (i :\n                          Fin\n                            (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial\n                                    (BfgsVerification.RealAlgebraicGeometry.survivingPolynomialProduct P Z)\n                                    a).roots.toFinset.card),\n                        SignType.sign\n                            (BfgsVerification.RealAlgebraicGeometry.parameterEval (P j)\n                              (x,\n                                BfgsVerification.RealAlgebraicGeometry.orderedFiberRoot\n                                  (BfgsVerification.RealAlgebraicGeometry.survivingPolynomialProduct P Z) (↑i) x)) =\n                          signs j i) →\n                    BfgsVerification.RealAlgebraicGeometry.HasFiniteSemialgebraicPathCover\n                      {v | (fun i => v (some i)) ∈ S ∧ f.Holds v}","axioms":["propext","Classical.choice","Quot.sound"]}
