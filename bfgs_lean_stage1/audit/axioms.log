BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.actual_deterministic_seed_failure","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1),\n  let R := BfgsVerification.SeedOrbit.run c₁ c₂ hc₁ hc₁' hc hc₂;\n  R.H 0 = 1 ∧\n    Filter.Tendsto R.x Filter.atTop (nhds 0) ∧\n      Filter.Tendsto\n          (fun k =>\n            BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n              (R.x k))\n          Filter.atTop (nhds 0) ∧\n        (∀ (k : ℕ),\n            0 <\n              BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                (R.x k)) ∧\n          (∀ (k : ℕ),\n              BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (R.x (k + 1)) <\n                BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (R.x k)) ∧\n            0 ∉\n                BfgsVerification.ConvexSubdifferential.subdifferential\n                  (BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC\n                    BfgsVerification.SeedOrbit.seedD)\n                  0 ∧\n              ∀ (k : ℕ),\n                BfgsVerification.DeterministicLineSearch.fromMetric\n                    (BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC\n                      BfgsVerification.SeedOrbit.seedD)\n                    (R.x k) (R.H k) c₁ c₂ 5 =\n                  (some (R.α k), BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k))","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.semialgebraic_vertical_path","signature":"∀ {σ : Type u_1} [inst : Fintype σ] {T : Set (Option σ → ℝ)} (x : σ → ℝ),\n  Convex ℝ {t | (fun j => j.elim t x) ∈ T} →\n    ∀ {t u : ℝ},\n      (fun j => j.elim t x) ∈ T →\n        (fun j => j.elim u x) ∈ T →\n          BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothPathIn T (fun j => j.elim t x) fun j =>\n            j.elim u x","axioms":["propext","Classical.choice","Quot.sound"]}
