def BfgsVerification.RadialCertificate.HasRadialSecantBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : ℝ),
    0 < η →
      ∃ C,
        ∀ (x z g h : BfgsVerification.Vec n),
          x ∈ K →
            z ∈ K →
              F star + η ≤ F z →
                F z ≤ F x →
                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                    HasFDerivAt F (BfgsVerification.gradientFunctional h) z →
                      0 < BfgsVerification.RadialCertificate.secantCurvature x z g h →
                        BfgsVerification.RadialCertificate.radialNumerator star z g h ^ 2 ≤
                          C * BfgsVerification.RadialCertificate.secantCurvature x z g h
def BfgsVerification.TransportedCertificateTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.TransportedCertificate.HasBandCertificates F {x | F x ≤ b} (F star) R.c₁ R.c₂ →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.HomogeneousDichotomyTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F →
    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0) ∨
      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop Filter.atBot
def BfgsVerification.ScalarMetricConvergenceTarget : Prop :=
∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f),
  IsCompact R.initialSublevel →
    ∀ (star : ℝ),
      (∀ (x : ℝ), f star ≤ f x) →
        (∀ (x : ℝ), f x = f star → x = star) →
          Filter.Tendsto (fun k => f (R.x k)) Filter.atTop (nhds (f star)) ∧ Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.ScalarBFGSConvergenceTarget : Prop :=
∀ {F : BfgsVerification.Vec 1 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 1 F),
  IsCompact R.initialSublevel →
    ∀ (star : BfgsVerification.Vec 1),
      (∀ (x : BfgsVerification.Vec 1), F star ≤ F x) →
        (∀ (x : BfgsVerification.Vec 1), F x = F star → x = star) →
          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧ Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.RadialCertificateConvergenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
@BfgsVerification.AdmissibleBFGSRun.accepted_pair_eligible : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),
  BfgsVerification.TransportedCertificate.EligiblePair F R.c₁ R.c₂ (R.x k) (R.x (k + 1)) (R.g k) (R.g (k + 1))
@BfgsVerification.AdmissibleBFGSRun.certificate_trace_step : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) {K : Set (BfgsVerification.Vec n)} {fstar η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar R.c₁ R.c₂ η) (k : ℕ),
  R.x k ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
    R.x (k + 1) ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
      R.d k ≤ C.δ →
        R.certificateEnergy C.W (k + 1) ≤ (1 + C.L * R.d k) * (R.certificateEnergy C.W k - C.m / R.q k) + C.C
@BfgsVerification.AdmissibleBFGSRun.homogeneous_global_gradient_bound : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F → ∃ G, 0 < G ∧ ∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2
@BfgsVerification.AdmissibleBFGSRun.homogeneous_coercive_iterates_zero : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F →
    Filter.Tendsto F (Filter.cocompact (BfgsVerification.Vec n)) Filter.atTop → Filter.Tendsto R.x Filter.atTop (nhds 0)
@BfgsVerification.AdmissibleBFGSRun.toScalarMetricRun : {F : BfgsVerification.Vec 1 → ℝ} →
  BfgsVerification.AdmissibleBFGSRun 1 F →
    BfgsVerification.ScalarMetricRun (BfgsVerification.OneDimensional.objective F)
@BfgsVerification.AdmissibleBFGSRun.radial_correction_bound : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n) {K : Set (BfgsVerification.Vec n)},
  (∀ (k : ℕ), R.x k ∈ K) →
    ∀ (η C : ℝ),
      (∀ (k : ℕ), F star + η ≤ F (R.x k)) →
        (∀ (x z g h : BfgsVerification.Vec n),
            x ∈ K →
              z ∈ K →
                F star + η ≤ F z →
                  F z ≤ F x →
                    HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                      HasFDerivAt F (BfgsVerification.gradientFunctional h) z →
                        0 < BfgsVerification.RadialCertificate.secantCurvature x z g h →
                          BfgsVerification.RadialCertificate.radialNumerator star z g h ^ 2 ≤
                            C * BfgsVerification.RadialCertificate.secantCurvature x z g h) →
          ∀ (k : ℕ), R.referenceCorrection star k ≤ C
@BfgsVerification.global_minimum_of_zero_gradient : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {x : BfgsVerification.Vec n},
      HasFDerivAt F (BfgsVerification.gradientFunctional 0) x → x ∈ BfgsVerification.argmin F
def BfgsVerification.Homogeneous.finiteMaxLinear : {n : ℕ} →
  (A : Finset (BfgsVerification.Vec n)) → A.Nonempty → BfgsVerification.Vec n → ℝ :=
fun {n} A hA x => A.sup' hA fun a => BfgsVerification.dot a x
def BfgsVerification.Homogeneous.recurrentValues.{u_1} : {α : Type u_1} → (ℕ → α) → Set α :=
fun {α} g => {v | ∃ᶠ (k : ℕ) in Filter.atTop, g k = v}
def BfgsVerification.Homogeneous.commonTilt : {n : ℕ} →
  (B : Finset (BfgsVerification.Vec n)) → B.Nonempty → BfgsVerification.Vec (n + 1) → ℝ :=
fun {n} B hB x => x 0 + BfgsVerification.Homogeneous.finiteMaxLinear B hB (Fin.tail x)
