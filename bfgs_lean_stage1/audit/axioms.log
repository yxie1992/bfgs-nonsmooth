BFGS_AUDIT {"theorem":"BfgsVerification.ConvexSubdifferential.local_affine_critical_correctness","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {f : Fin m → BfgsVerification.Vec n → ℝ} (g : BfgsVerification.Vec n → Fin m → BfgsVerification.Vec n)\n      (xstar : BfgsVerification.Vec n),\n      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f xstar →\n        (∀ᶠ (p : BfgsVerification.Vec n) in nhds xstar,\n            ∀ (i : Fin m), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g p i)) p) →\n          (∀ (i : Fin m), ContinuousAt (fun p => g p i) xstar) →\n            AffineIndependent ℝ (g xstar) →\n              ∀ (wstar : BfgsVerification.Vec m),\n                (∀ (i : Fin m), 0 < wstar i) →\n                  ∑ i, wstar i = 1 →\n                    ∑ i, wstar i • g xstar i = 0 →\n                      ∀ᶠ (p : BfgsVerification.Vec n) in nhds xstar,\n                        AffineIndependent ℝ (g p) ∧\n                          (0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p) ↔\n                              ∀ (z : BfgsVerification.Vec n), F p ≤ F z) ∧\n                            (0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p) →\n                              BfgsVerification.ConvexSubdifferential.activeIndices F f p = Finset.univ)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon_rpow","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (η D : ℝ),\n            0 < η →\n              0 ≤ D →\n                ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                  ↑(m + 1) *\n                        (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) (E J)) ^ (-1 / ↑(m + 1)) *\n                      (η + D / ↑m) ^ (-↑m / ↑(m + 1)) ≤\n                    ∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
