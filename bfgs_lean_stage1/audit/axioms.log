BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_error_le_of_pair_radial","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star x g h : BfgsVerification.Vec n) (t C : ℝ),\n      0 ≤ t →\n        t ≤ 1 / 2 →\n          0 ≤ C →\n            HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n              HasFDerivAt F (BfgsVerification.gradientFunctional h)\n                  (BfgsVerification.RadialCertificate.inwardPoint star x t) →\n                (0 <\n                      BfgsVerification.RadialCertificate.secantCurvature x\n                        (BfgsVerification.RadialCertificate.inwardPoint star x t) g h →\n                    BfgsVerification.RadialCertificate.radialNumerator star\n                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h ^\n                        2 ≤\n                      C *\n                        BfgsVerification.RadialCertificate.secantCurvature x\n                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h) →\n                  BfgsVerification.RadialCertificate.supportingError F x g\n                      (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤\n                    4 * C * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_step","signature":"∀ (n : ℕ) (e eNext : ℕ → ℝ) (q K η δ : ℝ),\n  0 ≤ K →\n    0 < η →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        e (n + 1) = 0 →\n          (∀ (j : ℕ), 1 ≤ j → j ≤ n → q * eNext j ≤ K * e (j + 1) + δ * e j) →\n            q * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) eNext ≤\n              (η + δ) * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) e","axioms":["propext","Quot.sound","Classical.choice"]}
