BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.stepProjector_fixes_perpendicular","signature":"∀ {n : ℕ} (s v : BfgsVerification.Vec n),\n  BfgsVerification.dot v s = 0 → Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) v = v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalar_gradient_band_bounds","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 1) {K : Set (BfgsVerification.Vec 1)},\n      IsCompact K →\n        ∀ {η : ℝ},\n          0 < η →\n            ∃ m G,\n              0 < m ∧\n                0 < G ∧\n                  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K (F star) η,\n                    ∀ (g : BfgsVerification.Vec 1),\n                      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ |g 0| ∧ |g 0| ≤ G","axioms":["propext","Quot.sound","Classical.choice"]}
