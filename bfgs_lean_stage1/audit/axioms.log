BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.decrease_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    0 < BfgsVerification.TransportedCertificate.pairDecrease x z g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compressed_update_bound","signature":"∀ (α β q Δ u D Dy Dgy Dplus : ℝ),\n  0 ≤ α →\n    0 < β →\n      0 < q →\n        0 ≤ Δ →\n          u ≤ q →\n            0 ≤ Dgy →\n              β ^ 2 * q ^ 2 * D = q * Dy - Dgy → Dplus = D + α / (β * q) * Δ * u → Dplus ≤ Dy / (β ^ 2 * q) + α / β * Δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.IncomingJump.sqrt_metricEnergy_sum_le","signature":"∀ {n r : ℕ} {W : BfgsVerification.Mat n},\n  Matrix.PosSemidef W →\n    ∀ (coeff : Fin r → ℝ) (y : Fin r → BfgsVerification.Vec n),\n      √(BfgsVerification.metricEnergy W (∑ j, coeff j • y j)) ≤\n        ∑ j, |coeff j| * √(BfgsVerification.metricEnergy W (y j))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.basis_limit_no_band_certificate","signature":"∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {n : ℕ} {F : BfgsVerification.Vec n → ℝ}\n  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin n → BfgsVerification.Vec n),\n      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n        (∀ (a : ι) (j : Fin n), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →\n            (∀ (a : ι) (j : Fin n),\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →\n              (∀ (j : Fin n),\n                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l\n                    (nhds 0)) →\n                ∀ (b : Basis (Fin n) ℝ (BfgsVerification.Vec n)),\n                  (∀ (j : Fin n), Filter.Tendsto (fun a => h a - g a j) l (nhds (b j))) →\n                    (∀ (j : Fin n),\n                        Filter.Tendsto\n                          (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)) l\n                          (nhds 0)) →\n                      ∀ (B : ℝ),\n                        (∀ᶠ (a : ι) in l, ‖h a‖ ≤ B) →\n                          ¬Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η)","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalarGradient_eq","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {x g : BfgsVerification.Vec 1},\n  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n    BfgsVerification.TransportedCertificate.scalarGradient F x = g 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression_add_rank_one_det","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r ρ : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det (BfgsVerification.CompressionDeterminant.compression A a b κ r + ρ • BfgsVerification.outer a a) =\n        Matrix.det (BfgsVerification.CompressionDeterminant.compression A a b κ r) +\n          ρ * Matrix.det A * BfgsVerification.dot a (Matrix.mulVec A⁻¹ a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.no_uniform_positive_gap","signature":"∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f),\n  IsCompact R.initialSublevel →\n    ∀ (xStar : ℝ), (∀ (x : ℝ), f xStar ≤ f x) → ∀ (L : ℝ), 0 < L → (∀ (k : ℕ), L ≤ f (R.x k) - f xStar) → False","axioms":["propext","Quot.sound","Classical.choice"]}
