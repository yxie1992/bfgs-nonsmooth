BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.normalizedQuadratic.eq_1","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) (i : Fin m) (v : ℝ),\n  P.normalizedQuadratic i v = (1 - P.b i * v) / P.a i","axioms":["propext","Quot.sound","Classical.choice"]}
