BFGS_AUDIT {"theorem":"BfgsVerification.DEmbedding.branch_plateau","signature":"∀ (n : ℕ) (i : Fin 3) {h : BfgsVerification.Vec 2},\n  |BfgsVerification.dot\n          (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i) h| ≤\n      BfgsVerification.DScalarGeometric.scale n / 2 →\n    BfgsVerification.DEmbedding.branch i.castSucc (BfgsVerification.DEmbedding.center n + h) =\n      BfgsVerification.DScalarGeometric.scale n ^ 3 +\n        BfgsVerification.DScalarGeometric.scale n ^ 2 *\n          BfgsVerification.dot\n            (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i) h","axioms":["propext","Classical.choice","Quot.sound"]}
