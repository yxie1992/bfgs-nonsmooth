BFGS_AUDIT {"theorem":"BfgsVerification.AffineCertificate.forward_pair_curvature","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 →\n    ∀ (b x z g h : BfgsVerification.Vec n),\n      BfgsVerification.TransportedCertificate.pairCurvature (BfgsVerification.AffineCertificate.forward A b x)\n          (BfgsVerification.AffineCertificate.forward A b z) (A⁻¹.transpose.mulVec g) (A⁻¹.transpose.mulVec h) =\n        BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
