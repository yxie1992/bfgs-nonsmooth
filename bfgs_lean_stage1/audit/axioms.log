BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.relativeInterior_euclidean_projection_bound","signature":"∀ {n r : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),\n  BfgsVerification.Homogeneous.RelativeInteriorZero A →\n    ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n      U.transpose * U = 1 →\n        (∀ (x : BfgsVerification.Vec n), x ∈ Submodule.span ℝ ↑A ↔ ∃ z, U.mulVec z = x) →\n          ∃ μ,\n            0 < μ ∧\n              ∀ (x : Fin n → ℝ),\n                μ * ‖BfgsVerification.euclideanVector (U.transpose.mulVec x)‖ ≤\n                  BfgsVerification.Homogeneous.finiteMaxLinear A hA x","axioms":["propext","Quot.sound","Classical.choice"]}
