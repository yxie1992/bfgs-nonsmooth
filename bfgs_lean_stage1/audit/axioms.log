BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCrossing.CornerSecantData.mk.inj","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {c : BfgsVerification.Vec 2} {f : Fin 2 → BfgsVerification.Vec 2 → ℝ}\n  {W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2} {radius : ℝ} {radius_pos : 0 < radius} {L G H B A D : ℝ}\n  {L_nonneg : 0 ≤ L} {G_nonneg : 0 ≤ G} {H_nonneg : 0 ≤ H} {B_nonneg : 0 ≤ B} {A_pos : 0 < A} {D_pos : 0 < D}\n  {representation : ∀ x ∈ Metric.closedBall c radius, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x}\n  {differentiable : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius, DifferentiableAt ℝ (f i) x}\n  {gradLip :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius,\n        ∀ z ∈ Metric.closedBall c radius,\n          ‖BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x‖ ≤ L * ‖z - x‖}\n  {fieldBound : ∀ x ∈ Metric.closedBall c radius, ‖W x‖ ≤ G}\n  {gradBound : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius, ‖BfgsVerification.coordinateGradient (f i) x‖ ≤ H}\n  {fieldLip : ∀ x ∈ Metric.closedBall c radius, ∀ z ∈ Metric.closedBall c radius, ‖W z - W x‖ ≤ B * ‖z - x‖}\n  {common :\n    ∀ p ∈ Metric.closedBall c radius,\n      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n        ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n          BfgsVerification.dot g (W p) = BfgsVerification.dot h (W p)}\n  {pair :\n    ∀ x ∈ Metric.closedBall c radius,\n      ∀ (v : BfgsVerification.Vec 2),\n        ‖v‖ ≤\n          A *\n            (|BfgsVerification.dot (BfgsVerification.coordinateGradient (f 0) x) v| +\n              |BfgsVerification.dot (BfgsVerification.coordinateGradient (f 1) x) v|)}\n  {cocoercive :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius,\n        ∀ z ∈ Metric.closedBall c radius,\n          BfgsVerification.sqNorm\n              (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) ≤\n            D *\n              BfgsVerification.dot\n                (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) (z - x)}\n  {radius_1 : ℝ} {radius_pos_1 : 0 < radius_1} {L_1 G_1 H_1 B_1 A_1 D_1 : ℝ} {L_nonneg_1 : 0 ≤ L_1}\n  {G_nonneg_1 : 0 ≤ G_1} {H_nonneg_1 : 0 ≤ H_1} {B_nonneg_1 : 0 ≤ B_1} {A_pos_1 : 0 < A_1} {D_pos_1 : 0 < D_1}\n  {representation_1 : ∀ x ∈ Metric.closedBall c radius_1, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x}\n  {differentiable_1 : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius_1, DifferentiableAt ℝ (f i) x}\n  {gradLip_1 :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius_1,\n        ∀ z ∈ Metric.closedBall c radius_1,\n          ‖BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x‖ ≤ L_1 * ‖z - x‖}\n  {fieldBound_1 : ∀ x ∈ Metric.closedBall c radius_1, ‖W x‖ ≤ G_1}\n  {gradBound_1 : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius_1, ‖BfgsVerification.coordinateGradient (f i) x‖ ≤ H_1}\n  {fieldLip_1 : ∀ x ∈ Metric.closedBall c radius_1, ∀ z ∈ Metric.closedBall c radius_1, ‖W z - W x‖ ≤ B_1 * ‖z - x‖}\n  {common_1 :\n    ∀ p ∈ Metric.closedBall c radius_1,\n      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n        ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n          BfgsVerification.dot g (W p) = BfgsVerification.dot h (W p)}\n  {pair_1 :\n    ∀ x ∈ Metric.closedBall c radius_1,\n      ∀ (v : BfgsVerification.Vec 2),\n        ‖v‖ ≤\n          A_1 *\n            (|BfgsVerification.dot (BfgsVerification.coordinateGradient (f 0) x) v| +\n              |BfgsVerification.dot (BfgsVerification.coordinateGradient (f 1) x) v|)}\n  {cocoercive_1 :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius_1,\n        ∀ z ∈ Metric.closedBall c radius_1,\n          BfgsVerification.sqNorm\n              (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) ≤\n            D_1 *\n              BfgsVerification.dot\n                (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) (z - x)},\n  { radius := radius, radius_pos := radius_pos, L := L, G := G, H := H, B := B, A := A, D := D, L_nonneg := L_nonneg,\n        G_nonneg := G_nonneg, H_nonneg := H_nonneg, B_nonneg := B_nonneg, A_pos := A_pos, D_pos := D_pos,\n        representation := representation, differentiable := differentiable, gradLip := gradLip,\n        fieldBound := fieldBound, gradBound := gradBound, fieldLip := fieldLip, common := common, pair := pair,\n        cocoercive := cocoercive } =\n      { radius := radius_1, radius_pos := radius_pos_1, L := L_1, G := G_1, H := H_1, B := B_1, A := A_1, D := D_1,\n        L_nonneg := L_nonneg_1, G_nonneg := G_nonneg_1, H_nonneg := H_nonneg_1, B_nonneg := B_nonneg_1,\n        A_pos := A_pos_1, D_pos := D_pos_1, representation := representation_1, differentiable := differentiable_1,\n        gradLip := gradLip_1, fieldBound := fieldBound_1, gradBound := gradBound_1, fieldLip := fieldLip_1,\n        common := common_1, pair := pair_1, cocoercive := cocoercive_1 } →\n    radius = radius_1 ∧ L = L_1 ∧ G = G_1 ∧ H = H_1 ∧ B = B_1 ∧ A = A_1 ∧ D = D_1","axioms":["propext","Classical.choice","Quot.sound"]}
