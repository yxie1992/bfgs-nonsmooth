          ∀ (star : BfgsVerification.Vec n)
            (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.TransformedGauge.objective Φ γ star)),
            Filter.Tendsto (fun k => BfgsVerification.TransformedGauge.objective Φ γ star (R.x k)) Filter.atTop
                (nhds 0) ∧
              Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.RelativeInteriorConvergenceTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  BfgsVerification.Homogeneous.RelativeInteriorZero A →
    ∃ xstar, Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧ BfgsVerification.Homogeneous.finiteMaxLinear A hA xstar = 0
def BfgsVerification.RecurrentRelativeInteriorTarget : Prop :=
∀ {n : ℕ} (A B : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),
  B.Nonempty →
    ∀ (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
