BFGS_AUDIT {"theorem":"BfgsVerification.PlanarNormalGeometry.normalSector_eq_actual_normals","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {f : Fin 2 → BfgsVerification.Vec 2 → ℝ} {g : Fin 2 → BfgsVerification.Vec 2} {x : BfgsVerification.Vec 2},\n      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n        (∀ (i : Fin 2), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g i)) x) →\n          (∀ (i : Fin 2), f i x = F x) →\n            BfgsVerification.PlanarNormalGeometry.normalized ''\n                BfgsVerification.ConvexSubdifferential.subdifferential F x =\n              BfgsVerification.PlanarNormalGeometry.normalSector (g 0) (g 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_two","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        let a := Z.transpose.mulVec (Matrix.mulVec H g);\n        let b := Z.transpose.mulVec (Matrix.mulVec H y);\n        let A := BfgsVerification.metricGram H Z;\n        (BfgsVerification.metricGram H (Matrix.fromCols (fun i k => ![g i, y i] k) Z)).det =\n          A.det *\n            ((BfgsVerification.metricEnergy H g - BfgsVerification.dot a (A⁻¹.mulVec a)) *\n                (BfgsVerification.metricEnergy H y - BfgsVerification.dot b (A⁻¹.mulVec b)) -\n              (BfgsVerification.dot g (Matrix.mulVec H y) - BfgsVerification.dot a (A⁻¹.mulVec b)) ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.Rotation.pair_eigenvalues_nonzero","signature":"∀ (P : BfgsVerification.NuclearSymmetric2.Rotation) {ε : ℝ},\n  0 < ε → (∀ (i : Fin 2), ⋯.eigenvalues i ≠ 0) ∧ ∀ (i : Fin 2), ⋯.eigenvalues i ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.HomogeneousBlock.interpolation_parameter_bound","signature":"∀ {n : ℕ} (g a b x : BfgsVerification.Vec n) (f κ c θ : ℝ),\n  0 < f →\n    0 < κ →\n      0 < c →\n        BfgsVerification.dot g a = f →\n          BfgsVerification.dot g b ≤ (1 - c) * f →\n            -f / κ ≤ BfgsVerification.dot g x →\n              BfgsVerification.dot g x ≤ f → x = a + θ • (b - a) → 0 ≤ θ ∧ θ ≤ (1 + 1 / κ) / c","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.cutoffFrame_transport","signature":"∀ {n r : ℕ} (U : Matrix (Fin n) (Fin r) ℝ) (a x z : BfgsVerification.Vec n) (b : ℝ) (τ : ℝ → ℝ),\n  let β := BfgsVerification.FixedNormal.cutoffSlope τ (BfgsVerification.dot a x - b) (BfgsVerification.dot a z - b);\n  BfgsVerification.FixedNormal.cutoffFrame U a (τ (BfgsVerification.dot a z - b)) =\n    BfgsVerification.FixedNormal.cutoffFrame U a (τ (BfgsVerification.dot a x - b)) * 1 +\n        BfgsVerification.EnergyIdentities.rectOuter (z - x) (BfgsVerification.FixedNormal.normalCoefficient β) +\n      BfgsVerification.FixedNormal.cutoffResidual a (z - x) β","axioms":["propext","Quot.sound","Classical.choice"]}
