BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.PolynomialFormula.finite_smooth_cover_of_sign_cover","signature":"∀ {σ : Type u_1} [inst : Fintype σ] (f : BfgsVerification.RealAlgebraicGeometry.PolynomialFormula σ)\n  (C : Finset (Set (σ → ℝ))),\n  (∀ T ∈ C,\n      BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic T ∧\n        BfgsVerification.RealAlgebraicGeometry.PiecewiseSmoothConnected T) →\n    ⋃ T ∈ C, T = Set.univ →\n      (∀ T ∈ C,\n          ∀ x ∈ T,\n            ∀ y ∈ T,\n              ∀ p ∈ f.atomPolynomials,\n                SignType.sign ((MvPolynomial.eval x) p) = SignType.sign ((MvPolynomial.eval y) p)) →\n        BfgsVerification.RealAlgebraicGeometry.HasFiniteSmoothSemialgebraicCover {x | f.Holds x}","axioms":["propext","Classical.choice","Quot.sound"]}
