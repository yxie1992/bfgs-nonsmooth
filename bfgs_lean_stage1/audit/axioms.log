BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.source_eligible_common_rate","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (f : Fin m → BfgsVerification.Vec n → ℝ) {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        (∀ p ∈ K, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f p) →\n          (∀ p ∈ K, ∀ (j : Fin m), ContDiffAt ℝ 2 (f j) p) →\n            (∀ p ∈ K, ∃ V, IsOpen V ∧ p ∈ V ∧ ∀ (j : Fin m), ConvexOn ℝ V (f j)) →\n              (∀ p ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p) →\n                (∀ p ∈ K, BfgsVerification.ConstantRankFields.LocallyConstantActiveRank F f p) →\n                  ∀ {c₁ c₂ : ℝ},\n                    c₂ < 1 →\n                      ∃ v,\n                        ContDiff ℝ 1 v ∧\n                          ∃ V Q,\n                            IsOpen V ∧\n                              K ⊆ V ∧\n                                closure V ⊆ Q ∧\n                                  IsCompact Q ∧\n                                    ∃ G δ C,\n                                      0 < G ∧\n                                        0 < δ ∧\n                                          0 ≤ C ∧\n                                            (∀ x ∈ Q, BfgsVerification.sqNorm (v x) ≤ G ^ 2) ∧\n                                              (∀ x ∈ Q,\n                                                  ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                                    BfgsVerification.dot g (v x) = 1) ∧\n                                                ∀ (x z g h : BfgsVerification.Vec n),\n                                                  x ∈ Q →\n                                                    z ∈ Q →\n                                                      ‖BfgsVerification.euclideanVector (z - x)‖ < δ →\n                                                        BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z\n                                                            g h →\n                                                          BfgsVerification.dot (h - g) (v z) ^ 2 /\n                                                              BfgsVerification.TransportedCertificate.pairCurvature x z\n                                                                g h ≤\n                                                            C","axioms":["propext","Classical.choice","Quot.sound"]}
