fields:
  BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.W : BfgsVerification.Vec n →
      BfgsVerification.Mat n
  BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.m : ℝ
  BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.C : ℝ
