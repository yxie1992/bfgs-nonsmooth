BFGS_AUDIT {"theorem":"BfgsVerification.DEmbedding.deterministic_embedding_failure","signature":"Filter.Tendsto\n    (fun n =>\n      BfgsVerification.SeedEmbedding.point (BfgsVerification.DEmbedding.center n)\n        (BfgsVerification.DScalarGeometric.scale n ^ 2) 0)\n    Filter.atTop (nhds 0) ∧\n  Filter.Tendsto\n      (fun n =>\n        BfgsVerification.DEmbedding.objective\n          (BfgsVerification.SeedEmbedding.point (BfgsVerification.DEmbedding.center n)\n            (BfgsVerification.DScalarGeometric.scale n ^ 2) 0))\n      Filter.atTop (nhds 0) ∧\n    (∀ (n : ℕ),\n        BfgsVerification.DEmbedding.center n ≠ 0 ∧\n          BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) =\n              BfgsVerification.DScalarGeometric.scale n ^ 3 ∧\n            0 < BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) ∧\n              0 ∉\n                  BfgsVerification.ConvexSubdifferential.subdifferential BfgsVerification.DEmbedding.objective\n                    (BfgsVerification.DEmbedding.center n) ∧\n                Filter.Tendsto\n                  (fun t =>\n                    (BfgsVerification.DEmbedding.objective\n                          (BfgsVerification.DEmbedding.center n + t • BfgsVerification.DEmbedding.descentDirection) -\n                        BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n)) /\n                      t)\n                  (nhdsWithin 0 (Set.Ioi 0)) (nhds (-BfgsVerification.DScalarGeometric.scale n ^ 2))) ∧\n      (∀ V ∈ nhds 0,\n          ∀ᶠ (n : ℕ) in Filter.atTop,\n            (∀ (k : ℕ),\n                BfgsVerification.SeedEmbedding.point (BfgsVerification.DEmbedding.center n)\n                    (BfgsVerification.DScalarGeometric.scale n ^ 2) k ∈\n                  V) ∧\n              ∀ (k : ℕ) (q : Fin 9),\n                BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n                  BfgsVerification.DEmbedding.center n +\n                      BfgsVerification.DScalarGeometric.scale n ^ 2 • BfgsVerification.SeedEmbedding.trialPoint k q ∈\n                    V) ∧\n        ∀ (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (n : ℕ) (hn : 1 ≤ n),\n          let R := BfgsVerification.DEmbedding.run hn c₁ c₂ hc₁ hc₁' hc hc₂;\n          R.H 0 = 1 ∧\n            (∀ (k : ℕ), Matrix.PosDef (R.H k)) ∧\n              Filter.Tendsto R.x Filter.atTop (nhds (BfgsVerification.DEmbedding.center n)) ∧\n                Filter.Tendsto (fun k => BfgsVerification.DEmbedding.objective (R.x k)) Filter.atTop\n                    (nhds (BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n))) ∧\n                  (∀ (k : ℕ),\n                      BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) <\n                        BfgsVerification.DEmbedding.objective (R.x k)) ∧\n                    (∀ (k : ℕ),\n                        BfgsVerification.DEmbedding.objective (R.x (k + 1)) <\n                          BfgsVerification.DEmbedding.objective (R.x k)) ∧\n                      (∀ (k : ℕ),\n                          BfgsVerification.DeterministicLineSearch.fromMetric BfgsVerification.DEmbedding.objective\n                              (R.x k) (R.H k) c₁ c₂ 5 =\n                            (some (R.α k),\n                              BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k))) ∧\n                        (∀ (k : ℕ),\n                            (BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k)).length ≤ 5) ∧\n                          (∀ (k : ℕ) (q : Fin 9),\n                              BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n                                HasFDerivAt BfgsVerification.DEmbedding.objective\n                                  (BfgsVerification.gradientFunctional\n                                    (BfgsVerification.DScalarGeometric.scale n ^ 2 •\n                                      BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC\n                                        BfgsVerification.SeedOrbit.seedD (BfgsVerification.SeedOrbit.trialActive q)))\n                                  (R.x k +\n                                    BfgsVerification.SeedOrbit.trialLength q •\n                                      BfgsVerification.bfgsStep (R.H k) (R.g k) 1)) ∧\n                            ∀ (m : ℕ) (j : Fin 3),\n                              R.x (3 * m + ↑j) =\n                                  BfgsVerification.DEmbedding.center n +\n                                    BfgsVerification.DScalarGeometric.scale n ^ 2 •\n                                      BfgsVerification.SeedOrbit.seedRatio ^ m •\n                                        BfgsVerification.SeedOrbit.point BfgsVerification.SeedOrbit.seedC\n                                          BfgsVerification.SeedOrbit.seedD BfgsVerification.SeedOrbit.seedRatio j ∧\n                                R.H (3 * m + ↑j) =\n                                    BfgsVerification.SeedOrbit.seedRatio ^ m •\n                                      BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC\n                                        BfgsVerification.SeedOrbit.seedD j ∧\n                                  R.g (3 * m + ↑j) =\n                                      BfgsVerification.DScalarGeometric.scale n ^ 2 •\n                                        BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC\n                                          BfgsVerification.SeedOrbit.seedD j ∧\n                                    R.α (3 * m + ↑j) = BfgsVerification.SeedOrbit.length j","axioms":["propext","Classical.choice","Quot.sound"]}
