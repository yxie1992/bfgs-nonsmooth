BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.field_supports_pairing_corner","signature":"∀ {m : ℕ} {F : BfgsVerification.Vec 2 → ℝ} (hF : ConvexOn ℝ Set.univ F) {f : Fin 2 → BfgsVerification.Vec 2 → ℝ}\n  {g : Fin 2 → BfgsVerification.Vec 2} {x u : BfgsVerification.Vec 2},\n  BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n    (∀ (j : Fin 2), HasFDerivAt (f j) (BfgsVerification.gradientFunctional (g j)) x) →\n      (∀ (j : Fin 2), f j x = F x) →\n        (∀ (j : Fin 2), BfgsVerification.dot (g j) u = 1) →\n          ∀ {χ : Fin m → BfgsVerification.Vec 2 → ℝ} (v : Fin m → ℝ → BfgsVerification.Vec 2),\n            (Pairwise fun i j => Disjoint (Function.support (χ i)) (Function.support (χ j))) →\n              ∀ {i : Fin m},\n                (∀ᶠ (w : BfgsVerification.Vec 2) in\n                    nhdsSet (BfgsVerification.PlanarNormalGeometry.normalSector (g 0) (g 1)), χ i w = 1) →\n                  v i (F x) = u →\n                    ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                      BfgsVerification.dot a (BfgsVerification.PlanarObjectiveField.field hF χ v x) = 1","axioms":["propext","Quot.sound","Classical.choice"]}
