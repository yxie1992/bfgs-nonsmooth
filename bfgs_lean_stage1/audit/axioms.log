BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.fullBFGS_step_exists","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {ψ : BfgsVerification.Vec n → ℝ},\n  Differentiable ℝ ψ →\n    ∀ (P : ι → BfgsVerification.AffineKinks.Kink n),\n      ConvexOn ℝ Set.univ (BfgsVerification.AffineKinks.objective ψ P) →\n        ∀ (x g : BfgsVerification.Vec n) (H : BfgsVerification.Mat n),\n          Matrix.PosDef H →\n            g ≠ 0 →\n              HasFDerivAt (BfgsVerification.AffineKinks.objective ψ P) (BfgsVerification.gradientFunctional g) x →\n                ∀ {c₁ c₂ : ℝ},\n                  0 < c₁ →\n                    c₁ < c₂ →\n                      c₂ < 1 →\n                        ∀ (L : ℝ),\n                          (∀ (t : ℝ),\n                              0 ≤ t →\n                                L ≤ BfgsVerification.AffineKinks.objective ψ P (x + BfgsVerification.bfgsStep H g t)) →\n                            ∃ α h,\n                              0 < α ∧\n                                HasFDerivAt (BfgsVerification.AffineKinks.objective ψ P)\n                                    (BfgsVerification.gradientFunctional h) (x + BfgsVerification.bfgsStep H g α) ∧\n                                  BfgsVerification.AffineKinks.objective ψ P (x + BfgsVerification.bfgsStep H g α) <\n                                      BfgsVerification.AffineKinks.objective ψ P x +\n                                        c₁ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ∧\n                                    c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) <\n                                      BfgsVerification.dot h (BfgsVerification.bfgsStep H g α)","axioms":["propext","Classical.choice","Quot.sound"]}
