BFGS_AUDIT {"theorem":"BfgsVerification.PlanarJoinedFrame.height_eq_single","signature":"∀ {m : ℕ} {χ : Fin m → BfgsVerification.Vec 2 → ℝ} (v : Fin m → BfgsVerification.Vec 2),\n  (Pairwise fun i j => Disjoint (Function.support (χ i)) (Function.support (χ j))) →\n    ∀ {i : Fin m} {θ : ℝ},\n      χ i (BfgsVerification.PlanarTransport.normal θ) ≠ 0 →\n        BfgsVerification.PlanarJoinedFrame.height χ v θ =\n          1 +\n            χ i (BfgsVerification.PlanarTransport.normal θ) *\n              (BfgsVerification.dot (BfgsVerification.PlanarTransport.normal θ) (v i) - 1)","axioms":["propext","Quot.sound","Classical.choice"]}
