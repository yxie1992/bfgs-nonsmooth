BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_common_component_escape","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (Q : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA))\n  (v : BfgsVerification.Vec n),\n  (∀ a ∈ A, BfgsVerification.dot v a = 1) →\n    Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (Q.x k)) Filter.atTop Filter.atBot","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_step_det","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (α : ℝ),\n      BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) ≠ 0 →\n        Matrix.det (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) =\n          α ^ 2 * BfgsVerification.metricEnergy H g / BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) *\n            Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_correction_ratio_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    Summable R.d →\n      Filter.Tendsto (fun N => ∑ k ∈ Finset.range N, (R.q k)⁻¹) Filter.atTop Filter.atTop →\n        Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, R.referenceCorrection 0 k) / ∑ k ∈ Finset.range N, (R.q k)⁻¹)\n          Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
