BFGS_AUDIT {"theorem":"BfgsVerification.RadialSingularCurvature.singular_curvature_counterexample","signature":"StrongConvexOn Set.univ 1 BfgsVerification.ScalarCounterexamples.shiftedAbs ∧\n  (∀ (x : ℝ),\n      BfgsVerification.ScalarCounterexamples.shiftedAbs (-1) ≤ BfgsVerification.ScalarCounterexamples.shiftedAbs x) ∧\n    (∀ (x : ℝ),\n        BfgsVerification.ScalarCounterexamples.shiftedAbs x = BfgsVerification.ScalarCounterexamples.shiftedAbs (-1) →\n          x = -1) ∧\n      IsCompact {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3} ∧\n        (∀ᵐ (x : ℝ),\n            BfgsVerification.ScalarCounterexamples.shiftedAbs x ≤ 3 →\n              0 ≤ (x + 1) ^ 2 * deriv (deriv BfgsVerification.ScalarCounterexamples.shiftedAbs) x ∧\n                (x + 1) ^ 2 * deriv (deriv BfgsVerification.ScalarCounterexamples.shiftedAbs) x ≤ 3) ∧\n          ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds\n              BfgsVerification.ScalarCounterexamples.shiftedObjective\n              {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3}\n              (BfgsVerification.OneDimensional.embed (-1))","axioms":["propext","Classical.choice","Quot.sound"]}
