BFGS_AUDIT {"theorem":"BfgsVerification.ConvexSubdifferential.subdifferential_eq_active_convexHull","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {f : Fin m → BfgsVerification.Vec n → ℝ} {g : Fin m → BfgsVerification.Vec n} {x : BfgsVerification.Vec n},\n      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n        (∀ (i : Fin m), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g i)) x) →\n          BfgsVerification.ConvexSubdifferential.subdifferential F x =\n            (convexHull ℝ) (g '' ↑(BfgsVerification.ConvexSubdifferential.activeIndices F f x))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.rescale._proof_2","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (w : BfgsVerification.Vec n → ℝ)\n  (lo hi : ℝ),\n  0 < lo →\n    (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, lo ≤ w x ∧ w x ≤ hi) →\n      ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n        DifferentiableAt ℝ F x → Matrix.PosSemidef (w x • C.W x)","axioms":["propext","Quot.sound","Classical.choice"]}
