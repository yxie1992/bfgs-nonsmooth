BFGS_AUDIT {"theorem":"BfgsVerification.PolynomialBounds.polynomial_quadratic_abs_sub_le","signature":"∀ {ι : Type u_1} [inst : Fintype ι] (a : ι → ℝ) (w : ι → List (Fin 2)),\n  (∀ (i : ι), 2 ≤ (w i).length) →\n    ∀ {x y : BfgsVerification.Vec 2} {r : ℝ},\n      r ≤ 1 →\n        (∀ (i : Fin 2), |x i| ≤ r) →\n          (∀ (i : Fin 2), |y i| ≤ r) →\n            |∑ i, a i * BfgsVerification.PolynomialBounds.monomial (w i) x -\n                  ∑ i, a i * BfgsVerification.PolynomialBounds.monomial (w i) y| ≤\n              (∑ i, |a i| * ↑(w i).length) * r * ‖x - y‖","axioms":["propext","Classical.choice","Quot.sound"]}
