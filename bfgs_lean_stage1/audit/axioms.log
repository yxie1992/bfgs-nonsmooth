BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression_eq_rank_two","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r : ℝ),\n  BfgsVerification.CompressionDeterminant.compression A a b κ r =\n    A + (r / κ ^ 2) • BfgsVerification.outer a a + -κ⁻¹ • (BfgsVerification.outer a b + BfgsVerification.outer b a)","axioms":["propext","Quot.sound","Classical.choice"]}
