BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.decrease_gap_identity","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i : Fin m} {x z : BfgsVerification.Vec 2},\n  P.Active i x →\n    BfgsVerification.TransportedCertificate.pairDecrease x z (P.branchGradient i x) - (P.objective x - P.objective z) =\n      P.a i * BfgsVerification.Parabolic.Family.horizontalStep x z ^ 2 + P.deficit i z","axioms":["propext","Quot.sound","Classical.choice"]}
