BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalSum_orthogonal_conjugate","signature":"∀ {n : ℕ} (Q H : BfgsVerification.Mat n),\n  Q * Matrix.transpose Q = 1 →\n    ∀ (j : ℕ), BfgsVerification.principalSum (Matrix.transpose Q * H * Q) j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_coeff","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (j : ℕ),\n  (BfgsVerification.PrincipalInvariance.principalPolynomial H).coeff j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.weightedPotential_mul_le","signature":"∀ (n : ℕ) (r t : ℝ) (e : ℕ → ℝ),\n  0 ≤ r →\n    1 ≤ t →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        BfgsVerification.ScalarHierarchy.weightedPotential n (r * t) e ≤\n          BfgsVerification.ScalarHierarchy.weightedPotential n r e * t ^ n","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_gram_diagonal","signature":"∀ {n : ℕ} (lam : Fin n → ℝ) (I : Finset (Fin n)),\n  BfgsVerification.metricGram (Matrix.diagonal lam) (BfgsVerification.coordinateMatrix I) =\n    Matrix.diagonal fun i => lam ↑i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_sub_le","signature":"∀ {n : ℕ} (g h : BfgsVerification.Vec n),\n  BfgsVerification.sqNorm (g - h) ≤ 2 * BfgsVerification.sqNorm g + 2 * BfgsVerification.sqNorm h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon_rpow","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (η D : ℝ),\n            0 < η →\n              0 ≤ D →\n                ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                  ↑(m + 1) *\n                        (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) (E J)) ^ (-1 / ↑(m + 1)) *\n                      (η + D / ↑m) ^ (-↑m / ↑(m + 1)) ≤\n                    ∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.shifted_succ","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.shiftedPotential (n + 1) r e =\n    BfgsVerification.ScalarHierarchy.shiftedPotential n r e + r ^ n * e (n + 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.det_piecewise_one","signature":"∀ {ι : Type u_1} {R : Type u_2} [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : CommRing R] (I : Finset ι)\n  (M : Matrix ι ι R), Matrix.det (I.piecewise M 1) = (M.submatrix (fun i => ↑i) fun i => ↑i).det","axioms":["propext","Quot.sound","Classical.choice"]}
