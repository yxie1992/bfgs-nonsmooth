def BfgsVerification.Parabolic.Example.objective : BfgsVerification.Vec 2 → ℝ :=
BfgsVerification.Parabolic.Example.family.objective
def BfgsVerification.Parabolic.Example.initialMetric : ℝ → ℝ → ℝ → ℝ → BfgsVerification.Mat 2 :=
fun u A ρ ε => !![A, -2 * u * A; -2 * u * A, 4 * u ^ 2 * A + (1 + ρ) * ε]
def BfgsVerification.ParabolicEligibleSeparationTarget : Prop :=
∀ {K : Set (BfgsVerification.Vec 2)},
  K ∈ nhds 0 →
    ∀ {c₁ c₂ : ℝ},
      c₁ < 1 →
        0 ≤ c₂ →
          ∃ η,
            0 < η ∧
              ∀ (δ : ℝ),
                0 < δ →
                  ∀ (C : ℝ),
                    ∃ x z g h H,
                      x ∈ K ∧
                        z ∈ K ∧
                          η ≤ BfgsVerification.Parabolic.Example.objective z ∧
                            BfgsVerification.Parabolic.Example.objective z ≤
                                BfgsVerification.Parabolic.Example.objective x ∧
                              BfgsVerification.TransportedCertificate.EligiblePair
                                  BfgsVerification.Parabolic.Example.objective c₁ c₂ x z g h ∧
                                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ ∧
                                  Matrix.PosDef H ∧
                                    BfgsVerification.bfgsStep H g 1 =
                                        BfgsVerification.TransportedCertificate.pairStep x z ∧
                                      C * BfgsVerification.TransportedCertificate.pairCurvature x z g h <
                                        BfgsVerification.RadialCertificate.radialNumerator 0 z g h ^ 2
def BfgsVerification.ParabolicNonnecessityTarget : Prop :=
∀ {K : Set (BfgsVerification.Vec 2)},
  K ∈ nhds 0 →
    (∀ (R : BfgsVerification.AdmissibleBFGSRun 2 BfgsVerification.Parabolic.Example.objective),
        Filter.Tendsto (fun k => BfgsVerification.Parabolic.Example.objective (R.x k)) Filter.atTop (nhds 0) ∧
          Filter.Tendsto R.x Filter.atTop (nhds 0)) ∧
      ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.Parabolic.Example.objective K 0
@BfgsVerification.Parabolic.Example.printed_armijo_iff : ∀ {u ε c₁ : ℝ},
  0 < ε →
    ε < 6 * u ^ 2 →
      (c₁ *
            BfgsVerification.TransportedCertificate.pairDecrease (BfgsVerification.Parabolic.Example.oldPoint u ε)
              (BfgsVerification.Parabolic.Example.newPoint u (1 / 2) ε)
              (BfgsVerification.Parabolic.Example.oldGradient u) ≤
          BfgsVerification.Parabolic.Example.objective (BfgsVerification.Parabolic.Example.oldPoint u ε) -
            BfgsVerification.Parabolic.Example.objective (BfgsVerification.Parabolic.Example.newPoint u (1 / 2) ε) ↔
        c₁ ≤ 2 / 3)
@BfgsVerification.Parabolic.Example.source_compensated_log : ∀ {u ρ ε : ℝ},
  0 < ρ →
    0 < ε →
      ρ * ε < 3 * u ^ 2 →
        Real.log
            (BfgsVerification.Parabolic.Example.sourceScale (BfgsVerification.Parabolic.Example.newPoint u ρ ε) *
                BfgsVerification.Parabolic.Family.quotientMultiplier (BfgsVerification.Parabolic.Example.oldPoint u ε)
                  (BfgsVerification.Parabolic.Example.newPoint u ρ ε) /
              BfgsVerification.Parabolic.Example.sourceScale (BfgsVerification.Parabolic.Example.oldPoint u ε)) =
          ε / (6 * (3 * u ^ 2 + ε))
def BfgsVerification.AccessibleActiveSeparationTarget : Prop :=
∃ B,
  (B.W = fun x => 1) ∧
    Continuous B.W ∧
      (∀ (i : Fin 2) (k : ℕ),
          HasFDerivAt BfgsVerification.ScalarCounterexamples.shiftedObjective
            (BfgsVerification.gradientFunctional (BfgsVerification.ShiftedAbsAccessibility.activeGradientApproach i k))
            (BfgsVerification.ShiftedAbsAccessibility.activeApproach i k)) ∧
        (∀ (i : Fin 2),
            Filter.Tendsto (BfgsVerification.ShiftedAbsAccessibility.activeApproach i) Filter.atTop (nhds 0) ∧
              Filter.Tendsto (BfgsVerification.ShiftedAbsAccessibility.activeGradientApproach i) Filter.atTop
                (nhds (BfgsVerification.ShiftedAbsAccessibility.activeGradients i))) ∧
          (∀ (i : Fin 2) (k : ℕ),
              BfgsVerification.ShiftedAbsAccessibility.activeApproach i k ∈
                BfgsVerification.TransportedCertificate.positiveBand
                  BfgsVerification.ScalarCounterexamples.shiftedObjective
                  {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3}
                  (BfgsVerification.ScalarCounterexamples.shiftedObjective (BfgsVerification.OneDimensional.embed (-1)))
                  (1 / 4)) ∧
            (∀ (i : Fin 2),
                0 <
                  BfgsVerification.metricEnergy (B.W 0) (BfgsVerification.ShiftedAbsAccessibility.activeGradients i)) ∧
              ∀ (i : Fin 2),
                (BfgsVerification.AccessibleJumpGeometry.tangentSpace fun j =>
                        BfgsVerification.euclideanVector
                          (BfgsVerification.ShiftedAbsAccessibility.activeGradients j)).orthogonalProjection
                    (BfgsVerification.euclideanVector (BfgsVerification.ShiftedAbsAccessibility.activeGradients i)) =
                  0
@BfgsVerification.ShiftedAbsAccessibility.accessible_jump_zero : ∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot]
  {c₁ : ℝ},
  0 < c₁ →
    ∀ (x z g h : ι → BfgsVerification.Vec 1) (p jump : BfgsVerification.Vec 1),
      (∀ᶠ (a : ι) in l,
          BfgsVerification.TransportedCertificate.EligiblePair BfgsVerification.ScalarCounterexamples.shiftedObjective
            c₁ (1 / 4) (x a) (z a) (g a) (h a)) →
        Filter.Tendsto x l (nhds p) →
          Filter.Tendsto z l (nhds p) →
            Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a) (z a) (g a) (h a)) l
                (nhds 0) →
              Filter.Tendsto (fun a => h a - g a) l (nhds jump) → jump = 0
BfgsVerification.ShiftedAbsAccessibility.full_active_tangent_space_eq_bot : (BfgsVerification.AccessibleJumpGeometry.tangentSpace
    fun j => BfgsVerification.euclideanVector (BfgsVerification.ShiftedAbsAccessibility.activeGradients j)) =
  ⊥
@BfgsVerification.ShiftedAbsAccessibility.shifted_all_compact_band_certificates : ∀ {K : Set (BfgsVerification.Vec 1)},
  IsCompact K →
    ∀ {c₁ : ℝ},
      0 < c₁ →
        BfgsVerification.TransportedCertificate.HasBandCertificates
          BfgsVerification.ScalarCounterexamples.shiftedObjective K
          (BfgsVerification.ScalarCounterexamples.shiftedObjective (BfgsVerification.OneDimensional.embed (-1))) c₁
          (1 / 4)
def BfgsVerification.MaxAffineThresholdTarget : Prop :=
∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m) {ψ : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ ψ →
    BfgsVerification.CenteredSmoothSublinear.LocallyC11On Set.univ ψ →
      ∀ (star : BfgsVerification.Vec n),
        (∀ (x : BfgsVerification.Vec n), ψ star + P.objective star ≤ ψ x + P.objective x) →
          (∀ (x : BfgsVerification.Vec n), ψ x + P.objective x = ψ star + P.objective star → x = star) →
            ∀ (R : BfgsVerification.AdmissibleBFGSRun n fun x => ψ x + P.objective x) (J : ℕ),
              ↑(ψ (R.x J) + P.objective (R.x J)) < P.threshold (fun x => ψ x + P.objective x) star →
                Filter.Tendsto (fun k => ψ (R.x k) + P.objective (R.x k)) Filter.atTop
                    (nhds (ψ star + P.objective star)) ∧
                  Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.MixedLinearPowersTarget.{u_1} : Prop :=
∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (γ : (j : ι) → BfgsVerification.Vec (m j) → ℝ),
      (∀ (j : ι), ConvexOn ℝ Set.univ (γ j)) →
        (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (γ j)) →
          (∀ (j : ι) (x : BfgsVerification.Vec (m j)), 0 ≤ γ j x) →
            ∀ (A : (j : ι) → BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec (m j)) (p : ι → ℝ),
              (∀ (j : ι), 1 ≤ p j) →
                ∀ (star : BfgsVerification.Vec n),
                  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
                    (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                      ∀ {U : Set (BfgsVerification.Vec n)},
                        IsOpen U →
                          star ∈ U →
                            BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
                              (∀ x ∈ U, F x = ψ x + ∑ j, γ j ((A j) (x - star)) ^ p j) →
                                ∃ δ,
                                  0 < δ ∧
                                    ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                                      F (R.x 0) ≤ F star + δ →
                                        (∀ (k : ℕ), R.x k ∈ U) ∧
                                          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                            Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.RecurrentLowRankTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)) ≤ 2 →
    ∀ (L : ℝ),
      Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds L) →
        L = 0 ∧
          ∃ xstar,
            Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧ BfgsVerification.Homogeneous.finiteMaxLinear A hA xstar = 0
def BfgsVerification.RelativeInteriorClassTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),
  BfgsVerification.Homogeneous.RelativeInteriorZero A ↔
    (∀ (x : BfgsVerification.Vec n), 0 ≤ BfgsVerification.Homogeneous.finiteMaxLinear A hA x) ∧
      ∃ S, ∀ (x : BfgsVerification.Vec n), BfgsVerification.Homogeneous.finiteMaxLinear A hA x = 0 ↔ x ∈ S
def BfgsVerification.ParabolicPruningTarget : Prop :=
∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m),
  (∀ (x : BfgsVerification.Vec 2), P.prunedFamily.objective x = P.objective x) ∧
    StrictMono P.prunedFamily.b ∧
      StrictMono (P.orderedBreakpoint P.prunedOrder) ∧
        ∀ (i : { i // ↑i + 1 < P.prunedOrder.count }),
          let l := P.prunedOrder.index ↑i;
          let r := P.prunedOrder.index ⟨↑↑i + 1, ⋯⟩;
          P.ProfileActive l (P.breakpoint l r) ∧
            P.ProfileActive r (P.breakpoint l r) ∧
              0 < P.profile l (P.breakpoint l r) ∧
                P.calibration r - P.calibration l = -(P.a r - P.a l) / (2 * P.profile l (P.breakpoint l r))
def BfgsVerification.ParabolicPrintedFieldTarget : Prop :=
∀ {K : Set (BfgsVerification.Vec 2)},
  IsCompact K →
    ∀ {η c₁ c₂ : ℝ},
      0 < η →
        0 ≤ c₁ →
          c₂ < 1 →
            ∃ B,
              ∀ (x : BfgsVerification.Vec 2),
                B.W x =
                  BfgsVerification.outer (BfgsVerification.Parabolic.Example.sourceVector x)
                    (BfgsVerification.Parabolic.Example.sourceVector x)
def BfgsVerification.PolyhedralBasinTarget.{u_1} : Prop :=
∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (a : (i : ι) → Fin (m i) → BfgsVerification.Vec n) (b : (i : ι) → Fin (m i) → ℝ)
      (V : ι → Set (BfgsVerification.Vec n)) (f : ι → BfgsVerification.Vec n → ℝ),
      (∀ (i : ι), IsOpen (V i)) →
        (∀ (i : ι), BfgsVerification.CenteredSmoothSublinear.LocallyC11On (V i) (f i)) →
          ∀ {U : Set (BfgsVerification.Vec n)},
            IsOpen U →
              ∀ {star : BfgsVerification.Vec n},
                star ∈ U →
                  (∀ (i : ι), U ∩ BfgsVerification.ConvexCellRadial.polyhedron (a i) (b i) ⊆ V i) →
                    (∀ x ∈ U, ∃ i, x ∈ BfgsVerification.ConvexCellRadial.polyhedron (a i) (b i)) →
                      (∀ (i : ι), ∀ x ∈ U, x ∈ BfgsVerification.ConvexCellRadial.polyhedron (a i) (b i) → F x = f i x) →
                        (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
                          (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                            ∃ δ,
                              0 < δ ∧
                                ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                                  F (R.x 0) ≤ F star + δ →
                                    (∀ (k : ℕ), R.x k ∈ U) ∧
                                      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                        Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.FivePieceObstructionTarget : Prop :=
∀ K ∈ nhds 0,
  ∃ τ,
    0 < τ ∧
      BfgsVerification.FivePieceObstruction.ray τ 0 ∈ K ∧
        Matrix.PosDef (BfgsVerification.FivePieceObstruction.initialMetric τ) ∧
          HasFDerivAt BfgsVerification.FivePieceObstruction.objective
              (BfgsVerification.gradientFunctional BfgsVerification.FivePieceObstruction.initialGradient)
              (BfgsVerification.FivePieceObstruction.ray τ 0) ∧
            ∀ (α : ℝ),
              0 < α →
                ∀ (g : BfgsVerification.Vec 3),
                  HasFDerivAt BfgsVerification.FivePieceObstruction.objective (BfgsVerification.gradientFunctional g)
                      (BfgsVerification.FivePieceObstruction.ray τ α) →
                    ¬(BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ α) ≤
                          BfgsVerification.FivePieceObstruction.objective
                              (BfgsVerification.FivePieceObstruction.ray τ 0) +
                            1 / 4 *
                              BfgsVerification.dot BfgsVerification.FivePieceObstruction.initialGradient
                                (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
                                  BfgsVerification.FivePieceObstruction.initialGradient α) ∧
                        1 / 2 *
                            BfgsVerification.dot BfgsVerification.FivePieceObstruction.initialGradient
                              (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
                                BfgsVerification.FivePieceObstruction.initialGradient α) ≤
                          BfgsVerification.dot g
                            (BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
                              BfgsVerification.FivePieceObstruction.initialGradient α))
BfgsVerification.FivePieceObstruction.objective_coercive : Filter.Tendsto
  BfgsVerification.FivePieceObstruction.objective (Filter.cocompact (BfgsVerification.Vec 3)) Filter.atTop
@BfgsVerification.FivePieceObstruction.unique_minimum : ∀ {x : BfgsVerification.Vec 3},
  BfgsVerification.FivePieceObstruction.objective x = 0 → x = 0
BfgsVerification.FivePieceObstruction.ray_step : ∀ (τ α : ℝ),
  BfgsVerification.FivePieceObstruction.ray τ α =
    BfgsVerification.FivePieceObstruction.ray τ 0 +
      BfgsVerification.bfgsStep (BfgsVerification.FivePieceObstruction.initialMetric τ)
        BfgsVerification.FivePieceObstruction.initialGradient α
@BfgsVerification.MaxAffine.Family.threshold_eq_inactive_infima : ∀ {n m : ℕ}
  (P : BfgsVerification.MaxAffine.Family n m) (F : BfgsVerification.Vec n → ℝ) (star : BfgsVerification.Vec n),
  P.threshold F star = ⨅ i, sInf ((fun x => ↑(F x)) '' P.activeRegion ↑i)
@BfgsVerification.MaxAffine.Family.threshold_gt_minimum : ∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m)
  {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) → ↑(F star) < P.threshold F star
@BfgsVerification.MaxAffine.Family.inactive_radius_domination : ∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m)
  (star z : BfgsVerification.Vec n) {i j : Fin m},
  i ∈ P.activeIndices star →
    j ∉ P.activeIndices star →
      P.a i ≠ P.a j →
        ‖BfgsVerification.euclideanVector z‖ ≤
            (P.objective star - P.branch j star) / (2 * ‖BfgsVerification.euclideanVector (P.a i - P.a j)‖) →
          P.branch j (star + z) < P.branch i (star + z)
@BfgsVerification.AffineBarycentric.affine_critical_subfamily_eventually_full : ∀ {X : Type u_1}
  [inst : TopologicalSpace X] {n m : ℕ} (g : X → Fin m → BfgsVerification.Vec n) (xstar : X),
  (∀ (i : Fin m), ContinuousAt (fun x => g x i) xstar) →
    AffineIndependent ℝ (g xstar) →
      ∀ (wstar : BfgsVerification.Vec m),
        (∀ (i : Fin m), 0 < wstar i) →
          ∑ i, wstar i = 1 →
            ∑ i, wstar i • g xstar i = 0 →
              ∀ᶠ (p : X) in nhds xstar,
                AffineIndependent ℝ (g p) ∧
                  ∀ (J : Finset (Fin m)),
                    0 ∈ affineSpan ℝ (g p '' ↑J) → J = Finset.univ ∧ 0 ∈ (convexHull ℝ) (g p '' ↑J)
def BfgsVerification.SmoothPLQBasinTarget.{u_1} : Prop :=
∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (a : (i : ι) → Fin (m i) → BfgsVerification.Vec n) (b : (i : ι) → Fin (m i) → ℝ) (Q : ι → BfgsVerification.Mat n)
      (c : ι → BfgsVerification.Vec n) (d : ι → ℝ) {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        ∀ {star : BfgsVerification.Vec n},
          star ∈ U →
            BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
              (∀ x ∈ U, ∃ i, x ∈ BfgsVerification.ConvexCellRadial.polyhedron (a i) (b i)) →
                (∀ (i : ι),
                    ∀ x ∈ U,
                      x ∈ BfgsVerification.ConvexCellRadial.polyhedron (a i) (b i) →
                        F x = ψ x + BfgsVerification.ConvexCellRadial.quadratic (Q i) (c i) (d i) x) →
                  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
                    (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                      ∃ δ,
                        0 < δ ∧
                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                            F (R.x 0) ≤ F star + δ →
                              (∀ (k : ℕ), R.x k ∈ U) ∧
                                Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                  Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.ActualFiniteMaxSubdifferentialTarget : Prop :=
∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {f : Fin m → BfgsVerification.Vec n → ℝ} {g : Fin m → BfgsVerification.Vec n} {x : BfgsVerification.Vec n},
      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →
        (∀ (i : Fin m), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g i)) x) →
          BfgsVerification.ConvexSubdifferential.subdifferential F x =
            (convexHull ℝ) (g '' ↑(BfgsVerification.ConvexSubdifferential.activeIndices F f x))
def BfgsVerification.LocalAffineCorrectnessTarget : Prop :=
∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {f : Fin m → BfgsVerification.Vec n → ℝ} (g : BfgsVerification.Vec n → Fin m → BfgsVerification.Vec n)
      (xstar : BfgsVerification.Vec n),
      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f xstar →
        (∀ᶠ (p : BfgsVerification.Vec n) in nhds xstar,
            ∀ (i : Fin m), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g p i)) p) →
          (∀ (i : Fin m), ContinuousAt (fun p => g p i) xstar) →
            (AffineIndependent ℝ fun i => g xstar (BfgsVerification.ConvexSubdifferential.activeIndexMap F f xstar i)) →
              ∀ (wstar : BfgsVerification.Vec (BfgsVerification.ConvexSubdifferential.activeIndices F f xstar).card),
                (∀ (i : Fin (BfgsVerification.ConvexSubdifferential.activeIndices F f xstar).card), 0 < wstar i) →
                  ∑ i, wstar i = 1 →
                    ∑ i, wstar i • g xstar (BfgsVerification.ConvexSubdifferential.activeIndexMap F f xstar i) = 0 →
                      ∀ᶠ (p : BfgsVerification.Vec n) in nhds xstar,
                        0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p) ↔
                          ∀ (z : BfgsVerification.Vec n), F p ≤ F z
def BfgsVerification.FiniteMaxRadialBasinTarget.{u_1} : Prop :=
∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] (hne : Finset.univ.Nonempty) {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (f : ι → BfgsVerification.Vec n → ℝ) {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        (∀ (i : ι), ContDiffOn ℝ 2 (f i) U) →
          ∀ {star : BfgsVerification.Vec n},
            star ∈ U →
              (∀ w ∈ U, F w = Finset.univ.sup' hne fun i => f i w) →
                (∀ w ∈ U,
                    ∀ (i j : ι),
                      f i w = F w → f j w = F w → (fderiv ℝ (f i) w) (w - star) = (fderiv ℝ (f j) w) (w - star)) →
                  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
                    (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                      ∃ δ,
                        0 < δ ∧
                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                            F (R.x 0) ≤ F star + δ →
                              (∀ (k : ℕ), R.x k ∈ U) ∧
                                Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                  Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.EuclideanResidualBasinTarget.{u_1} : Prop :=
∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (A : (i : ι) → Matrix (Fin (m i)) (Fin n) ℝ) (b : (i : ι) → BfgsVerification.Vec (m i))
      {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        ∀ {star : BfgsVerification.Vec n},
          star ∈ U →
            BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
              (∀ x ∈ U, F x = ψ x + ∑ i, ‖BfgsVerification.euclideanVector ((A i).mulVec x - b i)‖) →
                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
                  (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                    ∃ δ,
                      0 < δ ∧
                        ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                          F (R.x 0) ≤ F star + δ →
                            (∀ (k : ℕ), R.x k ∈ U) ∧
                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.FiniteRayStepTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (x g : BfgsVerification.Vec n) (H : BfgsVerification.Mat n),
      Matrix.PosDef H →
        g ≠ 0 →
          HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
            ∀ {c₁ c₂ : ℝ},
              0 < c₁ →
                c₁ < c₂ →
                  c₂ < 1 →
                    ∀ (L : ℝ),
                      (∀ (t : ℝ), 0 ≤ t → L ≤ F (x + BfgsVerification.bfgsStep H g t)) →
                        {t | 0 < t ∧ ¬DifferentiableAt ℝ F (x + BfgsVerification.bfgsStep H g t)}.Finite →
                          ∃ α h,
                            0 < α ∧
                              HasFDerivAt F (BfgsVerification.gradientFunctional h)
                                  (x + BfgsVerification.bfgsStep H g α) ∧
                                F (x + BfgsVerification.bfgsStep H g α) <
                                    F x + c₁ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ∧
                                  c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) <
                                    BfgsVerification.dot h (BfgsVerification.bfgsStep H g α)
def BfgsVerification.UnexcitedMetricTarget : Prop :=
∀ (A v₀ ρ c₁ c₂ : ℝ) (hA : 0 < A) (hv : 0 < v₀) (hρ : 0 < ρ) (hc₁ : 0 < c₁) (hc : c₁ < c₂) (hc₂ : c₂ < 1)
  (hr : ρ < (1 - c₁) / (1 + c₁)),
  let R := BfgsVerification.UnexcitedMetric.run A v₀ ρ c₁ c₂ hA hv hρ hc₁ hc hc₂ hr;
  Filter.Tendsto R.x Filter.atTop (nhds 0) ∧
    Filter.Tendsto (fun k => BfgsVerification.UnexcitedMetric.objective (R.x k)) Filter.atTop (nhds 0) ∧
      Filter.Tendsto R.H Filter.atTop (nhds (BfgsVerification.UnexcitedMetric.diagonal A 0)) ∧
        (∀ (k : ℕ), R.H k 0 0 = A) ∧ ∀ (k : ℕ), R.x k = ![0, (-ρ) ^ k * v₀]
def BfgsVerification.ParabolicRadialBoundaryTarget : Prop :=
∀ {K : Set (BfgsVerification.Vec 2)},
  K ∈ nhds 0 →
    (∀ (R : BfgsVerification.AdmissibleBFGSRun 2 BfgsVerification.ParabolicRadialBoundary.objective),
        Filter.Tendsto (fun k => BfgsVerification.ParabolicRadialBoundary.objective (R.x k)) Filter.atTop (nhds 0) ∧
          Filter.Tendsto R.x Filter.atTop (nhds 0)) ∧
      ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.ParabolicRadialBoundary.objective K 0
def BfgsVerification.AlgebraicSeedRootTarget : Prop :=
∃! x,
  (∀ (i : Fin 2), |x i - BfgsVerification.AlgebraicSeed.center i| ≤ 1 / 10 ^ 30) ∧
    264192 * BfgsVerification.AlgebraicSeed.R (x 0) (x 1) * BfgsVerification.AlgebraicSeed.K (x 0) (x 1) -
          BfgsVerification.AlgebraicSeed.U (x 0) (x 1) * BfgsVerification.AlgebraicSeed.V (x 0) (x 1) *
            (BfgsVerification.AlgebraicSeed.U (x 0) (x 1) + 129) =
        0 ∧
      16 * BfgsVerification.AlgebraicSeed.V (x 0) (x 1) * BfgsVerification.AlgebraicSeed.T (x 0) (x 1) *
            BfgsVerification.AlgebraicSeed.K (x 0) (x 1) -
          BfgsVerification.AlgebraicSeed.R (x 0) (x 1) * BfgsVerification.AlgebraicSeed.U (x 0) (x 1) *
            BfgsVerification.AlgebraicSeed.Y (x 0) (x 1) =
        0
def BfgsVerification.AlgebraicSeedBoundsTarget : Prop :=
∀ {x : BfgsVerification.Vec 2},
  ‖x - BfgsVerification.AlgebraicSeed.center‖ ≤ BfgsVerification.AlgebraicSeed.radius →
    0 < BfgsVerification.AlgebraicSeed.U (x 0) (x 1) ∧
      0 < BfgsVerification.AlgebraicSeed.V (x 0) (x 1) ∧
        0 < BfgsVerification.AlgebraicSeed.R (x 0) (x 1) ∧
          0 < BfgsVerification.AlgebraicSeed.K (x 0) (x 1) ∧
            0 < BfgsVerification.AlgebraicSeed.T (x 0) (x 1) ∧
              0 < BfgsVerification.AlgebraicSeed.Y (x 0) (x 1) ∧
                0 < BfgsVerification.AlgebraicSeed.U (x 0) (x 1) + 129 ∧
                  60 / 1000 < BfgsVerification.AlgebraicSeed.ratio (x 0) (x 1) ∧
                    BfgsVerification.AlgebraicSeed.ratio (x 0) (x 1) < 61 / 1000
def BfgsVerification.AffineRankLossTarget : Prop :=
(∀ (x : BfgsVerification.Vec 2),
    BfgsVerification.AffineCriticalObjective.AffineCorrectAt BfgsVerification.AffineRankLoss.objective x) ∧
  BfgsVerification.AffineRankLoss.affineDistance 0 = 1 ∧
    (∀ (t : ℝ), t ≠ 0 → BfgsVerification.AffineRankLoss.affineDistance ![0, t] = 2 * |t|) ∧
      Filter.Tendsto (fun t => BfgsVerification.AffineRankLoss.affineDistance ![0, t]) (nhdsWithin 0 {0}ᶜ) (nhds 0) ∧
        Filter.Tendsto
          (fun t =>
            BfgsVerification.AffineRankLoss.objective ![0, t] - BfgsVerification.AffineRankLoss.objective ![-1 / 2, 0])
          (nhdsWithin 0 {0}ᶜ) (nhds (1 / 4))
def BfgsVerification.AlgebraicJacobianCertificateTarget : Prop :=
fderiv ℝ BfgsVerification.AlgebraicSeed.P BfgsVerification.AlgebraicSeed.center =
    BfgsVerification.AffineProjection.matrixCLM BfgsVerification.AlgebraicSeed.J ∧
  BfgsVerification.AlgebraicSeed.M = BfgsVerification.AlgebraicSeed.J⁻¹ ∧
    (BfgsVerification.AffineProjection.matrixCLM BfgsVerification.AlgebraicSeed.M).comp
          (fderiv ℝ BfgsVerification.AlgebraicSeed.P BfgsVerification.AlgebraicSeed.center) =
        ContinuousLinearMap.id ℝ (BfgsVerification.Vec 2) ∧
      ‖Matrix.mulVec BfgsVerification.AlgebraicSeed.M
              (BfgsVerification.AlgebraicSeed.P BfgsVerification.AlgebraicSeed.center)‖ <
          1 / 10 ^ 50 ∧
        sSup
            ((fun z =>
                ‖ContinuousLinearMap.id ℝ (BfgsVerification.Vec 2) -
                    (BfgsVerification.AffineProjection.matrixCLM BfgsVerification.AlgebraicSeed.M).comp
                      (fderiv ℝ BfgsVerification.AlgebraicSeed.P z)‖) ''
              {z | ‖z - BfgsVerification.AlgebraicSeed.center‖ ≤ BfgsVerification.AlgebraicSeed.radius}) <
          1 / 10 ^ 26
def BfgsVerification.NuclearBoundaryTarget : Prop :=
∀ {K : Set (BfgsVerification.Vec 3)},
  K ∈ nhds BfgsVerification.NuclearSymmetric2.minimizer →
    ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.NuclearSymmetric2.objective K
        BfgsVerification.NuclearSymmetric2.minimizer
def BfgsVerification.FixedNormalHyperplaneTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)
  {Ω : Set (BfgsVerification.Vec n)},
  IsOpen Ω →
    IsCompact R.initialSublevel →
      R.initialSublevel ⊆ Ω →
        ∀ {μ : ℝ},
          0 < μ →
            BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →
              ∀ {a : BfgsVerification.Vec n},
                BfgsVerification.sqNorm a = 1 →
                  ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},
                    (∀ x ∈ Ω,
                        ∀ (g : BfgsVerification.Vec n),
                          BfgsVerification.Homogeneous.Supports F x g →
                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →
                      ∀ {L : NNReal},
                        LipschitzOnWith L A Ω →
                          BfgsVerification.CenteredSmoothSublinear.LocallyC11On
                              (BfgsVerification.FixedNormal.regularRegion Ω a b {0}) F →
                            ∀ (star : BfgsVerification.Vec n),
                              (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →
                                (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →
                                  BfgsVerification.dot a star = b →
                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                      Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.ParallelInterfacesClusterTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)
  {Ω : Set (BfgsVerification.Vec n)},
  IsOpen Ω →
    IsCompact R.initialSublevel →
      R.initialSublevel ⊆ Ω →
        ∀ {μ : ℝ},
          0 < μ →
            BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →
              ∀ {a : BfgsVerification.Vec n},
                BfgsVerification.sqNorm a = 1 →
                  ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},
                    (∀ x ∈ Ω,
                        ∀ (g : BfgsVerification.Vec n),
                          BfgsVerification.Homogeneous.Supports F x g →
                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →
                      ∀ {L : NNReal},
                        LipschitzOnWith L A Ω →
                          ∀ {E : Set ℝ},
                            IsClosed E →
                              BfgsVerification.CenteredSmoothSublinear.LocallyC11On
                                  (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →
                                (∀ p ∈ Ω,
                                    BfgsVerification.FixedNormal.normalCoordinate a b p ∈ E → ¬DifferentiableAt ℝ F p) →
                                  ∃ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,
                                    0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p)
def BfgsVerification.ParallelInterfacesConvergenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)
  {Ω : Set (BfgsVerification.Vec n)},
  IsOpen Ω →
    IsCompact R.initialSublevel →
      R.initialSublevel ⊆ Ω →
        ∀ {μ : ℝ},
          0 < μ →
            BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →
              ∀ {a : BfgsVerification.Vec n},
                BfgsVerification.sqNorm a = 1 →
                  ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},
                    (∀ x ∈ Ω,
                        ∀ (g : BfgsVerification.Vec n),
                          BfgsVerification.Homogeneous.Supports F x g →
                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →
                      ∀ {L : NNReal},
                        LipschitzOnWith L A Ω →
                          ∀ {E : Set ℝ},
                            IsClosed E →
                              BfgsVerification.CenteredSmoothSublinear.LocallyC11On
                                  (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →
                                (∀ p ∈ Ω,
                                    BfgsVerification.FixedNormal.normalCoordinate a b p ∈ E → ¬DifferentiableAt ℝ F p) →
                                  (∀ p ∈ R.initialSublevel,
                                      0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p) →
                                        BfgsVerification.Homogeneous.Supports F p 0) →
                                    ∀ (star : BfgsVerification.Vec n),
                                      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →
                                        Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                          Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F))
                                              Filter.atTop (nhds 0) ∧
                                            ((∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →
                                              Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.FixedNormalLocalBasinTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →
        (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →
          ∀ {Ω : Set (BfgsVerification.Vec n)},
            IsOpen Ω →
              star ∈ Ω →
                ∀ {μ : ℝ},
                  0 < μ →
                    BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →
                      ∀ {a : BfgsVerification.Vec n},
                        BfgsVerification.sqNorm a = 1 →
                          ∀ (b : ℝ),
