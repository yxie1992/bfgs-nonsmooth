BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.euclidean_residual_fullBFGS_step_exists","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  Differentiable ℝ ψ →\n    ∀ (A : (i : ι) → BfgsVerification.Vec n →L[ℝ] EuclideanSpace ℝ (Fin (m i)))\n      (b : (i : ι) → EuclideanSpace ℝ (Fin (m i))),\n      (∀ (z : BfgsVerification.Vec n), F z = ψ z + ∑ i, ‖BfgsVerification.EuclideanResidual.residual (A i) (b i) z‖) →\n        ConvexOn ℝ Set.univ F →\n          ∀ (x g : BfgsVerification.Vec n) (H : BfgsVerification.Mat n),\n            Matrix.PosDef H →\n              g ≠ 0 →\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                  ∀ {c₁ c₂ : ℝ},\n                    0 < c₁ →\n                      c₁ < c₂ →\n                        c₂ < 1 →\n                          ∀ (L : ℝ),\n                            (∀ (t : ℝ), 0 ≤ t → L ≤ F (x + BfgsVerification.bfgsStep H g t)) →\n                              ∃ α h,\n                                0 < α ∧\n                                  HasFDerivAt F (BfgsVerification.gradientFunctional h)\n                                      (x + BfgsVerification.bfgsStep H g α) ∧\n                                    F (x + BfgsVerification.bfgsStep H g α) <\n                                        F x + c₁ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ∧\n                                      c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) <\n                                        BfgsVerification.dot h (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_projection_form","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  α ≠ 0 →\n    BfgsVerification.metricEnergy H g ≠ 0 →\n      -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g ≠ 0 →\n        let q := BfgsVerification.metricEnergy H g;\n        let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n        let v := Matrix.mulVec H g;\n        BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y =\n          (1 + (β * q)⁻¹ • BfgsVerification.outer v y) * H * (1 + (β * q)⁻¹ • BfgsVerification.outer y v) +\n            (α / (β * q)) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
