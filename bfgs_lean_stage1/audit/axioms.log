BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.exists_log_transported_planar_field","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n  IsCompact R.initialSublevel →\n    ∀ {ℓ : ℝ},\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        (∃ y, F y < ℓ) →\n          (∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n            (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F p) →\n              (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                  ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p) →\n                ∃ W,\n                  (∃ N η,\n                      0 < η ∧\n                        IsOpen N ∧\n                          BfgsVerification.ClusterSetGeometry.clusterSet R.x ⊆ N ∧\n                            (∀ p ∈ N, ∃ L, ∃ U ∈ nhds p, LipschitzOnWith L W U) ∧\n                              ∀ p ∈ N,\n                                ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                                  η ≤ BfgsVerification.dot g (W p)) ∧\n                    ∃ C,\n                      0 ≤ C ∧\n                        ∃ J,\n                          ∀ (k : ℕ),\n                            J ≤ k →\n                              ∃ lam β,\n                                0 < lam ∧\n                                  W (R.x (k + 1)) = lam • W (R.x k) + β • R.displacement k ∧ |Real.log lam| ≤ C * R.d k","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PlanarAllPairs.compact_pair_transversality","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {c₁ c₂ : ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {Q : Set (BfgsVerification.Vec 2)},\n      IsCompact Q →\n        c₂ < 1 →\n          ∀ (W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2),\n            (∀ p ∈ Q, ContinuousAt W p) →\n              (∀ p ∈ Q,\n                  ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p, 0 < BfgsVerification.dot a (W p)) →\n                (∀ p ∈ Q,\n                    ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                      ∀ b ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                        BfgsVerification.dot a (W p) = BfgsVerification.dot b (W p)) →\n                  ∃ κ,\n                    0 < κ ∧\n                      ∃ δ,\n                        0 < δ ∧\n                          ∀ x ∈ Q,\n                            ∀ z ∈ Q,\n                              ∀ (g h : BfgsVerification.Vec 2),\n                                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                                  ‖z - x‖ < δ →\n                                    ∀ θ ∈ Set.Icc 0 1,\n                                      κ ≤\n                                        |BfgsVerification.HomogeneousPlanar.pairDet\n                                            (BfgsVerification.PlanarNormalGeometry.normalized (z - x))\n                                            (W (x + θ • (z - x)))|","axioms":["propext","Classical.choice","Quot.sound"]}
