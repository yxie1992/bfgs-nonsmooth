BFGS_AUDIT {"theorem":"BfgsVerification.CenteredSmoothSublinear.correction_le_of_split","signature":"∀ {n : ℕ} (u v r s : BfgsVerification.Vec n) (L G R : ℝ),\n  0 < L →\n    0 ≤ G →\n      0 ≤ R →\n        BfgsVerification.sqNorm u ≤ L * BfgsVerification.dot u s →\n          0 ≤ BfgsVerification.dot v r ∧ BfgsVerification.dot v r ≤ BfgsVerification.dot v s →\n            BfgsVerification.sqNorm v ≤ (2 * G) ^ 2 →\n              BfgsVerification.sqNorm r ≤ R ^ 2 →\n                0 < BfgsVerification.dot (u + v) s →\n                  BfgsVerification.dot (u + v) r ^ 2 / BfgsVerification.dot (u + v) s ≤ L * R ^ 2 + 2 * G * R","axioms":["propext","Classical.choice","Quot.sound"]}
