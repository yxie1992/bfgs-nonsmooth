BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.affine_critical_iff_tangent_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x a A : BfgsVerification.Vec n},\n      (∀ (g : BfgsVerification.Vec n),\n          BfgsVerification.Homogeneous.Supports F x g → BfgsVerification.FixedNormal.tangentProjection a g = A) →\n        ¬DifferentiableAt ℝ F x →\n          (0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F x) ↔ A = 0)","axioms":["propext","Classical.choice","Quot.sound"]}
