BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.composite_secant_curvature_dominates","signature":"∀ {n : ℕ} {F ψ : BfgsVerification.Vec n → ℝ} {h : ℝ → ℝ},\n  ConvexOn ℝ Set.univ h →\n    ∀ {Ω : Set (BfgsVerification.Vec n)},\n      IsOpen Ω →\n        ∀ (a : BfgsVerification.Vec n) (b : ℝ),\n          (∀ y ∈ Ω, F y = ψ y + h (BfgsVerification.FixedNormal.normalCoordinate a b y)) →\n            ∀ {x z g g' p p' : BfgsVerification.Vec n},\n              x ∈ Ω →\n                z ∈ Ω →\n                  BfgsVerification.Homogeneous.Supports F x g →\n                    BfgsVerification.Homogeneous.Supports F z g' →\n                      HasFDerivAt ψ (BfgsVerification.gradientFunctional p) x →\n                        HasFDerivAt ψ (BfgsVerification.gradientFunctional p') z →\n                          BfgsVerification.dot (p' - p) (z - x) ≤ BfgsVerification.dot (g' - g) (z - x)","axioms":["propext","Classical.choice","Quot.sound"]}
