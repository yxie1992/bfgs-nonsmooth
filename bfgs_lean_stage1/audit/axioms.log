BFGS_AUDIT {"theorem":"BfgsVerification.AnalyticStableGraph.exists_smooth_locally_invariant_graph","signature":"∀ {S : Type u_1} {U : Type u_2} [inst : NormedAddCommGroup S] [inst_1 : NormedSpace ℝ S] [inst_2 : CompleteSpace S]\n  [inst_3 : NormedAddCommGroup U] [inst_4 : NormedSpace ℝ U] [inst_5 : CompleteSpace U] (A : S →L[ℝ] S) (L : U ≃L[ℝ] U)\n  (T : S × U → S × U),\n  AnalyticAt ℝ T 0 →\n    T 0 = 0 →\n      HasFDerivAt T (A.prodMap ↑L) 0 →\n        ‖A‖ < 1 →\n          ‖↑L.symm‖ < 1 →\n            ∀ {r : ℝ},\n              0 < r →\n                ∃ h V,\n                  IsOpen V ∧\n                    0 ∈ V ∧\n                      h 0 = 0 ∧\n                        ContDiffOn ℝ (↑⊤) h V ∧\n                          HasFDerivAt h 0 0 ∧\n                            (∀ a ∈ V,\n                                ∃ w,\n                                  w 0 = (a, h a) ∧\n                                    (∀ (n : ℕ), ‖w n‖ ≤ r) ∧\n                                      Filter.Tendsto w Filter.atTop (nhds 0) ∧ ∀ (n : ℕ), w (n + 1) = T (w n)) ∧\n                              ∃ V₀, IsOpen V₀ ∧ 0 ∈ V₀ ∧ V₀ ⊆ V ∧ ∀ a ∈ V₀, ∃ b ∈ V, T (a, h a) = (b, h b)","axioms":["propext","Classical.choice","Quot.sound"]}
