BFGS_AUDIT {"theorem":"BfgsVerification.PlanarMaxRegular.finite_max_hessian_local_basin","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 2),\n      (∀ (x : BfgsVerification.Vec 2), F star ≤ F x) →\n        (∀ (x : BfgsVerification.Vec 2), F x = F star → x = star) →\n          ∀ {m : ℕ} {f : Fin m → BfgsVerification.Vec 2 → ℝ} {U : Set (BfgsVerification.Vec 2)},\n            IsOpen U →\n              star ∈ U →\n                (∀ (i : Fin m), ConvexOn ℝ U (f i) ∧ ContDiffOn ℝ 2 (f i) U) →\n                  BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f star →\n                    (AffineIndependent ℝ fun i =>\n                        BfgsVerification.coordinateGradient\n                          (f (BfgsVerification.ConvexSubdifferential.activeIndexMap F f star i)) star) →\n                      ∀ (w : BfgsVerification.Vec (BfgsVerification.ConvexSubdifferential.activeIndices F f star).card),\n                        (∀ (i : Fin (BfgsVerification.ConvexSubdifferential.activeIndices F f star).card), 0 < w i) →\n                          ∑ i, w i = 1 →\n                            ∑ i,\n                                  w i •\n                                    BfgsVerification.coordinateGradient\n                                      (f (BfgsVerification.ConvexSubdifferential.activeIndexMap F f star i)) star =\n                                0 →\n                              ∀ {μ : ℝ},\n                                0 < μ →\n                                  (∀ (i : Fin (BfgsVerification.ConvexSubdifferential.activeIndices F f star).card),\n                                      ∀ x ∈ U,\n                                        Matrix.PosSemidef\n                                          (BfgsVerification.RadialHessian.matrix\n                                              (f (BfgsVerification.ConvexSubdifferential.activeIndexMap F f star i)) x -\n                                            μ • 1)) →\n                                    ∃ ε,\n                                      0 < ε ∧\n                                        ∀ (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n                                          F (R.x 0) < F star + ε →\n                                            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                              Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.planar_local_basin_of_finite_critical_values","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    (F '' {x | BfgsVerification.AffineCriticalObjective.IsAffineCritical F x}).Finite →\n      ∀ (star : BfgsVerification.Vec 2),\n        (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →\n          (∀ (z : BfgsVerification.Vec 2), F z = F star → z = star) →\n            ∀ {Ω : Set (BfgsVerification.Vec 2)},\n              IsOpen Ω →\n                star ∈ Ω →\n                  (∀ p ∈ Ω,\n                      ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →\n                        ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p) →\n                    ∀ {b : ℝ},\n                      F star < b →\n                        (∀ (ℓ : ℝ),\n                            F star < ℓ →\n                              ℓ ≤ b →\n                                ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n                          ∃ ε,\n                            0 < ε ∧\n                              ∀ (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n                                F (R.x 0) < F star + ε →\n                                  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                    Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
