BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.orderedCylindricalCell_semialgebraicPiecewiseSmoothConnected","signature":"∀ {σ : Type u_1} [inst : Fintype σ] {r : ℕ} (S : Set (σ → ℝ)) (f : Fin r → (σ → ℝ) → ℝ),\n  BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic S →\n    BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothConnected S →\n      (∀ (i : Fin r), ContDiffOn ℝ (↑⊤) (f i) S) →\n        (∀ x ∈ S, StrictMono fun i => f i x) →\n          (∀ (i : Fin r),\n              BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n                {v | (fun k => v (some k)) ∈ S ∧ v none = f i fun k => v (some k)}) →\n            ∀ (i : Fin r ⊕ Fin (r + 1)),\n              BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothConnected\n                {v |\n                  (fun k => v (some k), v none) ∈ BfgsVerification.RealAlgebraicGeometry.orderedCylindricalCell S f i}","axioms":["propext","Classical.choice","Quot.sound"]}
