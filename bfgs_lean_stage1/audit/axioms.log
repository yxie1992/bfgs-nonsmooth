       D *\n              BfgsVerification.dot\n                (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) (z - x))\n  (radius_1 : ℝ) (radius_pos_1 : 0 < radius_1) (L_1 G_1 H_1 B_1 A_1 D_1 : ℝ) (L_nonneg_1 : 0 ≤ L_1)\n  (G_nonneg_1 : 0 ≤ G_1) (H_nonneg_1 : 0 ≤ H_1) (B_nonneg_1 : 0 ≤ B_1) (A_pos_1 : 0 < A_1) (D_pos_1 : 0 < D_1)\n  (representation_1 : ∀ x ∈ Metric.closedBall c radius_1, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x)\n  (differentiable_1 : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius_1, DifferentiableAt ℝ (f i) x)\n  (gradLip_1 :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius_1,\n        ∀ z ∈ Metric.closedBall c radius_1,\n          ‖BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x‖ ≤ L_1 * ‖z - x‖)\n  (fieldBound_1 : ∀ x ∈ Metric.closedBall c radius_1, ‖W x‖ ≤ G_1)\n  (gradBound_1 : ∀ (i : Fin 2), ∀ x ∈ Metric.closedBall c radius_1, ‖BfgsVerification.coordinateGradient (f i) x‖ ≤ H_1)\n  (fieldLip_1 : ∀ x ∈ Metric.closedBall c radius_1, ∀ z ∈ Metric.closedBall c radius_1, ‖W z - W x‖ ≤ B_1 * ‖z - x‖)\n  (common_1 :\n    ∀ p ∈ Metric.closedBall c radius_1,\n      ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n        ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n          BfgsVerification.dot g (W p) = BfgsVerification.dot h (W p))\n  (pair_1 :\n    ∀ x ∈ Metric.closedBall c radius_1,\n      ∀ (v : BfgsVerification.Vec 2),\n        ‖v‖ ≤\n          A_1 *\n            (|BfgsVerification.dot (BfgsVerification.coordinateGradient (f 0) x) v| +\n              |BfgsVerification.dot (BfgsVerification.coordinateGradient (f 1) x) v|))\n  (cocoercive_1 :\n    ∀ (i : Fin 2),\n      ∀ x ∈ Metric.closedBall c radius_1,\n        ∀ z ∈ Metric.closedBall c radius_1,\n          BfgsVerification.sqNorm\n              (BfgsVerification.coordinateGradient (f i) z - BfgsVerification.coordinateGradient (f i) x) ≤\n