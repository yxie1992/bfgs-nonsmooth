BFGS_AUDIT {"theorem":"BfgsVerification.RootClusterConservation.fiber_singleton_of_card_eq","signature":"∀ {α : Type u_1} {β : Type u_2} [inst : DecidableEq α] [inst : DecidableEq β] {s : Finset α} {t : Finset β} {c : α → β}\n  {w : α → ℕ} {m : β → ℕ},\n  (∀ a ∈ s, c a ∈ t) →\n    (∀ b ∈ t, 0 < m b) →\n      (∀ b ∈ t, BfgsVerification.RootClusterConservation.fiberWeight s c w b ≤ m b) →\n        ∑ a ∈ s, w a = ∑ b ∈ t, m b → s.card = t.card → ∀ {a : α}, a ∈ s → {a' ∈ s | c a' = c a} = {a}","axioms":["propext","Classical.choice","Quot.sound"]}
