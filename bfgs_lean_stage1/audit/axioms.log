BFGS_AUDIT {"theorem":"BfgsVerification.AnalyticStableGraph.stable_set_eq_range","signature":"∀ {S : Type u_1} {U : Type u_2} {X : Type u_3} [inst : NormedAddCommGroup S] [inst_1 : NormedSpace ℝ S]\n  [inst_2 : CompleteSpace S] [inst_3 : NormedAddCommGroup U] [inst_4 : NormedSpace ℝ U] [inst_5 : CompleteSpace U]\n  [inst_6 : NormedAddCommGroup X] [inst_7 : NormedSpace ℝ X] [inst_8 : CompleteSpace X] (F : X →L[ℝ] X)\n  (E : (S × U) ≃L[ℝ] X) (A : S →L[ℝ] S) (L : U ≃L[ℝ] U),\n  ‖A‖ < 1 →\n    ‖↑L.symm‖ < 1 →\n      F.comp ↑E = (↑E).comp (A.prodMap ↑L) →\n        BfgsVerification.AnalyticStableGraph.linearStableSet F = Set.range fun a => E (a, 0)","axioms":["propext","Classical.choice","Quot.sound"]}
