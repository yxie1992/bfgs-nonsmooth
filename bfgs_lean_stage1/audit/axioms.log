              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
def BfgsVerification.AdmissibleBFGSRun.hessian : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Mat n :=
fun {n} {F} R k => (R.H k)⁻¹
def BfgsVerification.AdmissibleBFGSRun.displacement : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Vec n :=
fun {n} {F} R k => BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)
def BfgsVerification.AdmissibleBFGSRun.gradientChange : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → BfgsVerification.Vec n :=
fun {n} {F} R k => R.g (k + 1) - R.g k
def BfgsVerification.AdmissibleBFGSRun.curvature : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → ℕ → ℝ :=
fun {n} {F} R k => BfgsVerification.dot (R.gradientChange k) (R.displacement k)
def BfgsVerification.AdmissibleBFGSRun.referenceEnergy : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.metricEnergy (R.hessian k) (R.x k - xstar)
def BfgsVerification.AdmissibleBFGSRun.referencePairing : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.dot (R.g k) (R.x k - xstar)
def BfgsVerification.AdmissibleBFGSRun.referenceCorrection : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℕ → ℝ :=
fun {n} {F} R xstar k => BfgsVerification.dot (R.gradientChange k) (R.x (k + 1) - xstar) ^ 2 / R.curvature k
def BfgsVerification.EnergyIdentities.rectOuter : {n r : ℕ} →
  BfgsVerification.Vec n → BfgsVerification.Vec r → Matrix (Fin n) (Fin r) ℝ :=
fun {n r} s b i j => s i * b j
def BfgsVerification.FrameBounds.OperatorSqBound : {r : ℕ} → BfgsVerification.Mat r → ℝ → Prop :=
fun {r} T a =>
  ∀ (v : BfgsVerification.Vec r),
    BfgsVerification.sqNorm ((Matrix.transpose T).mulVec v) ≤ a * BfgsVerification.sqNorm v
def BfgsVerification.FrameNorms.euclideanOpNorm : {r : ℕ} → BfgsVerification.Mat r → ℝ :=
fun {r} T => ‖Matrix.toEuclideanCLM T‖
def BfgsVerification.SmoothSubspace.frobSq : {n r : ℕ} → Matrix (Fin n) (Fin r) ℝ → ℝ :=
fun {n r} W => ∑ i, ∑ j, W i j ^ 2
structure BfgsVerification.ExactFrameCertificate {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) : Type
number of parameters: 3
fields:
  BfgsVerification.ExactFrameCertificate.J : ℕ
  BfgsVerification.ExactFrameCertificate.r : ℕ
  BfgsVerification.ExactFrameCertificate.V : ℕ → Matrix (Fin n) (Fin self.r) ℝ
  BfgsVerification.ExactFrameCertificate.T : ℕ → BfgsVerification.Mat self.r
  BfgsVerification.ExactFrameCertificate.P : ℕ → BfgsVerification.Mat self.r
  BfgsVerification.ExactFrameCertificate.b : ℕ → BfgsVerification.Vec self.r
  BfgsVerification.ExactFrameCertificate.m : ℝ
  BfgsVerification.ExactFrameCertificate.K : ℝ
  BfgsVerification.ExactFrameCertificate.L : ℝ
  BfgsVerification.ExactFrameCertificate.C : ℝ
  BfgsVerification.ExactFrameCertificate.m_pos : 0 < self.m
  BfgsVerification.ExactFrameCertificate.K_pos : 0 < self.K
  BfgsVerification.ExactFrameCertificate.L_nonneg : 0 ≤ self.L
  BfgsVerification.ExactFrameCertificate.invertible : ∀ (k : ℕ), self.J ≤ k → Matrix.det (self.P k) ≠ 0
  BfgsVerification.ExactFrameCertificate.product : ∀ (k : ℕ), self.J ≤ k → self.P (k + 1) = self.P k * self.T k
  BfgsVerification.ExactFrameCertificate.transport : ∀ (k : ℕ),
      self.J ≤ k →
        self.V (k + 1) = self.V k * self.T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (self.b k)
  BfgsVerification.ExactFrameCertificate.visible : ∀ (k : ℕ),
      self.J ≤ k → self.m ≤ BfgsVerification.sqNorm ((self.V k).transpose.mulVec (R.g k))
  BfgsVerification.ExactFrameCertificate.correction : ∀ (k : ℕ),
      self.J ≤ k →
        BfgsVerification.sqNorm ((self.V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ self.C
  BfgsVerification.ExactFrameCertificate.product_bound : ∀ (k : ℕ),
      self.J ≤ k →
        ∀ (v : Fin self.r → ℝ),
          BfgsVerification.sqNorm ((Matrix.transpose (self.P k)).mulVec v) ≤ self.K * BfgsVerification.sqNorm v
  BfgsVerification.ExactFrameCertificate.inverse_bound : ∀ (k : ℕ),
      self.J ≤ k →
        ∀ (v : Fin self.r → ℝ),
          BfgsVerification.sqNorm ((self.P k)⁻¹.transpose.mulVec v) ≤ self.L * BfgsVerification.sqNorm v
constructor:
  BfgsVerification.ExactFrameCertificate.mk {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
    {R : BfgsVerification.AdmissibleBFGSRun n F} (J r : ℕ) (V : ℕ → Matrix (Fin n) (Fin r) ℝ)
    (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r) (m K L C : ℝ) (m_pos : 0 < m) (K_pos : 0 < K)
    (L_nonneg : 0 ≤ L) (invertible : ∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0)
    (product : ∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k)
    (transport :
      ∀ (k : ℕ), J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k))
    (visible : ∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k)))
    (correction :
      ∀ (k : ℕ),
        J ≤ k → BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C)
    (product_bound :
      ∀ (k : ℕ),
        J ≤ k →
          ∀ (v : Fin r → ℝ),
            BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v)
    (inverse_bound :
      ∀ (k : ℕ),
        J ≤ k →
          ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) :
    BfgsVerification.ExactFrameCertificate R
structure BfgsVerification.ResidualFrameCertificate {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) : Type
number of parameters: 3
fields:
  BfgsVerification.ResidualFrameCertificate.J : ℕ
  BfgsVerification.ResidualFrameCertificate.r : ℕ
  BfgsVerification.ResidualFrameCertificate.p : ℕ
  BfgsVerification.ResidualFrameCertificate.U : Matrix (Fin n) (Fin self.r) ℝ
  BfgsVerification.ResidualFrameCertificate.orthonormal : self.U.transpose * self.U = 1
  BfgsVerification.ResidualFrameCertificate.L : ℝ
  BfgsVerification.ResidualFrameCertificate.m : ℝ
  BfgsVerification.ResidualFrameCertificate.C₀ : ℝ
  BfgsVerification.ResidualFrameCertificate.C_T : ℝ
  BfgsVerification.ResidualFrameCertificate.C_R : ℝ
  BfgsVerification.ResidualFrameCertificate.m_pos : 0 < self.m
  BfgsVerification.ResidualFrameCertificate.V : ℕ → Matrix (Fin n) (Fin self.p) ℝ
  BfgsVerification.ResidualFrameCertificate.Z : ℕ → Matrix (Fin n) (Fin self.p) ℝ
  BfgsVerification.ResidualFrameCertificate.T : ℕ → BfgsVerification.Mat self.p
  BfgsVerification.ResidualFrameCertificate.b : ℕ → BfgsVerification.Vec self.p
  BfgsVerification.ResidualFrameCertificate.smooth : ∀ (k : ℕ),
      BfgsVerification.sqNorm (self.U.transpose.mulVec ((R.shift self.J).gradientChange k)) ≤
        self.L * (R.shift self.J).curvature k
  BfgsVerification.ResidualFrameCertificate.visible : ∀ (k : ℕ),
      self.m ≤ BfgsVerification.sqNorm ((self.V k).transpose.mulVec ((R.shift self.J).g k))
  BfgsVerification.ResidualFrameCertificate.correction : ∀ (k : ℕ),
      BfgsVerification.sqNorm ((self.V (k + 1)).transpose.mulVec ((R.shift self.J).gradientChange k)) ≤
        self.C₀ * (R.shift self.J).curvature k
  BfgsVerification.ResidualFrameCertificate.transport : ∀ (k : ℕ),
      self.V (k + 1) =
        self.V k * self.T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift self.J).displacement k) (self.b k) +
          self.Z k
  BfgsVerification.ResidualFrameCertificate.operator_bound : ∀ (k : ℕ),
      BfgsVerification.FrameBounds.OperatorSqBound (self.T k) (1 + self.C_T * (R.shift self.J).d k)
  BfgsVerification.ResidualFrameCertificate.residual_range : ∀ (k : ℕ), self.U * self.U.transpose * self.Z k = self.Z k
  BfgsVerification.ResidualFrameCertificate.residual_size : ∀ (k : ℕ),
      BfgsVerification.SmoothSubspace.frobSq (self.Z k) ≤ self.C_R * (R.shift self.J).d k
constructor:
  BfgsVerification.ResidualFrameCertificate.mk {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
    {R : BfgsVerification.AdmissibleBFGSRun n F} (J r p : ℕ) (U : Matrix (Fin n) (Fin r) ℝ)
    (orthonormal : U.transpose * U = 1) (L m C₀ C_T C_R : ℝ) (m_pos : 0 < m) (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ)
    (T : ℕ → BfgsVerification.Mat p) (b : ℕ → BfgsVerification.Vec p)
    (smooth :
      ∀ (k : ℕ),
        BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k)
    (visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k)))
    (correction :
      ∀ (k : ℕ),
        BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤
          C₀ * (R.shift J).curvature k)
    (transport :
      ∀ (k : ℕ),
        V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k)
    (operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k))
    (residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k)
    (residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) :
    BfgsVerification.ResidualFrameCertificate R
def BfgsVerification.HessianInvariantTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),
  R.hessian (k + 1) =
      R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k) +
        (R.curvature k)⁻¹ • BfgsVerification.outer (R.gradientChange k) (R.gradientChange k) ∧
    Matrix.PosSemidef (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) ∧
      Matrix.mulVec (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) (R.displacement k) = 0 ∧
        Matrix.det (R.H (k + 1)) = R.α k / R.beta k * Matrix.det (R.H k)
def BfgsVerification.LocalizationTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ),
  ConvexOn ℝ Set.univ F →
    ∀ (xstar : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F xstar ≤ F x) →
        (∀ (x : BfgsVerification.Vec n), F x = F xstar → x = xstar) →
          (∀ (a : ℝ), IsCompact {x | F x ≤ a}) ∧ ∀ U ∈ nhds xstar, ∃ δ, 0 < δ ∧ {x | F x ≤ F xstar + δ} ⊆ U
def BfgsVerification.StrictContourTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F),
  IsCompact R.initialSublevel →
    ∀ (ℓ : ℝ),
      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →
        (∃ z, F z < ℓ) →
          (∀ (x z : BfgsVerification.Vec n), segment ℝ x z ⊆ frontier {w | F w ≤ ℓ} → x = z) →
            Filter.Tendsto R.displacement Filter.atTop (nhds 0)
def BfgsVerification.ReferenceEnergyTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F)
  (xstar : BfgsVerification.Vec n),
  (∀ (k : ℕ),
      R.referenceEnergy xstar (k + 1) =
        R.referenceEnergy xstar k - R.referencePairing xstar k ^ 2 / R.q k + R.referenceCorrection xstar k) ∧
    ((∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →
      ∀ (N : ℕ),
        (F (R.x N) - F xstar) ^ 2 * ∑ k ∈ Finset.range N, (R.q k)⁻¹ ≤
          R.referenceEnergy xstar 0 + ∑ k ∈ Finset.range N, R.referenceCorrection xstar k)
def BfgsVerification.QuadraticCorrectionTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F)
  (xstar : BfgsVerification.Vec n),
  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →
    (∀ (z : BfgsVerification.Vec n), F z = F xstar → z = xstar) →
      ∀ (C : ℝ),
        (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection xstar k ≤ C * ↑N ^ 2) →
          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar)) ∧
            Filter.Tendsto R.x Filter.atTop (nhds xstar)
def BfgsVerification.MovingFrameCriterionTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F) (G : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      Filter.Tendsto R.d Filter.atTop (nhds 0) → ¬Nonempty (BfgsVerification.ExactFrameCertificate R)
def BfgsVerification.ResidualFrameCriterionTarget : Prop :=
∀ (n : ℕ) (F : BfgsVerification.Vec n → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n F) (G : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      Summable R.d → ¬Nonempty (BfgsVerification.ResidualFrameCertificate R)
@BfgsVerification.Localization.sphere_gap : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] [inst_3 : Nontrivial E] {F : E → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (xStar : E),
      (∀ (x : E), F xStar ≤ F x) →
        (∀ (x : E), F x = F xStar → x = xStar) →
          ∀ {r : ℝ},
            0 < r →
              ∃ ω, 0 < ω ∧ (∃ z, dist z xStar = r ∧ F z - F xStar = ω) ∧ ∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar
@BfgsVerification.Localization.radial_lower_bound : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] {F : E → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {xStar : E} {r ω : ℝ},
      0 < r →
        (∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar) →
          ∀ {x : E}, r ≤ dist x xStar → dist x xStar / r * ω ≤ F x - F xStar
@BfgsVerification.AdmissibleBFGSRun.objective_tendsto_min_of_negligible_corrections : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n),
  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →
    ∀ (G : ℝ),
      0 < G →
        (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
          Filter.Tendsto
              (fun N => (∑ k ∈ Finset.range N, R.referenceCorrection xstar k) / ∑ k ∈ Finset.range N, (R.q k)⁻¹)
              Filter.atTop (nhds 0) →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))
@BfgsVerification.AdmissibleBFGSRun.objective_tendsto_min_of_quadratic_corrections : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n),
  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →
    ∀ (G : ℝ),
      0 < G →
        (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
          ∀ (C : ℝ),
            (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection xstar k ≤ C * ↑N ^ 2) →
              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))
@BfgsVerification.AdmissibleBFGSRun.moving_frame_energy : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (k : ℕ) (V W : Matrix (Fin n) (Fin r) ℝ)
  (T : BfgsVerification.Mat r) (b : BfgsVerification.Vec r),
  W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b →
    BfgsVerification.metricGram (R.hessian (k + 1)) W =
      Matrix.transpose T *
            (BfgsVerification.metricGram (R.hessian k) V -
              (R.q k)⁻¹ • BfgsVerification.outer (V.transpose.mulVec (R.g k)) (V.transpose.mulVec (R.g k))) *
          T +
        (R.curvature k)⁻¹ •
          BfgsVerification.outer (W.transpose.mulVec (R.gradientChange k)) (W.transpose.mulVec (R.gradientChange k))
@BfgsVerification.AdmissibleBFGSRun.moving_frame_tail_criterion : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (J : ℕ) (V : ℕ → Matrix (Fin n) (Fin r) ℝ)
  (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),
  (∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0) →
    (∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k) →
      (∀ (k : ℕ),
          J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →
        ∀ (m K L C : ℝ),
          0 < m →
            0 < K →
              0 ≤ L →
                (∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →
                  (∀ (k : ℕ),
                      J ≤ k →
                        BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤
                          C) →
                    (∀ (k : ℕ),
                        J ≤ k →
                          ∀ (v : Fin r → ℝ),
                            BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤
                              K * BfgsVerification.sqNorm v) →
                      (∀ (k : ℕ),
                          J ≤ k →
                            ∀ (v : Fin r → ℝ),
                              BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →
                        ∀ (G : ℝ),
                          0 < G →
                            (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
                              Filter.Tendsto R.d Filter.atTop (nhds 0) → False
@BfgsVerification.AdmissibleBFGSRun.residual_frames_on_tail_incompatible_source : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (J : ℕ) (G : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      Summable R.d →
        ∀ (U : Matrix (Fin n) (Fin r) ℝ),
          U.transpose * U = 1 →
            ∀ (L m C₀ C_T C_R : ℝ),
              0 < m →
                (∀ (k : ℕ),
                    BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤
                      L * (R.shift J).curvature k) →
                  ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)
                    (b : ℕ → BfgsVerification.Vec p),
                    (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))) →
                      (∀ (k : ℕ),
                          BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤
                            C₀ * (R.shift J).curvature k) →
                        (∀ (k : ℕ),
                            V (k + 1) =
                              V k * T k +
                                  BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) +
                                Z k) →
                          (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)) →
                            (∀ (k : ℕ), U * U.transpose * Z k = Z k) →
                              (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) → False
@BfgsVerification.FrameNorms.operatorSqBound_iff_opNorm_sq : ∀ {r : ℕ} (T : BfgsVerification.Mat r) (a : ℝ),
  0 ≤ a → (BfgsVerification.FrameBounds.OperatorSqBound T a ↔ BfgsVerification.FrameNorms.euclideanOpNorm T ^ 2 ≤ a)
@BfgsVerification.FrameNorms.orthonormal_matrix_for_subspace : ∀ {n : ℕ} (S : Submodule ℝ (EuclideanSpace ℝ (Fin n))),
  ∃ U, U.transpose * U = 1 ∧ ∀ (x : EuclideanSpace ℝ (Fin n)), x ∈ S ↔ ∃ a, U.mulVec a = fun i => x i

exit_code=0
