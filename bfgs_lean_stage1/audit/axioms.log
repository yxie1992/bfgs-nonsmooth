BFGS_AUDIT {"theorem":"BfgsVerification.AffineCertificate.projected_transport_covariant","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 →\n    ∀ (W Z : BfgsVerification.Mat n),\n      Matrix.IsSymm W →\n        Matrix.IsSymm Z →\n          ∀ (s : BfgsVerification.Vec n) (a : ℝ),\n            (a •\n                    (BfgsVerification.TransportedCertificate.stepProjector s * W *\n                      BfgsVerification.TransportedCertificate.stepProjector s) -\n                  BfgsVerification.TransportedCertificate.stepProjector s * Z *\n                    BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef ↔\n              (a •\n                    (BfgsVerification.TransportedCertificate.stepProjector (Matrix.mulVec A s) *\n                        (A * W * Matrix.transpose A) *\n                      BfgsVerification.TransportedCertificate.stepProjector (Matrix.mulVec A s)) -\n                  BfgsVerification.TransportedCertificate.stepProjector (Matrix.mulVec A s) *\n                      (A * Z * Matrix.transpose A) *\n                    BfgsVerification.TransportedCertificate.stepProjector (Matrix.mulVec A s)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.projected_transport_iff_perpendicular","signature":"∀ {n : ℕ} (W Z : BfgsVerification.Mat n),\n  Matrix.IsSymm W →\n    Matrix.IsSymm Z →\n      ∀ (s : BfgsVerification.Vec n) (a : ℝ),\n        (a •\n                (BfgsVerification.TransportedCertificate.stepProjector s * W *\n                  BfgsVerification.TransportedCertificate.stepProjector s) -\n              BfgsVerification.TransportedCertificate.stepProjector s * Z *\n                BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef ↔\n          ∀ (v : BfgsVerification.Vec n),\n            BfgsVerification.dot v s = 0 → BfgsVerification.metricEnergy Z v ≤ a * BfgsVerification.metricEnergy W v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.exists_visible_transverse_planar_field_of_no_affineCritical_cluster","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n  IsCompact R.initialSublevel →\n    ∀ (star : BfgsVerification.Vec 2),\n      (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →\n        (∀ (ℓ : ℝ),\n            F star < ℓ →\n              ℓ ≤ F (R.x 0) → ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n          (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n              ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F p) →\n            (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p) →\n              ∃ W,\n                (∃ η,\n                    0 < η ∧\n                      ∃ N,\n                        IsOpen N ∧\n                          BfgsVerification.ClusterSetGeometry.clusterSet R.x ⊆ N ∧\n                            (∀ p ∈ N, ∃ L, ∃ U ∈ nhds p, LipschitzOnWith L W U) ∧\n                              ∀ p ∈ N,\n                                ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                                  η ≤ BfgsVerification.dot g (W p)) ∧\n                  ∃ κ,\n                    0 < κ ∧\n                      ∃ J,\n                        ∀ (k : ℕ),\n                          J ≤ k →\n                            ∀ θ ∈ Set.Icc 0 1,\n                              κ * ‖BfgsVerification.euclideanVector (R.displacement k)‖ ≤\n                                |BfgsVerification.HomogeneousPlanar.pairDet (R.displacement k)\n                                    (W (R.x k + θ • R.displacement k))|","axioms":["propext","Quot.sound","Classical.choice"]}
