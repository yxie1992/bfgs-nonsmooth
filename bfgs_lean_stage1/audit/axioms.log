BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.PrunedOrder.mk.sizeOf_spec","signature":"∀ {m : ℕ} {P : BfgsVerification.Parabolic.Family m} (count : ℕ) (count_pos : 0 < count) (index : Fin count → Fin m)\n  (essential : ∀ (i : Fin count), P.Essential (index i)) (covers : ∀ (i : Fin m), P.Essential i → ∃ k, index k = i)\n  (slopes_strictMono : StrictMono fun i => P.b (index i)),\n  sizeOf\n      { count := count, count_pos := count_pos, index := index, essential := essential, covers := covers,\n        slopes_strictMono := slopes_strictMono } =\n    1 + sizeOf count + sizeOf count_pos","axioms":["propext","Quot.sound","Classical.choice"]}
