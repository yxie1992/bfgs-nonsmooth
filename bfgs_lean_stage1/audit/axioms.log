BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.det_one_add_smul_conjugate","signature":"∀ {ι : Type u_1} {R : Type u_2} [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : CommRing R] (t : R)\n  (U V H : Matrix ι ι R), U * V = 1 → (1 + t • (U * H * V)).det = (1 + t • H).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.rectOuter_mul","signature":"∀ {n r : ℕ} (s : BfgsVerification.Vec n) (b : BfgsVerification.Vec r) (Q : BfgsVerification.Mat r),\n  BfgsVerification.EnergyIdentities.rectOuter s b * Q =\n    BfgsVerification.EnergyIdentities.rectOuter s ((Matrix.transpose Q).mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.step","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    ∀ (k j : ℕ), 1 ≤ j → j ≤ n → q k * E (k + 1) j ≤ K * E k (j + 1) + δ k * E k j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.rescale._proof_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (lo : ℝ), 0 < lo → 0 < lo * C.m","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.zero_mem_recurrent_affineSpan","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n),\n  (Set.range R.g).Finite →\n    ∀ (c : ℝ),\n      0 < c →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          Filter.Tendsto R.d Filter.atTop (nhds 0) → 0 ∈ affineSpan ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.rankOneCertificate._proof_3","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (v : BfgsVerification.Vec n → BfgsVerification.Vec n) (C δ : ℝ),\n  (∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.dot (h - g) (v z) ^ 2 ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h) →\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (BfgsVerification.outer (v z) (v z)) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.log_product_upper_of_potential","signature":"∀ (q V a : ℕ → ℝ) (C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      (∀ (k : ℕ), 0 < a k) →\n        0 < C →\n          (∀ (k : ℕ), q k * V (k + 1) ≤ a k * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ i ∈ Finset.range (m + 1), Real.log (q (J + i)) ≤\n                Real.log (C * V J) + ∑ i ∈ Finset.range m, Real.log (a (J + i))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.abs_gradient_contracts_of_same_sign","signature":"∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f) (k : ℕ),\n  0 < R.g k ∧ 0 < R.g (k + 1) ∨ R.g k < 0 ∧ R.g (k + 1) < 0 → |R.g (k + 1)| ≤ R.c₂ * |R.g k|","axioms":["propext","Quot.sound","Classical.choice"]}
