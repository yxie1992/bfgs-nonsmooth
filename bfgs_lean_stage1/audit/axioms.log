BFGS_AUDIT {"theorem":"BfgsVerification.LActualCopies.trial_hasGradient","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (D : BfgsVerification.LActualCopies.CopyData F) (m k : ℕ) (q : Fin 9),\n  BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n    HasFDerivAt F\n      (BfgsVerification.gradientFunctional\n        (BfgsVerification.LScalarGeometric.scale m •\n          BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective BfgsVerification.LEmbedding.mu)\n            (BfgsVerification.LSeedCopies.run.x k +\n              BfgsVerification.SeedOrbit.trialLength q •\n                BfgsVerification.bfgsStep (BfgsVerification.LSeedCopies.run.H k) (BfgsVerification.LSeedCopies.run.g k)\n                  1)))\n      ((BfgsVerification.LActualCopies.family D m).x k +\n        BfgsVerification.SeedOrbit.trialLength q •\n          BfgsVerification.bfgsStep ((BfgsVerification.LActualCopies.family D m).H k)\n            ((BfgsVerification.LActualCopies.family D m).g k) 1)","axioms":["propext","Classical.choice","Quot.sound"]}
