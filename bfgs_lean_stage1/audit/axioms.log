BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.abs_radialNumerator_le_two_mul","signature":"∀ {n : ℕ} (star z g h : BfgsVerification.Vec n) (G R : ℝ),\n  0 ≤ G →\n    0 ≤ R →\n      BfgsVerification.sqNorm g ≤ G ^ 2 →\n        BfgsVerification.sqNorm h ≤ G ^ 2 →\n          BfgsVerification.sqNorm (z - star) ≤ R ^ 2 →\n            |BfgsVerification.RadialCertificate.radialNumerator star z g h| ≤ 2 * G * R","axioms":["propext","Quot.sound","Classical.choice"]}
