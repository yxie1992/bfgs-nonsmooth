BFGS_AUDIT {"theorem":"BfgsVerification.IncomingJump.basis_limit_coefficients","signature":"∀ {ι : Type u_1} {l : Filter ι} {n : ℕ} (Y : ι → BfgsVerification.Mat n) (Y₀ : BfgsVerification.Mat n),\n  Filter.Tendsto Y l (nhds Y₀) →\n    Matrix.det Y₀ ≠ 0 →\n      ∀ (h : ι → BfgsVerification.Vec n) (B : ℝ),\n        (∀ᶠ (a : ι) in l, ‖h a‖ ≤ B) →\n          ∀ (t : ι → Fin n → ℝ),\n            (∀ (j : Fin n), Filter.Tendsto (fun a => t a j) l (nhds 0)) →\n              ∃ coeff,\n                (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • fun i => Y a i j) ∧\n                  Filter.Tendsto (fun a => ∑ j, |coeff a j| * √(t a j)) l (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
