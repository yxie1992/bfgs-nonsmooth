  (R : BfgsVerification.AdmissibleBFGSRun n F) (G L : ℝ),
  0 < G →
    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
      (∀ (k : ℕ), L ≤ F (R.x k)) → BfgsVerification.ObjectiveFiniteHorizonBound R G
@BfgsVerification.objectiveGrowth_of_value_limit : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F) (G ℓ : ℝ),
