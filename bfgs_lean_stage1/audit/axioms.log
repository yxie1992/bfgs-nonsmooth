BFGS_AUDIT {"theorem":"BfgsVerification.UnexcitedMetric.run._proof_9","signature":"∀ (A v₀ ρ c₁ : ℝ),\n  0 < v₀ →\n    0 < ρ →\n      0 < c₁ →\n        ρ < (1 - c₁) / (1 + c₁) →\n          ∀ (k : ℕ),\n            BfgsVerification.UnexcitedMetric.objective\n                (BfgsVerification.UnexcitedMetric.point (BfgsVerification.UnexcitedMetric.sign (k + 1))\n                  (BfgsVerification.UnexcitedMetric.radius ρ v₀ (k + 1))) ≤\n              BfgsVerification.UnexcitedMetric.objective\n                  (BfgsVerification.UnexcitedMetric.point (BfgsVerification.UnexcitedMetric.sign k)\n                    (BfgsVerification.UnexcitedMetric.radius ρ v₀ k)) +\n                c₁ *\n                  BfgsVerification.dot\n                    (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign k))\n                    (BfgsVerification.bfgsStep\n                      (BfgsVerification.UnexcitedMetric.diagonal A\n                        ((1 + ρ) / (2 * ρ) * BfgsVerification.UnexcitedMetric.radius ρ v₀ k))\n                      (BfgsVerification.UnexcitedMetric.gradient (BfgsVerification.UnexcitedMetric.sign k)) (2 * ρ))","axioms":["propext","Quot.sound","Classical.choice"]}
