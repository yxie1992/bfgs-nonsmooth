BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.boundary_sign_semialgebraic_partition","signature":"∀ {n m r : ℕ} (P : Fin m → MvPolynomial (Option (Fin n)) ℝ) (f : Fin r → BfgsVerification.Vec n → ℝ)\n  (S : Set (BfgsVerification.Vec n)),\n  BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic S →\n    (∀ (i : Fin r),\n        BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n          {v | (fun k => v (some k)) ∈ S ∧ v none = f i fun k => v (some k)}) →\n      (∀ (ω : Fin m → Fin r → SignType),\n          BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n            (BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S ω)) ∧\n        ⋃ ω, BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S ω = S ∧\n          (Pairwise fun ω η =>\n              Disjoint (BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S ω)\n                (BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S η)) ∧\n            (∀ (ω : Fin m → Fin r → SignType) (i : Fin r),\n                BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n                  {v |\n                    (fun k => v (some k)) ∈ BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S ω ∧\n                      v none = f i fun k => v (some k)}) ∧\n              ∀ (ω : Fin m → Fin r → SignType) (j : Fin m) (i : Fin r) (z : BfgsVerification.Vec n × ℝ),\n                z.1 ∈ BfgsVerification.RealAlgebraicGeometry.boundarySignStratum P f S ω ∧ z.2 = f i z.1 →\n                  SignType.sign (BfgsVerification.RealAlgebraicGeometry.parameterEval (P j) z) = ω j i","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineWhitening.fixed_family_identity","signature":"∀ {n : ℕ} {ι : Type u_1} {F : BfgsVerification.Vec n → ℝ} (H₀ : BfgsVerification.Mat n),\n  Matrix.PosDef H₀ →\n    ∀ (R : ι → BfgsVerification.AdmissibleBFGSRun n F),\n      (∀ (i : ι), (R i).H 0 = H₀) →\n        ∃ A,\n          A * A = H₀ ∧\n            Matrix.transpose A = A ∧\n              ∃ (hA : Matrix.det A ≠ 0),\n                (∀ (i : ι), (BfgsVerification.AffineWhitening.run A hA (R i)).H 0 = 1) ∧\n                  ∀ (i : ι) (k fuel : ℕ),\n                    BfgsVerification.DeterministicLineSearch.fromMetric (BfgsVerification.AffineWhitening.objective A F)\n                        ((BfgsVerification.AffineWhitening.run A hA (R i)).x k)\n                        ((BfgsVerification.AffineWhitening.run A hA (R i)).H k) (R i).c₁ (R i).c₂ fuel =\n                      BfgsVerification.DeterministicLineSearch.fromMetric F ((R i).x k) ((R i).H k) (R i).c₁ (R i).c₂\n                        fuel","axioms":["propext","Classical.choice","Quot.sound"]}
