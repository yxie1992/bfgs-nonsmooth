BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_gradient_range_finite","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)), (Set.range R.g).Finite","axioms":["propext","Quot.sound","Classical.choice"]}
