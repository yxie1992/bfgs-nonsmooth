BFGS_AUDIT {"theorem":"BfgsVerification.sum_transformed_coordinate_grams","signature":"∀ {n : ℕ} (H U : BfgsVerification.Mat n),\n  Matrix.transpose U * U = 1 →\n    ∀ (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ,\n          (BfgsVerification.metricGram H (U * BfgsVerification.coordinateMatrix I)).det =\n        BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
