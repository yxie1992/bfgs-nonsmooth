BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.tangential_cluster_geometry_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {Ω : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    IsCompact R.initialSublevel →\n      R.initialSublevel ⊆ Ω →\n        ∀ {a : BfgsVerification.Vec n},\n          BfgsVerification.sqNorm a = 1 →\n            ∀ (b : ℝ) {μ : ℝ},\n              0 < μ →\n                (ConvexOn ℝ Ω fun x =>\n                    F x - μ / 2 * BfgsVerification.sqNorm (BfgsVerification.FixedNormal.tangentProjection a x)) →\n                  ∀ {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n                    (∀ x ∈ Ω,\n                        ∀ (g : BfgsVerification.Vec n),\n                          BfgsVerification.Homogeneous.Supports F x g →\n                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n                      ContinuousOn A Ω →\n                        ∀ {L : ℝ},\n                          0 ≤ L →\n                            (∀ (k : ℕ),\n                                BfgsVerification.sqNorm\n                                    (BfgsVerification.FixedNormal.tangentProjection a (R.gradientChange k)) ≤\n                                  L * R.curvature k) →\n                              Filter.Tendsto R.displacement Filter.atTop (nhds 0) →\n                                ∀ {E : Set ℝ},\n                                  IsClosed E →\n                                    BfgsVerification.CenteredSmoothSublinear.LocallyC11On\n                                        (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →\n                                      (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                                          A p = 0 → BfgsVerification.FixedNormal.normalCoordinate a b p ∉ E) →\n                                        (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                                            DifferentiableAt ℝ F p → BfgsVerification.coordinateGradient F p ≠ 0) →\n                                          False","axioms":["propext","Classical.choice","Quot.sound"]}
