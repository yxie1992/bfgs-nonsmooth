BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxHessian.gradient_increment_bound","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ} {f : Fin m → BfgsVerification.Vec n → ℝ}\n  {g : Fin m → BfgsVerification.Vec n → BfgsVerification.Vec n} {x a : BfgsVerification.Vec n} {L : ℝ},\n  BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n    HasFDerivAt F (BfgsVerification.gradientFunctional a) x →\n      (∀ (i : Fin m) (z : BfgsVerification.Vec n), HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g i z)) z) →\n        (∀ (i : Fin m) (z w : BfgsVerification.Vec n),\n            BfgsVerification.sqNorm (g i z - g i w) ≤ L ^ 2 * BfgsVerification.sqNorm (z - w)) →\n          ∀ᶠ (z : BfgsVerification.Vec n) in nhds x,\n            ∀ (b : BfgsVerification.Vec n),\n              HasFDerivAt F (BfgsVerification.gradientFunctional b) z →\n                BfgsVerification.sqNorm (b - a) ≤ L ^ 2 * BfgsVerification.sqNorm (z - x)","axioms":["propext","Classical.choice","Quot.sound"]}
