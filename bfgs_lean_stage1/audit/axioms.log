BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.metricGram_submatrix_columns","signature":"∀ {n : ℕ} {ι : Type u_1} {κ : Type u_2} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) ι ℝ) (f : κ → ι),\n  BfgsVerification.metricGram H (Z.submatrix id f) = (BfgsVerification.metricGram H Z).submatrix f f","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.congruence_outer","signature":"∀ {n m : ℕ} (Z : Matrix (Fin n) (Fin m) ℝ) (a b : BfgsVerification.Vec n),\n  Z.transpose * BfgsVerification.outer a b * Z = BfgsVerification.outer (Z.transpose.mulVec a) (Z.transpose.mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.trace_bound","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k : ℕ), q k ≤ C * E k 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.global_log_product_upper._proof_1","signature":"∀ (J N : ℕ), J + 1 ≤ N → ¬N = J + (N - (J + 1) + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (y : BfgsVerification.Vec n) (Z : Matrix (Fin n) ι ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricEnergy H y -\n              Z.transpose.mulVec (Matrix.mulVec H y) ⬝ᵥ\n                (BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H y)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_sub_le._proof_1","signature":"∀ {ι : Type u_1} {M : Type u_4} {s : Finset ι} [inst : AddCommMonoid M] {f g : ι → M},\n  ∑ x ∈ s, f x + ∑ x ∈ s, g x = ∑ x ∈ s, (f x + g x)","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.geometricMean_eq_exp_logMean","signature":"∀ (q : ℕ → ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    ∀ (N : ℕ),\n      BfgsVerification.reciprocalGeometricMean q N = Real.exp (BfgsVerification.ReciprocalGrowth.logReciprocalMean q N)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalSum_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 → ∀ (j : ℕ), BfgsVerification.principalSum (U * H * V) j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_mulVec_at","signature":"∀ {n : ℕ} (I : Finset (Fin n)) (x : { x // x ∈ I } → ℝ) (i : { x // x ∈ I }),\n  (BfgsVerification.coordinateMatrix I).mulVec x ↑i = x i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression.eq_1","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r : ℝ),\n  BfgsVerification.CompressionDeterminant.compression A a b κ r =\n    A - κ⁻¹ • (BfgsVerification.outer a b + BfgsVerification.outer b a) + (r / κ ^ 2) • BfgsVerification.outer a a","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compression_from_gram_relations","signature":"∀ (Δ q u r z κ w D Dy Dgy : ℝ),\n  κ ^ 2 * D = Δ * ((κ - w) ^ 2 + u * (r - z)) →\n    Dy = Δ * (r - z) → Dgy = Δ * ((q - u) * (r - z) - (κ - w) ^ 2) → κ ^ 2 * D = q * Dy - Dgy","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.energy_pos","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ), 0 < BfgsVerification.metricEnergy (self.H k) (self.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.shift_identity","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  r * BfgsVerification.ScalarHierarchy.shiftedPotential n r e + e 1 =\n    BfgsVerification.ScalarHierarchy.weightedPotential n r e + r ^ n * e (n + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 →\n    BfgsVerification.PrincipalInvariance.principalPolynomial (U * H * V) =\n      BfgsVerification.PrincipalInvariance.principalPolynomial H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ k ∈ Finset.range (m + 1), Real.log (q (J + k)) ≤ Real.log C + Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.projection_expansion","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (v y : BfgsVerification.Vec n) (κ : ℝ),\n  Matrix.IsSymm H →\n    (1 - κ⁻¹ • BfgsVerification.outer v y) * H * (1 - κ⁻¹ • BfgsVerification.outer v y).transpose =\n      H - κ⁻¹ • (BfgsVerification.outer v (Matrix.mulVec H y) + BfgsVerification.outer (Matrix.mulVec H y) v) +\n        (BfgsVerification.dot y (Matrix.mulVec H y) / κ ^ 2) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.det_rank_two","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (t v : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a)) =\n        Matrix.det A *\n          ((1 + v * BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)) ^ 2 +\n            BfgsVerification.dot a (Matrix.mulVec A⁻¹ a) * (t - v ^ 2 * BfgsVerification.dot b (Matrix.mulVec A⁻¹ b)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_fixed_tail_lower_eventually._proof_3","signature":"∀ (J M N : ℕ), N ≥ J + (max M 1 + 1) → 0 < N - (J + 1) → ¬M ≤ N - (J + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.sum_compressed_bounds","signature":"∀ {ι : Type u_1} [inst : Fintype ι] (Dplus Dy Δ : ι → ℝ) (α β q normY2 eNext eCurrent : ℝ),\n  0 < β →\n    0 < q →\n      (∀ (i : ι), Dplus i ≤ Dy i / (β ^ 2 * q) + α / β * Δ i) →\n        ∑ i, Dy i ≤ normY2 * eNext →\n          ∑ i, Δ i = eCurrent → ∑ i, Dplus i ≤ normY2 / (β ^ 2 * q) * eNext + α / β * eCurrent","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.global_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∃ B, ∀ (N : ℕ), J + 1 ≤ N → ∑ k ∈ Finset.range N, Real.log (q k) ≤ B + ↑N * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_le_sqNorm_mul_trace","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n),\n  Matrix.PosSemidef H → BfgsVerification.metricEnergy H g ≤ BfgsVerification.sqNorm g * Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.fullBFGS_normalizedHierarchy","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          BfgsVerification.ScalarHierarchy.NormalizedHierarchy n (fun k => BfgsVerification.principalSum (R.H k)) R.q\n            (fun k => R.d k / c) (4 * G ^ 2 / c ^ 2) (G ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic._proof_2","signature":"∀ {m : Type u_2} {n : Type u_3} {o : Type u_4} {α : Type v} [inst : NonUnitalSemiring α] [inst_1 : Fintype n]\n  [inst_2 : Fintype o] (v : o → α) (M : Matrix m n α) (N : Matrix n o α), (M * N).mulVec v = M.mulVec (N.mulVec v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.dimension_pos","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → 0 < n","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon._proof_1","signature":"∀ (m : ℕ), 0 < m → ¬0 < m + 1 → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.K_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → 0 ≤ K","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.mk.sizeOf_spec","signature":"∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)\n  (positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k))\n  (curvature_pos : ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)),\n  sizeOf\n      { H := H, g := g, α := α, positive_definite := positive_definite, alpha_pos := alpha_pos,\n        energy_pos := energy_pos, curvature_pos := curvature_pos, update := update } =\n    1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_step","signature":"∀ (n : ℕ) (e eNext : ℕ → ℝ) (q K η δ : ℝ),\n  0 ≤ K →\n    0 < η →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        e (n + 1) = 0 →\n          (∀ (j : ℕ), 1 ≤ j → j ≤ n → q * eNext j ≤ K * e (j + 1) + δ * e j) →\n            q * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) eNext ≤\n              (η + δ) * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) e","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compression_scalar_identity","signature":"∀ (Δ q u r z κ w : ℝ),\n  Δ / κ ^ 2 * ((κ - w) ^ 2 + u * (r - z)) = (q * (Δ * (r - z)) - Δ * ((q - u) * (r - z) - (κ - w) ^ 2)) / κ ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic._proof_1","signature":"∀ {m : Type u_2} {n : Type u_3} {α : Type v} {ι : Type u_6} [inst : Fintype n] [inst_1 : NonUnitalNonAssocSemiring α]\n  (M : Matrix m n α) (v : n → α), M * Matrix.replicateCol ι v = Matrix.replicateCol ι (M.mulVec v)","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.d_eq_neg_dot_step","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  R.d k = -BfgsVerification.dot (R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_nonneg","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n), 0 ≤ BfgsVerification.sqNorm g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix.eq_1","signature":"∀ {n : ℕ} (I : Finset (Fin n)), BfgsVerification.coordinateMatrix I = Matrix.submatrix 1 id Subtype.val","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.metricGram_det_reindex","signature":"∀ {n : ℕ} {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [inst_2 : DecidableEq ι]\n  [inst_3 : DecidableEq κ] (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) ι ℝ) (e : κ ≃ ι),\n  (BfgsVerification.metricGram H (Z.submatrix id ⇑e)).det = (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.rank_two_add_rank_one_det","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (t v ρ : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det\n          (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a) +\n            ρ • BfgsVerification.outer a a) =\n        Matrix.det\n            (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a)) +\n          ρ * Matrix.det A * BfgsVerification.dot a (Matrix.mulVec A⁻¹ a)","axioms":["propext","Quot.sound","Classical.choice"]}
