BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.local_matrix_l1_basin","signature":"∀ {n m : ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (A : Matrix (Fin m) (Fin n) ℝ) (b : BfgsVerification.Vec m) {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n          ∀ {star : BfgsVerification.Vec n},\n            star ∈ U →\n              (∀ x ∈ U, F x = ψ x + ∑ i, |(A.mulVec x - b) i|) →\n                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                  (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                    ∃ δ,\n                      0 < δ ∧\n                        ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                          F (R.x 0) ≤ F star + δ →\n                            (∀ (k : ℕ), R.x k ∈ U) ∧\n                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_old_endpoint_pairing","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ), BfgsVerification.dot (R.g k) (R.x (k + 1)) = F (R.x k) - R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
