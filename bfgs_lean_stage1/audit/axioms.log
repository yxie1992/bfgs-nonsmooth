BFGS_AUDIT {"theorem":"BfgsVerification.DScalar.component_affine_of_coordinate","signature":"∀ {b x : ℝ},\n  0 < b →\n    ∀ (n : ℕ),\n      BfgsVerification.DScalarRamp.center b + BfgsVerification.DScalarRamp.epsilon ≤\n          BfgsVerification.DScalarGeometric.coordinate b (BfgsVerification.DScalarGeometric.scale n) x →\n        BfgsVerification.DScalar.component b n x =\n          (1 - BfgsVerification.DScalarGeometric.theta ^ 2) * BfgsVerification.DScalarGeometric.scale n ^ 2 * x +\n            (1 - b) * (1 - BfgsVerification.DScalarGeometric.theta ^ 3) * BfgsVerification.DScalarGeometric.scale n ^ 3","axioms":["propext","Quot.sound","Classical.choice"]}
