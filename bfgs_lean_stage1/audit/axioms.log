      ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,
        ∀ (g : BfgsVerification.Vec n),
          HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)
    (secant :
      ∀ (x z g h : BfgsVerification.Vec n),
        x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
          z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
              BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                BfgsVerification.metricEnergy (W z) (h - g) ≤
                  C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)
    (transport :
      ∀ (x z g h : BfgsVerification.Vec n),
        x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
          z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
              BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                (Real.exp (L * BfgsVerification.TransportedCertificate.pairDecrease x z g + Ψ x - Ψ z) •
                      (BfgsVerification.TransportedCertificate.stepProjector
                            (BfgsVerification.TransportedCertificate.pairStep x z) *
                          W x *
                        BfgsVerification.TransportedCertificate.stepProjector
                          (BfgsVerification.TransportedCertificate.pairStep x z)) -
                    BfgsVerification.TransportedCertificate.stepProjector
                          (BfgsVerification.TransportedCertificate.pairStep x z) *
                        W z *
                      BfgsVerification.TransportedCertificate.stepProjector
                        (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef) :
    BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η
def BfgsVerification.TransportedCertificate.ScalarQuotientBound : (BfgsVerification.Vec 1 → ℝ) →
  Set (BfgsVerification.Vec 1) → ℝ → ℝ → ℝ → ℝ → Prop :=
fun F K fstar c₁ c₂ η =>
  ∃ δ,
    0 < δ ∧
      ∃ A,
        ∀ (x z g h : BfgsVerification.Vec 1),
          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                  |h 0 - g 0| / (|z 0 - x 0| * h 0 ^ 2) ≤ A
def BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz : (BfgsVerification.Vec 1 → ℝ) →
  Set (BfgsVerification.Vec 1) → ℝ → ℝ → ℝ → ℝ → Prop :=
fun F K fstar c₁ c₂ η =>
  ∃ δ,
    0 < δ ∧
      ∃ A,
        ∀ (x z g h : BfgsVerification.Vec 1),
          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ → |h 0 - g 0| ≤ A * |z 0 - x 0|
def BfgsVerification.TransportedCertificate.HasShellCertificates : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → ℝ → ℝ → ℝ → Prop :=
fun {n} F K fstar c₁ c₂ =>
  ∀ (ell : ℝ),
    fstar < ell →
      (∃ x ∈ K, ell ≤ F x) →
        ∃ ε,
          0 < ε ∧
            Nonempty
              (BfgsVerification.TransportedCertificate.BandCertificate F (K ∩ {x | F x ≤ ell + ε}) fstar c₁ c₂
                (ell - fstar))
def BfgsVerification.RadialCertificate.HasInterceptBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : ℝ),
    0 < η →
      ∃ C,
        ∀ (x z g h : BfgsVerification.Vec n),
          x ∈ K →
            z ∈ K →
              F star + η ≤ F z →
                F z ≤ F x →
                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                    HasFDerivAt F (BfgsVerification.gradientFunctional h) z →
                      0 < BfgsVerification.RadialCertificate.secantCurvature x z g h →
                        (BfgsVerification.RadialCertificate.optimizerIntercept F star z h -
                              BfgsVerification.RadialCertificate.optimizerIntercept F star x g) ^
                            2 ≤
                          C * BfgsVerification.RadialCertificate.secantCurvature x z g h
def BfgsVerification.RadialCertificate.HasInwardTaylorBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : ℝ),
    0 < η →
      ∃ M θ,
        0 < θ ∧
          θ ≤ 1 / 2 ∧
            ∀ (x g : BfgsVerification.Vec n),
              x ∈ K →
                F star + η ≤ F x →
                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                    ∀ (t : ℝ),
                      0 ≤ t →
                        t ≤ θ →
                          0 ≤
                              BfgsVerification.RadialCertificate.supportingError F x g
                                (BfgsVerification.RadialCertificate.inwardPoint star x t) ∧
                            BfgsVerification.RadialCertificate.supportingError F x g
                                (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤
                              M / 2 * t ^ 2
def BfgsVerification.CertificateNormalizationTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ : ℝ},
  0 < c₁ →
    c₂ < 1 →
      ∀ (b : ℝ),
        (∀ x ∈ K, F x ≤ b) →
          (BfgsVerification.TransportedCertificate.HasBandCertificates F K fstar c₁ c₂ ↔
            ∀ (η : ℝ),
              0 < η → (BfgsVerification.TransportedCertificate.positiveBand F K fstar η).Nonempty → ∃ C, C.L = 0)
def BfgsVerification.RecurrentAffineHullTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) (L : ℝ),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds L) →
    0 ∈ affineSpan ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)
def BfgsVerification.MaxLinearAffineEscapeTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  0 ∉ affineSpan ℝ ↑A →
    Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop Filter.atBot
def BfgsVerification.RadialInterceptEquivalenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {K : Set (BfgsVerification.Vec n)},
      IsCompact K →
        ∀ (star : BfgsVerification.Vec n),
          BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star ↔
            BfgsVerification.RadialCertificate.HasInterceptBounds F K star
def BfgsVerification.InwardCertificateConvergenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.RadialCertificate.HasInwardTaylorBounds F {x | F x ≤ b} star →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.IncomingJumpObstructionTarget : Prop :=
∀ {ι : Type} {l : Filter ι} [inst : l.NeBot] {n r : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},
  c₂ < 1 →
    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin r → BfgsVerification.Vec n) (coeff : ι → Fin r → ℝ),
      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
        (∀ (a : ι) (j : Fin r), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →
            (∀ (a : ι) (j : Fin r),
                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →
              (∀ (j : Fin r),
                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l
                    (nhds 0)) →
                (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • (h a - g a j)) →
                  Filter.Tendsto
                      (fun a =>
                        ∑ j,
                          |coeff a j| *
                            √(BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)))
                      l (nhds 0) →
                    ¬Nonempty (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
def BfgsVerification.ScalarCertificateCharacterizationTarget : Prop :=
∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec 1),
      IsCompact K →
        ∀ {c₁ c₂ η : ℝ},
          c₂ < 1 →
            0 < η →
              (Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K (F star) c₁ c₂ η) ↔
                BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz F K (F star) c₁ c₂ η)
@BfgsVerification.TransportedCertificate.BandCertificate.normalize_field : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)
  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b) (x : BfgsVerification.Vec n),
  (C.normalize hc₁ hc₂ b hb).W x = Real.exp (C.L / c₁ * (F x - fstar)) • C.W x
@BfgsVerification.TransportedCertificate.BandCertificate.normalize_budget : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)
  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b),
  (C.normalize hc₁ hc₂ b hb).L = 0 ∧ (C.normalize hc₁ hc₂ b hb).δ = C.δ
@BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb_constants : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η) (hc₂ : c₂ < 1),
  (C.absorb hc₂).L = 2 * C.L ∧ (C.absorb hc₂).δ = min C.δ (C.L + 1)⁻¹
@BfgsVerification.TransportedCertificate.local_transported_certificate_basin : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
          ∀ (b : ℝ),
            F star < b →
              ∀ {U : Set (BfgsVerification.Vec n)},
                U ∈ nhds star →
                  ∀ {c₁ c₂ : ℝ},
                    BfgsVerification.TransportedCertificate.HasBandCertificates F ({x | F x ≤ b} ∩ U) (F star) c₁ c₂ →
                      ∃ δ,
                        0 < δ ∧
                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                            R.c₁ = c₁ →
                              R.c₂ = c₂ →
                                F (R.x 0) ≤ F star + δ →
                                  (∀ (k : ℕ), F (R.x k) ≤ b ∧ R.x k ∈ U) ∧
                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                      Filter.Tendsto R.x Filter.atTop (nhds star)
@BfgsVerification.AdmissibleBFGSRun.transported_shell_certificate_convergence_on_sublevel : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.TransportedCertificate.HasShellCertificates F {x | F x ≤ b} (F star) R.c₁ R.c₂ →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
@BfgsVerification.TransportedCertificate.projected_transport_iff_perpendicular : ∀ {n : ℕ}
  (W Z : BfgsVerification.Mat n),
  Matrix.IsSymm W →
    Matrix.IsSymm Z →
      ∀ (s : BfgsVerification.Vec n) (a : ℝ),
        (a •
                (BfgsVerification.TransportedCertificate.stepProjector s * W *
                  BfgsVerification.TransportedCertificate.stepProjector s) -
              BfgsVerification.TransportedCertificate.stepProjector s * Z *
                BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef ↔
          ∀ (v : BfgsVerification.Vec n),
            BfgsVerification.dot v s = 0 → BfgsVerification.metricEnergy Z v ≤ a * BfgsVerification.metricEnergy W v
@BfgsVerification.AdmissibleBFGSRun.commonTilt_value_escape : ∀ {n : ℕ} (B : Finset (BfgsVerification.Vec n))
  (hB : B.Nonempty) (R : BfgsVerification.AdmissibleBFGSRun (n + 1) (BfgsVerification.Homogeneous.commonTilt B hB)),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.commonTilt B hB (R.x k)) Filter.atTop Filter.atBot
@BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_gradient_cardinality : ∀ {n : ℕ}
  (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (Q : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) (L : ℝ),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (Q.x k)) Filter.atTop (nhds L) →
    Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues Q.g)) + 1 ≤
      (BfgsVerification.Homogeneous.recurrentValues Q.g).ncard
@BfgsVerification.TransportedCertificate.basis_limit_no_visibility_secant : ∀ {ι : Type u_1} {l : Filter ι}
  [inst : l.NeBot] {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},
  c₂ < 1 →
    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin n → BfgsVerification.Vec n),
      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
        (∀ (a : ι) (j : Fin n), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →
            (∀ (a : ι) (j : Fin n),
                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →
              (∀ (j : Fin n),
                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l
                    (nhds 0)) →
                ∀ (b : Basis (Fin n) ℝ (BfgsVerification.Vec n)),
                  (∀ (j : Fin n), Filter.Tendsto (fun a => h a - g a j) l (nhds (b j))) →
                    (∀ (j : Fin n),
                        Filter.Tendsto
                          (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)) l
                          (nhds 0)) →
                      ∀ (B : ℝ),
                        (∀ᶠ (a : ι) in l, ‖h a‖ ≤ B) →
                          ¬Nonempty
                              (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
@BfgsVerification.RadialCertificate.inward_error_le_of_pair_radial : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star x g h : BfgsVerification.Vec n) (t C : ℝ),
      0 ≤ t →
        t ≤ 1 / 2 →
          0 ≤ C →
            HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
              HasFDerivAt F (BfgsVerification.gradientFunctional h)
                  (BfgsVerification.RadialCertificate.inwardPoint star x t) →
                (0 <
                      BfgsVerification.RadialCertificate.secantCurvature x
                        (BfgsVerification.RadialCertificate.inwardPoint star x t) g h →
                    BfgsVerification.RadialCertificate.radialNumerator star
                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h ^
                        2 ≤
                      C *
                        BfgsVerification.RadialCertificate.secantCurvature x
                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h) →
                  BfgsVerification.RadialCertificate.supportingError F x g
                      (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤
                    4 * C * t ^ 2
@BfgsVerification.convex_gradients_tendsto_at_differentiable : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {x a : ℕ → BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},
      Filter.Tendsto x Filter.atTop (nhds star) →
        (∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (a k)) (x k)) →
          HasFDerivAt F (BfgsVerification.gradientFunctional g) star → Filter.Tendsto a Filter.atTop (nhds g)

exit_code=0
