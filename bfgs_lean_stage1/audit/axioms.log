BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    ∀ (g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineCertificate.backward_pair_decrease","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 →\n    ∀ (b x z g : BfgsVerification.Vec n),\n      BfgsVerification.TransportedCertificate.pairDecrease (BfgsVerification.AffineCertificate.backward A b x)\n          (BfgsVerification.AffineCertificate.backward A b z) ((Matrix.transpose A).mulVec g) =\n        BfgsVerification.TransportedCertificate.pairDecrease x z g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Example.eligible_radial_unbounded_on_neighborhood","signature":"∀ {K : Set (BfgsVerification.Vec 2)},\n  K ∈ nhds 0 →\n    ∀ {c₁ c₂ : ℝ},\n      c₁ < 1 →\n        0 ≤ c₂ →\n          ∃ η,\n            0 < η ∧\n              ∀ (δ : ℝ),\n                0 < δ →\n                  ∀ (C : ℝ),\n                    ∃ x z g h H,\n                      x ∈ K ∧\n                        z ∈ K ∧\n                          η ≤ BfgsVerification.Parabolic.Example.objective z ∧\n                            BfgsVerification.Parabolic.Example.objective z ≤\n                                BfgsVerification.Parabolic.Example.objective x ∧\n                              BfgsVerification.TransportedCertificate.EligiblePair\n                                  BfgsVerification.Parabolic.Example.objective c₁ c₂ x z g h ∧\n                                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ ∧\n                                  Matrix.PosDef H ∧\n                                    BfgsVerification.bfgsStep H g 1 =\n                                        BfgsVerification.TransportedCertificate.pairStep x z ∧\n                                      C * BfgsVerification.TransportedCertificate.pairCurvature x z g h <\n                                        BfgsVerification.RadialCertificate.radialNumerator 0 z g h ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FivePieceObstruction.ray_value_middle","signature":"∀ {τ α : ℝ},\n  0 < τ →\n    1 ≤ α → α ≤ 6 → BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ α) = τ","axioms":["propext","Quot.sound","Classical.choice"]}
