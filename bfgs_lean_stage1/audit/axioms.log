BFGS_AUDIT {"theorem":"BfgsVerification.HomogeneousBlock.tendsto_zero_of_anchor_blocks._proof_6","signature":"∀ (p : ℕ → Prop),\n  ℕ →\n    ℕ →\n      ∀ (k : ℕ) (hS : (Finset.filter p (Finset.range (k + 1))).Nonempty),\n        (∃ b, k < b ∧ p b) →\n          ∀ (j : ℕ),\n            (Finset.filter p (Finset.range (k + 1))).max' hS < j →\n              j ≤ (Finset.filter p (Finset.range (k + 1))).max' hS → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PolynomialBounds.polynomial_quadratic_abs_sub_le","signature":"∀ {ι : Type u_1} [inst : Fintype ι] (a : ι → ℝ) (w : ι → List (Fin 2)),\n  (∀ (i : ι), 2 ≤ (w i).length) →\n    ∀ {x y : BfgsVerification.Vec 2} {r : ℝ},\n      r ≤ 1 →\n        (∀ (i : Fin 2), |x i| ≤ r) →\n          (∀ (i : Fin 2), |y i| ≤ r) →\n            |∑ i, a i * BfgsVerification.PolynomialBounds.monomial (w i) x -\n                  ∑ i, a i * BfgsVerification.PolynomialBounds.monomial (w i) y| ≤\n              (∑ i, |a i| * ↑(w i).length) * r * ‖x - y‖","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.scalar_frame_tail_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J : ℕ)\n  (w : ℕ → BfgsVerification.Vec n) (a b : ℕ → ℝ),\n  (∀ (k : ℕ), J ≤ k → w (k + 1) = a k • w k + b k • R.displacement k) →\n    ∀ (m C C0 : ℝ),\n      0 < m →\n        0 ≤ C →\n          0 ≤ C0 →\n            (∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.dot (R.g k) (w k) ^ 2) →\n              (∀ (k : ℕ), J ≤ k → a k ^ 2 ≤ 1 + C * R.d k) →\n                (∀ (k : ℕ), J ≤ k → BfgsVerification.dot (R.gradientChange k) (w (k + 1)) ^ 2 / R.curvature k ≤ C0) →\n                  Summable R.d → ∀ (G : ℝ), 0 < G → (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) → False","axioms":["propext","Quot.sound","Classical.choice"]}
