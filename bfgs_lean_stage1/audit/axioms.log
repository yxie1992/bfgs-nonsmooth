BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.moving_frame","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (g y s : BfgsVerification.Vec n) (q t : ℝ),\n  Matrix.IsSymm (B - q⁻¹ • BfgsVerification.outer g g) →\n    Matrix.mulVec (B - q⁻¹ • BfgsVerification.outer g g) s = 0 →\n      ∀ (V W : Matrix (Fin n) (Fin r) ℝ) (T : BfgsVerification.Mat r) (b : BfgsVerification.Vec r),\n        W = V * T + BfgsVerification.EnergyIdentities.rectOuter s b →\n          BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g + t⁻¹ • BfgsVerification.outer y y) W =\n            Matrix.transpose T *\n                  (BfgsVerification.metricGram B V -\n                    q⁻¹ • BfgsVerification.outer (V.transpose.mulVec g) (V.transpose.mulVec g)) *\n                T +\n              t⁻¹ • BfgsVerification.outer (W.transpose.mulVec y) (W.transpose.mulVec y)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.curvature_pos","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  0 < BfgsVerification.dot (self.g (k + 1) - self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_energy","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (k : ℕ)\n  (V W : Matrix (Fin n) (Fin r) ℝ) (T : BfgsVerification.Mat r) (b : BfgsVerification.Vec r),\n  W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b →\n    BfgsVerification.metricGram (R.hessian (k + 1)) W =\n      Matrix.transpose T *\n            (BfgsVerification.metricGram (R.hessian k) V -\n              (R.q k)⁻¹ • BfgsVerification.outer (V.transpose.mulVec (R.g k)) (V.transpose.mulVec (R.g k))) *\n          T +\n        (R.curvature k)⁻¹ •\n          BfgsVerification.outer (W.transpose.mulVec (R.gradientChange k)) (W.transpose.mulVec (R.gradientChange k))","axioms":["propext","Quot.sound","Classical.choice"]}
