BFGS_AUDIT {"theorem":"BfgsVerification.posDef_orthogonal_diagonalization","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∃ U lam,\n      Matrix.transpose U * U = 1 ∧\n        U * Matrix.transpose U = 1 ∧ Matrix.transpose U * H * U = Matrix.diagonal lam ∧ ∀ (i : Fin n), 0 < lam i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression_det","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      κ ≠ 0 →\n        κ ^ 2 * Matrix.det (BfgsVerification.CompressionDeterminant.compression A a b κ r) =\n          Matrix.det A *\n            ((κ - BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)) ^ 2 +\n              BfgsVerification.dot a (Matrix.mulVec A⁻¹ a) * (r - BfgsVerification.dot b (Matrix.mulVec A⁻¹ b)))","axioms":["propext","Quot.sound","Classical.choice"]}
