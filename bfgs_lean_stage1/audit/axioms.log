BFGS_AUDIT {"theorem":"BfgsVerification.AffineProjection.inverseBFGS_compress._proof_1","signature":"∀ {l : Type u_1} {m : Type u_2} {n : Type u_3} {o : Type u_4} {α : Type v} [inst : NonUnitalSemiring α]\n  [inst_1 : Fintype m] [inst_2 : Fintype n] (L : Matrix l m α) (M : Matrix m n α) (N : Matrix n o α),\n  L * (M * N) = L * M * N","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.norm_sub_le_of_centered_local_bound","signature":"∀ {D : ℝ → ℝ} {U : Set ℝ},\n  IsOpen U →\n    Convex ℝ U →\n      ContinuousOn D U →\n        ∀ {L : ℝ},\n          (∀ x ∈ U, ∀ᶠ (z : ℝ) in nhds x, z ∈ U → ‖D z - D x‖ ≤ L * ‖z - x‖) →\n            ∀ {a b : ℝ}, a ∈ U → b ∈ U → ‖D b - D a‖ ≤ L * ‖b - a‖","axioms":["propext","Classical.choice","Quot.sound"]}
