BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.source_last_step","signature":"BfgsVerification.bfgsStep\n    (BfgsVerification.SeedCycle.update BfgsVerification.SeedCycle.M1 BfgsVerification.SeedCycle.g1\n      (BfgsVerification.SeedCycle.g2 (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1))\n      (1 / 4))\n    (BfgsVerification.SeedCycle.g2 (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1))\n    (1 / 16) =\n  BfgsVerification.AlgebraicSeed.ratio (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1) •\n    (BfgsVerification.SeedCycle.g0 -\n      BfgsVerification.SeedCycle.g2 (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1))","axioms":["propext","Classical.choice","Quot.sound"]}
