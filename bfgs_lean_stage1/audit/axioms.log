BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.nonneg_of_bounded_below","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ), (∀ (x : BfgsVerification.Vec n), L ≤ F x) → ∀ (x : BfgsVerification.Vec n), 0 ≤ F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.certificateOfScalarQuotient._proof_6","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n        ∀ (g : BfgsVerification.Vec 1), HasFDerivAt F (BfgsVerification.gradientFunctional g) x → g 0 ≠ 0) →\n      ∀ (δ A : ℝ),\n        (∀ (x z g h : BfgsVerification.Vec 1),\n            x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n              z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                  BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n                    |h 0 - g 0| / (|z 0 - x 0| * h 0 ^ 2) ≤ A) →\n          ∀ (x z g h : BfgsVerification.Vec 1),\n            x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n              z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                  BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n                    BfgsVerification.metricEnergy\n                        ((BfgsVerification.TransportedCertificate.scalarGradient F z ^ 2)⁻¹ •\n                          BfgsVerification.outer (fun x => 1) fun x => 1)\n                        (h - g) ≤\n                      A * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_support","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ) (z : BfgsVerification.Vec n), BfgsVerification.dot (R.g k) z ≤ F z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.scalar_step_ne","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec 1},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h → z 0 - x 0 ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.positive_invariants","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  Matrix.PosDef (R.H k) ∧\n    0 < R.q k ∧ 0 < BfgsVerification.dot (R.g (k + 1) - R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.curvature_pos_of_weakWolfe","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (gnext : BfgsVerification.Vec n) {α c₂ : ℝ},\n          0 < α →\n            c₂ < 1 →\n              c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ≤\n                  BfgsVerification.dot gnext (BfgsVerification.bfgsStep H g α) →\n                0 < BfgsVerification.dot (gnext - g) (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.m_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ResidualFrameCertificate R), 0 < self.m","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_gram_diagonal","signature":"∀ {n : ℕ} (lam : Fin n → ℝ) (I : Finset (Fin n)),\n  BfgsVerification.metricGram (Matrix.diagonal lam) (BfgsVerification.coordinateMatrix I) =\n    Matrix.diagonal fun i => lam ↑i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_sub_le","signature":"∀ {n : ℕ} (g h : BfgsVerification.Vec n),\n  BfgsVerification.sqNorm (g - h) ≤ 2 * BfgsVerification.sqNorm g + 2 * BfgsVerification.sqNorm h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.accepted_pair_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  BfgsVerification.TransportedCertificate.pairStep (R.x k) (R.x (k + 1)) = R.displacement k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_probe","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star x z g h : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n        ∀ (M t : ℝ),\n          BfgsVerification.RadialCertificate.supportingError F z h\n                (BfgsVerification.RadialCertificate.inwardPoint star z t) ≤\n              M / 2 * t ^ 2 →\n            t * BfgsVerification.RadialCertificate.radialNumerator star z g h ≤\n              BfgsVerification.RadialCertificate.supportingError F x g z + M / 2 * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.quadratic_corrections_of_uniform_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n)\n  (C : ℝ),\n  (∀ (k : ℕ), R.referenceCorrection star k ≤ C) →\n    ∀ (N : ℕ), ∑ k ∈ Finset.range N, R.referenceCorrection star k ≤ max C 0 * ↑N ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.accepted_displacement_ne_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), R.displacement k ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.m_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η), 0 < self.m","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.displacement.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  R.displacement k = BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.d.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), R.d k = R.α k * R.q k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.recurrent_affine_zero_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  (Set.range R.g).Finite →\n    ∀ (L : ℝ), (∀ (k : ℕ), L ≤ F (R.x k)) → 0 ∈ affineSpan ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_summable","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ → (∀ (k : ℕ), 0 ≤ d k) → (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → (∀ (k : ℕ), L ≤ f k) → Summable d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace_nonneg","signature":"∀ {n r : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B → ∀ (W : Matrix (Fin n) (Fin r) ℝ), 0 ≤ (BfgsVerification.metricGram B W).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon_rpow","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (η D : ℝ),\n            0 < η →\n              0 ≤ D →\n                ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                  ↑(m + 1) *\n                        (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) (E J)) ^ (-1 / ↑(m + 1)) *\n                      (η + D / ↑m) ^ (-↑m / ↑(m + 1)) ≤\n                    ∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.sphere_gap","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [inst_2 : FiniteDimensional ℝ E]\n  [inst_3 : Nontrivial E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (xStar : E),\n      (∀ (x : E), F xStar ≤ F x) →\n        (∀ (x : E), F x = F xStar → x = xStar) →\n          ∀ {r : ℝ},\n            0 < r →\n              ∃ ω, 0 < ω ∧ (∃ z, dist z xStar = r ∧ F z - F xStar = ω) ∧ ∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  [inst : (a : BfgsVerification.Vec n) → SizeOf (K a)] (W : BfgsVerification.Vec n → BfgsVerification.Mat n)\n  (m C L δ : ℝ) (m_pos : 0 < m) (L_nonneg : 0 ≤ L) (delta_pos : 0 < δ)\n  (positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))\n  (visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)\n  (secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)\n  (transport :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              ((1 + L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef),\n  sizeOf\n      { W := W, m := m, C := C, L := L, δ := δ, m_pos := m_pos, L_nonneg := L_nonneg, delta_pos := delta_pos,\n        positive_semidefinite := positive_semidefinite, visibility := visibility, secant := secant,\n        transport := transport } =\n    1 + sizeOf m + sizeOf C + sizeOf L + sizeOf δ + sizeOf m_pos + sizeOf L_nonneg + sizeOf delta_pos","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.initial_posDef","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F), Matrix.PosDef (self.H 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.shifted_succ","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.shiftedPotential (n + 1) r e =\n    BfgsVerification.ScalarHierarchy.shiftedPotential n r e + r ^ n * e (n + 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.det_piecewise_one","signature":"∀ {ι : Type u_1} {R : Type u_2} [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : CommRing R] (I : Finset ι)\n  (M : Matrix ι ι R), Matrix.det (I.piecewise M 1) = (M.submatrix (fun i => ↑i) fun i => ↑i).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_on_tail_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (J : ℕ) (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 ≤ L →\n                0 < m →\n                  0 ≤ C₀ →\n                    0 ≤ C_T →\n                      0 ≤ C_R →\n                        (∀ (k : ℕ),\n                            BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                              L * (R.shift J).curvature k) →\n                          ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                            (b : ℕ → BfgsVerification.Vec p),\n                            (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))) →\n                              (∀ (k : ℕ),\n                                  BfgsVerification.sqNorm\n                                      ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                                    C₀ * (R.shift J).curvature k) →\n                                (∀ (k : ℕ),\n                                    V (k + 1) =\n                                      V k * T k +\n                                          BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k)\n                                            (b k) +\n                                        Z k) →\n                                  (∀ (k : ℕ),\n                                      BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)) →\n                                    (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                                      (∀ (k : ℕ),\n                                          BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) →\n                                        False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.normalize_field","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)\n  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b) (x : BfgsVerification.Vec n),\n  (C.normalize hc₁ hc₂ b hb).W x = Real.exp (C.L / c₁ * (F x - fstar)) • C.W x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.reciprocalGrowth","signature":"BfgsVerification.ReciprocalGrowthTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.gap_le_referencePairing","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n)\n  (k : ℕ), F (R.x k) - F xstar ≤ R.referencePairing xstar k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.transported_shell_certificate_convergence_on_sublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),\n  IsCompact {x | F x ≤ b} →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        F (R.x 0) ≤ b →\n          BfgsVerification.TransportedCertificate.HasShellCertificates F {x | F x ≤ b} (F star) R.c₁ R.c₂ →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧\n                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                  Filter.Tendsto R.x Filter.atTop (nhds star))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.projected_outer","signature":"∀ {n : ℕ} (s v : BfgsVerification.Vec n),\n  BfgsVerification.TransportedCertificate.stepProjector s * BfgsVerification.outer v v *\n      BfgsVerification.TransportedCertificate.stepProjector s =\n    BfgsVerification.outer (Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) v)\n      (Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_succ","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.weightedPotential (n + 1) r e =\n    BfgsVerification.ScalarHierarchy.weightedPotential n r e + r ^ n * e (n + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_projection_trace_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm ((U * U.transpose).mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (k : ℕ), (U * U.transpose * R.hessian k).trace ≤ (U * U.transpose * R.hessian 0).trace + L * ↑k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.objective_tendsto_min_of_negligible_corrections","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xstar : BfgsVerification.Vec n),\n  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →\n    ∀ (G : ℝ),\n      0 < G →\n        (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n          Filter.Tendsto\n              (fun N => (∑ k ∈ Finset.range N, R.referenceCorrection xstar k) / ∑ k ∈ Finset.range N, (R.q k)⁻¹)\n              Filter.atTop (nhds 0) →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_reciprocal_sum_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), P (k + 1) = P k * T k) →\n      (∀ (k : ℕ), V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (m K L C : ℝ),\n          0 < K →\n            0 ≤ L →\n              (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                (∀ (k : ℕ),\n                    BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C) →\n                  (∀ (k : ℕ) (v : Fin r → ℝ),\n                      BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v) →\n                    (∀ (k : ℕ) (v : Fin r → ℝ),\n                        BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →\n                      ∀ (N : ℕ), m / K * ∑ k ∈ Finset.range N, (R.q k)⁻¹ ≤ R.normalizedFrameEnergy V P 0 + L * C * ↑N","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.local_basin_of_unique_minimizer","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xStar : BfgsVerification.Vec n),\n  (∀ (x : BfgsVerification.Vec n), F xStar ≤ F x) →\n    (∀ (x : BfgsVerification.Vec n), F x = F xStar → x = xStar) →\n      ∀ {U : Set (BfgsVerification.Vec n)},\n        U ∈ nhds xStar → ∃ δ, 0 < δ ∧ (F (R.x 0) ≤ F xStar + δ → ∀ (k : ℕ), R.x k ∈ U)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.referenceEnergy","signature":"BfgsVerification.ReferenceEnergyTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.projection_columns_iff","signature":"∀ {n r p : ℕ} (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (W : Matrix (Fin n) (Fin p) ℝ), U * U.transpose * W = W ↔ ∀ (j : Fin p), ∃ a, U.mulVec a = fun i => W i j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualBudget.driftProduct_le_exp_tsum","signature":"∀ {u : ℕ → ℝ},\n  (∀ (k : ℕ), 0 ≤ u k) →\n    Summable u → ∀ (N : ℕ), BfgsVerification.ResidualBudget.driftProduct u N ≤ Real.exp (∑' (k : ℕ), u k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.transported_certificate_convergence_on_sublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),\n  IsCompact {x | F x ≤ b} →\n    ∀ (xstar : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F xstar ≤ F x) →\n        F (R.x 0) ≤ b →\n          BfgsVerification.TransportedCertificate.HasBandCertificates F {x | F x ≤ b} (F xstar) R.c₁ R.c₂ →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar)) ∧\n              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧\n                ((∀ (x : BfgsVerification.Vec n), F x = F xstar → x = xstar) →\n                  Filter.Tendsto R.x Filter.atTop (nhds xstar))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.summable_predicted_decreases_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → Summable R.d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift_gradientChange","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  (R.shift J).gradientChange k = R.gradientChange (J + k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.transport","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          ((1 + self.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                (BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z) *\n                    self.W x *\n                  BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z)) -\n              BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z) *\n                  self.W z *\n                BfgsVerification.TransportedCertificate.stepProjector\n                  (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_diagonal","signature":"∀ {n : ℕ} (lam : Fin n → ℝ) (j : ℕ),\n  BfgsVerification.principalSum (Matrix.diagonal lam) j = ∑ I ∈ Finset.powersetCard j Finset.univ, ∏ i ∈ I, lam i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.certificateOfScalarQuotient._proof_2","signature":"0 < 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_orthogonal_coordinates","signature":"∀ {n : ℕ} (U : BfgsVerification.Mat n),\n  U * Matrix.transpose U = 1 →\n    ∀ (y : BfgsVerification.Vec n), BfgsVerification.sqNorm ((Matrix.transpose U).mulVec y) = BfgsVerification.sqNorm y","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.metricGram_submatrix_columns","signature":"∀ {n : ℕ} {ι : Type u_1} {κ : Type u_2} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) ι ℝ) (f : κ → ι),\n  BfgsVerification.metricGram H (Z.submatrix id f) = (BfgsVerification.metricGram H Z).submatrix f f","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.d_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), 0 < R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_nonpositive_forces_escape","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ), F (R.x k) ≤ 0 → Filter.Tendsto (fun j => F (R.x j)) Filter.atTop Filter.atBot","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.supporting_limit","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  Continuous F →\n    ∀ {x g : ℕ → BfgsVerification.Vec n} {xlim glim : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds xlim) →\n        Filter.Tendsto g Filter.atTop (nhds glim) →\n          (∀ (k : ℕ) (z : BfgsVerification.Vec n), BfgsVerification.dot (g k) (z - x k) ≤ F z - F (x k)) →\n            ∀ (z : BfgsVerification.Vec n), BfgsVerification.dot glim (z - xlim) ≤ F z - F xlim","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.euclidean_distance_to_argmin_of_values","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  Continuous F →\n    ∀ (xStar : BfgsVerification.Vec n),\n      (∀ (y : BfgsVerification.Vec n), F xStar ≤ F y) →\n        ∀ {K : Set (BfgsVerification.Vec n)},\n          IsCompact K →\n            ∀ {x : ℕ → BfgsVerification.Vec n},\n              (∀ (k : ℕ), x k ∈ K) →\n                Filter.Tendsto (fun k => F (x k)) Filter.atTop (nhds (F xStar)) →\n                  Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (x k)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.congruence_outer","signature":"∀ {n m : ℕ} (Z : Matrix (Fin n) (Fin m) ℝ) (a b : BfgsVerification.Vec n),\n  Z.transpose * BfgsVerification.outer a b * Z = BfgsVerification.outer (Z.transpose.mulVec a) (Z.transpose.mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.local_transported_certificate_basin_on_neighborhood","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n          ∀ {U : Set (BfgsVerification.Vec n)},\n            U ∈ nhds star →\n              ∀ {c₁ c₂ : ℝ},\n                BfgsVerification.TransportedCertificate.HasBandCertificates F U (F star) c₁ c₂ →\n                  ∃ δ,\n                    0 < δ ∧\n                      ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                        R.c₁ = c₁ →\n                          R.c₂ = c₂ →\n                            F (R.x 0) ≤ F star + δ →\n                              (∀ (k : ℕ), R.x k ∈ U) ∧\n                                Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                  Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift_d_tendsto_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  Filter.Tendsto R.d Filter.atTop (nhds 0) → ∀ (J : ℕ), Filter.Tendsto (R.shift J).d Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J : ℕ),\n  R.shift J =\n    { convex := ⋯, x := fun k => R.x (J + k), H := fun k => R.H (J + k), g := fun k => R.g (J + k),\n      α := fun k => R.α (J + k), c₁ := R.c₁, c₂ := R.c₂, c₁_pos := ⋯, c₁_lt_c₂ := ⋯, c₂_lt_one := ⋯,\n      initial_posDef := ⋯, alpha_pos := ⋯, gradient_nonzero := ⋯, hasGradient := ⋯, step := ⋯, update := ⋯, armijo := ⋯,\n      weak_wolfe := ⋯ }","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb_constants","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η) (hc₂ : c₂ < 1),\n  (C.absorb hc₂).L = 2 * C.L ∧ (C.absorb hc₂).δ = min C.δ (C.L + 1)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.rescale._proof_3","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (w : BfgsVerification.Vec n → ℝ)\n  (lo hi : ℝ),\n  0 < lo →\n    (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, lo ≤ w x ∧ w x ≤ hi) →\n      ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n        ∀ (g : BfgsVerification.Vec n),\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n            lo * C.m ≤ BfgsVerification.metricEnergy (w x • C.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.trace_bound","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k : ℕ), q k ≤ C * E k 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.trapped_in_ball_of_sphere_gap","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xStar : BfgsVerification.Vec n)\n  {r ω : ℝ},\n  0 < r →\n    0 ≤ ω →\n      (∀ (z : BfgsVerification.Vec n), dist z xStar = r → ω ≤ F z - F xStar) →\n        F (R.x 0) - F xStar < ω → ∀ (k : ℕ), R.x k ∈ Metric.ball xStar r","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.certificateOfScalarQuotient._proof_7","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)} {fstar c₁ c₂ η : ℝ} (δ : ℝ)\n  (x z g h : BfgsVerification.Vec 1),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n          ((1 + 0 * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                ((BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z) *\n                    (BfgsVerification.TransportedCertificate.scalarGradient F x ^ 2)⁻¹ •\n                      BfgsVerification.outer (fun x => 1) fun x => 1) *\n                  BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z)) -\n              (BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z) *\n                  (BfgsVerification.TransportedCertificate.scalarGradient F z ^ 2)⁻¹ •\n                    BfgsVerification.outer (fun x => 1) fun x => 1) *\n                BfgsVerification.TransportedCertificate.stepProjector\n                  (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.transport","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ),\n  self.J ≤ k →\n    self.V (k + 1) = self.V k * self.T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (self.b k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.recurrent_gradient_cardinality_of_value_limit","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  (Set.range R.g).Finite →\n    ∀ (L : ℝ),\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds L) →\n        Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)) + 1 ≤\n          (BfgsVerification.Homogeneous.recurrentValues R.g).ncard","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb._proof_17","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η)\n  (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ min C.δ (C.L + 1)⁻¹ →\n          ((1 + 2 * C.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                (BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z) *\n                    Real.exp (C.Ψ x) • C.W x *\n                  BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z)) -\n              BfgsVerification.TransportedCertificate.stepProjector\n                    (BfgsVerification.TransportedCertificate.pairStep x z) *\n                  Real.exp (C.Ψ z) • C.W z *\n                BfgsVerification.TransportedCertificate.stepProjector\n                  (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclideanOpNorm_transpose","signature":"∀ {r : ℕ} (T : BfgsVerification.Mat r),\n  BfgsVerification.FrameNorms.euclideanOpNorm (Matrix.transpose T) = BfgsVerification.FrameNorms.euclideanOpNorm T","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.radial_of_inward_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        ∀ (star : BfgsVerification.Vec n),\n          BfgsVerification.RadialCertificate.HasInwardTaylorBounds F K star →\n            BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.c₂_lt_one","signature":"∀ {f : ℝ → ℝ} (self : BfgsVerification.ScalarMetricRun f), self.c₂ < 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.commonTilt_eq_finiteMaxLinear","signature":"∀ {n : ℕ} (B : Finset (BfgsVerification.Vec n)) (hB : B.Nonempty),\n  BfgsVerification.Homogeneous.commonTilt B hB =\n    BfgsVerification.Homogeneous.finiteMaxLinear (Finset.image BfgsVerification.Homogeneous.tiltedSlope B) ⋯","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.global_log_product_upper._proof_1","signature":"∀ (J N : ℕ), J + 1 ≤ N → ¬N = J + (N - (J + 1) + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.OneDimensional.objective.eq_1","signature":"∀ (F : BfgsVerification.Vec 1 → ℝ) (t : ℝ),\n  BfgsVerification.OneDimensional.objective F t = F (BfgsVerification.OneDimensional.embed t)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (y : BfgsVerification.Vec n) (Z : Matrix (Fin n) ι ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricEnergy H y -\n              Z.transpose.mulVec (Matrix.mulVec H y) ⬝ᵥ\n                (BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H y)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)\n  (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          BfgsVerification.metricEnergy (self.W z) (h - g) ≤\n            self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_sub_le._proof_1","signature":"∀ {ι : Type u_1} {M : Type u_4} {s : Finset ι} [inst : AddCommMonoid M] {f g : ι → M},\n  ∑ x ∈ s, f x + ∑ x ∈ s, g x = ∑ x ∈ s, (f x + g x)","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.geometricMean_eq_exp_logMean","signature":"∀ (q : ℕ → ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    ∀ (N : ℕ),\n      BfgsVerification.reciprocalGeometricMean q N = Real.exp (BfgsVerification.ReciprocalGrowth.logReciprocalMean q N)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.hessianInvariants","signature":"BfgsVerification.HessianInvariantTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.toScalarMetricRun._proof_12","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 1 F) (k : ℕ),\n  BfgsVerification.OneDimensional.objective F (R.x (k + 1) 0) ≤\n    BfgsVerification.OneDimensional.objective F (R.x k 0) + R.c₁ * R.g k 0 * (R.x (k + 1) 0 - R.x k 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_on_tail_incompatible_source","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (J : ℕ) (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 < m →\n                (∀ (k : ℕ),\n                    BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                      L * (R.shift J).curvature k) →\n                  ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                    (b : ℕ → BfgsVerification.Vec p),\n                    (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))) →\n                      (∀ (k : ℕ),\n                          BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                            C₀ * (R.shift J).curvature k) →\n                        (∀ (k : ℕ),\n                            V (k + 1) =\n                              V k * T k +\n                                  BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) +\n                                Z k) →\n                          (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)) →\n                            (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                              (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.secantCurvature_le_four_mul","signature":"∀ {n : ℕ} (star x z g h : BfgsVerification.Vec n) (G R : ℝ),\n  0 ≤ G →\n    0 ≤ R →\n      BfgsVerification.sqNorm g ≤ G ^ 2 →\n        BfgsVerification.sqNorm h ≤ G ^ 2 →\n          BfgsVerification.sqNorm (x - star) ≤ R ^ 2 →\n            BfgsVerification.sqNorm (z - star) ≤ R ^ 2 →\n              BfgsVerification.RadialCertificate.secantCurvature x z g h ≤ 4 * G * R","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.supporting_vector_eq_gradient","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {x a g : BfgsVerification.Vec n},\n  (∀ (z : BfgsVerification.Vec n), BfgsVerification.dot a (z - x) ≤ F z - F x) →\n    HasFDerivAt F (BfgsVerification.gradientFunctional g) x → a = g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalSum_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 → ∀ (j : ℕ), BfgsVerification.principalSum (U * H * V) j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.convergence","signature":"∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f),\n  IsCompact R.initialSublevel →\n    ∀ (xStar : ℝ),\n      (∀ (x : ℝ), f xStar ≤ f x) →\n        (∀ (x : ℝ), f x = f xStar → x = xStar) →\n          Filter.Tendsto (fun k => f (R.x k)) Filter.atTop (nhds (f xStar)) ∧\n            Filter.Tendsto R.x Filter.atTop (nhds xStar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.step","signature":"∀ {f : ℝ → ℝ} (self : BfgsVerification.ScalarMetricRun f) (k : ℕ),\n  self.x (k + 1) = self.x k - self.α k * self.metric k * self.g k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.rank_one_transport","signature":"∀ {n : ℕ} (s v w : BfgsVerification.Vec n) (ell β a : ℝ),\n  w = ell • v + β • s →\n    ell ^ 2 ≤ a →\n      (a •\n            (BfgsVerification.TransportedCertificate.stepProjector s * BfgsVerification.outer v v *\n              BfgsVerification.TransportedCertificate.stepProjector s) -\n          BfgsVerification.TransportedCertificate.stepProjector s * BfgsVerification.outer w w *\n            BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
