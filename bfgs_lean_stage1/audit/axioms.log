BFGS_AUDIT {"theorem":"BfgsVerification.IncomingJump.no_visible_suppression","signature":"∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {n r : ℕ} (W : ι → BfgsVerification.Mat n)\n  (h : ι → BfgsVerification.Vec n) (y : ι → Fin r → BfgsVerification.Vec n) (t coeff : ι → Fin r → ℝ) (m C : ℝ),\n  0 < m →\n    (∀ᶠ (a : ι) in l, Matrix.PosSemidef (W a)) →\n      (∀ᶠ (a : ι) in l, m ≤ BfgsVerification.metricEnergy (W a) (h a)) →\n        (∀ᶠ (a : ι) in l, ∀ (j : Fin r), 0 ≤ t a j) →\n          (∀ᶠ (a : ι) in l, ∀ (j : Fin r), BfgsVerification.metricEnergy (W a) (y a j) ≤ C * t a j) →\n            (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • y a j) →\n              Filter.Tendsto (fun a => ∑ j, |coeff a j| * √(t a j)) l (nhds 0) → False","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.referencePairing.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n)\n  (k : ℕ), R.referencePairing xstar k = BfgsVerification.dot (R.g k) (R.x k - xstar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  {W : BfgsVerification.Vec n → BfgsVerification.Mat n} {m C δ : ℝ} {m_pos : 0 < m} {delta_pos : 0 < δ}\n  {positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x)}\n  {visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g}\n  {secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h}\n  {W_1 : BfgsVerification.Vec n → BfgsVerification.Mat n} {m_1 C_1 δ_1 : ℝ} {m_pos_1 : 0 < m_1} {delta_pos_1 : 0 < δ_1}\n  {positive_semidefinite_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W_1 x)}\n  {visibility_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m_1 ≤ BfgsVerification.metricEnergy (W_1 x) g}\n  {secant_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              BfgsVerification.metricEnergy (W_1 z) (h - g) ≤\n                C_1 * BfgsVerification.TransportedCertificate.pairCurvature x z g h},\n  { W := W, m := m, C := C, δ := δ, m_pos := m_pos, delta_pos := delta_pos,\n        positive_semidefinite := positive_semidefinite, visibility := visibility, secant := secant } =\n      { W := W_1, m := m_1, C := C_1, δ := δ_1, m_pos := m_pos_1, delta_pos := delta_pos_1,\n        positive_semidefinite := positive_semidefinite_1, visibility := visibility_1, secant := secant_1 } →\n    W = W_1 ∧ m = m_1 ∧ C = C_1 ∧ δ = δ_1","axioms":["propext","Quot.sound","Classical.choice"]}
