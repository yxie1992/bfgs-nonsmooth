BFGS_AUDIT {"theorem":"BfgsVerification.orthogonal_coordinate_gram_sum_eq","signature":"∀ {n : ℕ} (H U : BfgsVerification.Mat n) (lam : BfgsVerification.Vec n),\n  U * Matrix.transpose U = 1 →\n    Matrix.transpose U * H * U = Matrix.diagonal lam →\n      (∀ (i : Fin n), 0 < lam i) →\n        ∀ (y : BfgsVerification.Vec n) (j : ℕ),\n          ∑ I ∈ Finset.powersetCard j Finset.univ,\n              (BfgsVerification.metricGram H\n                  ((Matrix.replicateCol Unit y).fromCols (U * BfgsVerification.coordinateMatrix I))).det =\n            ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ,\n              (∏ i ∈ J, lam i) * ∑ k ∈ J, (Matrix.transpose U).mulVec y k ^ 2","axioms":["propext","Classical.choice","Quot.sound"]}
