BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.cutoffFrame_sqNorm_le","signature":"∀ {n r : ℕ} {a : BfgsVerification.Vec n},\n  BfgsVerification.sqNorm a = 1 →\n    ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n      U.transpose * U = 1 →\n        (∀ (v : Fin n → ℝ), (U * U.transpose).mulVec v = BfgsVerification.FixedNormal.tangentProjection a v) →\n          ∀ (y : BfgsVerification.Vec n) {t : ℝ},\n            0 ≤ t →\n              t ≤ 1 →\n                BfgsVerification.sqNorm ((BfgsVerification.FixedNormal.cutoffFrame U a t).transpose.mulVec y) ≤\n                  BfgsVerification.sqNorm y","axioms":["propext","Quot.sound","Classical.choice"]}
