BFGS_AUDIT {"theorem":"BfgsVerification.SeedCycle.middle_metric_gradient","signature":"∀ {c d : ℝ},\n  BfgsVerification.AlgebraicSeed.U c d ≠ 0 →\n    BfgsVerification.AlgebraicSeed.V c d ≠ 0 →\n      BfgsVerification.AlgebraicSeed.U c d + 129 ≠ 0 →\n        Matrix.mulVec (BfgsVerification.SeedCycle.middleMatrix (BfgsVerification.SeedCycle.beta c d) c d)\n            (BfgsVerification.SeedCycle.g2 c d) =\n          (2064 * BfgsVerification.AlgebraicSeed.R c d /\n              (BfgsVerification.AlgebraicSeed.V c d * (BfgsVerification.AlgebraicSeed.U c d + 129))) •\n            ![c - 1, d]","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuadraticGauge.gauge_pairing_bounds","signature":"∀ {p : ℕ} {γ : BfgsVerification.Vec p → ℝ},\n  BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n    ∀ (μ Λ : ℝ),\n      0 < μ →\n        (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →\n          (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →\n            ∀ (v w h j : BfgsVerification.Vec p),\n              BfgsVerification.Homogeneous.Supports γ v h →\n                BfgsVerification.Homogeneous.Supports γ w j →\n                  0 ≤ BfgsVerification.dot (j - h) w ∧\n                    BfgsVerification.dot (j - h) w ≤ BfgsVerification.dot (j - h) (w - v) ∧\n                      BfgsVerification.dot (j - h) w ≤ BfgsVerification.QuadraticGauge.correctionConstant μ Λ * γ w","axioms":["propext","Quot.sound","Classical.choice"]}
