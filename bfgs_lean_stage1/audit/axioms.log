BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_7","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  F (R.x (J + k + 1)) ≤\n    F (R.x (J + k)) +\n      R.c₁ * BfgsVerification.dot (R.g (J + k)) (BfgsVerification.bfgsStep (R.H (J + k)) (R.g (J + k)) (R.α (J + k)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_supporting_bound_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        ∃ G,\n          0 < G ∧\n            ∀ x ∈ K,\n              ∀ (g : BfgsVerification.Vec n),\n                (∀ (y : BfgsVerification.Vec n), BfgsVerification.dot g (y - x) ≤ F y - F x) →\n                  BfgsVerification.sqNorm g ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
