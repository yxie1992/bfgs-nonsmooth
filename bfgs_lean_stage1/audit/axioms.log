BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.common_pairing_from_actual_cornerCharts","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec 2)} {m : ℕ} (points : Fin m → BfgsVerification.Vec 2)\n      (charts : (i : Fin m) → BfgsVerification.PlanarCornerCharts.CornerChart F (points i))\n      {W : BfgsVerification.Vec 2 → BfgsVerification.Vec 2},\n      (∀ (i : Fin m), W (points i) = deriv (charts i).curve (F (points i))) →\n        (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ ∃ i, x = points i) →\n          ∀ x ∈ K,\n            ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n              ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                BfgsVerification.dot g (W x) = BfgsVerification.dot h (W x)","axioms":["propext","Quot.sound","Classical.choice"]}
