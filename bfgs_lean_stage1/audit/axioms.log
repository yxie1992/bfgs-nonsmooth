BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.exists_visible_transverse_planar_field","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n  IsCompact R.initialSublevel →\n    ∀ {ℓ : ℝ},\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        (∃ y, F y < ℓ) →\n          (∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n            (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F p) →\n              (∀ p ∈ BfgsVerification.ClusterSetGeometry.clusterSet R.x,\n                  ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p) →\n                ∃ W,\n                  (∃ η,\n                      0 < η ∧\n                        ∃ N,\n                          IsOpen N ∧\n                            BfgsVerification.ClusterSetGeometry.clusterSet R.x ⊆ N ∧\n                              (∀ p ∈ N, ∃ L, ∃ U ∈ nhds p, LipschitzOnWith L W U) ∧\n                                ∀ p ∈ N,\n                                  ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F p,\n                                    η ≤ BfgsVerification.dot g (W p)) ∧\n                    ∃ κ,\n                      0 < κ ∧\n                        ∃ J,\n                          ∀ (k : ℕ),\n                            J ≤ k →\n                              ∀ θ ∈ Set.Icc 0 1,\n                                κ * ‖BfgsVerification.euclideanVector (R.displacement k)‖ ≤\n                                  |BfgsVerification.HomogeneousPlanar.pairDet (R.displacement k)\n                                      (W (R.x k + θ • R.displacement k))|","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.relativeInteriorZero_iff_nonneg_linear_zero_fiber","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),\n  BfgsVerification.Homogeneous.RelativeInteriorZero A ↔\n    (∀ (x : BfgsVerification.Vec n), 0 ≤ BfgsVerification.Homogeneous.finiteMaxLinear A hA x) ∧\n      ∃ S, ∀ (x : BfgsVerification.Vec n), BfgsVerification.Homogeneous.finiteMaxLinear A hA x = 0 ↔ x ∈ S","axioms":["propext","Quot.sound","Classical.choice"]}
