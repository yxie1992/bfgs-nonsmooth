BFGS_AUDIT {"theorem":"BfgsVerification.fullBFGS_positive_invariants","signature":"∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ) (c₂ : ℝ),\n  Matrix.PosDef (H 0) →\n    (∀ (k : ℕ), g k ≠ 0) →\n      (∀ (k : ℕ), 0 < α k) →\n        c₂ < 1 →\n          (∀ (k : ℕ),\n              c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤\n                BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))) →\n            (∀ (k : ℕ),\n                H (k + 1) =\n                  BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)) →\n              ∀ (k : ℕ),\n                Matrix.PosDef (H k) ∧\n                  0 < BfgsVerification.metricEnergy (H k) (g k) ∧\n                    0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverse_mul_step","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H → ∀ (g : BfgsVerification.Vec n) (α : ℝ), Matrix.mulVec H⁻¹ (BfgsVerification.bfgsStep H g α) = -α • g","axioms":["propext","Quot.sound","Classical.choice"]}
