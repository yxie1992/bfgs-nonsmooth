BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frame_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (k : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (V W Z : Matrix (Fin n) (Fin p) ℝ) (T : BfgsVerification.Mat p) (b : BfgsVerification.Vec p)\n          (m C₀ C_T C_R : ℝ),\n          0 ≤ C_T →\n            m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)) →\n              BfgsVerification.sqNorm (W.transpose.mulVec (R.gradientChange k)) ≤ C₀ * R.curvature k →\n                W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b + Z →\n                  BfgsVerification.FrameBounds.OperatorSqBound T (1 + C_T * R.d k) →\n                    U * U.transpose * Z = Z →\n                      BfgsVerification.SmoothSubspace.frobSq Z ≤ C_R * R.d k →\n                        (BfgsVerification.metricGram (R.hessian (k + 1)) W).trace ≤\n                          (1 + R.d k) * (1 + C_T * R.d k) *\n                                ((BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k) +\n                              (1 + (R.d k)⁻¹) *\n                                (C_R * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)) +\n                            C₀","axioms":["propext","Classical.choice","Quot.sound"]}
