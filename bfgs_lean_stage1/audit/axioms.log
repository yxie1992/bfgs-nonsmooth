BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.rankOneCertificate._proof_4","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (v : BfgsVerification.Vec n → BfgsVerification.Vec n) (L δ : ℝ),\n  (∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              ∃ ell β,\n                v z = ell • v x + β • BfgsVerification.TransportedCertificate.pairStep x z ∧\n                  ell ^ 2 ≤ 1 + L * BfgsVerification.TransportedCertificate.pairDecrease x z g) →\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              ((1 + L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        BfgsVerification.outer (v x) (v x) *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      BfgsVerification.outer (v z) (v z) *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.finiteHorizon","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          Summable R.d →\n            ∀ (J m : ℕ),\n              0 < m →\n                ∀ (η : ℝ),\n                  0 < η →\n                    let D := ∑' (i : ℕ), R.d (J + i);\n                    let V :=\n                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                        (BfgsVerification.principalSum (R.H J));\n                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
