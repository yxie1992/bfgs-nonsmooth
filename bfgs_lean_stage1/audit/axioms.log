BFGS_AUDIT {"theorem":"BfgsVerification.RadialPower.mixed_linear_powers_radial","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (γ : (j : ι) → BfgsVerification.Vec (m j) → ℝ),\n      (∀ (j : ι), ConvexOn ℝ Set.univ (γ j)) →\n        (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (γ j)) →\n          (∀ (j : ι) (x : BfgsVerification.Vec (m j)), 0 ≤ γ j x) →\n            ∀ (A : (j : ι) → BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec (m j)) (p : ι → ℝ),\n              (∀ (j : ι), 1 ≤ p j) →\n                ∀ (star : BfgsVerification.Vec n) {U K : Set (BfgsVerification.Vec n)},\n                  IsOpen U →\n                    BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n                      IsCompact K →\n                        K ⊆ U →\n                          (∀ x ∈ U, F x = ψ x + ∑ j, γ j ((A j) (x - star)) ^ p j) →\n                            BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.fixed_basis_spans_near","signature":"∀ {d n m r : ℕ} (g : BfgsVerification.Vec d → Fin m → BfgsVerification.Vec n) (p : BfgsVerification.Vec d)\n  (a : Fin r → Fin m),\n  Fin r →\n    (∀ (i : Fin m), ContinuousAt (fun x => g x i) p) →\n      (AffineIndependent ℝ fun q => g p (a q)) →\n        affineSpan ℝ (Set.range fun q => g p (a q)) = affineSpan ℝ (Set.range (g p)) →\n          (∀ᶠ (x : BfgsVerification.Vec d) in nhds p,\n              Module.finrank ℝ ↥(vectorSpan ℝ (Set.range (g x))) = Module.finrank ℝ ↥(vectorSpan ℝ (Set.range (g p)))) →\n            ∀ᶠ (x : BfgsVerification.Vec d) in nhds p,\n              (AffineIndependent ℝ fun q => g x (a q)) ∧\n                affineSpan ℝ (Set.range fun q => g x (a q)) = affineSpan ℝ (Set.range (g x))","axioms":["propext","Classical.choice","Quot.sound"]}
