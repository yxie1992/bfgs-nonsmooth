BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.projected_strong_supporting_inequality","signature":"∀ {n m : ℕ} (P : BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec m) {F : BfgsVerification.Vec n → ℝ}\n  {U : Set (BfgsVerification.Vec n)} {μ : ℝ},\n  (ConvexOn ℝ U fun x => F x - μ / 2 * BfgsVerification.sqNorm (P x)) →\n    ∀ {x z g : BfgsVerification.Vec n},\n      x ∈ U →\n        z ∈ U →\n          BfgsVerification.Homogeneous.Supports F x g →\n            BfgsVerification.dot g (z - x) + μ / 2 * BfgsVerification.sqNorm (P (z - x)) ≤ F z - F x","axioms":["propext","Quot.sound","Classical.choice"]}
