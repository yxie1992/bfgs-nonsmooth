BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.coercive_scaled_reject","signature":"∀ {t c₁ : ℝ},\n  0 < t →\n    t ≤ 1 →\n      0 < c₁ →\n        ∀ (q : Fin 9),\n          BfgsVerification.SeedOrbit.trialAccept q = false →\n            ¬BfgsVerification.DeterministicLineSearch.Armijo BfgsVerification.SeedOrbit.coerciveObjective\n                (t •\n                  BfgsVerification.SeedOrbit.point BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    BfgsVerification.SeedOrbit.seedRatio (BfgsVerification.SeedOrbit.trialPhase q))\n                (t •\n                  BfgsVerification.SeedOrbit.direction BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                    BfgsVerification.SeedOrbit.seedRatio (BfgsVerification.SeedOrbit.trialPhase q))\n                (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (BfgsVerification.SeedOrbit.trialPhase q))\n                c₁ (BfgsVerification.SeedOrbit.trialLength q)","axioms":["propext","Quot.sound","Classical.choice"]}
