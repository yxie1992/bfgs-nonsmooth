BFGS_AUDIT {"theorem":"BfgsVerification.LocalStableOrbit.stable_sequence_exists","signature":"∀ {S : Type u_1} {U : Type u_2} [inst : NormedAddCommGroup S] [inst_1 : NormedSpace ℝ S] [inst_2 : CompleteSpace S]\n  [inst_3 : NormedAddCommGroup U] [inst_4 : NormedSpace ℝ U] [inst_5 : CompleteSpace U] (A : S →L[ℝ] S) (B : U →L[ℝ] U)\n  (N : S × U → S × U) (a : S),\n  ContinuousAt N 0 →\n    N 0 = 0 →\n      ∀ {R δ : ℝ} {K : NNReal},\n        0 ≤ R →\n          0 ≤ δ →\n            K < 1 →\n              ‖a‖ ≤ R →\n                ‖A‖ + δ ≤ ↑K →\n                  ‖B‖ * (1 + δ) ≤ ↑K →\n                    (∀ (x y : S × U), ‖x‖ ≤ R → ‖y‖ ≤ R → ‖N x - N y‖ ≤ δ * ‖x - y‖) →\n                      ∃ w,\n                        ‖w‖ ≤ R ∧\n                          (w 0).1 = a ∧\n                            ∀ (n : ℕ),\n                              (w (n + 1)).1 = A (w n).1 + (N (w n)).1 ∧ (w n).2 = B ((w (n + 1)).2 - (N (w n)).2)","axioms":["propext","Classical.choice","Quot.sound"]}
