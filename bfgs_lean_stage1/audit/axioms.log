BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r p : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ) (orthonormal : U.transpose * U = 1) (L m C₀ C_T C_R : ℝ) (m_pos : 0 < m)\n  (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p) (b : ℕ → BfgsVerification.Vec p)\n  (smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k)\n  (visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k)))\n  (correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k)\n  (transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k)\n  (operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k))\n  (residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k)\n  (residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k),\n  sizeOf\n      { J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n    1 + sizeOf J + sizeOf r + sizeOf p + sizeOf orthonormal + sizeOf L + sizeOf m + sizeOf C₀ + sizeOf C_T +\n        sizeOf C_R +\n      sizeOf m_pos","axioms":["propext","Classical.choice","Quot.sound"]}
