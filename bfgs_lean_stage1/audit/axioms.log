BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.exists_one_sided_constant_on_compact","signature":"∀ {n : ℕ} {ψ : BfgsVerification.Vec n → ℝ} {U K : Set (BfgsVerification.Vec n)},\n  IsOpen U →\n    ConvexOn ℝ U ψ →\n      BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n        IsCompact K →\n          K ⊆ U →\n            ∃ L,\n              0 < L ∧\n                ∀ x ∈ K,\n                  ∀ y ∈ K,\n                    BfgsVerification.sqNorm\n                        (BfgsVerification.coordinateGradient ψ y - BfgsVerification.coordinateGradient ψ x) ≤\n                      2 * L * (ψ y - ψ x - BfgsVerification.dot (BfgsVerification.coordinateGradient ψ x) (y - x))","axioms":["propext","Classical.choice","Quot.sound"]}
