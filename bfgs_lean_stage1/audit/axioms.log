BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.exists_separating_cutoff","signature":"∀ {E Z : Set ℝ},\n  IsClosed E →\n    IsCompact Z →\n      Disjoint Z E →\n        ∃ δ,\n          0 < δ ∧\n            ∃ L τ,\n              LipschitzWith L τ ∧\n                (∀ (t : ℝ), 0 ≤ τ t ∧ τ t ≤ 1) ∧ (∀ t ∈ Z, τ t = 1) ∧ ∀ (t e : ℝ), e ∈ E → |t - e| ≤ δ → τ t = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.HomogeneousBlock.tendsto_zero_of_anchor_blocks","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] (x : ℕ → E) (p : ℕ → Prop),\n  (∀ (K : ℕ), ∃ j, K ≤ j ∧ p j) →\n    (∀ (ε : ℝ), 0 < ε → ∃ J, ∀ (j : ℕ), J ≤ j → p j → ‖x j‖ < ε) →\n      ∀ (C : ℝ),\n        0 ≤ C →\n          (∀ (a b : ℕ),\n              a < b →\n                p a →\n                  p b →\n                    (∀ (j : ℕ), a < j → j < b → ¬p j) →\n                      ∀ (k : ℕ), a ≤ k → k ≤ b → ‖x k‖ ≤ (1 + C) * ‖x a‖ + C * ‖x b‖) →\n            Filter.Tendsto x Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
