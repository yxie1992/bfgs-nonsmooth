BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.incoming_jump_no_visibility_secant","signature":"∀ {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {n r : ℕ} {F : BfgsVerification.Vec n → ℝ}\n  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin r → BfgsVerification.Vec n) (coeff : ι → Fin r → ℝ),\n      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n        (∀ (a : ι) (j : Fin r), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →\n          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →\n            (∀ (a : ι) (j : Fin r),\n                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →\n              (∀ (j : Fin r),\n                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l\n                    (nhds 0)) →\n                (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • (h a - g a j)) →\n                  Filter.Tendsto\n                      (fun a =>\n                        ∑ j,\n                          |coeff a j| *\n                            √(BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)))\n                      l (nhds 0) →\n                    ¬Nonempty (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.curvature_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  0 < BfgsVerification.dot (R.g (k + 1) - R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {convex : ConvexOn ℝ Set.univ F} {x : ℕ → BfgsVerification.Vec n}\n  {H : ℕ → BfgsVerification.Mat n} {g : ℕ → BfgsVerification.Vec n} {α : ℕ → ℝ} {c₁ c₂ : ℝ} {c₁_pos : 0 < c₁}\n  {c₁_lt_c₂ : c₁ < c₂} {c₂_lt_one : c₂ < 1} {initial_posDef : Matrix.PosDef (H 0)} {alpha_pos : ∀ (k : ℕ), 0 < α k}\n  {gradient_nonzero : ∀ (k : ℕ), g k ≠ 0}\n  {hasGradient : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g k)) (x k)}\n  {step : ∀ (k : ℕ), x (k + 1) = x k + BfgsVerification.bfgsStep (H k) (g k) (α k)}\n  {update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)}\n  {armijo :\n    ∀ (k : ℕ), F (x (k + 1)) ≤ F (x k) + c₁ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k))}\n  {weak_wolfe :\n    ∀ (k : ℕ),\n      c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤\n        BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))}\n  {convex_1 : ConvexOn ℝ Set.univ F} {x_1 : ℕ → BfgsVerification.Vec n} {H_1 : ℕ → BfgsVerification.Mat n}\n  {g_1 : ℕ → BfgsVerification.Vec n} {α_1 : ℕ → ℝ} {c₁_1 c₂_1 : ℝ} {c₁_pos_1 : 0 < c₁_1} {c₁_lt_c₂_1 : c₁_1 < c₂_1}\n  {c₂_lt_one_1 : c₂_1 < 1} {initial_posDef_1 : Matrix.PosDef (H_1 0)} {alpha_pos_1 : ∀ (k : ℕ), 0 < α_1 k}\n  {gradient_nonzero_1 : ∀ (k : ℕ), g_1 k ≠ 0}\n  {hasGradient_1 : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g_1 k)) (x_1 k)}\n  {step_1 : ∀ (k : ℕ), x_1 (k + 1) = x_1 k + BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)}\n  {update_1 :\n    ∀ (k : ℕ),\n      H_1 (k + 1) =\n        BfgsVerification.inverseBFGS (H_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) (g_1 (k + 1) - g_1 k)}\n  {armijo_1 :\n    ∀ (k : ℕ),\n      F (x_1 (k + 1)) ≤\n        F (x_1 k) + c₁_1 * BfgsVerification.dot (g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k))}\n  {weak_wolfe_1 :\n    ∀ (k : ℕ),\n      c₂_1 * BfgsVerification.dot (g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) ≤\n        BfgsVerification.dot (g_1 (k + 1)) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k))},\n  { convex := convex, x := x, H := H, g := g, α := α, c₁ := c₁, c₂ := c₂, c₁_pos := c₁_pos, c₁_lt_c₂ := c₁_lt_c₂,\n        c₂_lt_one := c₂_lt_one, initial_posDef := initial_posDef, alpha_pos := alpha_pos,\n        gradient_nonzero := gradient_nonzero, hasGradient := hasGradient, step := step, update := update,\n        armijo := armijo, weak_wolfe := weak_wolfe } =\n      { convex := convex_1, x := x_1, H := H_1, g := g_1, α := α_1, c₁ := c₁_1, c₂ := c₂_1, c₁_pos := c₁_pos_1,\n        c₁_lt_c₂ := c₁_lt_c₂_1, c₂_lt_one := c₂_lt_one_1, initial_posDef := initial_posDef_1, alpha_pos := alpha_pos_1,\n        gradient_nonzero := gradient_nonzero_1, hasGradient := hasGradient_1, step := step_1, update := update_1,\n        armijo := armijo_1, weak_wolfe := weak_wolfe_1 } →\n    x = x_1 ∧ H = H_1 ∧ g = g_1 ∧ α = α_1 ∧ c₁ = c₁_1 ∧ c₂ = c₂_1","axioms":["propext","Quot.sound","Classical.choice"]}
