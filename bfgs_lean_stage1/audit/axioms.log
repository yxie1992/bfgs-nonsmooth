BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.family_signs_eq_of_product_profile","signature":"∀ {m : ℕ} (q : Fin m → Polynomial ℝ) {x y : ℝ},\n  x ∉ (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q).roots.toFinset →\n    y ∉ (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q).roots.toFinset →\n      BfgsVerification.RealAlgebraicGeometry.cutProfile\n            (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q).roots.toFinset x =\n          BfgsVerification.RealAlgebraicGeometry.cutProfile\n            (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q).roots.toFinset y →\n        ∀ (i : Fin m), SignType.sign (Polynomial.eval x (q i)) = SignType.sign (Polynomial.eval y (q i))","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.LNormalizedOracle.Conditions.physical_reject","signature":"∀ {μ c₁ c₂ : ℝ} {w : BfgsVerification.LNormalizedReturn.State},\n  BfgsVerification.LNormalizedOracle.Conditions μ c₁ c₂ w →\n    0 < BfgsVerification.LNormalizedReturn.scale w →\n      ∀ (q : Fin 9),\n        BfgsVerification.SeedOrbit.trialAccept q = false →\n          ¬BfgsVerification.DeterministicLineSearch.Armijo (BfgsVerification.LQuadraticSeed.objective μ)\n              (BfgsVerification.LNormalizedOracle.physicalPoint μ w (BfgsVerification.SeedOrbit.trialPhase q))\n              (BfgsVerification.bfgsStep\n                (BfgsVerification.LNormalizedOracle.physicalMetric μ w (BfgsVerification.SeedOrbit.trialPhase q))\n                (BfgsVerification.LNormalizedOracle.phaseGradient μ w (BfgsVerification.SeedOrbit.trialPhase q)) 1)\n              (BfgsVerification.LNormalizedOracle.phaseGradient μ w (BfgsVerification.SeedOrbit.trialPhase q)) c₁\n              (BfgsVerification.SeedOrbit.trialLength q)","axioms":["propext","Classical.choice","Quot.sound"]}
