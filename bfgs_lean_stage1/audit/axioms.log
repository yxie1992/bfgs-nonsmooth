BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.local_radial_iff_nested_central","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        ((∃ b,\n            F star < b ∧\n              IsCompact {x | F x ≤ b} ∧ BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star) ↔\n          ∃ b,\n            F star < b ∧ IsCompact {x | F x ≤ b} ∧ BfgsVerification.RadialCertificate.HasNestedCentralBounds F star b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.normalize_field","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)\n  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b) (x : BfgsVerification.Vec n),\n  (C.normalize hc₁ hc₂ b hb).W x = Real.exp (C.L / c₁ * (F x - fstar)) • C.W x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineCriticalObjective.equal_rate_exists_iff_not_affineCritical","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (x : BfgsVerification.Vec n),\n      (∃ v, ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x, BfgsVerification.dot g v = -1) ↔\n        ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F x","axioms":["propext","Quot.sound","Classical.choice"]}
