  BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.mk {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
    {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ} (W : BfgsVerification.Vec n → BfgsVerification.Mat n)
