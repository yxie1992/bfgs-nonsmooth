BFGS_AUDIT {"theorem":"BfgsVerification.metricGram.eq_1","signature":"∀ {n : ℕ} {ι : Type u_1} (H : BfgsVerification.Mat n) (X : Matrix (Fin n) ι ℝ),\n  BfgsVerification.metricGram H X = X.transpose * H * X","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.det_one_add_smul_conjugate","signature":"∀ {ι : Type u_1} {R : Type u_2} [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : CommRing R] (t : R)\n  (U V H : Matrix ι ι R), U * V = 1 → (1 + t • (U * H * V)).det = (1 + t • H).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.step","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    ∀ (k j : ℕ), 1 ≤ j → j ≤ n → q k * E (k + 1) j ≤ K * E k (j + 1) + δ k * E k j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.log_product_upper_of_potential","signature":"∀ (q V a : ℕ → ℝ) (C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      (∀ (k : ℕ), 0 < a k) →\n        0 < C →\n          (∀ (k : ℕ), q k * V (k + 1) ≤ a k * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ i ∈ Finset.range (m + 1), Real.log (q (J + i)) ≤\n                Real.log (C * V J) + ∑ i ∈ Finset.range m, Real.log (a (J + i))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_append_orthogonal","signature":"∀ {n : ℕ} {ι : Type u_1} (H U : BfgsVerification.Mat n),\n  U * Matrix.transpose U = 1 →\n    ∀ (y : BfgsVerification.Vec n) (X : Matrix (Fin n) ι ℝ),\n      BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols (U * X)) =\n        BfgsVerification.metricGram (Matrix.transpose U * H * U)\n          ((Matrix.replicateCol Unit ((Matrix.transpose U).mulVec y)).fromCols X)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.hierarchy_tail_potentials","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    BfgsVerification.ScalarHierarchy.UpperNull δ →\n      ∀ (A : ℝ),\n        0 < A → ∃ J V, (∀ (k : ℕ), 0 < V k) ∧ (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) ∧ ∀ (k : ℕ), q k ≤ C * V k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.diagonal_pos_of_posDef","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n}, Matrix.PosDef H → ∀ (i : Fin n), 0 < H i i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.mk.inj","signature":"∀ {n : ℕ} {H : ℕ → BfgsVerification.Mat n} {g : ℕ → BfgsVerification.Vec n} {α : ℕ → ℝ}\n  {positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)} {alpha_pos : ∀ (k : ℕ), 0 < α k}\n  {energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k)}\n  {curvature_pos : ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k))}\n  {update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)}\n  {H_1 : ℕ → BfgsVerification.Mat n} {g_1 : ℕ → BfgsVerification.Vec n} {α_1 : ℕ → ℝ}\n  {positive_definite_1 : ∀ (k : ℕ), Matrix.PosDef (H_1 k)} {alpha_pos_1 : ∀ (k : ℕ), 0 < α_1 k}\n  {energy_pos_1 : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H_1 k) (g_1 k)}\n  {curvature_pos_1 :\n    ∀ (k : ℕ), 0 < BfgsVerification.dot (g_1 (k + 1) - g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k))}\n  {update_1 :\n    ∀ (k : ℕ),\n      H_1 (k + 1) =\n        BfgsVerification.inverseBFGS (H_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) (g_1 (k + 1) - g_1 k)},\n  { H := H, g := g, α := α, positive_definite := positive_definite, alpha_pos := alpha_pos, energy_pos := energy_pos,\n        curvature_pos := curvature_pos, update := update } =\n      { H := H_1, g := g_1, α := α_1, positive_definite := positive_definite_1, alpha_pos := alpha_pos_1,\n        energy_pos := energy_pos_1, curvature_pos := curvature_pos_1, update := update_1 } →\n    H = H_1 ∧ g = g_1 ∧ α = α_1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_gram","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (I : Finset (Fin n)),\n  BfgsVerification.metricGram H (BfgsVerification.coordinateMatrix I) = Matrix.submatrix H Subtype.val Subtype.val","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_sub_left","signature":"∀ {n : ℕ} (x y z : BfgsVerification.Vec n),\n  BfgsVerification.dot (x - y) z = BfgsVerification.dot x z - BfgsVerification.dot y z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_apply","signature":"∀ {n : ℕ} {ι : Type u_1} (H : BfgsVerification.Mat n) (X : Matrix (Fin n) ι ℝ) (i j : ι),\n  BfgsVerification.metricGram H X i j = BfgsVerification.dot (fun k => X k i) (Matrix.mulVec H fun k => X k j)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.log_potential_telescope","signature":"∀ (q V : ℕ → ℝ) (A : ℝ) (J : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n          ∀ (m : ℕ),\n            ∑ k ∈ Finset.range m, Real.log (q (J + k)) + Real.log (V (J + m)) ≤ Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_coeff._proof_1","signature":"∀ {α : Sort u_1} {a b : α}, (a = b) = (b = a)","axioms":["propext"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.compressed_inverseBFGS_bound","signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.PosDef H →\n    Function.Injective Z.mulVec →\n      0 < α →\n        0 < BfgsVerification.metricEnergy H g →\n          0 < -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g →\n            let q := BfgsVerification.metricEnergy H g;\n            let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n            (BfgsVerification.metricGram (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) Z).det ≤\n              (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det / (β ^ 2 * q) +\n                α / β * (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_one","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n), BfgsVerification.principalSum H 1 = Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weightedPotential.eq_1","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.weightedPotential n r e = ∑ j ∈ Finset.range n, r ^ j * e (j + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_smul_right","signature":"∀ {n : ℕ} (a : ℝ) (x y : BfgsVerification.Vec n), BfgsVerification.dot x (a • y) = a * BfgsVerification.dot x y","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.sum_compressed_bounds._proof_1","signature":"∀ {ι : Type u_1} {α : Type u_3} [inst : NonUnitalNonAssocSemiring α] (s : Finset ι) (f : ι → α) (a : α),\n  ∑ i ∈ s, a * f i = a * ∑ i ∈ s, f i","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.mk.injEq","signature":"∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)\n  (positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k))\n  (curvature_pos : ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k))\n  (H_1 : ℕ → BfgsVerification.Mat n) (g_1 : ℕ → BfgsVerification.Vec n) (α_1 : ℕ → ℝ)\n  (positive_definite_1 : ∀ (k : ℕ), Matrix.PosDef (H_1 k)) (alpha_pos_1 : ∀ (k : ℕ), 0 < α_1 k)\n  (energy_pos_1 : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H_1 k) (g_1 k))\n  (curvature_pos_1 :\n    ∀ (k : ℕ), 0 < BfgsVerification.dot (g_1 (k + 1) - g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)))\n  (update_1 :\n    ∀ (k : ℕ),\n      H_1 (k + 1) =\n        BfgsVerification.inverseBFGS (H_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) (g_1 (k + 1) - g_1 k)),\n  ({ H := H, g := g, α := α, positive_definite := positive_definite, alpha_pos := alpha_pos, energy_pos := energy_pos,\n        curvature_pos := curvature_pos, update := update } =\n      { H := H_1, g := g_1, α := α_1, positive_definite := positive_definite_1, alpha_pos := alpha_pos_1,\n        energy_pos := energy_pos_1, curvature_pos := curvature_pos_1, update := update_1 }) =\n    (H = H_1 ∧ g = g_1 ∧ α = α_1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.normalizedLower.eq_1","signature":"∀ (A D : ℝ) (n m : ℕ),\n  BfgsVerification.QuantitativeGrowth.normalizedLower A D n m =\n    ↑m / (↑m + 1) * Real.exp (-(Real.log A + (↑n + 1) * Real.log ↑m) / (↑m + 1) - ↑m / (↑m + 1) * Real.log (2 * D))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.inverseBFGS_compression","signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.IsSymm H →\n    α ≠ 0 →\n      BfgsVerification.metricEnergy H g ≠ 0 →\n        -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g ≠ 0 →\n          let q := BfgsVerification.metricEnergy H g;\n          let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n          Z.transpose * BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y * Z =\n            BfgsVerification.CompressionDeterminant.compression (Z.transpose * H * Z)\n                (Z.transpose.mulVec (Matrix.mulVec H g)) (Z.transpose.mulVec (Matrix.mulVec H y)) (-β * q)\n                (BfgsVerification.dot y (Matrix.mulVec H y)) +\n              (α / (β * q)) •\n                BfgsVerification.outer (Z.transpose.mulVec (Matrix.mulVec H g)) (Z.transpose.mulVec (Matrix.mulVec H g))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.superquadraticGrowth_of_principalMinorHierarchy","signature":"BfgsVerification.PrincipalMinorHierarchyTarget → BfgsVerification.SuperquadraticReciprocalTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_eq_zero_of_dimension_lt","signature":"∀ {n j : ℕ} (H : BfgsVerification.Mat n), n < j → BfgsVerification.principalSum H j = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.finiteHorizon","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          Summable R.d →\n            ∀ (J m : ℕ),\n              0 < m →\n                ∀ (η : ℝ),\n                  0 < η →\n                    let D := ∑' (i : ℕ), R.d (J + i);\n                    let V :=\n                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                        (BfgsVerification.principalSum (R.H J));\n                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (η D : ℝ),\n            0 < η →\n              0 ≤ D →\n                ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                  ↑(m + 1) *\n                      Real.exp\n                        (-(Real.log (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) (E J)) +\n                              ↑m * Real.log (η + D / ↑m)) /\n                          ↑(m + 1)) ≤\n                    ∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.compressed_energy_le","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        BfgsVerification.dot (Z.transpose.mulVec (Matrix.mulVec H g))\n            ((BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H g))) ≤\n          BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
