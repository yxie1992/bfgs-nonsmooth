BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.exists_regular_corner_motion","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x : BfgsVerification.Vec 2},\n      BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F x →\n        ∃ f p,\n          p (F x) = x ∧\n            ContDiffAt ℝ 2 p (F x) ∧\n              ContDiffAt ℝ 1 (deriv p) (F x) ∧\n                (∀ (i : Fin 2), ContinuousAt (fun t => BfgsVerification.coordinateGradient (f i) (p t)) (F x)) ∧\n                  (∀ᶠ (t : ℝ) in nhds (F x),\n                      F (p t) = t ∧\n                        ∀ (i : Fin 2),\n                          BfgsVerification.Homogeneous.Supports F (p t)\n                              (BfgsVerification.coordinateGradient (f i) (p t)) ∧\n                            BfgsVerification.dot (BfgsVerification.coordinateGradient (f i) (p t)) (deriv p t) = 1) ∧\n                    ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, ¬DifferentiableAt ℝ F z → z = p (F z)","axioms":["propext","Classical.choice","Quot.sound"]}
