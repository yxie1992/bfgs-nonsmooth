BFGS_AUDIT {"theorem":"BfgsVerification.ResidualBudget.residual_reciprocal_sum_le","signature":"∀ {E q u : ℕ → ℝ} {m C : ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ u k) →\n        Summable u →\n          0 < m →\n            0 ≤ C →\n              (∀ (k : ℕ), E (k + 1) ≤ (1 + u k) * (E k - m / q k) + C * (↑k + 1)) →\n                ∀ (N : ℕ),\n                  m / Real.exp (∑' (k : ℕ), u k) * ∑ k ∈ Finset.range N, (q k)⁻¹ ≤\n                    E 0 + C * ∑ k ∈ Finset.range N, (↑k + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
