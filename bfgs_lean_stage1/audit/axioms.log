    (Ψ : BfgsVerification.Vec n → ℝ) (m C L δ ψlo ψhi : ℝ) (m_pos : 0 < m) (L_nonneg : 0 ≤ L) (delta_pos : 0 < δ)
    (potential_bounds : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, ψlo ≤ Ψ x ∧ Ψ x ≤ ψhi)
    (positive_semidefinite :
      ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,
        DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))
    (visibility :
      ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,
        ∀ (g : BfgsVerification.Vec n),
          HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)
    (secant :
      ∀ (x z g h : BfgsVerification.Vec n),
        x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
          z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
              BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                BfgsVerification.metricEnergy (W z) (h - g) ≤
                  C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)
    (transport :
      ∀ (x z g h : BfgsVerification.Vec n),
        x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
          z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
              BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                (Real.exp (L * BfgsVerification.TransportedCertificate.pairDecrease x z g + Ψ x - Ψ z) •
                      (BfgsVerification.TransportedCertificate.stepProjector
                            (BfgsVerification.TransportedCertificate.pairStep x z) *
                          W x *
                        BfgsVerification.TransportedCertificate.stepProjector
                          (BfgsVerification.TransportedCertificate.pairStep x z)) -
                    BfgsVerification.TransportedCertificate.stepProjector
                          (BfgsVerification.TransportedCertificate.pairStep x z) *
                        W z *
                      BfgsVerification.TransportedCertificate.stepProjector
                        (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef) :
    BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η
def BfgsVerification.TransportedCertificate.ScalarQuotientBound : (BfgsVerification.Vec 1 → ℝ) →
  Set (BfgsVerification.Vec 1) → ℝ → ℝ → ℝ → ℝ → Prop :=
fun F K fstar c₁ c₂ η =>
  ∃ δ,
    0 < δ ∧
      ∃ A,
        ∀ (x z g h : BfgsVerification.Vec 1),
          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                  |h 0 - g 0| / (|z 0 - x 0| * h 0 ^ 2) ≤ A
def BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz : (BfgsVerification.Vec 1 → ℝ) →
  Set (BfgsVerification.Vec 1) → ℝ → ℝ → ℝ → ℝ → Prop :=
fun F K fstar c₁ c₂ η =>
  ∃ δ,
    0 < δ ∧
      ∃ A,
        ∀ (x z g h : BfgsVerification.Vec 1),
          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →
              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ → |h 0 - g 0| ≤ A * |z 0 - x 0|
def BfgsVerification.TransportedCertificate.HasShellCertificates : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → ℝ → ℝ → ℝ → Prop :=
fun {n} F K fstar c₁ c₂ =>
  ∀ (ell : ℝ),
    fstar < ell →
      (∃ x ∈ K, ell ≤ F x) →
        ∃ ε,
          0 < ε ∧
            Nonempty
              (BfgsVerification.TransportedCertificate.BandCertificate F (K ∩ {x | F x ≤ ell + ε}) fstar c₁ c₂
                (ell - fstar))
def BfgsVerification.RadialCertificate.HasInterceptBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : ℝ),
    0 < η →
      ∃ C,
        ∀ (x z g h : BfgsVerification.Vec n),
          x ∈ K →
            z ∈ K →
              F star + η ≤ F z →
                F z ≤ F x →
                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                    HasFDerivAt F (BfgsVerification.gradientFunctional h) z →
                      0 < BfgsVerification.RadialCertificate.secantCurvature x z g h →
                        (BfgsVerification.RadialCertificate.optimizerIntercept F star z h -
                              BfgsVerification.RadialCertificate.optimizerIntercept F star x g) ^
                            2 ≤
                          C * BfgsVerification.RadialCertificate.secantCurvature x z g h
def BfgsVerification.RadialCertificate.HasInwardTaylorBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : ℝ),
    0 < η →
      ∃ M θ,
        0 < θ ∧
          θ ≤ 1 / 2 ∧
            ∀ (x g : BfgsVerification.Vec n),
              x ∈ K →
                F star + η ≤ F x →
                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                    ∀ (t : ℝ),
                      0 ≤ t →
                        t ≤ θ →
                          0 ≤
                              BfgsVerification.RadialCertificate.supportingError F x g
                                (BfgsVerification.RadialCertificate.inwardPoint star x t) ∧
                            BfgsVerification.RadialCertificate.supportingError F x g
                                (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤
                              M / 2 * t ^ 2
def BfgsVerification.CertificateNormalizationTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ : ℝ},
  0 < c₁ →
    c₂ < 1 →
      ∀ (b : ℝ),
        (∀ x ∈ K, F x ≤ b) →
          (BfgsVerification.TransportedCertificate.HasBandCertificates F K fstar c₁ c₂ ↔
            ∀ (η : ℝ),
              0 < η → (BfgsVerification.TransportedCertificate.positiveBand F K fstar η).Nonempty → ∃ C, C.L = 0)
def BfgsVerification.RecurrentAffineHullTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) (L : ℝ),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds L) →
    0 ∈ affineSpan ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)
def BfgsVerification.MaxLinearAffineEscapeTarget : Prop :=
∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  0 ∉ affineSpan ℝ ↑A →
    Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop Filter.atBot
def BfgsVerification.RadialInterceptEquivalenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {K : Set (BfgsVerification.Vec n)},
      IsCompact K →
        ∀ (star : BfgsVerification.Vec n),
          BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star ↔
            BfgsVerification.RadialCertificate.HasInterceptBounds F K star
def BfgsVerification.InwardCertificateConvergenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.RadialCertificate.HasInwardTaylorBounds F {x | F x ≤ b} star →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.IncomingJumpObstructionTarget : Prop :=
∀ {ι : Type} {l : Filter ι} [inst : l.NeBot] {n r : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},
  c₂ < 1 →
    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin r → BfgsVerification.Vec n) (coeff : ι → Fin r → ℝ),
      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
        (∀ (a : ι) (j : Fin r), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →
            (∀ (a : ι) (j : Fin r),
                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →
              (∀ (j : Fin r),
                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l
                    (nhds 0)) →
                (∀ᶠ (a : ι) in l, h a = ∑ j, coeff a j • (h a - g a j)) →
                  Filter.Tendsto
                      (fun a =>
                        ∑ j,
                          |coeff a j| *
                            √(BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)))
                      l (nhds 0) →
                    ¬Nonempty (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
def BfgsVerification.ScalarCertificateCharacterizationTarget : Prop :=
∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec 1),
      IsCompact K →
        ∀ {c₁ c₂ η : ℝ},
          c₂ < 1 →
            0 < η →
              (Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K (F star) c₁ c₂ η) ↔
                BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz F K (F star) c₁ c₂ η)
@BfgsVerification.TransportedCertificate.BandCertificate.normalize_field : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)
  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b) (x : BfgsVerification.Vec n),
  (C.normalize hc₁ hc₂ b hb).W x = Real.exp (C.L / c₁ * (F x - fstar)) • C.W x
@BfgsVerification.TransportedCertificate.BandCertificate.normalize_budget : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)
  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b),
  (C.normalize hc₁ hc₂ b hb).L = 0 ∧ (C.normalize hc₁ hc₂ b hb).δ = C.δ
@BfgsVerification.TransportedCertificate.PotentialBandCertificate.absorb_constants : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η) (hc₂ : c₂ < 1),
  (C.absorb hc₂).L = 2 * C.L ∧ (C.absorb hc₂).δ = min C.δ (C.L + 1)⁻¹
@BfgsVerification.TransportedCertificate.local_transported_certificate_basin : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
          ∀ (b : ℝ),
            F star < b →
              ∀ {U : Set (BfgsVerification.Vec n)},
                U ∈ nhds star →
                  ∀ {c₁ c₂ : ℝ},
                    BfgsVerification.TransportedCertificate.HasBandCertificates F ({x | F x ≤ b} ∩ U) (F star) c₁ c₂ →
                      ∃ δ,
                        0 < δ ∧
                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                            R.c₁ = c₁ →
                              R.c₂ = c₂ →
                                F (R.x 0) ≤ F star + δ →
                                  (∀ (k : ℕ), F (R.x k) ≤ b ∧ R.x k ∈ U) ∧
                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                      Filter.Tendsto R.x Filter.atTop (nhds star)
@BfgsVerification.AdmissibleBFGSRun.transported_shell_certificate_convergence_on_sublevel : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.TransportedCertificate.HasShellCertificates F {x | F x ≤ b} (F star) R.c₁ R.c₂ →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                  Filter.Tendsto R.x Filter.atTop (nhds star))
@BfgsVerification.TransportedCertificate.projected_transport_iff_perpendicular : ∀ {n : ℕ}
  (W Z : BfgsVerification.Mat n),
  Matrix.IsSymm W →
    Matrix.IsSymm Z →
      ∀ (s : BfgsVerification.Vec n) (a : ℝ),
        (a •
                (BfgsVerification.TransportedCertificate.stepProjector s * W *
                  BfgsVerification.TransportedCertificate.stepProjector s) -
              BfgsVerification.TransportedCertificate.stepProjector s * Z *
                BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef ↔
          ∀ (v : BfgsVerification.Vec n),
            BfgsVerification.dot v s = 0 → BfgsVerification.metricEnergy Z v ≤ a * BfgsVerification.metricEnergy W v
@BfgsVerification.AdmissibleBFGSRun.commonTilt_value_escape : ∀ {n : ℕ} (B : Finset (BfgsVerification.Vec n))
  (hB : B.Nonempty) (R : BfgsVerification.AdmissibleBFGSRun (n + 1) (BfgsVerification.Homogeneous.commonTilt B hB)),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.commonTilt B hB (R.x k)) Filter.atTop Filter.atBot
@BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_gradient_cardinality : ∀ {n : ℕ}
  (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (Q : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) (L : ℝ),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (Q.x k)) Filter.atTop (nhds L) →
    Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues Q.g)) + 1 ≤
      (BfgsVerification.Homogeneous.recurrentValues Q.g).ncard
@BfgsVerification.TransportedCertificate.basis_limit_no_visibility_secant : ∀ {ι : Type u_1} {l : Filter ι}
  [inst : l.NeBot] {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},
  c₂ < 1 →
    ∀ (z h : ι → BfgsVerification.Vec n) (x g : ι → Fin n → BfgsVerification.Vec n),
      (∀ (a : ι), z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
        (∀ (a : ι) (j : Fin n), x a j ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η) →
          (∀ (a : ι), HasFDerivAt F (BfgsVerification.gradientFunctional (h a)) (z a)) →
            (∀ (a : ι) (j : Fin n),
                BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a j) (z a) (g a j) (h a)) →
              (∀ (j : Fin n),
                  Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a j) (z a) (g a j)) l
                    (nhds 0)) →
                ∀ (b : Basis (Fin n) ℝ (BfgsVerification.Vec n)),
                  (∀ (j : Fin n), Filter.Tendsto (fun a => h a - g a j) l (nhds (b j))) →
                    (∀ (j : Fin n),
                        Filter.Tendsto
                          (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a j) (z a) (g a j) (h a)) l
                          (nhds 0)) →
                      ∀ (B : ℝ),
                        (∀ᶠ (a : ι) in l, ‖h a‖ ≤ B) →
                          ¬Nonempty
                              (BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
@BfgsVerification.RadialCertificate.inward_error_le_of_pair_radial : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star x g h : BfgsVerification.Vec n) (t C : ℝ),
      0 ≤ t →
        t ≤ 1 / 2 →
          0 ≤ C →
            HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
              HasFDerivAt F (BfgsVerification.gradientFunctional h)
                  (BfgsVerification.RadialCertificate.inwardPoint star x t) →
                (0 <
                      BfgsVerification.RadialCertificate.secantCurvature x
                        (BfgsVerification.RadialCertificate.inwardPoint star x t) g h →
                    BfgsVerification.RadialCertificate.radialNumerator star
                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h ^
                        2 ≤
                      C *
                        BfgsVerification.RadialCertificate.secantCurvature x
                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h) →
                  BfgsVerification.RadialCertificate.supportingError F x g
                      (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤
                    4 * C * t ^ 2
@BfgsVerification.convex_gradients_tendsto_at_differentiable : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ {x a : ℕ → BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},
      Filter.Tendsto x Filter.atTop (nhds star) →
        (∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (a k)) (x k)) →
          HasFDerivAt F (BfgsVerification.gradientFunctional g) star → Filter.Tendsto a Filter.atTop (nhds g)
def BfgsVerification.RadialCertificate.HasNestedCentralBounds : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → ℝ → Prop :=
fun {n} F star b =>
  ∀ (η : ℝ),
    0 < η →
      ∃ C θ,
        0 < θ ∧
          θ ≤ 1 / 2 ∧
            ∀ (x : BfgsVerification.Vec n) (t : ℝ),
              0 ≤ t →
                t ≤ θ →
                  F (BfgsVerification.RadialCertificate.outwardPoint star x t) ≤ b →
                    F star + η ≤ F (BfgsVerification.RadialCertificate.inwardPoint star x t) →
                      BfgsVerification.RadialCertificate.centralDifference F star x t ≤ C * t ^ 2
def BfgsVerification.AffineProjection.FullRowRank : {n r : ℕ} → Matrix (Fin r) (Fin n) ℝ → Prop :=
fun {n r} A => Function.Injective A.transpose.mulVec
def BfgsVerification.AffineProjection.compress : {n r : ℕ} →
  Matrix (Fin r) (Fin n) ℝ → BfgsVerification.Mat n → BfgsVerification.Mat r :=
fun {n r} A H => A * H * A.transpose
def BfgsVerification.AffineProjection.lift : {n r : ℕ} →
  Matrix (Fin r) (Fin n) ℝ → BfgsVerification.Mat n → Matrix (Fin n) (Fin r) ℝ :=
fun {n r} A H => H * A.transpose * (BfgsVerification.AffineProjection.compress A H)⁻¹
def BfgsVerification.AffineProjection.fiberPoint : {n r : ℕ} →
  Matrix (Fin r) (Fin n) ℝ →
    BfgsVerification.Mat n → BfgsVerification.Vec n → BfgsVerification.Vec r → BfgsVerification.Vec n :=
fun {n r} A H x₀ z => x₀ + (BfgsVerification.AffineProjection.lift A H).mulVec (z - A.mulVec x₀)
def BfgsVerification.AffineProjection.projectRun : {n r : ℕ} →
  (A : Matrix (Fin r) (Fin n) ℝ) →
    BfgsVerification.AffineProjection.FullRowRank A →
      (F : BfgsVerification.Vec r → ℝ) →
        (BfgsVerification.AdmissibleBFGSRun n fun x => F (A.mulVec x)) → BfgsVerification.AdmissibleBFGSRun r F :=
fun {n r} A hA F R =>
  { convex := ⋯, x := fun k => A.mulVec (R.x k), H := fun k => BfgsVerification.AffineProjection.compress A (R.H k),
    g := BfgsVerification.AffineProjection.projectedGradient A F R, α := R.α, c₁ := R.c₁, c₂ := R.c₂, c₁_pos := ⋯,
    c₁_lt_c₂ := ⋯, c₂_lt_one := ⋯, initial_posDef := ⋯, alpha_pos := ⋯, gradient_nonzero := ⋯, hasGradient := ⋯,
    step := ⋯, update := ⋯, armijo := ⋯, weak_wolfe := ⋯ }
def BfgsVerification.AdmissibleBFGSRun.valueCorrectionBudget : {n : ℕ} →
  {F : BfgsVerification.Vec n → ℝ} → BfgsVerification.AdmissibleBFGSRun n F → BfgsVerification.Vec n → ℝ → ℕ → ℝ :=
fun {n} {F} R star C N => R.referenceEnergy star 0 + C * ∑ k ∈ Finset.range N, (F (R.x (k + 1)) - F star)
def BfgsVerification.TransportedCertificate.realizingMetric : {n : ℕ} →
  BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Mat n :=
fun {n} g s =>
  1 - (BfgsVerification.sqNorm g)⁻¹ • BfgsVerification.outer g g +
    (-BfgsVerification.dot g s)⁻¹ • BfgsVerification.outer s s
def BfgsVerification.ScalarCounterexamples.shiftedAbs : ℝ → ℝ :=
fun t => (t + 2) ^ 2 / 2 + |t|
def BfgsVerification.AccumulatingKinks.knot : ℕ → ℝ :=
fun j => (1 / 4) ^ (j + 1)
def BfgsVerification.AccumulatingKinks.kinkSum : ℝ → ℝ :=
fun x => ∑' (j : ℕ), BfgsVerification.AccumulatingKinks.term j x
def BfgsVerification.AccumulatingKinks.objective : ℝ → ℝ :=
fun x => x ^ 2 / 2 + 3 * BfgsVerification.AccumulatingKinks.kinkSum x
def BfgsVerification.RadialInwardEquivalenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ∀ (b : ℝ),
          F star < b →
            IsCompact {x | F x ≤ b} →
              (BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star ↔
                BfgsVerification.RadialCertificate.HasInwardTaylorBounds F {x | F x ≤ b} star)
def BfgsVerification.LocalRadialCentralEquivalenceTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ((∃ b,
            F star < b ∧
              IsCompact {x | F x ≤ b} ∧ BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star) ↔
          ∃ b,
            F star < b ∧ IsCompact {x | F x ≤ b} ∧ BfgsVerification.RadialCertificate.HasNestedCentralBounds F star b)
def BfgsVerification.LinearImageLiftingTarget : Prop :=
∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ) (hA : BfgsVerification.AffineProjection.FullRowRank A)
  (F : BfgsVerification.Vec r → ℝ) (R : BfgsVerification.AdmissibleBFGSRun n fun x => F (A.mulVec x))
  (zstar : BfgsVerification.Vec r),
  Filter.Tendsto (BfgsVerification.AffineProjection.projectRun A hA F R).x Filter.atTop (nhds zstar) →
    Filter.Tendsto R.x Filter.atTop (nhds (BfgsVerification.AffineProjection.fiberPoint A (R.H 0) (R.x 0) zstar)) ∧
      A.mulVec (BfgsVerification.AffineProjection.fiberPoint A (R.H 0) (R.x 0) zstar) = zstar ∧
        ∀ (x : BfgsVerification.Vec n),
          A.mulVec x = zstar →
            BfgsVerification.metricEnergy (R.H 0)⁻¹
                  (BfgsVerification.AffineProjection.fiberPoint A (R.H 0) (R.x 0) zstar - R.x 0) ≤
                BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) ∧
              (BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) =
                  BfgsVerification.metricEnergy (R.H 0)⁻¹
                    (BfgsVerification.AffineProjection.fiberPoint A (R.H 0) (R.x 0) zstar - R.x 0) ↔
                x = BfgsVerification.AffineProjection.fiberPoint A (R.H 0) (R.x 0) zstar)
def BfgsVerification.NonuniqueSolutionBasinTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ∀ (b : ℝ),
          F star < b →
            IsCompact {x | F x ≤ b} →
              ∀ {U : Set (BfgsVerification.Vec n)},
                (∀ (x : BfgsVerification.Vec n), F x = F star → U ∈ nhds x) →
                  ∀ {c₁ c₂ : ℝ},
                    BfgsVerification.TransportedCertificate.HasBandCertificates F ({x | F x ≤ b} ∩ U) (F star) c₁ c₂ →
                      ∃ δ,
                        0 < δ ∧
                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                            R.c₁ = c₁ →
                              R.c₂ = c₂ →
                                F (R.x 0) ≤ F star + δ →
                                  (∀ (k : ℕ), F (R.x k) ≤ b ∧ R.x k ∈ U) ∧
                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                      Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k))
                                          Filter.atTop (nhds 0) ∧
                                        ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                                          Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.LinearCorrectionRateTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n),
  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
    IsCompact R.initialSublevel →
      ∀ (C : ℝ),
        (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection star k ≤ C * ↑N) →
          Filter.Tendsto (fun N => √↑N * (F (R.x N) - F star)) Filter.atTop (nhds 0)
def BfgsVerification.HomogeneousRatesTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F →
    ∀ (L : ℝ),
      (∀ (k : ℕ), L ≤ F (R.x k)) →
        (∀ (N : ℕ), 0 < N → F (R.x N) ≤ √(R.homogeneousPotential 0 / ∑ k ∈ Finset.range N, (R.q k)⁻¹)) ∧
          Filter.Tendsto (fun N => ↑N * F (R.x N)) Filter.atTop (nhds 0) ∧
            (Filter.Tendsto F (Filter.cocompact (BfgsVerification.Vec n)) Filter.atTop →
              Filter.Tendsto (fun N => ↑N * ‖BfgsVerification.euclideanVector (R.x N)‖) Filter.atTop (nhds 0))
def BfgsVerification.ScalarGlobalCertificateNonnecessityTarget : Prop :=
let f := BfgsVerification.ScalarCounterexamples.shiftedAbs;
let F := BfgsVerification.ScalarCounterexamples.shiftedObjective;
StrongConvexOn Set.univ 1 f ∧
  (∀ (x : ℝ), f (-1) ≤ f x) ∧
    (∀ (x : ℝ), f x = f (-1) → x = -1) ∧
      ¬BfgsVerification.TransportedCertificate.HasBandCertificates F {x | F x ≤ 3}
            (F (BfgsVerification.OneDimensional.embed (-1))) (1 / 4) (1 / 2) ∧
        (∀ (R : BfgsVerification.ScalarMetricRun f),
            Filter.Tendsto (fun k => f (R.x k)) Filter.atTop (nhds (3 / 2)) ∧
              Filter.Tendsto R.x Filter.atTop (nhds (-1))) ∧
          ∀ (R : BfgsVerification.AdmissibleBFGSRun 1 F),
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (3 / 2)) ∧
              Filter.Tendsto R.x Filter.atTop (nhds (BfgsVerification.OneDimensional.embed (-1)))
def BfgsVerification.ScalarLocalCertificateNonnecessityTarget : Prop :=
let f := BfgsVerification.AccumulatingKinks.objective;
let F := BfgsVerification.AccumulatingKinks.coordinateObjective;
StrongConvexOn Set.univ 1 f ∧
  Filter.Tendsto f (Filter.cocompact ℝ) Filter.atTop ∧
    ConvexOn ℝ Set.univ f ∧
      (∀ (x : ℝ), f 0 ≤ f x) ∧
        (∀ (x : ℝ), f x = f 0 → x = 0) ∧
          (∀ (b : ℝ), IsCompact {x | f x ≤ b}) ∧
            (∀ K ∈ nhds 0, ¬BfgsVerification.TransportedCertificate.HasBandCertificates F K 0 (1 / 4) (1 / 2)) ∧
              (∀ (R : BfgsVerification.ScalarMetricRun f),
                  Filter.Tendsto (fun k => f (R.x k)) Filter.atTop (nhds 0) ∧
                    Filter.Tendsto R.x Filter.atTop (nhds 0)) ∧
                ∀ (R : BfgsVerification.AdmissibleBFGSRun 1 F),
                  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0) ∧ Filter.Tendsto R.x Filter.atTop (nhds 0)
def BfgsVerification.EligiblePairRealizabilityTarget : Prop :=
∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},
  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →
    ∃ H,
      Matrix.PosDef H ∧
        BfgsVerification.bfgsStep H g 1 = BfgsVerification.TransportedCertificate.pairStep x z ∧
          BfgsVerification.metricEnergy H g = BfgsVerification.TransportedCertificate.pairDecrease x z g
def BfgsVerification.FiniteSampleFeasibilityTarget : Prop :=
∀ {n r : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n) {c₁ c₂ : ℝ},
      c₂ < 1 →
        ∀ (x g : Fin r → BfgsVerification.Vec n),
          (∀ (i : Fin r), HasFDerivAt F (BfgsVerification.gradientFunctional (g i)) (x i)) →
            (∀ (i : Fin r), F star < F (x i)) →
              ∀ (P : Finset (Fin r × Fin r)),
                (∀ p ∈ P,
                    BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x p.1) (x p.2) (g p.1) (g p.2)) →
                  ∃ m C,
                    Matrix.PosSemidef 1 ∧
                      0 < m ∧
                        0 ≤ C ∧
                          (∀ (i : Fin r), m ≤ BfgsVerification.metricEnergy 1 (g i)) ∧
                            (∀ p ∈ P,
                                BfgsVerification.metricEnergy 1 (g p.2 - g p.1) ≤
                                  C *
                                    BfgsVerification.TransportedCertificate.pairCurvature (x p.1) (x p.2) (g p.1)
                                      (g p.2)) ∧
                              ∀ (s : BfgsVerification.Vec n),
                                (BfgsVerification.TransportedCertificate.stepProjector s * 1 *
                                      Matrix.transpose (BfgsVerification.TransportedCertificate.stepProjector s) -
                                    BfgsVerification.TransportedCertificate.stepProjector s * 1 *
                                      Matrix.transpose
                                        (BfgsVerification.TransportedCertificate.stepProjector s)).PosSemidef
@BfgsVerification.RadialCertificate.inward_iff_intercept_on_compact_sublevel : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ∀ (b : ℝ),
          F star < b →
            IsCompact {x | F x ≤ b} →
              (BfgsVerification.RadialCertificate.HasInwardTaylorBounds F {x | F x ≤ b} star ↔
                BfgsVerification.RadialCertificate.HasInterceptBounds F {x | F x ≤ b} star)
@BfgsVerification.RadialCertificate.central_of_radial_on_sublevel : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ∀ (b : ℝ),
          F star < b →
            BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star →
              BfgsVerification.RadialCertificate.HasNestedCentralBounds F star b
@BfgsVerification.RadialCertificate.radial_of_central_on_smaller_sublevel : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        ∀ (b b' : ℝ),
          b' < b →
            IsCompact {x | F x ≤ b} →
              BfgsVerification.RadialCertificate.HasNestedCentralBounds F star b →
                BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b'} star
@BfgsVerification.AffineProjection.matrix_lift_invariant : ∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ),
  BfgsVerification.AffineProjection.FullRowRank A →
    ∀ (R : BfgsVerification.FullBFGSRun n) (gbar : ℕ → BfgsVerification.Vec r),
      (∀ (k : ℕ), A.transpose.mulVec (gbar k) = R.g k) →
        ∀ (k : ℕ),
          R.H k * A.transpose =
            BfgsVerification.AffineProjection.lift A (R.H 0) * BfgsVerification.AffineProjection.compress A (R.H k)
@BfgsVerification.AffineProjection.fiberPoint_minimizer_unique : ∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ),
  BfgsVerification.AffineProjection.FullRowRank A →
    ∀ {H : BfgsVerification.Mat n},
      Matrix.PosDef H →
        ∀ (x₀ x : BfgsVerification.Vec n) (z : BfgsVerification.Vec r),
          A.mulVec x = z →
            (BfgsVerification.metricEnergy H⁻¹ (x - x₀) =
                BfgsVerification.metricEnergy H⁻¹ (BfgsVerification.AffineProjection.fiberPoint A H x₀ z - x₀) ↔
              x = BfgsVerification.AffineProjection.fiberPoint A H x₀ z)
@BfgsVerification.AdmissibleBFGSRun.homogeneous_weighted_sum_bound : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}
  (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F →
    (∀ (k : ℕ), 0 ≤ F (R.x k)) → ∀ (N : ℕ), ∑ k ∈ Finset.range N, F (R.x k) ^ 2 / R.q k ≤ R.homogeneousPotential 0
@BfgsVerification.Homogeneous.coercive_euclidean_lower_bound : ∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    BfgsVerification.Homogeneous.PositiveDegreeOne F →
      Filter.Tendsto F (Filter.cocompact (BfgsVerification.Vec n)) Filter.atTop →
        ∃ μ, 0 < μ ∧ ∀ (x : BfgsVerification.Vec n), μ * ‖BfgsVerification.euclideanVector x‖ ≤ F x
@BfgsVerification.AdmissibleBFGSRun.compact_value_log_orders_of_correction_bound : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n),
  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
    IsCompact R.initialSublevel →
      ∀ (C : ℝ),
        0 ≤ C →
          (∀ (k : ℕ), R.referenceCorrection star k ≤ C * (F (R.x (k + 1)) - F star)) →
            ((fun N => F (R.x N) - F star) =o[Filter.atTop] fun N => Real.log ↑N / ↑N) ∧
              (fun N => F (R.x N) - F star) =O[Filter.atTop] fun N => Real.log ↑N / ↑N
@BfgsVerification.HarmonicRates.self_budget_value_log_orders : ∀ {A f S : ℕ → ℝ} {C : ℝ},
  (∀ (N : ℕ), 0 ≤ A N) →
    (∀ (N : ℕ), 0 ≤ f N) →
      0 ≤ C →
        (∀ (N : ℕ), A (N + 1) = A N + C * f (N + 1)) →
          (∀ (N : ℕ), f N ^ 2 * S N ≤ A N) →
            Filter.Tendsto (fun N => S N / ↑N ^ 2) Filter.atTop Filter.atTop →
              (f =o[Filter.atTop] fun N => Real.log ↑N / ↑N) ∧ f =O[Filter.atTop] fun N => Real.log ↑N / ↑N
BfgsVerification.ScalarCounterexamples.crossing_quotient_tendsto : Filter.Tendsto
  (fun ε =>
    |BfgsVerification.ScalarCounterexamples.crossingH ε 0 - BfgsVerification.ScalarCounterexamples.crossingG ε 0| /
      (|BfgsVerification.ScalarCounterexamples.crossingZ ε 0 - BfgsVerification.ScalarCounterexamples.crossingX ε 0| *
        BfgsVerification.ScalarCounterexamples.crossingH ε 0 ^ 2))
  (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop
BfgsVerification.AccumulatingKinks.crossing_quotient_tendsto : ∀ (j : ℕ),
  Filter.Tendsto
    (fun ε =>
      |BfgsVerification.AccumulatingKinks.crossingH j ε 0 - BfgsVerification.AccumulatingKinks.crossingG j ε 0| /
        (|BfgsVerification.AccumulatingKinks.crossingZ j ε 0 - BfgsVerification.AccumulatingKinks.crossingX j ε 0| *
          BfgsVerification.AccumulatingKinks.crossingH j ε 0 ^ 2))
    (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop
@BfgsVerification.AccumulatingKinks.series_uniform_on_compact : ∀ {K : Set ℝ},
  IsCompact K →
    TendstoUniformlyOn (fun N x => ∑ j ∈ Finset.range N, BfgsVerification.AccumulatingKinks.term j x)
      BfgsVerification.AccumulatingKinks.kinkSum Filter.atTop K
BfgsVerification.AccumulatingKinks.objective_coercive : Filter.Tendsto BfgsVerification.AccumulatingKinks.objective
  (Filter.cocompact ℝ) Filter.atTop
def BfgsVerification.AffineCertificateCovarianceTarget : Prop :=
∀ {n : ℕ} (A : BfgsVerification.Mat n),
  Matrix.det A ≠ 0 →
    ∀ (b : BfgsVerification.Vec n) (F : BfgsVerification.Vec n → ℝ) (K : Set (BfgsVerification.Vec n))
      (fstar c₁ c₂ : ℝ),
      BfgsVerification.TransportedCertificate.HasBandCertificates F K fstar c₁ c₂ ↔
        BfgsVerification.TransportedCertificate.HasBandCertificates (BfgsVerification.AffineCertificate.objective A b F)
          (BfgsVerification.AffineCertificate.forward A b '' K) fstar c₁ c₂
def BfgsVerification.CenteredSmoothConvergenceTarget : Prop :=
∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)
  (star : BfgsVerification.Vec n),
  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
    ∀ {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        ConvexOn ℝ U ψ →
          BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
            ConvexOn ℝ Set.univ γ →
              BfgsVerification.Homogeneous.PositiveDegreeOne γ →
                (∀ x ∈ U, F x = ψ x + γ (x - star)) →
                  IsCompact R.initialSublevel →
                    R.initialSublevel ⊆ U →
                      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                        ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
                          Filter.Tendsto R.x Filter.atTop (nhds star))
def BfgsVerification.CenteredLocalBasinTarget : Prop :=
∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ},
  ConvexOn ℝ Set.univ F →
    ∀ (star : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
        (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →
          ∀ {U : Set (BfgsVerification.Vec n)},
            IsOpen U →
              star ∈ U →
                ConvexOn ℝ U ψ →
                  BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
                    ConvexOn ℝ Set.univ γ →
                      BfgsVerification.Homogeneous.PositiveDegreeOne γ →
                        (∀ x ∈ U, F x = ψ x + γ (x - star)) →
                          ∃ δ,
                            0 < δ ∧
                              ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),
                                F (R.x 0) ≤ F star + δ →
                                  (∀ (k : ℕ), R.x k ∈ U) ∧
                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧
                                      Filter.Tendsto R.x Filter.atTop (nhds star)
def BfgsVerification.QuadraticGaugeRatesTarget : Prop :=
∀ {m p : ℕ} (Q : BfgsVerification.Mat m),
  Matrix.PosDef Q →
    ∀ (γ : BfgsVerification.Vec p → ℝ),
      ConvexOn ℝ Set.univ γ →
        BfgsVerification.Homogeneous.PositiveDegreeOne γ →
          ∀ (μ Λ : ℝ),
            0 < μ →
              (∀ (v : BfgsVerification.Vec p), μ * ‖BfgsVerification.euclideanVector v‖ ≤ γ v) →
                (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * ‖BfgsVerification.euclideanVector v‖) →
                  ∀ (R : BfgsVerification.AdmissibleBFGSRun (m + p) (BfgsVerification.QuadraticGauge.objective Q γ)),
                    ((fun N => BfgsVerification.QuadraticGauge.objective Q γ (R.x N)) =o[Filter.atTop] fun N =>
                        Real.log ↑N / ↑N) ∧
                      ((fun N => BfgsVerification.QuadraticGauge.objective Q γ (R.x N)) =O[Filter.atTop] fun N =>
                          Real.log ↑N / ↑N) ∧
                        Filter.Tendsto (fun N => BfgsVerification.QuadraticGauge.objective Q γ (R.x N)) Filter.atTop
                            (nhds 0) ∧
                          Filter.Tendsto R.x Filter.atTop (nhds 0)
def BfgsVerification.EllipsoidCertificateGeometryTarget : Prop :=
∀ {n : ℕ} {W Z : BfgsVerification.Mat n} (hW : Matrix.PosSemidef W) (hZ : Matrix.PosSemidef Z),
  (∀ (a : BfgsVerification.Vec n),
      sSup (BfgsVerification.dot a '' BfgsVerification.CertificateGeometry.ellipsoid hW) =
        √(BfgsVerification.metricEnergy W a)) ∧
    ∀ (P : BfgsVerification.Mat n),
      Matrix.mulVec P '' BfgsVerification.CertificateGeometry.ellipsoid hZ ⊆
          Matrix.mulVec P '' BfgsVerification.CertificateGeometry.ellipsoid hW ↔
        (P * W * Matrix.transpose P - P * Z * Matrix.transpose P).PosSemidef
def BfgsVerification.PointwiseCertificateCapacityTarget : Prop :=
∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (K : Set (BfgsVerification.Vec n)) (fstar c₁ c₂ η δ : ℝ),
  c₂ < 1 →
    0 < δ → ((∃ B, B.δ = δ) ↔ 0 < ⨅ z, BfgsVerification.PointwiseFeasibility.sourceCapacity F K fstar c₁ c₂ η δ z)
def BfgsVerification.PlanarHomogeneousEscapeTarget : Prop :=
∀ (A : Finset (BfgsVerification.Vec 2)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun 2 (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  ¬BddBelow (Set.range (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) →
    (∀ (x : BfgsVerification.Vec 2),
        ¬BfgsVerification.Homogeneous.Supports (BfgsVerification.Homogeneous.finiteMaxLinear A hA) x 0) ∧
      Xor'
        (Filter.Tendsto R.x Filter.atTop (nhds 0) ∧
          Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) ∧
            (∀ (k : ℕ), 0 < BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) ∧
              StrictAnti fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k))
        (Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop Filter.atBot ∧
          Filter.Tendsto (fun k => ‖BfgsVerification.euclideanVector (R.x k)‖) Filter.atTop Filter.atTop)
def BfgsVerification.ParabolicDenominatorTarget : Prop :=
∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {K : Set (BfgsVerification.Vec 2)},
  IsCompact K →
    ∀ {η c₁ c₂ : ℝ},
      0 < η →
        0 ≤ c₁ →
          c₂ < 1 →
            ∃ C δ,
              0 < C ∧
                0 < δ ∧
                  ∀ x ∈ K,
                    ∀ z ∈ K,
                      ∀ (g h : BfgsVerification.Vec 2),
                        BfgsVerification.TransportedCertificate.EligiblePair P.objective c₁ c₂ x z g h →
                          η ≤ P.objective x →
                            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →
                              BfgsVerification.TransportedCertificate.pairDecrease x z g ≤
                                  C * |BfgsVerification.Parabolic.Family.stepDeterminant x z| ∧
                                |BfgsVerification.Parabolic.Family.horizontalStep x z| ≤
                                    C * |BfgsVerification.Parabolic.Family.stepDeterminant x z| ∧
                                  BfgsVerification.Parabolic.Family.stepDeterminant x z ≠ 0
def BfgsVerification.AffineCertificate.forward : {n : ℕ} →
  BfgsVerification.Mat n → BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Vec n :=
fun {n} A b x => Matrix.mulVec A x + b
def BfgsVerification.AffineCertificate.backward : {n : ℕ} →
  BfgsVerification.Mat n → BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Vec n :=
fun {n} A b z => Matrix.mulVec A⁻¹ (z - b)
def BfgsVerification.AffineCertificate.objective : {n : ℕ} →
  BfgsVerification.Mat n → BfgsVerification.Vec n → (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → ℝ :=
fun {n} A b F z => F (BfgsVerification.AffineCertificate.backward A b z)
def BfgsVerification.AffineCertificate.field : {n : ℕ} →
  BfgsVerification.Mat n →
    BfgsVerification.Vec n →
      (BfgsVerification.Vec n → BfgsVerification.Mat n) → BfgsVerification.Vec n → BfgsVerification.Mat n :=
fun {n} A b W z => A * W (BfgsVerification.AffineCertificate.backward A b z) * Matrix.transpose A
def BfgsVerification.AffineCertificate.transform : {n : ℕ} →
  (A : BfgsVerification.Mat n) →
    Matrix.det A ≠ 0 →
      (b : BfgsVerification.Vec n) →
        {F : BfgsVerification.Vec n → ℝ} →
          {K : Set (BfgsVerification.Vec n)} →
            {fstar c₁ c₂ η : ℝ} →
              BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η →
                BfgsVerification.TransportedCertificate.BandCertificate
                  (BfgsVerification.AffineCertificate.objective A b F)
                  (BfgsVerification.AffineCertificate.forward A b '' K) fstar c₁ c₂ η :=
fun {n} A hA b {F} {K} {fstar c₁ c₂ η} C =>
  { W := BfgsVerification.AffineCertificate.field A b C.W, m := C.m, C := C.C, L := C.L, δ := C.δ, m_pos := ⋯,
    L_nonneg := ⋯, delta_pos := ⋯, positive_semidefinite := ⋯, visibility := ⋯, secant := ⋯, transport := ⋯ }
def BfgsVerification.CenteredSmoothSublinear.LocallyC11On : {n : ℕ} →
  Set (BfgsVerification.Vec n) → (BfgsVerification.Vec n → ℝ) → Prop :=
fun {n} U ψ => DifferentiableOn ℝ ψ U ∧ LocallyLipschitzOn U (fderiv ℝ ψ)
def BfgsVerification.CenteredSmoothSublinear.smoothRemainder : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Vec n → ℝ :=
fun {n} ψ star p x => ψ x - ψ star - BfgsVerification.dot p (x - star)
def BfgsVerification.CenteredSmoothSublinear.recenteredHomogeneous : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → BfgsVerification.Vec n → ℝ :=
fun {n} γ p z => γ z + BfgsVerification.dot p z
def BfgsVerification.QuadraticGauge.objective : {m p : ℕ} →
  BfgsVerification.Mat m → (BfgsVerification.Vec p → ℝ) → BfgsVerification.Vec (m + p) → ℝ :=
fun {m p} Q γ x =>
  BfgsVerification.metricEnergy Q (BfgsVerification.QuadraticGauge.left x) / 2 +
    γ (BfgsVerification.QuadraticGauge.right x)
def BfgsVerification.QuadraticGauge.correctionConstant : ℝ → ℝ → ℝ :=
fun μ Λ => max 2 (1 + Λ / μ)
def BfgsVerification.CertificateGeometry.euclideanUnitBall : {n : ℕ} → Set (BfgsVerification.Vec n) :=
fun {n} => {v | BfgsVerification.sqNorm v ≤ 1}
def BfgsVerification.CertificateGeometry.ellipsoid : {n : ℕ} →
  {W : BfgsVerification.Mat n} → Matrix.PosSemidef W → Set (BfgsVerification.Vec n) :=
fun {n} {W} hW => BfgsVerification.CertificateGeometry.matrixBall hW.sqrt
def BfgsVerification.PointwiseFeasibility.sourceCapacity : {n : ℕ} →
  (F : BfgsVerification.Vec n → ℝ) →
    (K : Set (BfgsVerification.Vec n)) →
      (fstar : ℝ) → ℝ → ℝ → (η : ℝ) → ℝ → BfgsVerification.PointwiseFeasibility.BandPoint F K fstar η → ENNReal :=
fun {n} F K fstar c₁ c₂ η δ z =>
  BfgsVerification.PointwiseFeasibility.descentCapacity (BfgsVerification.coordinateGradient F ↑z)
    (BfgsVerification.PointwiseFeasibility.sourceJump z) (BfgsVerification.PointwiseFeasibility.sourceCurvature z)
def BfgsVerification.PointwiseFeasibility.BandPoint : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → ℝ → ℝ → Type :=
fun {n} F K fstar η =>
  { z // z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧ DifferentiableAt ℝ F z }
def BfgsVerification.PointwiseFeasibility.IncomingPoint : {n : ℕ} →
  (F : BfgsVerification.Vec n → ℝ) →
    (K : Set (BfgsVerification.Vec n)) →
      (fstar : ℝ) → ℝ → ℝ → (η : ℝ) → ℝ → BfgsVerification.PointwiseFeasibility.BandPoint F K fstar η → Type :=
fun {n} F K fstar c₁ c₂ η δ z =>
  { x //
    BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (↑x) (↑z) (BfgsVerification.coordinateGradient F ↑x)
        (BfgsVerification.coordinateGradient F ↑z) ∧
      BfgsVerification.TransportedCertificate.pairDecrease (↑x) (↑z) (BfgsVerification.coordinateGradient F ↑x) ≤ δ }
structure BfgsVerification.Parabolic.Family (m : ℕ) : Type
number of parameters: 1
fields:
  BfgsVerification.Parabolic.Family.a : Fin m → ℝ
  BfgsVerification.Parabolic.Family.b : Fin m → ℝ
  BfgsVerification.Parabolic.Family.a_pos : ∀ (i : Fin m), 0 < self.a i
  BfgsVerification.Parabolic.Family.negative_slope : ∃ i, self.b i < 0
  BfgsVerification.Parabolic.Family.positive_slope : ∃ i, 0 < self.b i
constructor:
  BfgsVerification.Parabolic.Family.mk {m : ℕ} (a b : Fin m → ℝ) (a_pos : ∀ (i : Fin m), 0 < a i)
    (negative_slope : ∃ i, b i < 0) (positive_slope : ∃ i, 0 < b i) : BfgsVerification.Parabolic.Family m
def BfgsVerification.Parabolic.Family.objective : {m : ℕ} →
  BfgsVerification.Parabolic.Family m → BfgsVerification.Vec 2 → ℝ :=
fun {m} P x => Finset.univ.sup' ⋯ fun i => P.branch i x
def BfgsVerification.Parabolic.Family.Active : {m : ℕ} →
  BfgsVerification.Parabolic.Family m → Fin m → BfgsVerification.Vec 2 → Prop :=
fun {m} P i x => P.objective x = P.branch i x
def BfgsVerification.Parabolic.Family.branchGradient : {m : ℕ} →
  BfgsVerification.Parabolic.Family m → Fin m → BfgsVerification.Vec 2 → BfgsVerification.Vec 2 :=
fun {m} P i x => ![2 * P.a i * x 0, P.b i]
def BfgsVerification.Parabolic.Family.stepDeterminant : BfgsVerification.Vec 2 → BfgsVerification.Vec 2 → ℝ :=
fun x z =>
  2 * x 1 * BfgsVerification.Parabolic.Family.horizontalStep x z -
    x 0 * BfgsVerification.Parabolic.Family.normalStep x z
@BfgsVerification.AffineCertificate.eligible_pair_affine_iff : ∀ {n : ℕ} (A : BfgsVerification.Mat n),
  Matrix.det A ≠ 0 →
    ∀ (b : BfgsVerification.Vec n) {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} (x z g h : BfgsVerification.Vec n),
      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h ↔
        BfgsVerification.TransportedCertificate.EligiblePair (BfgsVerification.AffineCertificate.objective A b F) c₁ c₂
          (BfgsVerification.AffineCertificate.forward A b x) (BfgsVerification.AffineCertificate.forward A b z)
          (A⁻¹.transpose.mulVec g) (A⁻¹.transpose.mulVec h)
@BfgsVerification.AffineCertificate.transform_constants : ∀ {n : ℕ} (A : BfgsVerification.Mat n) (hA : Matrix.det A ≠ 0)
  (b : BfgsVerification.Vec n) {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}
  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),
  (BfgsVerification.AffineCertificate.transform A hA b C).m = C.m ∧
    (BfgsVerification.AffineCertificate.transform A hA b C).C = C.C ∧
      (BfgsVerification.AffineCertificate.transform A hA b C).L = C.L ∧
        (BfgsVerification.AffineCertificate.transform A hA b C).δ = C.δ
@BfgsVerification.CenteredSmoothSublinear.exists_cocoercivity_constant_on_compact : ∀ {n : ℕ}
  {ψ : BfgsVerification.Vec n → ℝ} {U K : Set (BfgsVerification.Vec n)},
  IsOpen U →
    ConvexOn ℝ U ψ →
      BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
        IsCompact K →
          K ⊆ U →
            ∃ L,
              0 < L ∧
                ∀ x ∈ K,
                  ∀ y ∈ K,
                    BfgsVerification.sqNorm
                        (BfgsVerification.coordinateGradient ψ y - BfgsVerification.coordinateGradient ψ x) ≤
                      L *
                        BfgsVerification.dot
                          (BfgsVerification.coordinateGradient ψ y - BfgsVerification.coordinateGradient ψ x) (y - x)
@BfgsVerification.CenteredSmoothSublinear.exists_pair_correction_bound : ∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ}
  (star : BfgsVerification.Vec n) {U K : Set (BfgsVerification.Vec n)},
  IsOpen U →
    ConvexOn ℝ U ψ →
      BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
        ConvexOn ℝ Set.univ γ →
          BfgsVerification.Homogeneous.PositiveDegreeOne γ →
            (∀ x ∈ U, F x = ψ x + γ (x - star)) →
              IsCompact K →
                K ⊆ U →
                  ∃ L G R,
                    0 < L ∧
                      0 < G ∧
                        0 < R ∧
                          (∀ x ∈ K,
                              ∀ y ∈ K,
                                BfgsVerification.sqNorm
                                    (BfgsVerification.coordinateGradient ψ y -
                                      BfgsVerification.coordinateGradient ψ x) ≤
                                  L *
                                    BfgsVerification.dot
                                      (BfgsVerification.coordinateGradient ψ y -
                                        BfgsVerification.coordinateGradient ψ x)
                                      (y - x)) ∧
                            (∀ (x g : BfgsVerification.Vec n),
                                BfgsVerification.Homogeneous.Supports γ x g → BfgsVerification.sqNorm g ≤ G ^ 2) ∧
                              (∀ x ∈ K, BfgsVerification.sqNorm (x - star) ≤ R ^ 2) ∧
                                ∀ x ∈ K,
                                  ∀ y ∈ K,
                                    ∀ (g g' : BfgsVerification.Vec n),
                                      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →
                                        HasFDerivAt F (BfgsVerification.gradientFunctional g') y →
                                          0 < BfgsVerification.dot (g' - g) (y - x) →
                                            BfgsVerification.dot (g' - g) (y - star) ^ 2 /
                                                BfgsVerification.dot (g' - g) (y - x) ≤
                                              L * R ^ 2 + 2 * G * R
@BfgsVerification.CenteredSmoothSublinear.center_support : ∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ}
  (star : BfgsVerification.Vec n),
  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
    ∀ {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        star ∈ U →
          BfgsVerification.Homogeneous.PositiveDegreeOne γ →
            (∀ x ∈ U, F x = ψ x + γ (x - star)) →
              ∀ {p : BfgsVerification.Vec n},
                HasFDerivAt ψ (BfgsVerification.gradientFunctional p) star →
                  BfgsVerification.Homogeneous.Supports γ 0 (-p)
@BfgsVerification.CenteredSmoothSublinear.centered_rewriting : ∀ {n : ℕ} {F ψ γ : BfgsVerification.Vec n → ℝ}
  (star : BfgsVerification.Vec n),
  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →
    ∀ {U : Set (BfgsVerification.Vec n)},
      IsOpen U →
        star ∈ U →
          ConvexOn ℝ U ψ →
            BfgsVerification.Homogeneous.PositiveDegreeOne γ →
              (∀ x ∈ U, F x = ψ x + γ (x - star)) →
                ∀ {p : BfgsVerification.Vec n},
                  HasFDerivAt ψ (BfgsVerification.gradientFunctional p) star →
                    (∀ x ∈ U, 0 ≤ BfgsVerification.CenteredSmoothSublinear.smoothRemainder ψ star p x) ∧
                      BfgsVerification.CenteredSmoothSublinear.smoothRemainder ψ star p star = 0 ∧
                        (∀ (z : BfgsVerification.Vec n),
                            0 ≤ BfgsVerification.CenteredSmoothSublinear.recenteredHomogeneous γ p z) ∧
                          BfgsVerification.CenteredSmoothSublinear.recenteredHomogeneous γ p 0 = 0 ∧
                            ∀ x ∈ U,
                              F x - F star =
                                BfgsVerification.CenteredSmoothSublinear.smoothRemainder ψ star p x +
                                  BfgsVerification.CenteredSmoothSublinear.recenteredHomogeneous γ p (x - star)
@BfgsVerification.CenteredSmoothSublinear.smoothRemainder_locallyC11 : ∀ {n : ℕ} {ψ : BfgsVerification.Vec n → ℝ}
  {U : Set (BfgsVerification.Vec n)},
  IsOpen U →
    BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →
      ∀ (star p : BfgsVerification.Vec n),
        BfgsVerification.CenteredSmoothSublinear.LocallyC11On U
          (BfgsVerification.CenteredSmoothSublinear.smoothRemainder ψ star p)
@BfgsVerification.AdmissibleBFGSRun.quadraticGauge_finite_budget : ∀ {m p : ℕ} (Q : BfgsVerification.Mat m),
  Matrix.PosSemidef Q →
    ∀ (γ : BfgsVerification.Vec p → ℝ),
      BfgsVerification.Homogeneous.PositiveDegreeOne γ →
        ∀ (μ Λ : ℝ),
          0 < μ →
            (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →
              (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →
                ∀ (R : BfgsVerification.AdmissibleBFGSRun (m + p) (BfgsVerification.QuadraticGauge.objective Q γ))
                  (N : ℕ),
                  BfgsVerification.QuadraticGauge.objective Q γ (R.x N) ^ 2 * ∑ k ∈ Finset.range N, (R.q k)⁻¹ ≤
                    R.referenceEnergy 0 0 +
                      BfgsVerification.QuadraticGauge.correctionConstant μ Λ *
                        ∑ k ∈ Finset.range N, BfgsVerification.QuadraticGauge.objective Q γ (R.x (k + 1))
@BfgsVerification.AdmissibleBFGSRun.quadraticGauge_finite_sqrt_bound : ∀ {m p : ℕ} (Q : BfgsVerification.Mat m),
  Matrix.PosSemidef Q →
    ∀ (γ : BfgsVerification.Vec p → ℝ),
      BfgsVerification.Homogeneous.PositiveDegreeOne γ →
        ∀ (μ Λ : ℝ),
          0 < μ →
            (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →
              (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →
                ∀ (R : BfgsVerification.AdmissibleBFGSRun (m + p) (BfgsVerification.QuadraticGauge.objective Q γ))
                  {N : ℕ},
                  0 < N →
                    BfgsVerification.QuadraticGauge.objective Q γ (R.x N) ≤
                      √((R.referenceEnergy 0 0 +
                            BfgsVerification.QuadraticGauge.correctionConstant μ Λ *
                              ∑ k ∈ Finset.range N, BfgsVerification.QuadraticGauge.objective Q γ (R.x (k + 1))) /
                          ∑ k ∈ Finset.range N, (R.q k)⁻¹)
@BfgsVerification.AdmissibleBFGSRun.quadraticGauge_sqrt_budget_log_rate : ∀ {m p : ℕ} (Q : BfgsVerification.Mat m),
  Matrix.PosDef Q →
    ∀ (γ : BfgsVerification.Vec p → ℝ),
      BfgsVerification.Homogeneous.PositiveDegreeOne γ →
        ∀ (μ Λ : ℝ),
          0 < μ →
            (∀ (v : BfgsVerification.Vec p), μ * √(BfgsVerification.sqNorm v) ≤ γ v) →
              (∀ (v : BfgsVerification.Vec p), γ v ≤ Λ * √(BfgsVerification.sqNorm v)) →
                ∀ (R : BfgsVerification.AdmissibleBFGSRun (m + p) (BfgsVerification.QuadraticGauge.objective Q γ)),
                  Filter.Tendsto
                    (fun N =>
                      √(R.referenceEnergy 0 0 +
                            BfgsVerification.QuadraticGauge.correctionConstant μ Λ *
                              ∑ k ∈ Finset.range N, BfgsVerification.QuadraticGauge.objective Q γ (R.x (k + 1))) /
                        Real.log ↑N)
                    Filter.atTop (nhds 0)
@BfgsVerification.AdmissibleBFGSRun.homogeneous_endpoint_pairings_tendsto_zero : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),
  BfgsVerification.Homogeneous.PositiveDegreeOne F →
    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0) →
      Filter.Tendsto (fun k => BfgsVerification.dot (R.g k) (R.x (k + 1))) Filter.atTop (nhds 0) ∧
        Filter.Tendsto (fun k => BfgsVerification.dot (R.g (k + 1)) (R.x (k + 1))) Filter.atTop (nhds 0)
BfgsVerification.AdmissibleBFGSRun.maxLinear_independent_anchors_tendsto_zero : ∀ (A : Finset (BfgsVerification.Vec 2))
  (hA : A.Nonempty) (R : BfgsVerification.AdmissibleBFGSRun 2 (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) →
    ∀ (j : ℕ → ℕ),
      Filter.Tendsto j Filter.atTop Filter.atTop →
        (∀ (k : ℕ), BfgsVerification.HomogeneousPlanar.pairDet (R.g (j k)) (R.g (j k + 1)) ≠ 0) →
          Filter.Tendsto (fun k => R.x (j k + 1)) Filter.atTop (nhds 0)
@BfgsVerification.Parabolic.Family.sublevel_compact : ∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) (B : ℝ),
  IsCompact {x | P.objective x ≤ B}
@BfgsVerification.Parabolic.Family.active_eq_gradient : ∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i : Fin m}
  {x g : BfgsVerification.Vec 2},
  P.Active i x → HasFDerivAt P.objective (BfgsVerification.gradientFunctional g) x → P.branchGradient i x = g
@BfgsVerification.Parabolic.Family.secant_quotient_bound : ∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m)
  {i j : Fin m} {x z : BfgsVerification.Vec 2},
  P.Active i x →
    P.Active j z →
      0 < BfgsVerification.TransportedCertificate.pairCurvature x z (P.branchGradient i x) (P.branchGradient j z) →
        BfgsVerification.dot (P.branchGradient j z - P.branchGradient i x)
                (BfgsVerification.Parabolic.Family.radialDirection z) ^
              2 /
            BfgsVerification.TransportedCertificate.pairCurvature x z (P.branchGradient i x) (P.branchGradient j z) ≤
          4 * P.a i ^ 2 / (P.a i + P.a j) * z 0 ^ 2 + 4 * P.deficit i z
@BfgsVerification.Parabolic.Family.exists_uniform_secant_bound : ∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m)
  {K : Set (BfgsVerification.Vec 2)},
  IsCompact K →
    ∀ {c₁ c₂ : ℝ},
      0 ≤ c₁ →
        c₂ < 1 →
          ∃ C,
            0 < C ∧
              ∀ x ∈ K,
                ∀ z ∈ K,
                  ∀ (g h : BfgsVerification.Vec 2),
                    BfgsVerification.TransportedCertificate.EligiblePair P.objective c₁ c₂ x z g h →
                      BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ 1 →
                        BfgsVerification.dot (h - g) (BfgsVerification.Parabolic.Family.radialDirection z) ^ 2 ≤
                          C * BfgsVerification.TransportedCertificate.pairCurvature x z g h
@BfgsVerification.Parabolic.Family.positive_visibility : ∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m)
  {x g : BfgsVerification.Vec 2} {η : ℝ},
  0 ≤ η →
    η ≤ P.objective x →
      HasFDerivAt P.objective (BfgsVerification.gradientFunctional g) x →
        4 * η ^ 2 ≤ BfgsVerification.dot g (BfgsVerification.Parabolic.Family.radialDirection x) ^ 2
@BfgsVerification.CertificateGeometry.projected_matrixRange : ∀ {n : ℕ} {W : BfgsVerification.Mat n},
  Matrix.PosSemidef W →
    ∀ (P : BfgsVerification.Mat n),
      BfgsVerification.CertificateGeometry.matrixRange (P * W * Matrix.transpose P) =
        Submodule.map (Matrix.mulVecLin P) (BfgsVerification.CertificateGeometry.matrixRange W)
@BfgsVerification.CertificateGeometry.range_le_sup_span_of_projected_order : ∀ {n : ℕ} {W Z : BfgsVerification.Mat n},
  Matrix.PosSemidef W →
    Matrix.PosSemidef Z →
      ∀ (s : BfgsVerification.Vec n),
        (BfgsVerification.TransportedCertificate.stepProjector s * W *
                BfgsVerification.TransportedCertificate.stepProjector s -
              BfgsVerification.TransportedCertificate.stepProjector s * Z *
                BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef →
          BfgsVerification.CertificateGeometry.matrixRange Z ≤
            BfgsVerification.CertificateGeometry.matrixRange W ⊔ Submodule.span ℝ {s}
@BfgsVerification.PointwiseFeasibility.uniformPSD_iff_capacity : ∀ {n : ℕ} {α : Type u_1} {β : α → Type u_2}
  (h : α → BfgsVerification.Vec n) (y : (z : α) → β z → BfgsVerification.Vec n) (t : (z : α) → β z → ℝ),
  (∀ (z : α) (j : β z), 0 ≤ t z j) →
    (BfgsVerification.PointwiseFeasibility.UniformPSD h y t ↔
      0 < ⨅ z, BfgsVerification.PointwiseFeasibility.descentCapacity (h z) (y z) (t z))
@BfgsVerification.PointwiseFeasibility.sourceIncomingPolar_eq_closedHull_polar : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η δ : ℝ},
  c₂ < 1 →
    ∀ (z : BfgsVerification.PointwiseFeasibility.BandPoint F K fstar η),
      BfgsVerification.PointwiseFeasibility.incomingPolar (BfgsVerification.PointwiseFeasibility.sourceJump z)
          (BfgsVerification.PointwiseFeasibility.sourceCurvature z) =
        BfgsVerification.PointwiseFeasibility.dotPairing.polar
          ((closedAbsConvexHull ℝ)
            (Set.range fun x =>
              (√(BfgsVerification.PointwiseFeasibility.sourceCurvature z x))⁻¹ •
                BfgsVerification.PointwiseFeasibility.sourceJump z x))
@BfgsVerification.AccessibleJumpGeometry.common_tangential_projection : ∀ {n : ℕ} {α : Type u_1}
  (g : α → EuclideanSpace ℝ (Fin n)) (i j : α),
  (BfgsVerification.AccessibleJumpGeometry.tangentSpace g).orthogonalProjection (g i) =
    (BfgsVerification.AccessibleJumpGeometry.tangentSpace g).orthogonalProjection (g j)
@BfgsVerification.AccessibleJumpGeometry.tangent_projection_zero_iff_zero_mem_affineSpan : ∀ {n : ℕ} {α : Type u_1}
  (g : α → EuclideanSpace ℝ (Fin n)) (i : α),
  (BfgsVerification.AccessibleJumpGeometry.tangentSpace g).orthogonalProjection (g i) = 0 ↔
    0 ∈ affineSpan ℝ (Set.range g)
@BfgsVerification.AccessibleJumpGeometry.accessible_jump_annihilated_of_continuousAt : ∀ {n : ℕ} {ι : Type u_1}
  {l : Filter ι} [inst : l.NeBot] {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)}
  {fstar c₁ c₂ η : ℝ} (B : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
  (x z g h : ι → BfgsVerification.Vec n) (p jump : BfgsVerification.Vec n),
  (∀ᶠ (a : ι) in l,
      x a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧
        z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧
          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a) (z a) (g a) (h a)) →
    Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairDecrease (x a) (z a) (g a)) l (nhds 0) →
      Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a) (z a) (g a) (h a)) l
          (nhds 0) →
        Filter.Tendsto (fun a => h a - g a) l (nhds jump) →
          Filter.Tendsto z l (nhds p) → ContinuousAt B.W p → Matrix.mulVec (B.W p) jump = 0
@BfgsVerification.AccessibleJumpGeometry.visible_accessible_projection_ne_zero : ∀ {n : ℕ} {α : Type u_1}
  (W : BfgsVerification.Mat n) (jump : α → BfgsVerification.Vec n),
  (∀ (i : α), Matrix.mulVec W (jump i) = 0) →
    ∀ (g : BfgsVerification.Vec n),
      0 < BfgsVerification.metricEnergy W g →
        (Submodule.span ℝ (Set.range fun i => BfgsVerification.euclideanVector (jump i)))ᗮ.orthogonalProjection
            (BfgsVerification.euclideanVector g) ≠
          0
@BfgsVerification.AccessibleJumpGeometry.visible_tangent_projection_ne_zero : ∀ {n : ℕ} {α : Type u_1}
  (W : BfgsVerification.Mat n) (g : α → BfgsVerification.Vec n),
  (∀ (i j : α), Matrix.mulVec W (g i - g j) = 0) →
    ∀ (i : α),
      0 < BfgsVerification.metricEnergy W (g i) →
        (BfgsVerification.AccessibleJumpGeometry.tangentSpace fun j =>
                BfgsVerification.euclideanVector (g j)).orthogonalProjection
            (BfgsVerification.euclideanVector (g i)) ≠
          0
BfgsVerification.AccessibleJumpGeometry.active_accessible_span_countermodel : Matrix.PosDef 1 ∧
  (∀ (i : Fin 2),
      0 < BfgsVerification.metricEnergy 1 (BfgsVerification.AccessibleJumpGeometry.countermodelGradients i)) ∧
    (∀ (j : Empty), Matrix.mulVec 1 (BfgsVerification.AccessibleJumpGeometry.countermodelAccessible j) = 0) ∧
      (BfgsVerification.AccessibleJumpGeometry.tangentSpace fun i =>
                BfgsVerification.euclideanVector
                  (BfgsVerification.AccessibleJumpGeometry.countermodelGradients i)).orthogonalProjection
            (BfgsVerification.euclideanVector (BfgsVerification.AccessibleJumpGeometry.countermodelGradients 0)) =
          0 ∧
        (Submodule.span ℝ
                  (Set.range fun i =>
                    BfgsVerification.euclideanVector
                      (BfgsVerification.AccessibleJumpGeometry.countermodelAccessible i)))ᗮ.orthogonalProjection
            (BfgsVerification.euclideanVector (BfgsVerification.AccessibleJumpGeometry.countermodelGradients 0)) ≠
          0
@BfgsVerification.AccessibleJumpGeometry.accessible_curvature_annihilated_of_continuousAt : ∀ {n : ℕ} {ι : Type u_1}
  {l : Filter ι} [inst : l.NeBot] {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)}
  {fstar c₁ c₂ η : ℝ},
  c₂ < 1 →
    ∀ (B : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)
      (x z g h : ι → BfgsVerification.Vec n) (p jump : BfgsVerification.Vec n),
      (∀ᶠ (a : ι) in l,
          x a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧
            z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧
              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a) (z a) (g a) (h a)) →
        Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a) (z a) (g a) (h a)) l
            (nhds 0) →
          Filter.Tendsto (fun a => h a - g a) l (nhds jump) →
            Filter.Tendsto z l (nhds p) → ContinuousAt B.W p → Matrix.mulVec (B.W p) jump = 0
structure BfgsVerification.Parabolic.Family (m : ℕ) : Type
number of parameters: 1
fields:
  BfgsVerification.Parabolic.Family.a : Fin m → ℝ
  BfgsVerification.Parabolic.Family.b : Fin m → ℝ
  BfgsVerification.Parabolic.Family.a_pos : ∀ (i : Fin m), 0 < self.a i
  BfgsVerification.Parabolic.Family.negative_slope : ∃ i, self.b i < 0
  BfgsVerification.Parabolic.Family.positive_slope : ∃ i, 0 < self.b i
constructor:
  BfgsVerification.Parabolic.Family.mk {m : ℕ} (a b : Fin m → ℝ) (a_pos : ∀ (i : Fin m), 0 < a i)
    (negative_slope : ∃ i, b i < 0) (positive_slope : ∃ i, 0 < b i) : BfgsVerification.Parabolic.Family m
def BfgsVerification.Parabolic.Family.calibratedScale : {m : ℕ} →
  BfgsVerification.Parabolic.Family m → BfgsVerification.Vec 2 → ℝ :=
fun {m} P x => Real.exp (P.calibratedExponent x)
def BfgsVerification.Parabolic.Family.calibratedVector : {m : ℕ} →
  BfgsVerification.Parabolic.Family m → BfgsVerification.Vec 2 → BfgsVerification.Vec 2 :=
fun {m} P x => P.calibratedScale x • BfgsVerification.Parabolic.Family.radialDirection x
