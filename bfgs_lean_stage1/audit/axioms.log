BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_span_le_two_finite_value","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n  Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues R.g)) ≤ 2 →\n    ∀ (L : ℝ),\n      Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds L) →\n        L = 0 ∧\n          ∃ xstar,\n            Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧ BfgsVerification.Homogeneous.finiteMaxLinear A hA xstar = 0","axioms":["propext","Classical.choice","Quot.sound"]}
