    (c₁_pos : 0 < c₁) (c₁_lt_c₂ : c₁ < c₂) (c₂_lt_one : c₂ < 1) (metric_pos : ∀ (k : ℕ), 0 < metric k)
    (alpha_pos : ∀ (k : ℕ), 0 < α k) (gradient_ne : ∀ (k : ℕ), g k ≠ 0) (hasDeriv : ∀ (k : ℕ), HasDerivAt f (g k) (x k))
    (step : ∀ (k : ℕ), x (k + 1) = x k - α k * metric k * g k)
    (armijo : ∀ (k : ℕ), f (x (k + 1)) ≤ f (x k) + c₁ * g k * (x (k + 1) - x k))
    (weak_wolfe : ∀ (k : ℕ), c₂ * g k * (x (k + 1) - x k) ≤ g (k + 1) * (x (k + 1) - x k)) :
