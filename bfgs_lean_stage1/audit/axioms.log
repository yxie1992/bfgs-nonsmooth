BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Example.exists_source_bandCertificate","signature":"∀ {K : Set (BfgsVerification.Vec 2)},\n  IsCompact K →\n    ∀ {η c₁ c₂ : ℝ},\n      0 < η →\n        0 ≤ c₁ →\n          c₂ < 1 →\n            ∃ B,\n              ∀ (x : BfgsVerification.Vec 2),\n                B.W x =\n                  BfgsVerification.outer (BfgsVerification.Parabolic.Example.sourceVector x)\n                    (BfgsVerification.Parabolic.Example.sourceVector x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principal_product_augmented_sum_le","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ lam i) →\n    ∀ (y : BfgsVerification.Vec n) (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ, (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \\ I, lam k * y k ^ 2 ≤\n        BfgsVerification.sqNorm y * ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ, ∏ i ∈ J, lam i","axioms":["propext","Quot.sound","Classical.choice"]}
