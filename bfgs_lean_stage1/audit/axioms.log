BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.fixed_normal_cutoff_residual_budget","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  {Ω : Set (BfgsVerification.Vec n)} {μ : ℝ},\n  0 < μ →\n    BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n      (∀ (k : ℕ), R.x k ∈ Ω) →\n        ∀ {a : BfgsVerification.Vec n},\n          BfgsVerification.sqNorm a = 1 →\n            ∀ {τ : ℝ → ℝ} {L : NNReal},\n              LipschitzWith L τ →\n                ∀ (b : ℝ) (k : ℕ),\n                  BfgsVerification.SmoothSubspace.frobSq\n                      (BfgsVerification.FixedNormal.cutoffResidual a (R.displacement k)\n                        (BfgsVerification.FixedNormal.cutoffSlope τ (BfgsVerification.dot a (R.x k) - b)\n                          (BfgsVerification.dot a (R.x (k + 1)) - b))) ≤\n                    2 * ↑L ^ 2 / μ * R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
