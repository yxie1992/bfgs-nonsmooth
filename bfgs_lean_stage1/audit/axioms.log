BFGS_AUDIT {"theorem":"BfgsVerification.IncomingJump.weighted_jump_bound","signature":"∀ {n r : ℕ} {W : BfgsVerification.Mat n},\n  Matrix.PosSemidef W →\n    ∀ (coeff : Fin r → ℝ) (y : Fin r → BfgsVerification.Vec n) (t : Fin r → ℝ) (C : ℝ),\n      (∀ (j : Fin r), 0 ≤ t j) →\n        (∀ (j : Fin r), BfgsVerification.metricEnergy W (y j) ≤ C * t j) →\n          √(BfgsVerification.metricEnergy W (∑ j, coeff j • y j)) ≤ √(max C 0) * ∑ j, |coeff j| * √(t j)","axioms":["propext","Quot.sound","Classical.choice"]}
