BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_value_dichotomy","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0) ∨\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop Filter.atBot","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.summable_step_dist_of_gradient_lower","signature":"∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f),\n  Summable R.d → ∀ (m : ℝ), 0 < m → (∀ (k : ℕ), m ≤ |R.g k|) → Summable fun k => dist (R.x k) (R.x (k + 1))","axioms":["propext","Quot.sound","Classical.choice"]}
