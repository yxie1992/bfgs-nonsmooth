BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.exists_recurrent_maxLinear_run","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n  ∃ J B,\n    ∃ (hB : B.Nonempty),\n      ∃ Q,\n        ↑B = BfgsVerification.Homogeneous.recurrentValues R.g ∧\n          B ⊆ A ∧\n            (Q.x = fun k => R.x (J + k)) ∧\n              (Q.H = fun k => R.H (J + k)) ∧\n                (Q.g = fun k => R.g (J + k)) ∧\n                  (Q.α = fun k => R.α (J + k)) ∧\n                    Q.c₁ = R.c₁ ∧\n                      Q.c₂ = R.c₂ ∧\n                        ∀ (k : ℕ),\n                          BfgsVerification.Homogeneous.finiteMaxLinear B hB (Q.x k) =\n                            BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x (J + k))","axioms":["propext","Quot.sound","Classical.choice"]}
