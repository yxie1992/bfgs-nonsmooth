BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.normalizedFrameEnergy_eq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (P : ℕ → BfgsVerification.Mat r) (k : ℕ),\n  R.normalizedFrameEnergy V P k = ((P k)⁻¹.transpose * BfgsVerification.metricGram (R.hessian k) (V k) * (P k)⁻¹).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.fixed_reference_energy_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xstar : BfgsVerification.Vec n),\n  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →\n    ∀ (N : ℕ),\n      (F (R.x N) - F xstar) ^ 2 * ∑ k ∈ Finset.range N, (R.q k)⁻¹ ≤\n        R.referenceEnergy xstar 0 + ∑ k ∈ Finset.range N, R.referenceCorrection xstar k","axioms":["propext","Quot.sound","Classical.choice"]}
