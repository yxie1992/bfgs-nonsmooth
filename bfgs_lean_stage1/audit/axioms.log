BFGS_AUDIT {"theorem":"BfgsVerification.finiteHorizon","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          Summable R.d →\n            ∀ (J m : ℕ),\n              0 < m →\n                ∀ (η : ℝ),\n                  0 < η →\n                    let D := ∑' (i : ℕ), R.d (J + i);\n                    let V :=\n                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                        (BfgsVerification.principalSum (R.H J));\n                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","axioms":["propext","Classical.choice","Quot.sound"]}
