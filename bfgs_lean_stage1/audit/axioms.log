BFGS_AUDIT {"theorem":"BfgsVerification.DEmbedding.run_phase_parameters","signature":"∀ {n : ℕ} (hn : 1 ≤ n) {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (m : ℕ) (j : Fin 3),\n  let R := BfgsVerification.DEmbedding.run hn c₁ c₂ hc₁ hc₁' hc hc₂;\n  R.x (3 * m + ↑j) =\n      BfgsVerification.DEmbedding.center n +\n        BfgsVerification.DScalarGeometric.scale n ^ 2 •\n          BfgsVerification.SeedOrbit.seedRatio ^ m •\n            BfgsVerification.SeedOrbit.point BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n              BfgsVerification.SeedOrbit.seedRatio j ∧\n    R.H (3 * m + ↑j) =\n        BfgsVerification.SeedOrbit.seedRatio ^ m •\n          BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD j ∧\n      R.g (3 * m + ↑j) =\n          BfgsVerification.DScalarGeometric.scale n ^ 2 •\n            BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD j ∧\n        R.α (3 * m + ↑j) = BfgsVerification.SeedOrbit.length j","axioms":["propext","Classical.choice","Quot.sound"]}
