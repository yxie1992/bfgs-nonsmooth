BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.transported_certificate_values_on_sublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),\n  IsCompact {x | F x ≤ b} →\n    ∀ (xstar : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F xstar ≤ F x) →\n        F (R.x 0) ≤ b →\n          BfgsVerification.TransportedCertificate.HasBandCertificates F {x | F x ≤ b} (F xstar) R.c₁ R.c₂ →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.restrict._proof_5","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ K' ⊆ K,\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (C.W x)","axioms":["propext","Quot.sound","Classical.choice"]}
