BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.strong_displacement_sq_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {U : Set (BfgsVerification.Vec n)} {μ : ℝ},\n  0 < μ →\n    BfgsVerification.FixedNormal.EuclideanStrongConvexOn U μ F →\n      (∀ (k : ℕ), R.x k ∈ U) → ∀ (k : ℕ), BfgsVerification.sqNorm (R.displacement k) ≤ 2 / μ * R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.exists_uniform_log_transport","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {K : Set (BfgsVerification.Vec 2)},\n  IsCompact K →\n    ∀ {η c₁ c₂ : ℝ},\n      0 < η →\n        0 ≤ c₁ →\n          c₂ < 1 →\n            ∃ C δ,\n              0 < C ∧\n                0 < δ ∧\n                  δ ≤ 1 ∧\n                    ∀ x ∈ K,\n                      ∀ z ∈ K,\n                        ∀ (g h : BfgsVerification.Vec 2),\n                          BfgsVerification.TransportedCertificate.EligiblePair P.objective c₁ c₂ x z g h →\n                            η ≤ P.objective x →\n                              η ≤ P.objective z →\n                                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n                                  BfgsVerification.Parabolic.Family.stepDeterminant x z ≠ 0 ∧\n                                    0 < P.compensatedMultiplier x z ∧\n                                      |Real.log (P.compensatedMultiplier x z)| ≤\n                                        C * BfgsVerification.TransportedCertificate.pairDecrease x z g","axioms":["propext","Quot.sound","Classical.choice"]}
