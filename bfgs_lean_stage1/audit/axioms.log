BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCrossing.crossing_inverse_step_bound","signature":"∀ {a b s r : BfgsVerification.Vec 2} {A E d t : ℝ},\n  BfgsVerification.HomogeneousPlanar.pairDet a b ≠ 0 →\n    0 ≤ A →\n      0 ≤ E →\n        0 ≤ d →\n          0 ≤ t →\n            ‖BfgsVerification.AffineProjection.matrixCLM (BfgsVerification.HomogeneousPlanar.pairMatrix a b)⁻¹‖ ≤ A →\n              BfgsVerification.dot a s = -d →\n                BfgsVerification.dot b s = t - d - BfgsVerification.dot r s →\n                  |BfgsVerification.dot r s| ≤ E * ‖s‖ ^ 2 → ‖s‖ ≤ A * (2 * d + t + E * ‖s‖ ^ 2)","axioms":["propext","Classical.choice","Quot.sound"]}
