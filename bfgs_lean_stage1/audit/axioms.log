BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.positive_pseudoDivision_specialize","signature":"∀ {R : Type u_1} [inst : CommRing R] [inst_1 : IsDomain R] {p q Q r : Polynomial R} {k : ℕ},\n  Polynomial.C q.leadingCoeff ^ (2 * k) * p = q * Q + r →\n    r = 0 ∨ r.natDegree < q.natDegree →\n      ∀ (f : R →+* ℝ),\n        f q.leadingCoeff ≠ 0 →\n          (Polynomial.map f r = 0 ∨ (Polynomial.map f r).natDegree < (Polynomial.map f q).natDegree) ∧\n            ∀ (t : ℝ),\n              Polynomial.eval t (Polynomial.map f q) = 0 →\n                (Polynomial.eval t (Polynomial.map f p) = 0 ↔ Polynomial.eval t (Polynomial.map f r) = 0) ∧\n                  (0 < Polynomial.eval t (Polynomial.map f p) ↔ 0 < Polynomial.eval t (Polynomial.map f r)) ∧\n                    (0 ≤ Polynomial.eval t (Polynomial.map f p) ↔ 0 ≤ Polynomial.eval t (Polynomial.map f r))","axioms":["propext","Classical.choice","Quot.sound"]}
