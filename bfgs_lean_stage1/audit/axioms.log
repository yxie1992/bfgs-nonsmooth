BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.global_supporting_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    BfgsVerification.Homogeneous.PositiveDegreeOne F →\n      ∃ G,\n        0 < G ∧\n          ∀ (x g : BfgsVerification.Vec n),\n            BfgsVerification.Homogeneous.Supports F x g → BfgsVerification.sqNorm g ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CertificateGeometry.step_projected_ellipsoid_subset_iff","signature":"∀ {n : ℕ} {W Z : BfgsVerification.Mat n} (hW : Matrix.PosSemidef W) (hZ : Matrix.PosSemidef Z)\n  (s : BfgsVerification.Vec n),\n  Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) ''\n        BfgsVerification.CertificateGeometry.ellipsoid hZ ⊆\n      Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) ''\n        BfgsVerification.CertificateGeometry.ellipsoid hW ↔\n    (BfgsVerification.TransportedCertificate.stepProjector s * W *\n          BfgsVerification.TransportedCertificate.stepProjector s -\n        BfgsVerification.TransportedCertificate.stepProjector s * Z *\n          BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
