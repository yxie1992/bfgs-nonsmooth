BFGS_AUDIT {"theorem":"BfgsVerification.PlanarObjectiveField.exists_structured_visible_comparison_field","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (hF : ConvexOn ℝ Set.univ F) {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ},\n  IsCompact K →\n    (∀ x ∈ K, F x = ℓ) →\n      (∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n        (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F x) →\n          (∀ x ∈ K, ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F x) →\n            ∃ m χ v,\n              (∀ (i : Fin m), ContDiff ℝ (↑⊤) (χ i)) ∧\n                ∃ N η,\n                  0 < η ∧\n                    IsOpen N ∧\n                      K ⊆ N ∧\n                        (∀ x ∈ N,\n                            ∃ L,\n                              ∃ U ∈ nhds x, LipschitzOnWith L (BfgsVerification.PlanarObjectiveField.field hF χ v) U) ∧\n                          (∀ x ∈ N,\n                              ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                η ≤ BfgsVerification.dot g (BfgsVerification.PlanarObjectiveField.field hF χ v x)) ∧\n                            (∀ x ∈ N, ∀ (i : Fin m), ContDiffAt ℝ 1 (v i) (F x)) ∧\n                              (∀ x ∈ N,\n                                  ContDiffAt ℝ 2 F x ∨\n                                    ∃ i,\n                                      ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,\n                                        BfgsVerification.PlanarObjectiveField.field hF χ v z = v i (F z)) ∧\n                                ∀ x ∈ K,\n                                  ∀ g ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                    ∀ h ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                      BfgsVerification.dot g (BfgsVerification.PlanarObjectiveField.field hF χ v x) =\n                                        BfgsVerification.dot h (BfgsVerification.PlanarObjectiveField.field hF χ v x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.norm_objective_finite_bad_ray","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  Differentiable ℝ ψ →\n    ∀ (A : (i : ι) → BfgsVerification.Vec n →L[ℝ] EuclideanSpace ℝ (Fin (m i)))\n      (b : (i : ι) → EuclideanSpace ℝ (Fin (m i))),\n      (∀ (z : BfgsVerification.Vec n), F z = ψ z + BfgsVerification.EuclideanResidual.normPenalty A b z) →\n        ∀ {x : BfgsVerification.Vec n},\n          DifferentiableAt ℝ F x →\n            ∀ (p : BfgsVerification.Vec n), {t | 0 < t ∧ ¬DifferentiableAt ℝ F (x + t • p)}.Finite","axioms":["propext","Quot.sound","Classical.choice"]}
