BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.rescale._proof_5","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (w : BfgsVerification.Vec n → ℝ)\n  (lo hi L' : ℝ),\n  0 < lo →\n    (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, lo ≤ w x ∧ w x ≤ hi) →\n      (∀ (x z g h : BfgsVerification.Vec n),\n          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n                  w z * (1 + C.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) ≤\n                    (1 + L' * BfgsVerification.TransportedCertificate.pairDecrease x z g) * w x) →\n        ∀ (x z g h : BfgsVerification.Vec n),\n          x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n            z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n                BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n                  ((1 + L' * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                        (BfgsVerification.TransportedCertificate.stepProjector\n                              (BfgsVerification.TransportedCertificate.pairStep x z) *\n                            w x • C.W x *\n                          BfgsVerification.TransportedCertificate.stepProjector\n                            (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                      BfgsVerification.TransportedCertificate.stepProjector\n                            (BfgsVerification.TransportedCertificate.pairStep x z) *\n                          w z • C.W z *\n                        BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_finite_value_limit_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ), Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds L) → L = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.normalized_frame_trace_recurrence._proof_1","signature":"∀ {m : Type u_2} {n : Type u_3} {o : Type u_4} {α : Type v} [inst : NonUnitalSemiring α] [inst_1 : Fintype n]\n  [inst_2 : Fintype o] (v : o → α) (M : Matrix m n α) (N : Matrix n o α), (M * N).mulVec v = M.mulVec (N.mulVec v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.inverse_transpose_lower","signature":"∀ {r : ℕ} (P : BfgsVerification.Mat r),\n  Matrix.det P ≠ 0 →\n    ∀ (K : ℝ),\n      0 < K →\n        (∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose P).mulVec v) ≤ K * BfgsVerification.sqNorm v) →\n          ∀ (a : BfgsVerification.Vec r),\n            BfgsVerification.sqNorm a / K ≤ BfgsVerification.sqNorm (P⁻¹.transpose.mulVec a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.alpha_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), 0 < self.α k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.normalize_budget","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (hc₁ : 0 < c₁) (hc₂ : c₂ < 1) (b : ℝ)\n  (hb : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b),\n  (C.normalize hc₁ hc₂ b hb).L = 0 ∧ (C.normalize hc₁ hc₂ b hb).δ = C.δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.gap_tendsto_zero_of_quadratic_budget","signature":"∀ {gap S T : ℕ → ℝ} {E₀ C : ℝ},\n  (∀ (k : ℕ), 0 ≤ gap k) →\n    (∀ (N : ℕ), gap N ^ 2 * S N ≤ E₀ + T N) →\n      Filter.Tendsto (fun N => S N / ↑N ^ 2) Filter.atTop Filter.atTop →\n        (∀ᶠ (N : ℕ) in Filter.atTop, T N ≤ C * ↑N ^ 2) → Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 →\n    BfgsVerification.PrincipalInvariance.principalPolynomial (U * H * V) =\n      BfgsVerification.PrincipalInvariance.principalPolynomial H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.differences_tendsto_zero_of_strict_contour","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  IsCompact R.initialSublevel →\n    ∀ (ℓ : ℝ),\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        (∃ y, F y < ℓ) →\n          (∀ (x z : BfgsVerification.Vec n), segment ℝ x z ⊆ frontier {w | F w ≤ ℓ} → x = z) →\n            Filter.Tendsto (fun k => R.x (k + 1) - R.x k) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ k ∈ Finset.range (m + 1), Real.log (q (J + k)) ≤ Real.log C + Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_outer","signature":"∀ {n r : ℕ} (g : BfgsVerification.Vec n) (V : Matrix (Fin n) (Fin r) ℝ),\n  BfgsVerification.metricGram (BfgsVerification.outer g g) V =\n    BfgsVerification.outer (V.transpose.mulVec g) (V.transpose.mulVec g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η) (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          BfgsVerification.metricEnergy (self.W z) (h - g) ≤\n            self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.referenceEnergy.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n)\n  (k : ℕ), R.referenceEnergy xstar k = BfgsVerification.metricEnergy (R.hessian k) (R.x k - xstar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalar_certificate_iff_eligible_lipschitz","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 1),\n      IsCompact K →\n        ∀ {c₁ c₂ η : ℝ},\n          c₂ < 1 →\n            0 < η →\n              (Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K (F star) c₁ c₂ η) ↔\n                BfgsVerification.TransportedCertificate.ScalarEligibleLipschitz F K (F star) c₁ c₂ η)","axioms":["propext","Quot.sound","Classical.choice"]}
