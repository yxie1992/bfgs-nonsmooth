BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.radial_error_bound","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i j : Fin m} {x z : BfgsVerification.Vec 2} {G R d : ℝ},\n  0 ≤ G →\n    0 ≤ R →\n      0 ≤ d →\n        |z 0| ≤ R →\n          |P.branchGradient i x 0| ≤ G →\n            |P.branchGradient j z 0| ≤ G →\n              P.deficit i z ≤ d →\n                |2 * P.a i * BfgsVerification.Parabolic.Family.horizontalStep x z * z 0 + 2 * P.deficit i z +\n                      (P.branchGradient j z 0 - P.branchGradient i x 0) *\n                        BfgsVerification.Parabolic.Family.horizontalStep x z| ≤\n                  (2 * P.maxQuadratic * R + 2 * G + 2) * (|BfgsVerification.Parabolic.Family.horizontalStep x z| + d)","axioms":["propext","Quot.sound","Classical.choice"]}
