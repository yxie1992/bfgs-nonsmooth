BFGS_AUDIT {"theorem":"BfgsVerification.ResidualBudget.driftProduct.eq_1","signature":"∀ (u : ℕ → ℝ) (N : ℕ), BfgsVerification.ResidualBudget.driftProduct u N = ∏ k ∈ Finset.range N, (1 + u k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  {W : BfgsVerification.Vec n → BfgsVerification.Mat n} {m C L δ : ℝ} {m_pos : 0 < m} {L_nonneg : 0 ≤ L}\n  {delta_pos : 0 < δ}\n  {positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x)}\n  {visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g}\n  {secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h}\n  {transport :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              ((1 + L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef}\n  {W_1 : BfgsVerification.Vec n → BfgsVerification.Mat n} {m_1 C_1 L_1 δ_1 : ℝ} {m_pos_1 : 0 < m_1}\n  {L_nonneg_1 : 0 ≤ L_1} {delta_pos_1 : 0 < δ_1}\n  {positive_semidefinite_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W_1 x)}\n  {visibility_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m_1 ≤ BfgsVerification.metricEnergy (W_1 x) g}\n  {secant_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              BfgsVerification.metricEnergy (W_1 z) (h - g) ≤\n                C_1 * BfgsVerification.TransportedCertificate.pairCurvature x z g h}\n  {transport_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              ((1 + L_1 * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W_1 x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W_1 z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef},\n  { W := W, m := m, C := C, L := L, δ := δ, m_pos := m_pos, L_nonneg := L_nonneg, delta_pos := delta_pos,\n        positive_semidefinite := positive_semidefinite, visibility := visibility, secant := secant,\n        transport := transport } =\n      { W := W_1, m := m_1, C := C_1, L := L_1, δ := δ_1, m_pos := m_pos_1, L_nonneg := L_nonneg_1,\n        delta_pos := delta_pos_1, positive_semidefinite := positive_semidefinite_1, visibility := visibility_1,\n        secant := secant_1, transport := transport_1 } →\n    W = W_1 ∧ m = m_1 ∧ C = C_1 ∧ L = L_1 ∧ δ = δ_1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.normalizedLower_tendsto","signature":"∀ (A D : ℝ) (n : ℕ),\n  0 < D → Filter.Tendsto (BfgsVerification.QuantitativeGrowth.normalizedLower A D n) Filter.atTop (nhds (2 * D)⁻¹)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.transpose_outer","signature":"∀ {n : ℕ} (a b : BfgsVerification.Vec n), Matrix.transpose (BfgsVerification.outer a b) = BfgsVerification.outer b a","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace_eq_projection_trace","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (U : Matrix (Fin n) (Fin r) ℝ),\n  (BfgsVerification.metricGram B U).trace = (U * U.transpose * B).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.wolfe_constant_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F), 0 < 1 - R.c₂","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.residualFrameCriterion","signature":"BfgsVerification.ResidualFrameCriterionTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    ∀ (g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.fullBFGS_positive_invariants","signature":"∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ) (c₂ : ℝ),\n  Matrix.PosDef (H 0) →\n    (∀ (k : ℕ), g k ≠ 0) →\n      (∀ (k : ℕ), 0 < α k) →\n        c₂ < 1 →\n          (∀ (k : ℕ),\n              c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤\n                BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k))) →\n            (∀ (k : ℕ),\n                H (k + 1) =\n                  BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)) →\n              ∀ (k : ℕ),\n                Matrix.PosDef (H k) ∧\n                  0 < BfgsVerification.metricEnergy (H k) (g k) ∧\n                    0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverse_mul_step","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H → ∀ (g : BfgsVerification.Vec n) (α : ℝ), Matrix.mulVec H⁻¹ (BfgsVerification.bfgsStep H g α) = -α • g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_summable_of_tendsto","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), 0 ≤ d k) → (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → Filter.Tendsto f Filter.atTop (nhds L) → Summable d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.distance_to_argmin_of_values","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xStar : BfgsVerification.Vec n),\n  (∀ (y : BfgsVerification.Vec n), F xStar ≤ F y) →\n    ∀ {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        (∀ (k : ℕ), R.x k ∈ K) →\n          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xStar)) →\n            Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_6","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  R.H (J + k + 1) =\n    BfgsVerification.inverseBFGS (R.H (J + k)) (BfgsVerification.bfgsStep (R.H (J + k)) (R.g (J + k)) (R.α (J + k)))\n      (R.g (J + k + 1) - R.g (J + k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inwardPoint.eq_1","signature":"∀ {n : ℕ} (star x : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.RadialCertificate.inwardPoint star x t = x - t • (x - star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.objectiveReciprocalGrowth","signature":"BfgsVerification.ObjectiveReciprocalGrowthTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.trace_outer","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n), Matrix.trace (BfgsVerification.outer g g) = BfgsVerification.sqNorm g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.normalize._proof_8","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  0 < c₁ →\n    ∀ (b : ℝ),\n      (∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, F x ≤ b) →\n        ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n          Real.exp (C.L / c₁ * η) ≤ Real.exp (C.L / c₁ * (F x - fstar)) ∧\n            Real.exp (C.L / c₁ * (F x - fstar)) ≤ Real.exp (C.L / c₁ * (b - fstar))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_one_pos","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n}, Matrix.PosDef H → 0 < n → 0 < BfgsVerification.principalSum H 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.det_nonneg_of_posSemidef","signature":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {H : Matrix ι ι ℝ}, H.PosSemidef → 0 ≤ H.det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_projection_form","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  α ≠ 0 →\n    BfgsVerification.metricEnergy H g ≠ 0 →\n      -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g ≠ 0 →\n        let q := BfgsVerification.metricEnergy H g;\n        let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n        let v := Matrix.mulVec H g;\n        BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y =\n          (1 + (β * q)⁻¹ • BfgsVerification.outer v y) * H * (1 + (β * q)⁻¹ • BfgsVerification.outer y v) +\n            (α / (β * q)) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.frame_descent_nonneg","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {p : ℕ} (k : ℕ)\n  (V : Matrix (Fin n) (Fin p) ℝ),\n  ∀ m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)),\n    0 ≤ (BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclidean_sum_apply","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] (v : ι → EuclideanSpace ℝ (Fin n)) (i : Fin n), (∑ j, v j) i = ∑ j, v j i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.posDef_orthogonal_diagonalization","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∃ U lam,\n      Matrix.transpose U * U = 1 ∧\n        U * Matrix.transpose U = 1 ∧ Matrix.transpose U * H * U = Matrix.diagonal lam ∧ ∀ (i : Fin n), 0 < lam i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.dot_cons_one","signature":"∀ {n : ℕ} (b : BfgsVerification.Vec n) (x : BfgsVerification.Vec (n + 1)),\n  BfgsVerification.dot (Fin.cons 1 b) x = x 0 + BfgsVerification.dot b (Fin.tail x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression_det","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      κ ≠ 0 →\n        κ ^ 2 * Matrix.det (BfgsVerification.CompressionDeterminant.compression A a b κ r) =\n          Matrix.det A *\n            ((κ - BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)) ^ 2 +\n              BfgsVerification.dot a (Matrix.mulVec A⁻¹ a) * (r - BfgsVerification.dot b (Matrix.mulVec A⁻¹ b)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.log_potential_telescope._proof_1","signature":"∀ (J m : ℕ), ¬J + (m + 1) = J + m + 1 → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.mk.injEq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (W : BfgsVerification.Vec n → BfgsVerification.Mat n) (m C δ : ℝ) (m_pos : 0 < m) (delta_pos : 0 < δ)\n  (positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))\n  (visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)\n  (secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)\n  (W_1 : BfgsVerification.Vec n → BfgsVerification.Mat n) (m_1 C_1 δ_1 : ℝ) (m_pos_1 : 0 < m_1) (delta_pos_1 : 0 < δ_1)\n  (positive_semidefinite_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W_1 x))\n  (visibility_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m_1 ≤ BfgsVerification.metricEnergy (W_1 x) g)\n  (secant_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              BfgsVerification.metricEnergy (W_1 z) (h - g) ≤\n                C_1 * BfgsVerification.TransportedCertificate.pairCurvature x z g h),\n  ({ W := W, m := m, C := C, δ := δ, m_pos := m_pos, delta_pos := delta_pos,\n        positive_semidefinite := positive_semidefinite, visibility := visibility, secant := secant } =\n      { W := W_1, m := m_1, C := C_1, δ := δ_1, m_pos := m_pos_1, delta_pos := delta_pos_1,\n        positive_semidefinite := positive_semidefinite_1, visibility := visibility_1, secant := secant_1 }) =\n    (W = W_1 ∧ m = m_1 ∧ C = C_1 ∧ δ = δ_1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot_sq_le_sqNorm_mul_sqNorm","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n),\n  BfgsVerification.dot x y ^ 2 ≤ BfgsVerification.sqNorm x * BfgsVerification.sqNorm y","axioms":["propext","Quot.sound","Classical.choice"]}
