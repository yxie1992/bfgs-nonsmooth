BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.scalar_certificate_iff_quotient","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec 1) {c₁ c₂ η : ℝ},\n      c₂ < 1 →\n        0 < η →\n          (Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K (F star) c₁ c₂ η) ↔\n            BfgsVerification.TransportedCertificate.ScalarQuotientBound F K (F star) c₁ c₂ η)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_referenceCorrection_le_drop","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ), R.referenceCorrection 0 k ≤ (1 - R.c₁) / R.c₁ * (F (R.x k) - F (R.x (k + 1)))","axioms":["propext","Quot.sound","Classical.choice"]}
