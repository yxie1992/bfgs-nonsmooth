BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.Rotation.pair_frobenius_identities","signature":"∀ (P : BfgsVerification.NuclearSymmetric2.Rotation) (ε : ℝ),\n  BfgsVerification.NuclearSymmetric2.matrix (P.newGradient ε) -\n        BfgsVerification.NuclearSymmetric2.matrix (P.oldGradient ε) =\n      (2 * (1 + ε)) • BfgsVerification.outer P.u P.u ∧\n    BfgsVerification.NuclearSymmetric2.frobenius\n          (BfgsVerification.NuclearSymmetric2.matrix (P.newGradient ε) -\n            BfgsVerification.NuclearSymmetric2.matrix (P.oldGradient ε))\n          (BfgsVerification.NuclearSymmetric2.matrix (P.newPoint ε) -\n            BfgsVerification.NuclearSymmetric2.matrix (P.oldPoint ε)) =\n        4 * ε * (1 + ε) ∧\n      BfgsVerification.NuclearSymmetric2.frobenius\n          (BfgsVerification.NuclearSymmetric2.matrix (P.newGradient ε) -\n            BfgsVerification.NuclearSymmetric2.matrix (P.oldGradient ε))\n          (BfgsVerification.NuclearSymmetric2.matrix (P.newPoint ε) -\n            BfgsVerification.NuclearSymmetric2.matrix BfgsVerification.NuclearSymmetric2.minimizer) =\n        2 * (1 + ε) * (ε - P.s ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.no_quadratic_bound_of_linear_lower","signature":"∀ {D : ℝ → ℝ} {J : ℝ},\n  0 < J →\n    (∃ ε, 0 < ε ∧ ∀ (t : ℝ), 0 ≤ t → t ≤ ε → J * t ≤ D t) → ¬∃ C ε, 0 < ε ∧ ∀ (t : ℝ), 0 ≤ t → t ≤ ε → D t ≤ C * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FivePieceObstruction.no_acceptable_step","signature":"∀ {τ α : ℝ},\n  0 < τ →\n    0 < α →\n      ∀ (g : BfgsVerification.Vec 3),\n        HasFDerivAt BfgsVerification.FivePieceObstruction.objective (BfgsVerification.gradientFunctional g)\n            (BfgsVerification.FivePieceObstruction.ray τ α) →\n          BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ α) ≤\n              BfgsVerification.FivePieceObstruction.objective (BfgsVerification.FivePieceObstruction.ray τ 0) -\n                1 / 4 * τ * α →\n            -(1 / 2) ≤ g 0 → False","axioms":["propext","Quot.sound","Classical.choice"]}
