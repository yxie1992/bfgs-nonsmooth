BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalSum_orthogonal_conjugate","signature":"∀ {n : ℕ} (Q H : BfgsVerification.Mat n),\n  Q * Matrix.transpose Q = 1 →\n    ∀ (j : ℕ), BfgsVerification.principalSum (Matrix.transpose Q * H * Q) j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_smul","signature":"∀ {n r : ℕ} (a : ℝ) (B : BfgsVerification.Mat n) (V : Matrix (Fin n) (Fin r) ℝ),\n  BfgsVerification.metricGram (a • B) V = a • BfgsVerification.metricGram B V","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.intercept_bound_of_radial","signature":"∀ {N D T C Tmax : ℝ}, 0 ≤ D → D ≤ T → T ≤ Tmax → N ^ 2 ≤ C * T → (N - D) ^ 2 ≤ (2 * C + 2 * Tmax) * T","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_coeff","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (j : ℕ),\n  (BfgsVerification.PrincipalInvariance.principalPolynomial H).coeff j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.weightedPotential_mul_le","signature":"∀ (n : ℕ) (r t : ℝ) (e : ℕ → ℝ),\n  0 ≤ r →\n    1 ≤ t →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        BfgsVerification.ScalarHierarchy.weightedPotential n (r * t) e ≤\n          BfgsVerification.ScalarHierarchy.weightedPotential n r e * t ^ n","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_probe_quadratic_bound","signature":"∀ {A B D M θ : ℝ},\n  0 ≤ A →\n    A ≤ B →\n      0 ≤ D →\n        0 ≤ M → 0 < θ → (∀ (t : ℝ), 0 ≤ t → t ≤ θ → t * A ≤ D + M / 2 * t ^ 2) → A ^ 2 ≤ max (2 * M) (2 * B / θ) * D","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.continuous_objective","signature":"∀ {f : ℝ → ℝ}, BfgsVerification.ScalarMetricRun f → Continuous f","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_energy_identity","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ), R.referenceEnergy 0 (k + 1) = R.referenceEnergy 0 k - F (R.x k) ^ 2 / R.q k + R.referenceCorrection 0 k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.finiteMaxLinear_gradient_mem","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty) {x g : BfgsVerification.Vec n},\n  HasFDerivAt (BfgsVerification.Homogeneous.finiteMaxLinear A hA) (BfgsVerification.gradientFunctional g) x → g ∈ A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.restrict._proof_8","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ K' ⊆ K,\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n              ((1 + C.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        C.W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      C.W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
