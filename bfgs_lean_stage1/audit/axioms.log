BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_bounded_below_convergence","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ),\n      (∀ (x : BfgsVerification.Vec n), L ≤ F x) →\n        (∀ (x : BfgsVerification.Vec n), F 0 ≤ F x) ∧\n          F 0 = 0 ∧ Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.rank_two_add_rank_one_det","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (t v ρ : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det\n          (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a) +\n            ρ • BfgsVerification.outer a a) =\n        Matrix.det\n            (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a)) +\n          ρ * Matrix.det A * BfgsVerification.dot a (Matrix.mulVec A⁻¹ a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.logMean_le_arithmeticMean","signature":"∀ (q : ℕ → ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    ∀ (N : ℕ), BfgsVerification.ReciprocalGrowth.logReciprocalMean q N ≤ BfgsVerification.reciprocalMean q N","axioms":["propext","Quot.sound","Classical.choice"]}
