def BfgsVerification.TransportedCertificate.HasBandCertificates : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → ℝ → ℝ → ℝ → Prop :=
fun {n} F K fstar c₁ c₂ =>
  ∀ (η : ℝ),
    0 < η →
      (BfgsVerification.TransportedCertificate.positiveBand F K fstar η).Nonempty →
        Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η)
def BfgsVerification.Homogeneous.PositiveDegreeOne : {n : ℕ} → (BfgsVerification.Vec n → ℝ) → Prop :=
fun {n} F => ∀ (t : ℝ), 0 ≤ t → ∀ (x : BfgsVerification.Vec n), F (t • x) = t * F x
