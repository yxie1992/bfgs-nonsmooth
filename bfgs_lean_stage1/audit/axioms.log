BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)\n  (x z g h : BfgsVerification.Vec n),\n  x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n    z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n      BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n        BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ self.δ →\n          BfgsVerification.metricEnergy (self.W z) (h - g) ≤\n            self.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Classical.choice","Quot.sound"]}
