BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.pairCurvature.eq_1","signature":"∀ {n : ℕ} (x z g h : BfgsVerification.Vec n),\n  BfgsVerification.TransportedCertificate.pairCurvature x z g h =\n    BfgsVerification.dot (h - g) (BfgsVerification.TransportedCertificate.pairStep x z)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.hessian_minus_annihilated_posSemidef","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  Matrix.PosSemidef (R.hessian k - (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)))","axioms":["propext","Quot.sound","Classical.choice"]}
