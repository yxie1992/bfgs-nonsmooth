BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.restrict._proof_7","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ K' ⊆ K,\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K' fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n              BfgsVerification.metricEnergy (C.W z) (h - g) ≤\n                C.C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Classical.choice","Quot.sound"]}
