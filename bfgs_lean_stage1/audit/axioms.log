BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 ≤ L →\n                0 < m →\n                  0 ≤ C₀ →\n                    0 ≤ C_T →\n                      0 ≤ C_R →\n                        (∀ (k : ℕ),\n                            BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n                          ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                            (b : ℕ → BfgsVerification.Vec p),\n                            (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                              (∀ (k : ℕ),\n                                  BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) ≤\n                                    C₀ * R.curvature k) →\n                                (∀ (k : ℕ),\n                                    V (k + 1) =\n                                      V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k) +\n                                        Z k) →\n                                  (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * R.d k)) →\n                                    (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                                      (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * R.d k) → False","axioms":["propext","Classical.choice","Quot.sound"]}
