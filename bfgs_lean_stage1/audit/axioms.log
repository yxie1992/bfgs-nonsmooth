BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.local_parallel_interfaces_convergence_basin","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n        (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →\n          ∀ {Ω : Set (BfgsVerification.Vec n)},\n            IsOpen Ω →\n              star ∈ Ω →\n                ∀ {μ : ℝ},\n                  0 < μ →\n                    BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n                      ∀ {a : BfgsVerification.Vec n},\n                        BfgsVerification.sqNorm a = 1 →\n                          ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n                            (∀ x ∈ Ω,\n                                ∀ (g : BfgsVerification.Vec n),\n                                  BfgsVerification.Homogeneous.Supports F x g →\n                                    BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n                              ∀ {L : NNReal},\n                                LipschitzOnWith L A Ω →\n                                  ∀ {E : Set ℝ},\n                                    IsClosed E →\n                                      BfgsVerification.CenteredSmoothSublinear.LocallyC11On\n                                          (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →\n                                        (∀ p ∈ Ω,\n                                            BfgsVerification.FixedNormal.normalCoordinate a b p ∈ E →\n                                              ¬DifferentiableAt ℝ F p) →\n                                          (∀ p ∈ Ω,\n                                              0 ∈\n                                                  affineSpan ℝ\n                                                    (BfgsVerification.ConvexSubdifferential.subdifferential F p) →\n                                                BfgsVerification.Homogeneous.Supports F p 0) →\n                                            ∃ ε,\n                                              0 < ε ∧\n                                                ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                                                  F (R.x 0) < F star + ε →\n                                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                                      Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.ConvexCornerChart.mk.sizeOf_spec","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {x : BfgsVerification.Vec 2}\n  (toCornerChart : BfgsVerification.PlanarCornerCharts.CornerChart F x) (region : Set (BfgsVerification.Vec 2))\n  (region_open : IsOpen region) (point_mem : x ∈ region)\n  (branch_convex : ∀ (i : Fin 2), ConvexOn ℝ region (toCornerChart.branches i))\n  (branch_C2 : ∀ (i : Fin 2), ContDiffOn ℝ 2 (toCornerChart.branches i) region)\n  (representation : ∀ z ∈ region, IsGreatest (Set.range fun i => toCornerChart.branches i z) (F z))\n  (independent :\n    BfgsVerification.HomogeneousPlanar.pairDet (BfgsVerification.coordinateGradient (toCornerChart.branches 0) x)\n        (BfgsVerification.coordinateGradient (toCornerChart.branches 1) x) ≠\n      0)\n  (inverse :\n    ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,\n      (∀ (i : Fin 2), toCornerChart.branches i z = toCornerChart.branches 0 z) →\n        z = toCornerChart.curve (toCornerChart.branches 0 z)),\n  sizeOf\n      { toCornerChart := toCornerChart, region := region, region_open := region_open, point_mem := point_mem,\n        branch_convex := branch_convex, branch_C2 := branch_C2, representation := representation,\n        independent := independent, inverse := inverse } =\n    1 + sizeOf toCornerChart + sizeOf region_open + sizeOf point_mem + sizeOf inverse","axioms":["propext","Classical.choice","Quot.sound"]}
