BFGS_AUDIT {"theorem":"BfgsVerification.annihilatedMatrix_mul_step","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (α : ℝ),\n          Matrix.mulVec (H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g)\n              (BfgsVerification.bfgsStep H g α) =\n            0","axioms":["propext","Quot.sound","Classical.choice"]}
