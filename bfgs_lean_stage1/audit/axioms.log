    ∀ {η c₁ c₂ : ℝ},
      0 < η →
        0 ≤ c₁ →
          c₂ < 1 →
            ∃ B,
              ∀ (x : BfgsVerification.Vec 2),
                B.W x = BfgsVerification.outer (P.calibratedVector x) (P.calibratedVector x)
def BfgsVerification.ParabolicConvergenceTarget : Prop :=
∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) (R : BfgsVerification.AdmissibleBFGSRun 2 P.objective),
  Filter.Tendsto (fun k => P.objective (R.x k)) Filter.atTop (nhds 0) ∧ Filter.Tendsto R.x Filter.atTop (nhds 0)
def BfgsVerification.TransformedGaugeConvergenceTarget : Prop :=
