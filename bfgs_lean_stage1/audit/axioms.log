BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_relativeInterior_has_limit","signature":"∀ {n : ℕ} (A B : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),\n  B.Nonempty →\n    ∀ (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),\n      ↑B = BfgsVerification.Homogeneous.recurrentValues R.g →\n        BfgsVerification.Homogeneous.RelativeInteriorZero B →\n          ∃ xstar,\n            Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧ BfgsVerification.Homogeneous.finiteMaxLinear A hA xstar = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.local_strongly_convex_composite_basin","signature":"∀ {n : ℕ} {F ψ : BfgsVerification.Vec n → ℝ} {h : ℝ → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n        (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →\n          ∀ {Ω : Set (BfgsVerification.Vec n)},\n            IsOpen Ω →\n              star ∈ Ω →\n                ConvexOn ℝ Ω ψ →\n                  BfgsVerification.CenteredSmoothSublinear.LocallyC11On Ω ψ →\n                    ConvexOn ℝ Set.univ h →\n                      BfgsVerification.FixedNormal.ScalarLocallyC11On {0}ᶜ h →\n                        ∀ {a : BfgsVerification.Vec n},\n                          BfgsVerification.sqNorm a = 1 →\n                            ∀ (b : ℝ) {μ : ℝ},\n                              0 < μ →\n                                BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n                                  (∀ x ∈ Ω, F x = ψ x + h (BfgsVerification.FixedNormal.normalCoordinate a b x)) →\n                                    BfgsVerification.dot a star = b →\n                                      ∃ ε,\n                                        0 < ε ∧\n                                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                                            F (R.x 0) < F star + ε →\n                                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                                Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AccessibleJumpGeometry.accessible_curvature_annihilated_of_continuousAt","signature":"∀ {n : ℕ} {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {F : BfgsVerification.Vec n → ℝ}\n  {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ},\n  c₂ < 1 →\n    ∀ (B : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η)\n      (x z g h : ι → BfgsVerification.Vec n) (p jump : BfgsVerification.Vec n),\n      (∀ᶠ (a : ι) in l,\n          x a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧\n            z a ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η ∧\n              BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x a) (z a) (g a) (h a)) →\n        Filter.Tendsto (fun a => BfgsVerification.TransportedCertificate.pairCurvature (x a) (z a) (g a) (h a)) l\n            (nhds 0) →\n          Filter.Tendsto (fun a => h a - g a) l (nhds jump) →\n            Filter.Tendsto z l (nhds p) → ContinuousAt B.W p → Matrix.mulVec (B.W p) jump = 0","axioms":["Quot.sound","propext","Classical.choice"]}
