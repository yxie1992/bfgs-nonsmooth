BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_le_sqNorm_mul_trace","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n),\n  Matrix.PosSemidef H → BfgsVerification.metricEnergy H g ≤ BfgsVerification.sqNorm g * Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_global_gradient_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F → ∃ G, 0 < G ∧ ∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.fullBFGS_normalizedHierarchy","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          BfgsVerification.ScalarHierarchy.NormalizedHierarchy n (fun k => BfgsVerification.principalSum (R.H k)) R.q\n            (fun k => R.d k / c) (4 * G ^ 2 / c ^ 2) (G ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_finite_branch_positive","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ), Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds L) → ∀ (k : ℕ), 0 < F (R.x k)","axioms":["propext","Quot.sound","Classical.choice"]}
