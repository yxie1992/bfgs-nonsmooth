BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.TrialCertificate.actual_accept","signature":"∀ {c d r : ℝ} {j i : Fin 3} {a c₁ c₂ : ℝ},\n  BfgsVerification.SeedOrbit.StrictActive c d (BfgsVerification.SeedOrbit.point c d r j) j →\n    BfgsVerification.SeedOrbit.TrialCertificate c d r j a i true →\n      0 < c₁ →\n        c₁ ≤ 1 / 3 →\n          0 < c₂ →\n            BfgsVerification.SeedOrbit.objective c d (BfgsVerification.SeedOrbit.trial c d r j a) <\n                BfgsVerification.SeedOrbit.objective c d (BfgsVerification.SeedOrbit.point c d r j) +\n                  c₁ *\n                    BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j)\n                      (a • BfgsVerification.SeedOrbit.direction c d r j) ∧\n              c₂ *\n                  BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j)\n                    (a • BfgsVerification.SeedOrbit.direction c d r j) <\n                BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d i)\n                  (a • BfgsVerification.SeedOrbit.direction c d r j)","axioms":["propext","Quot.sound","Classical.choice"]}
