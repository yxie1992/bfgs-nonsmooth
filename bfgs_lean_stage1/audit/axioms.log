BFGS_AUDIT {"theorem":"BfgsVerification.HomogeneousPlanar.endpoints_tendsto_zero","signature":"∀ (A : Finset (BfgsVerification.Vec 2)) (a b x : ℕ → BfgsVerification.Vec 2),\n  (∀ (k : ℕ), a k ∈ A) →\n    (∀ (k : ℕ), b k ∈ A) →\n      (∀ (k : ℕ), BfgsVerification.HomogeneousPlanar.pairDet (a k) (b k) ≠ 0) →\n        Filter.Tendsto (fun k => BfgsVerification.dot (a k) (x k)) Filter.atTop (nhds 0) →\n          Filter.Tendsto (fun k => BfgsVerification.dot (b k) (x k)) Filter.atTop (nhds 0) →\n            Filter.Tendsto x Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
