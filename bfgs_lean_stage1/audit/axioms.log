BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.PrunedOrder.mk.injEq","signature":"∀ {m : ℕ} {P : BfgsVerification.Parabolic.Family m} (count : ℕ) (count_pos : 0 < count) (index : Fin count → Fin m)\n  (essential : ∀ (i : Fin count), P.Essential (index i)) (covers : ∀ (i : Fin m), P.Essential i → ∃ k, index k = i)\n  (slopes_strictMono : StrictMono fun i => P.b (index i)) (count_1 : ℕ) (count_pos_1 : 0 < count_1)\n  (index_1 : Fin count_1 → Fin m) (essential_1 : ∀ (i : Fin count_1), P.Essential (index_1 i))\n  (covers_1 : ∀ (i : Fin m), P.Essential i → ∃ k, index_1 k = i)\n  (slopes_strictMono_1 : StrictMono fun i => P.b (index_1 i)),\n  ({ count := count, count_pos := count_pos, index := index, essential := essential, covers := covers,\n        slopes_strictMono := slopes_strictMono } =\n      { count := count_1, count_pos := count_pos_1, index := index_1, essential := essential_1, covers := covers_1,\n        slopes_strictMono := slopes_strictMono_1 }) =\n    (count = count_1 ∧ HEq index index_1)","axioms":["propext","Quot.sound","Classical.choice"]}
