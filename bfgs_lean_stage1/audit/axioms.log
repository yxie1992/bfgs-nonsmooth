BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.exists_corner_chart","signature":"∀ {f : Fin 2 → BfgsVerification.Vec 2 → ℝ} {x a b : BfgsVerification.Vec 2} {ℓ : ℝ},\n  (∀ (i : Fin 2), ContDiffAt ℝ 2 (f i) x) →\n    HasFDerivAt (f 0) (BfgsVerification.gradientFunctional a) x →\n      HasFDerivAt (f 1) (BfgsVerification.gradientFunctional b) x →\n        BfgsVerification.HomogeneousPlanar.pairDet a b ≠ 0 →\n          f 0 x = ℓ →\n            f 1 x = ℓ →\n              ∃ p,\n                p ℓ = x ∧\n                  ContDiffAt ℝ 2 p ℓ ∧\n                    (∀ᶠ (t : ℝ) in nhds ℓ, ∀ (i : Fin 2), f i (p t) = t) ∧\n                      ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x, (∀ (i : Fin 2), f i z = f 0 z) → z = p (f 0 z)","axioms":["propext","Classical.choice","Quot.sound"]}
