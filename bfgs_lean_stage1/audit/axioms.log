BFGS_AUDIT {"theorem":"BfgsVerification.PlanarAmbientFrame.frame_eq_velocity","signature":"∀ {m : ℕ} {χ : Fin m → BfgsVerification.Vec 2 → ℝ} (v : Fin m → BfgsVerification.Vec 2),\n  (Pairwise fun i j => Disjoint (Function.support (χ i)) (Function.support (χ j))) →\n    ∀ {i : Fin m} {w : BfgsVerification.Vec 2},\n      BfgsVerification.sqNorm w = 1 →\n        (∀ᶠ (z : BfgsVerification.Vec 2) in nhds w, χ i z = 1) → BfgsVerification.PlanarAmbientFrame.frame χ v w = v i","axioms":["propext","Classical.choice","Quot.sound"]}
