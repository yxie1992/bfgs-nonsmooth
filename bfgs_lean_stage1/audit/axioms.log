BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.root_sign_counts_eq_of_queries_eq","signature":"∀ {m : ℕ} (p p' : Polynomial ℝ) (q q' : Fin m → Polynomial ℝ),\n  (∀ (e : Fin m → Fin 3),\n      BfgsVerification.RealAlgebraicGeometry.tarskiQuery p\n          (BfgsVerification.RealAlgebraicGeometry.signQueryPolynomial q e) =\n        BfgsVerification.RealAlgebraicGeometry.tarskiQuery p'\n          (BfgsVerification.RealAlgebraicGeometry.signQueryPolynomial q' e)) →\n    ∀ (σ : Fin m → SignType),\n      BfgsVerification.RealAlgebraicGeometry.rootSignCount p q σ =\n        BfgsVerification.RealAlgebraicGeometry.rootSignCount p' q' σ","axioms":["propext","Classical.choice","Quot.sound"]}
