BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCrossing.exists_actual_active_gradient","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {f : Fin m → BfgsVerification.Vec n → ℝ} {x g : BfgsVerification.Vec n},\n      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n        (∀ (i : Fin m), DifferentiableAt ℝ (f i) x) →\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n            ∃ i, f i x = F x ∧ BfgsVerification.coordinateGradient (f i) x = g","axioms":["propext","Classical.choice","Quot.sound"]}
