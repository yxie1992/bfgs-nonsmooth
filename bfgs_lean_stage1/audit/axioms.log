def BfgsVerification.TransportedCertificate.stepProjector : {n : ℕ} → BfgsVerification.Vec n → BfgsVerification.Mat n :=
fun {n} s => 1 - (BfgsVerification.sqNorm s)⁻¹ • BfgsVerification.outer s s
