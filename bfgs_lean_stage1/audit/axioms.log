BFGS_AUDIT {"theorem":"BfgsVerification.LScalar.phi_interval","signature":"∀ {b x : ℝ},\n  17 / 10 ≤ b →\n    b ≤ 34 →\n      ∀ (n : ℕ),\n        b * BfgsVerification.LScalarGeometric.theta * BfgsVerification.LScalarGeometric.scale n ≤ x →\n          x ≤ b * BfgsVerification.LScalarGeometric.scale n →\n            BfgsVerification.LScalar.phi b x =\n              (BfgsVerification.LScalarGeometric.theta * BfgsVerification.LScalarGeometric.scale n) ^ 2 +\n                b * BfgsVerification.LScalarGeometric.scale n ^ 2 * (1 - BfgsVerification.LScalarGeometric.theta) *\n                  (BfgsVerification.LScalarGeometric.theta *\n                      BfgsVerification.LScalarGeometric.coordinate b (BfgsVerification.LScalarGeometric.scale n) x +\n                    (1 - BfgsVerification.LScalarGeometric.theta) *\n                      BfgsVerification.LScalarRamp.primitive b\n                        (BfgsVerification.LScalarGeometric.coordinate b (BfgsVerification.LScalarGeometric.scale n) x))","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.parallel_interfaces_convergence_of_affine_correctness","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {Ω : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    IsCompact R.initialSublevel →\n      R.initialSublevel ⊆ Ω →\n        ∀ {μ : ℝ},\n          0 < μ →\n            BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n              ∀ {a : BfgsVerification.Vec n},\n                BfgsVerification.sqNorm a = 1 →\n                  ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n                    (∀ x ∈ Ω,\n                        ∀ (g : BfgsVerification.Vec n),\n                          BfgsVerification.Homogeneous.Supports F x g →\n                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n                      ∀ {L : NNReal},\n                        LipschitzOnWith L A Ω →\n                          ∀ {E : Set ℝ},\n                            IsClosed E →\n                              BfgsVerification.CenteredSmoothSublinear.LocallyC11On\n                                  (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →\n                                (∀ p ∈ Ω,\n                                    BfgsVerification.FixedNormal.normalCoordinate a b p ∈ E → ¬DifferentiableAt ℝ F p) →\n                                  (∀ p ∈ R.initialSublevel,\n                                      0 ∈ affineSpan ℝ (BfgsVerification.ConvexSubdifferential.subdifferential F p) →\n                                        BfgsVerification.Homogeneous.Supports F p 0) →\n                                    ∀ (star : BfgsVerification.Vec n),\n                                      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n                                        Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                          Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F))\n                                              Filter.atTop (nhds 0) ∧\n                                            ((∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →\n                                              Filter.Tendsto R.x Filter.atTop (nhds star))","axioms":["propext","Classical.choice","Quot.sound"]}
