BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.norm_residual_on_ray","signature":"∀ {n m : ℕ} (A : BfgsVerification.Vec n →L[ℝ] EuclideanSpace ℝ (Fin m)) (b : EuclideanSpace ℝ (Fin m))\n  (x p : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.EuclideanResidual.residual A b (x + t • p) =\n    BfgsVerification.EuclideanResidual.residual A b x + t • A p","axioms":["propext","Quot.sound","Classical.choice"]}
