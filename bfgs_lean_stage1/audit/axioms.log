BFGS_AUDIT {"theorem":"BfgsVerification.PointwiseFeasibility.rankOne_of_uniformDirections","signature":"∀ {n : ℕ} {α : Type u_1} {β : α → Type u_2} {h : α → BfgsVerification.Vec n}\n  {y : (z : α) → β z → BfgsVerification.Vec n} {t : (z : α) → β z → ℝ},\n  (∀ (z : α) (j : β z), 0 ≤ t z j) →\n    BfgsVerification.PointwiseFeasibility.UniformDirections h y t →\n      ∃ v m,\n        0 < m ∧\n          (∀ (z : α), Matrix.PosSemidef (BfgsVerification.outer (v z) (v z))) ∧\n            (∀ (z : α), m ≤ BfgsVerification.metricEnergy (BfgsVerification.outer (v z) (v z)) (h z)) ∧\n              ∀ (z : α) (j : β z), BfgsVerification.metricEnergy (BfgsVerification.outer (v z) (v z)) (y z j) ≤ t z j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.transformedGauge_actual_gauge_derivative","signature":"∀ {n : ℕ} {Φ : ℝ → ℝ} {γ : BfgsVerification.Vec n → ℝ},\n  BfgsVerification.TransformedGauge.IncreasingTransform Φ →\n    BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n      Filter.Tendsto γ (Filter.cocompact (BfgsVerification.Vec n)) Filter.atTop →\n        ∀ (star : BfgsVerification.Vec n)\n          (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.TransformedGauge.objective Φ γ star)) (k : ℕ),\n          HasFDerivAt γ ((deriv Φ (γ (R.x k - star)))⁻¹ • BfgsVerification.gradientFunctional (R.g k)) (R.x k - star)","axioms":["propext","Quot.sound","Classical.choice"]}
