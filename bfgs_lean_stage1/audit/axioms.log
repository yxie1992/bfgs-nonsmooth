BFGS_AUDIT {"theorem":"BfgsVerification.SharpPotentialDegree.run_optimized_bound","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < c →\n    Summable R.d →\n      ∀ (J m : ℕ),\n        2 ≤ m →\n          let D := ∑' (i : ℕ), R.d (J + i);\n          let K := 4 * G ^ 2 / c ^ 2;\n          BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / (c * (↑m - 1))))\n              (BfgsVerification.principalSum (R.H J)) ≤\n            BfgsVerification.ScalarHierarchy.weightedPotential n (K / (D / c)) (BfgsVerification.principalSum (R.H J)) *\n              (↑m - 1) ^ (n - 1)","axioms":["propext","Classical.choice","Quot.sound"]}
