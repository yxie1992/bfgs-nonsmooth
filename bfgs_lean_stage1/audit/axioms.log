BFGS_AUDIT {"theorem":"BfgsVerification.supporting_vectors_tendsto_at_differentiable","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x a : ℕ → BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds star) →\n        (∀ (k : ℕ) (z : BfgsVerification.Vec n), BfgsVerification.dot (a k) (z - x k) ≤ F z - F (x k)) →\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) star → Filter.Tendsto a Filter.atTop (nhds g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MaxAffine.Family.threshold_tail_convergence","signature":"∀ {n m : ℕ} (P : BfgsVerification.MaxAffine.Family n m) {ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ ψ →\n    BfgsVerification.CenteredSmoothSublinear.LocallyC11On Set.univ ψ →\n      ∀ (star : BfgsVerification.Vec n),\n        (∀ (x : BfgsVerification.Vec n), ψ star + P.objective star ≤ ψ x + P.objective x) →\n          (∀ (x : BfgsVerification.Vec n), ψ x + P.objective x = ψ star + P.objective star → x = star) →\n            ∀ (R : BfgsVerification.AdmissibleBFGSRun n fun x => ψ x + P.objective x) (J : ℕ),\n              ↑(ψ (R.x J) + P.objective (R.x J)) < P.threshold (fun x => ψ x + P.objective x) star →\n                Filter.Tendsto (fun k => ψ (R.x k) + P.objective (R.x k)) Filter.atTop\n                    (nhds (ψ star + P.objective star)) ∧\n                  Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.local_central_bound_of_nested","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  Continuous F →\n    ∀ {star w : BfgsVerification.Vec n} {b : ℝ},\n      F star < F w →\n        F w < b →\n          BfgsVerification.RadialCertificate.HasNestedCentralBounds F star b →\n            ∃ C ε,\n              0 < ε ∧\n                ∀ (t : ℝ), 0 ≤ t → t ≤ ε → BfgsVerification.RadialCertificate.centralDifference F star w t ≤ C * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
