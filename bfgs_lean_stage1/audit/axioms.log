BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.cutoffFrame_pairing_eq_visibility","signature":"∀ {n r : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {A : BfgsVerification.Vec n → BfgsVerification.Vec n} {a : BfgsVerification.Vec n} {b : ℝ} {τ : ℝ → ℝ}\n      (U : Matrix (Fin n) (Fin r) ℝ),\n      U.transpose * U = 1 →\n        (∀ (v : Fin n → ℝ), (U * U.transpose).mulVec v = BfgsVerification.FixedNormal.tangentProjection a v) →\n          ∀ {x g : BfgsVerification.Vec n},\n            HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n              (∀ (h : BfgsVerification.Vec n),\n                  BfgsVerification.Homogeneous.Supports F x h →\n                    BfgsVerification.FixedNormal.tangentProjection a h = A x) →\n                BfgsVerification.sqNorm\n                    ((BfgsVerification.FixedNormal.cutoffFrame U a\n                            (τ (BfgsVerification.FixedNormal.normalCoordinate a b x))).transpose.mulVec\n                      g) =\n                  BfgsVerification.FixedNormal.visibilityFunction F A a b τ x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarNegative.quadratic_hasDerivAt","signature":"∀ (x : ℝ),\n  HasDerivAt BfgsVerification.DScalarNegative.quadratic (BfgsVerification.DScalarNegative.quadraticDerivative x) x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.exists_visibility_neighborhood","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {A : BfgsVerification.Vec n → BfgsVerification.Vec n}\n  {a : BfgsVerification.Vec n} {b : ℝ} {τ : ℝ → ℝ} {Ω Γ : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    IsCompact Γ →\n      Γ.Nonempty →\n        Γ ⊆ Ω →\n          ContinuousOn (BfgsVerification.FixedNormal.visibilityFunction F A a b τ) Ω →\n            (∀ x ∈ Γ, 0 < BfgsVerification.FixedNormal.visibilityFunction F A a b τ x) →\n              ∃ m,\n                0 < m ∧\n                  ∃ N,\n                    IsOpen N ∧ Γ ⊆ N ∧ N ⊆ Ω ∧ ∀ x ∈ N, m ≤ BfgsVerification.FixedNormal.visibilityFunction F A a b τ x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.common_component_of_zero_not_mem_affineSpan","signature":"∀ {n : ℕ} {S : Set (BfgsVerification.Vec n)},\n  S.Nonempty → 0 ∉ affineSpan ℝ S → ∃ v, ∀ g ∈ S, BfgsVerification.dot v g = 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.local_tangential_composite_basin","signature":"∀ {n : ℕ} {F ψ : BfgsVerification.Vec n → ℝ} {h : ℝ → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n        (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →\n          ∀ {Ω : Set (BfgsVerification.Vec n)},\n            IsOpen Ω →\n              star ∈ Ω →\n                ConvexOn ℝ Ω ψ →\n                  BfgsVerification.CenteredSmoothSublinear.LocallyC11On Ω ψ →\n                    ConvexOn ℝ Set.univ h →\n                      BfgsVerification.FixedNormal.ScalarLocallyC11On {0}ᶜ h →\n                        ∀ {a : BfgsVerification.Vec n},\n                          BfgsVerification.sqNorm a = 1 →\n                            ∀ (b : ℝ) {μ : ℝ},\n                              0 < μ →\n                                (ConvexOn ℝ Ω fun x =>\n                                    ψ x -\n                                      μ / 2 *\n                                        BfgsVerification.sqNorm (BfgsVerification.FixedNormal.tangentProjection a x)) →\n                                  (∀ x ∈ Ω, F x = ψ x + h (BfgsVerification.FixedNormal.normalCoordinate a b x)) →\n                                    BfgsVerification.dot a star = b →\n                                      ∀ {c : ℝ},\n                                        F star < c →\n                                          (∀ (ℓ : ℝ), F star < ℓ → ℓ ≤ c → StrictConvex ℝ {x | F x ≤ ℓ}) →\n                                            ∃ ε,\n                                              0 < ε ∧\n                                                ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                                                  F (R.x 0) < F star + ε →\n                                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                                      Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_error_le_of_pair_radial","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star x g h : BfgsVerification.Vec n) (t C : ℝ),\n      0 ≤ t →\n        t ≤ 1 / 2 →\n          0 ≤ C →\n            HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n              HasFDerivAt F (BfgsVerification.gradientFunctional h)\n                  (BfgsVerification.RadialCertificate.inwardPoint star x t) →\n                (0 <\n                      BfgsVerification.RadialCertificate.secantCurvature x\n                        (BfgsVerification.RadialCertificate.inwardPoint star x t) g h →\n                    BfgsVerification.RadialCertificate.radialNumerator star\n                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h ^\n                        2 ≤\n                      C *\n                        BfgsVerification.RadialCertificate.secantCurvature x\n                          (BfgsVerification.RadialCertificate.inwardPoint star x t) g h) →\n                  BfgsVerification.RadialCertificate.supportingError F x g\n                      (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤\n                    4 * C * t ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.local_absolute_basin","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (a : ι → BfgsVerification.Vec n) (b : ι → ℝ) {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n          ∀ {star : BfgsVerification.Vec n},\n            star ∈ U →\n              (∀ x ∈ U, F x = ψ x + ∑ i, |BfgsVerification.dot (a i) x - b i|) →\n                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                  (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                    ∃ δ,\n                      0 < δ ∧\n                        ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                          F (R.x 0) ≤ F star + δ →\n                            (∀ (k : ℕ), R.x k ∈ U) ∧\n                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_step","signature":"∀ (n : ℕ) (e eNext : ℕ → ℝ) (q K η δ : ℝ),\n  0 ≤ K →\n    0 < η →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        e (n + 1) = 0 →\n          (∀ (j : ℕ), 1 ≤ j → j ≤ n → q * eNext j ≤ K * e (j + 1) + δ * e j) →\n            q * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) eNext ≤\n              (η + δ) * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) e","axioms":["propext","Quot.sound","Classical.choice"]}
