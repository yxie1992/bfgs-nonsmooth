BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.radial_certificate_values","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (K : Set (BfgsVerification.Vec n)),\n  IsCompact K →\n    (∀ (k : ℕ), R.x k ∈ K) →\n      ∀ (star : BfgsVerification.Vec n),\n        (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n          BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star →\n            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.value_zero","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}, BfgsVerification.Homogeneous.PositiveDegreeOne F → F 0 = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.product","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ), self.J ≤ k → self.P (k + 1) = self.P k * self.T k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.segment_value_lower","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ) (a b : ℝ),\n  a + b = 1 → F (R.x k) - b * R.d k ≤ F (a • R.x k + b • R.x (k + 1))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_tail_criterion","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (J : ℕ)\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k) →\n      (∀ (k : ℕ),\n          J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (m K L C : ℝ),\n          0 < m →\n            0 < K →\n              0 ≤ L →\n                (∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                  (∀ (k : ℕ),\n                      J ≤ k →\n                        BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤\n                          C) →\n                    (∀ (k : ℕ),\n                        J ≤ k →\n                          ∀ (v : Fin r → ℝ),\n                            BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤\n                              K * BfgsVerification.sqNorm v) →\n                      (∀ (k : ℕ),\n                          J ≤ k →\n                            ∀ (v : Fin r → ℝ),\n                              BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →\n                        ∀ (G : ℝ),\n                          0 < G →\n                            (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n                              Filter.Tendsto R.d Filter.atTop (nhds 0) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.cluster_pair_segment_constant._proof_1","signature":"∀ {R : Type v} [inst : Mul R] [inst_1 : Add R] [inst_2 : RightDistribClass R] (a b c : R), a * c + b * c = (a + b) * c","axioms":[]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.certificateOfScalarQuotient._proof_4","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {K : Set (BfgsVerification.Vec 1)} {fstar η : ℝ},\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    DifferentiableAt ℝ F x →\n      Matrix.PosSemidef\n        ((BfgsVerification.TransportedCertificate.scalarGradient F x ^ 2)⁻¹ •\n          BfgsVerification.outer (fun x => 1) fun x => 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.residual_energy_le","signature":"∀ {n r p : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B →\n    ∀ (g : BfgsVerification.Vec n) (q : ℝ),\n      0 ≤ q →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (W : Matrix (Fin n) (Fin p) ℝ),\n              U * U.transpose * W = W →\n                (BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g) W).trace ≤\n                  BfgsVerification.SmoothSubspace.frobSq W * (BfgsVerification.metricGram B U).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.gram_trace_nonneg","signature":"∀ {n r : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B → ∀ (V : Matrix (Fin n) (Fin r) ℝ), 0 ≤ (BfgsVerification.metricGram B V).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm_difference_le_four","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n) (A : ℝ),\n  BfgsVerification.sqNorm x ≤ A ^ 2 → BfgsVerification.sqNorm y ≤ A ^ 2 → BfgsVerification.sqNorm (x - y) ≤ (2 * A) ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.global_minimum_of_zero_gradient","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x : BfgsVerification.Vec n},\n      HasFDerivAt F (BfgsVerification.gradientFunctional 0) x → x ∈ BfgsVerification.argmin F","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (W : Matrix (Fin n) (Fin r) ℝ),\n  (BfgsVerification.metricGram B W).trace = ∑ j, BfgsVerification.metricEnergy B fun i => W i j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.energy_sub_matrix","signature":"∀ {n : ℕ} (B C : BfgsVerification.Mat n) (x : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy (B - C) x = BfgsVerification.metricEnergy B x - BfgsVerification.metricEnergy C x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_potentials_force_log_growth._proof_1","signature":"∀ (J : ℕ), ℕ → ∀ (N : ℕ), J + 1 ≤ N → ¬0 < N → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclideanOpNorm._proof_4","signature":"∀ {r : ℕ}, CompleteSpace (EuclideanSpace ℝ (Fin r))","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    ∀ (g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_two","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        let a := Z.transpose.mulVec (Matrix.mulVec H g);\n        let b := Z.transpose.mulVec (Matrix.mulVec H y);\n        let A := BfgsVerification.metricGram H Z;\n        (BfgsVerification.metricGram H (Matrix.fromCols (fun i k => ![g i, y i] k) Z)).det =\n          A.det *\n            ((BfgsVerification.metricEnergy H g - BfgsVerification.dot a (A⁻¹.mulVec a)) *\n                (BfgsVerification.metricEnergy H y - BfgsVerification.dot b (A⁻¹.mulVec b)) -\n              (BfgsVerification.dot g (Matrix.mulVec H y) - BfgsVerification.dot a (A⁻¹.mulVec b)) ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.common_component_incompatible","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (v : BfgsVerification.Vec n) (J : ℕ),\n  (∀ (k : ℕ), J ≤ k → BfgsVerification.dot v (R.g k) = 1) →\n    Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.supporting_euler","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ {x g : BfgsVerification.Vec n}, BfgsVerification.Homogeneous.Supports F x g → BfgsVerification.dot g x = F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.dot_sub_right","signature":"∀ {n : ℕ} (x y z : BfgsVerification.Vec n),\n  BfgsVerification.dot x (y - z) = BfgsVerification.dot x y - BfgsVerification.dot x z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.rank_one_increment_upper_bound","signature":"∀ (α β q Δ u : ℝ), 0 ≤ α → 0 < β → 0 < q → 0 ≤ Δ → u ≤ q → α / (β * q) * Δ * u ≤ α / β * Δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricEnergy H y -\n              BfgsVerification.dot (Z.transpose.mulVec (Matrix.mulVec H y))\n                ((BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H y))))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.accepted_pair_decrease","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  BfgsVerification.TransportedCertificate.pairDecrease (R.x k) (R.x (k + 1)) (R.g k) = R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_criterion","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), P (k + 1) = P k * T k) →\n      (∀ (k : ℕ), V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (m K L C : ℝ),\n          0 < m →\n            0 < K →\n              0 ≤ L →\n                (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                  (∀ (k : ℕ),\n                      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C) →\n                    (∀ (k : ℕ) (v : Fin r → ℝ),\n                        BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v) →\n                      (∀ (k : ℕ) (v : Fin r → ℝ),\n                          BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →\n                        ∀ (G : ℝ),\n                          0 < G →\n                            (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n                              Filter.Tendsto R.d Filter.atTop (nhds 0) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_trace_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ) (L : ℝ),\n  (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n    ∀ (k : ℕ),\n      (BfgsVerification.metricGram (R.hessian (k + 1)) U).trace ≤\n        (BfgsVerification.metricGram (R.hessian k) U).trace + L","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r p : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ) (orthonormal : U.transpose * U = 1) (L m C₀ C_T C_R : ℝ) (m_pos : 0 < m)\n  (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p) (b : ℕ → BfgsVerification.Vec p)\n  (smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k)\n  (visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k)))\n  (correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k)\n  (transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k)\n  (operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k))\n  (residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k)\n  (residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k),\n  sizeOf\n      { J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n    1 + sizeOf J + sizeOf r + sizeOf p + sizeOf orthonormal + sizeOf L + sizeOf m + sizeOf C₀ + sizeOf C_T +\n        sizeOf C_R +\n      sizeOf m_pos","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.convex_decrease","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    F x - F z ≤ BfgsVerification.TransportedCertificate.pairDecrease x z g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.VisibilitySecantCertificate.delta_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.VisibilitySecantCertificate F K fstar c₁ c₂ η), 0 < self.δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.projected_compression","signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (v y : BfgsVerification.Vec n) (κ : ℝ),\n  Matrix.IsSymm H →\n    Z.transpose * ((1 - κ⁻¹ • BfgsVerification.outer v y) * H * (1 - κ⁻¹ • BfgsVerification.outer v y).transpose) * Z =\n      BfgsVerification.CompressionDeterminant.compression (Z.transpose * H * Z) (Z.transpose.mulVec v)\n        (Z.transpose.mulVec (Matrix.mulVec H y)) κ (BfgsVerification.dot y (Matrix.mulVec H y))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm.eq_1","signature":"∀ {n : ℕ} (x : BfgsVerification.Vec n), BfgsVerification.sqNorm x = ∑ i, x i ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.stepProjector_isSymm","signature":"∀ {n : ℕ} (s : BfgsVerification.Vec n), Matrix.IsSymm (BfgsVerification.TransportedCertificate.stepProjector s)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.supporting_vectors_tendsto_at_differentiable","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x a : ℕ → BfgsVerification.Vec n} {star g : BfgsVerification.Vec n},\n      Filter.Tendsto x Filter.atTop (nhds star) →\n        (∀ (k : ℕ) (z : BfgsVerification.Vec n), BfgsVerification.dot (a k) (z - x k) ≤ F z - F (x k)) →\n          HasFDerivAt F (BfgsVerification.gradientFunctional g) star → Filter.Tendsto a Filter.atTop (nhds g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.hierarchy_reciprocal_growth","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    BfgsVerification.ScalarHierarchy.UpperNull δ →\n      Filter.Tendsto (BfgsVerification.reciprocalGeometricMean q) Filter.atTop Filter.atTop ∧\n        Filter.Tendsto (BfgsVerification.reciprocalMean q) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 ≤ L →\n                0 < m →\n                  0 ≤ C₀ →\n                    0 ≤ C_T →\n                      0 ≤ C_R →\n                        (∀ (k : ℕ),\n                            BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n                          ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                            (b : ℕ → BfgsVerification.Vec p),\n                            (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                              (∀ (k : ℕ),\n                                  BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) ≤\n                                    C₀ * R.curvature k) →\n                                (∀ (k : ℕ),\n                                    V (k + 1) =\n                                      V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k) +\n                                        Z k) →\n                                  (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * R.d k)) →\n                                    (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                                      (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * R.d k) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.gradient_x","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    HasFDerivAt F (BfgsVerification.gradientFunctional g) x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_gradient_cardinality","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (Q : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)) (L : ℝ),\n  Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (Q.x k)) Filter.atTop (nhds L) →\n    Module.finrank ℝ ↥(Submodule.span ℝ (BfgsVerification.Homogeneous.recurrentValues Q.g)) + 1 ≤\n      (BfgsVerification.Homogeneous.recurrentValues Q.g).ncard","axioms":["propext","Quot.sound","Classical.choice"]}
