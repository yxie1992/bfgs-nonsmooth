BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.actual_run_failure","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1),\n  let R := BfgsVerification.SeedOrbit.run c₁ c₂ hc₁ hc₁' hc hc₂;\n  R.H 0 = 1 ∧\n    Filter.Tendsto R.x Filter.atTop (nhds 0) ∧\n      Filter.Tendsto\n          (fun k =>\n            BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n              (R.x k))\n          Filter.atTop (nhds 0) ∧\n        (∀ (k : ℕ),\n            0 <\n              BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                (R.x k)) ∧\n          (∀ (k : ℕ),\n              BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (R.x (k + 1)) <\n                BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n                  (R.x k)) ∧\n            0 ∉\n              BfgsVerification.ConvexSubdifferential.subdifferential\n                (BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD)\n                0","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AccessibleJumpGeometry.visibility_limit","signature":"∀ {n : ℕ} {ι : Type u_1} {l : Filter ι} [inst : l.NeBot] {W : ι → BfgsVerification.Mat n} {W₀ : BfgsVerification.Mat n}\n  {g : ι → BfgsVerification.Vec n} {g₀ : BfgsVerification.Vec n} (m : ℝ),\n  Filter.Tendsto W l (nhds W₀) →\n    Filter.Tendsto g l (nhds g₀) →\n      (∀ᶠ (a : ι) in l, m ≤ BfgsVerification.metricEnergy (W a) (g a)) → m ≤ BfgsVerification.metricEnergy W₀ g₀","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.compact_value_log_orders_of_correction_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n),\n  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n    IsCompact R.initialSublevel →\n      ∀ (C : ℝ),\n        0 ≤ C →\n          (∀ (k : ℕ), R.referenceCorrection star k ≤ C * (F (R.x (k + 1)) - F star)) →\n            ((fun N => F (R.x N) - F star) =o[Filter.atTop] fun N => Real.log ↑N / ↑N) ∧\n              (fun N => F (R.x N) - F star) =O[Filter.atTop] fun N => Real.log ↑N / ↑N","axioms":["propext","Classical.choice","Quot.sound"]}
