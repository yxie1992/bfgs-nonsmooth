BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.Kink.mk.injEq","signature":"∀ {n : ℕ} (a : BfgsVerification.Vec n) (b lo hi : ℝ) (ordered : lo ≤ hi) (a_1 : BfgsVerification.Vec n)\n  (b_1 lo_1 hi_1 : ℝ) (ordered_1 : lo_1 ≤ hi_1),\n  ({ a := a, b := b, lo := lo, hi := hi, ordered := ordered } =\n      { a := a_1, b := b_1, lo := lo_1, hi := hi_1, ordered := ordered_1 }) =\n    (a = a_1 ∧ b = b_1 ∧ lo = lo_1 ∧ hi = hi_1)","axioms":["propext","Quot.sound","Classical.choice"]}
