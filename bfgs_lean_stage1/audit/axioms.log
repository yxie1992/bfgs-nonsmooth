BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.active_gap_forbids_radial","signature":"∀ {n : ℕ} {F f h : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        ConvexOn ℝ U f →\n          ConvexOn ℝ U h →\n            (∀ x ∈ U, f x ≤ F x) →\n              (∀ x ∈ U, h x ≤ F x) →\n                ∀ {star w : BfgsVerification.Vec n},\n                  w ∈ U →\n                    f w = F w →\n                      h w = F w →\n                        ∀ {g q : BfgsVerification.Vec n →L[ℝ] ℝ},\n                          HasFDerivAt f g w →\n                            HasFDerivAt h q w →\n                              q (w - star) < g (w - star) →\n                                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                                  ∀ {b : ℝ},\n                                    F star < F w →\n                                      F w < b →\n                                        ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds F {x | F x ≤ b} star","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.parameter_roots_upper_semicontinuous","signature":"∀ {n : ℕ} (p : Polynomial (MvPolynomial (Fin n) ℝ)) {a : BfgsVerification.Vec n},\n  (MvPolynomial.eval a) p.leadingCoeff ≠ 0 →\n    ∀ {U : Set ℝ},\n      IsOpen U →\n        (∀ (t : ℝ), (Polynomial.map (MvPolynomial.eval a) p).IsRoot t → t ∈ U) →\n          ∀ᶠ (x : Fin n → ℝ) in nhds a, ∀ (t : ℝ), (Polynomial.map (MvPolynomial.eval x) p).IsRoot t → t ∈ U","axioms":["propext","Classical.choice","Quot.sound"]}
