BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.normPenalty_finite_bad_ray","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ}\n  (A : (i : ι) → BfgsVerification.Vec n →L[ℝ] EuclideanSpace ℝ (Fin (m i))) (b : (i : ι) → EuclideanSpace ℝ (Fin (m i)))\n  {x : BfgsVerification.Vec n},\n  DifferentiableAt ℝ (BfgsVerification.EuclideanResidual.normPenalty A b) x →\n    ∀ (p : BfgsVerification.Vec n),\n      {t | 0 < t ∧ ¬DifferentiableAt ℝ (BfgsVerification.EuclideanResidual.normPenalty A b) (x + t • p)}.Finite","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.finite_branch_radial_remainders","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι],\n  Finset.univ.Nonempty →\n    ∀ (f : ι → BfgsVerification.Vec n → ℝ) {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        ∀ {w : BfgsVerification.Vec n},\n          w ∈ U →\n            (∀ (i : ι), ContDiffOn ℝ 2 (f i) U) →\n              ∀ (r : BfgsVerification.Vec n),\n                ∃ C,\n                  0 ≤ C ∧\n                    ∀ᶠ (t : ℝ) in nhds 0, ∀ (i : ι), |f i (w + t • r) - f i w - t * (fderiv ℝ (f i) w) r| ≤ C * t ^ 2","axioms":["propext","Classical.choice","Quot.sound"]}
