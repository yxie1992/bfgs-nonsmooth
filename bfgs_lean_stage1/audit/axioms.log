BFGS_AUDIT {"theorem":"BfgsVerification.DeterministicLineSearch.search.eq_2","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (x p g : BfgsVerification.Vec n) (c₁ c₂ l : ℝ) (h : Option ℝ) (a : ℝ)\n  (fuel_2 : ℕ),\n  BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel_2.succ l h a =\n    if BfgsVerification.DeterministicLineSearch.Armijo F x p g c₁ a then\n      if BfgsVerification.DeterministicLineSearch.Wolfe F x p g c₂ a then (some a, [a])\n      else\n        let r :=\n          BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel_2 a h\n            (BfgsVerification.DeterministicLineSearch.nextTrial a h);\n        (r.1, a :: r.2)\n    else\n      let r :=\n        BfgsVerification.DeterministicLineSearch.search F x p g c₁ c₂ fuel_2 l (some a)\n          (BfgsVerification.DeterministicLineSearch.nextTrial l (some a));\n      (r.1, a :: r.2)","axioms":["propext","Quot.sound","Classical.choice"]}
