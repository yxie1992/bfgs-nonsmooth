BFGS_AUDIT {"theorem":"BfgsVerification.LScalarStep.positivePart_interval","signature":"∀ {b x : ℝ},\n  17 / 10 ≤ b →\n    b ≤ 34 →\n      ∀ (m : ℕ),\n        b * BfgsVerification.LScalarGeometric.theta * BfgsVerification.LScalarGeometric.scale m ≤ x →\n          x ≤ b * BfgsVerification.LScalarGeometric.scale m →\n            BfgsVerification.LScalarStep.positivePart b x =\n              (BfgsVerification.LScalarGeometric.theta * BfgsVerification.LScalarGeometric.scale m) ^ 2 +\n                b * BfgsVerification.LScalarGeometric.scale m ^ 2 * (1 - BfgsVerification.LScalarGeometric.theta) *\n                  (BfgsVerification.LScalarGeometric.theta ^ 1 *\n                      BfgsVerification.LScalarGeometric.coordinate b (BfgsVerification.LScalarGeometric.scale m) x +\n                    (1 - BfgsVerification.LScalarGeometric.theta ^ 1) *\n                      BfgsVerification.LScalarStep.primitive b\n                        (BfgsVerification.LScalarGeometric.coordinate b (BfgsVerification.LScalarGeometric.scale m) x))","axioms":["propext","Classical.choice","Quot.sound"]}
