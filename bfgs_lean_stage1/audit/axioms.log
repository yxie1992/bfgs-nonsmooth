BFGS_AUDIT {"theorem":"BfgsVerification.FivePieceObstruction.objective_eq_of_dominates","signature":"∀ (x : BfgsVerification.Vec 3) (i : Fin 5),\n  (∀ (j : Fin 5),\n      BfgsVerification.FivePieceObstruction.family.branch j x ≤\n        BfgsVerification.FivePieceObstruction.family.branch i x) →\n    BfgsVerification.FivePieceObstruction.objective x = BfgsVerification.FivePieceObstruction.family.branch i x","axioms":["propext","Quot.sound","Classical.choice"]}
