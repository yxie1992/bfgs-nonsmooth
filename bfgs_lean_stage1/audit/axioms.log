BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.original_active_commonRate_chart","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (f : Fin m → BfgsVerification.Vec n → ℝ) (p : BfgsVerification.Vec n),\n      BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f p →\n        (∀ (j : Fin m), ContDiffAt ℝ 2 (f j) p) →\n          ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →\n            ∀ (i : Fin (BfgsVerification.ConvexSubdifferential.activeIndices F f p).card),\n              (∀ᶠ (x : BfgsVerification.Vec n) in nhds p,\n                  (BfgsVerification.ConstantRankFields.differenceMatrix\n                        (fun j =>\n                          BfgsVerification.coordinateGradient\n                            (f (BfgsVerification.ConvexSubdifferential.activeIndexMap F f p j)) x)\n                        i).rank =\n                    (BfgsVerification.ConstantRankFields.differenceMatrix\n                        (fun j =>\n                          BfgsVerification.coordinateGradient\n                            (f (BfgsVerification.ConvexSubdifferential.activeIndexMap F f p j)) p)\n                        i).rank) →\n                ∃ U v,\n                  IsOpen U ∧\n                    p ∈ U ∧\n                      ContDiffOn ℝ 1 v U ∧\n                        (∀ x ∈ U,\n                            ∀ j ∈ BfgsVerification.ConvexSubdifferential.activeIndices F f p,\n                              BfgsVerification.dot (BfgsVerification.coordinateGradient (f j) x) (v x) = 1) ∧\n                          (∀ x ∈ U,\n                              ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x,\n                                BfgsVerification.dot a (v x) = 1) ∧\n                            ∀ x ∈ U,\n                              BfgsVerification.ConvexSubdifferential.activeIndices F f x ⊆\n                                  BfgsVerification.ConvexSubdifferential.activeIndices F f p ∧\n                                BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x ∧\n                                  ∀ (j : Fin m), ContDiffAt ℝ 2 (f j) x","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.localCauchyIndex.eq_1","signature":"∀ (f : ℝ → ℝ) (a : ℝ),\n  BfgsVerification.RealAlgebraicGeometry.localCauchyIndex f a =\n    if\n        Filter.Tendsto f (nhdsWithin a (Set.Iio a)) Filter.atBot ∧\n          Filter.Tendsto f (nhdsWithin a (Set.Ioi a)) Filter.atTop then\n      1\n    else\n      if\n          Filter.Tendsto f (nhdsWithin a (Set.Iio a)) Filter.atTop ∧\n            Filter.Tendsto f (nhdsWithin a (Set.Ioi a)) Filter.atBot then\n        -1\n      else 0","axioms":["propext","Classical.choice","Quot.sound"]}
