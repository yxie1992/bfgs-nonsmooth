BFGS_AUDIT {"theorem":"BfgsVerification.NonStrictLineSearch.search.eq_def","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (x p g : BfgsVerification.Vec n) (c₁ c₂ : ℝ) (fuel : ℕ) (l : ℝ)\n  (h : Option ℝ) (a : ℝ),\n  BfgsVerification.NonStrictLineSearch.search F x p g c₁ c₂ fuel l h a =\n    match fuel with\n    | 0 => (none, [])\n    | fuel.succ =>\n      if BfgsVerification.NonStrictLineSearch.Armijo F x p g c₁ a then\n        if BfgsVerification.NonStrictLineSearch.Wolfe F x p g c₂ a then (some a, [a])\n        else\n          let r :=\n            BfgsVerification.NonStrictLineSearch.search F x p g c₁ c₂ fuel a h\n              (BfgsVerification.NonStrictLineSearch.nextTrial a h);\n          (r.1, a :: r.2)\n      else\n        let r :=\n          BfgsVerification.NonStrictLineSearch.search F x p g c₁ c₂ fuel l (some a)\n            (BfgsVerification.NonStrictLineSearch.nextTrial l (some a));\n        (r.1, a :: r.2)","axioms":["propext","Classical.choice","Quot.sound"]}
