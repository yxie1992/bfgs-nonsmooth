BFGS_AUDIT {"theorem":"BfgsVerification.LNormalizedReturn.secant.eq_1","signature":"∀ (μ τ : ℝ) (j : Fin 3) (s : BfgsVerification.LNormalizedReturn.PhaseState),\n  BfgsVerification.LNormalizedReturn.secant μ τ j s =\n    BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD\n          (BfgsVerification.SeedOrbit.nextPhase j) -\n        BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD j +\n      (μ * τ) • BfgsVerification.LNormalizedReturn.step μ τ j s","axioms":["propext","Classical.choice","Quot.sound"]}
