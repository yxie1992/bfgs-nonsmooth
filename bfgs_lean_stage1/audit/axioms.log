BFGS_AUDIT {"theorem":"BfgsVerification.diagonal_coordinate_gram_sum_le","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 < lam i) →\n    ∀ (y : BfgsVerification.Vec n) (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ,\n          (BfgsVerification.metricGram (Matrix.diagonal lam)\n              ((Matrix.replicateCol Unit y).fromCols (BfgsVerification.coordinateMatrix I))).det ≤\n        BfgsVerification.sqNorm y * BfgsVerification.principalSum (Matrix.diagonal lam) (j + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
