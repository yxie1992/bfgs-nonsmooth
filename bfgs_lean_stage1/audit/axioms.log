BFGS_AUDIT {"theorem":"BfgsVerification.convex_gradient_bound_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec n)},\n      IsCompact K →\n        ∃ G,\n          0 < G ∧\n            ∀ x ∈ K,\n              ∀ (g : BfgsVerification.Vec n),\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x → BfgsVerification.sqNorm g ≤ G ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.log_potential_telescope","signature":"∀ (q V : ℕ → ℝ) (A : ℝ) (J : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n          ∀ (m : ℕ),\n            ∑ k ∈ Finset.range m, Real.log (q (J + k)) + Real.log (V (J + m)) ≤ Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
