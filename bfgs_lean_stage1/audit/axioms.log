BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_error_eq","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (star x g : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.RadialCertificate.supportingError F x g (BfgsVerification.RadialCertificate.inwardPoint star x t) =\n    F (BfgsVerification.RadialCertificate.inwardPoint star x t) - F x + t * BfgsVerification.dot g (x - star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sum_transformed_coordinate_grams","signature":"∀ {n : ℕ} (H U : BfgsVerification.Mat n),\n  Matrix.transpose U * U = 1 →\n    ∀ (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ,\n          (BfgsVerification.metricGram H (U * BfgsVerification.coordinateMatrix I)).det =\n        BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.mk.sizeOf_spec","signature":"∀ {f : ℝ → ℝ} (convex : ConvexOn ℝ Set.univ f) (x g metric α : ℕ → ℝ) (c₁ c₂ : ℝ) (c₁_pos : 0 < c₁) (c₁_lt_c₂ : c₁ < c₂)\n  (c₂_lt_one : c₂ < 1) (metric_pos : ∀ (k : ℕ), 0 < metric k) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (gradient_ne : ∀ (k : ℕ), g k ≠ 0) (hasDeriv : ∀ (k : ℕ), HasDerivAt f (g k) (x k))\n  (step : ∀ (k : ℕ), x (k + 1) = x k - α k * metric k * g k)\n  (armijo : ∀ (k : ℕ), f (x (k + 1)) ≤ f (x k) + c₁ * g k * (x (k + 1) - x k))\n  (weak_wolfe : ∀ (k : ℕ), c₂ * g k * (x (k + 1) - x k) ≤ g (k + 1) * (x (k + 1) - x k)),\n  sizeOf\n      { convex := convex, x := x, g := g, metric := metric, α := α, c₁ := c₁, c₂ := c₂, c₁_pos := c₁_pos,\n        c₁_lt_c₂ := c₁_lt_c₂, c₂_lt_one := c₂_lt_one, metric_pos := metric_pos, alpha_pos := alpha_pos,\n        gradient_ne := gradient_ne, hasDeriv := hasDeriv, step := step, armijo := armijo, weak_wolfe := weak_wolfe } =\n    1 + sizeOf convex + sizeOf c₁ + sizeOf c₂ + sizeOf c₁_pos + sizeOf c₁_lt_c₂ + sizeOf c₂_lt_one","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.certificateNormalization","signature":"BfgsVerification.CertificateNormalizationTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_residual_budget","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (C : ℝ) (k : ℕ) (W : Matrix (Fin n) (Fin p) ℝ),\n          U * U.transpose * W = W →\n            BfgsVerification.SmoothSubspace.frobSq W ≤ C * R.d k →\n              (BfgsVerification.metricGram (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) W).trace ≤\n                C * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_pos","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H → ∀ {g : BfgsVerification.Vec n}, g ≠ 0 → 0 < BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot.eq_1","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n), BfgsVerification.dot x y = ∑ i, x i * y i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.abs_dot_le_of_sqNorm_le","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n) (A B : ℝ),\n  0 ≤ A →\n    0 ≤ B → BfgsVerification.sqNorm x ≤ A ^ 2 → BfgsVerification.sqNorm y ≤ B ^ 2 → |BfgsVerification.dot x y| ≤ A * B","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.radial_lower_bound","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {xStar : E} {r ω : ℝ},\n      0 < r →\n        (∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar) →\n          ∀ {x : E}, r ≤ dist x xStar → dist x xStar / r * ω ≤ F x - F xStar","axioms":["propext","Quot.sound","Classical.choice"]}
