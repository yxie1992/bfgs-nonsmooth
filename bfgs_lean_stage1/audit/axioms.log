BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothConnected.cylinder_of_section","signature":"∀ {σ : Type u_1} [inst : Fintype σ] {S : Set (σ → ℝ)} {T : Set (Option σ → ℝ)},\n  BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothConnected S →\n    BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic S →\n      ∀ {f : (σ → ℝ) → ℝ},\n        ContDiffOn ℝ (↑⊤) f S →\n          BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n              {v | (fun i => v (some i)) ∈ S ∧ v none = f fun i => v (some i)} →\n            (∀ x ∈ S, (fun j => j.elim (f x) x) ∈ T) →\n              (∀ z ∈ T, (fun i => z (some i)) ∈ S) →\n                (∀ x ∈ S, Convex ℝ {t | (fun j => j.elim t x) ∈ T}) →\n                  BfgsVerification.RealAlgebraicGeometry.SemialgebraicPiecewiseSmoothConnected T","axioms":["propext","Classical.choice","Quot.sound"]}
