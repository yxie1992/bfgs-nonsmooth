BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.exists_finite_cornerCharts","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ},\n      IsCompact K →\n        (∀ x ∈ K, F x = ℓ) →\n          (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.TwoBranchRegularAt F x) →\n            ∃ m points charts,\n              Function.Injective points ∧\n                (∀ (i : Fin m), points i ∈ K ∧ ¬DifferentiableAt ℝ F (points i)) ∧\n                  ∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ ∃ i, x = points i","axioms":["propext","Quot.sound","Classical.choice"]}
