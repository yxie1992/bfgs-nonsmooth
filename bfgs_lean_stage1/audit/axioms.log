BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.secant_square_bound","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i j : Fin m} {x z : BfgsVerification.Vec 2},\n  P.Active i x →\n    P.Active j z →\n      BfgsVerification.dot (P.branchGradient j z - P.branchGradient i x)\n            (BfgsVerification.Parabolic.Family.radialDirection z) ^\n          2 ≤\n        BfgsVerification.TransportedCertificate.pairCurvature x z (P.branchGradient i x) (P.branchGradient j z) *\n          (4 * P.a i ^ 2 / (P.a i + P.a j) * z 0 ^ 2 + 4 * P.deficit i z)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.LWhitening.failure_strict_accept","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} (D : BfgsVerification.LActualCopies.CopyData F) (m k : ℕ),\n  BfgsVerification.AffineWhitening.objective BfgsVerification.LWhitening.coordinateMatrix F\n        ((BfgsVerification.LWhitening.failureFamily D m).x (k + 1)) <\n      BfgsVerification.AffineWhitening.objective BfgsVerification.LWhitening.coordinateMatrix F\n          ((BfgsVerification.LWhitening.failureFamily D m).x k) +\n        1 / 10000 *\n          BfgsVerification.dot ((BfgsVerification.LWhitening.failureFamily D m).g k)\n            (BfgsVerification.bfgsStep ((BfgsVerification.LWhitening.failureFamily D m).H k)\n              ((BfgsVerification.LWhitening.failureFamily D m).g k)\n              ((BfgsVerification.LWhitening.failureFamily D m).α k)) ∧\n    1 / 2 *\n        BfgsVerification.dot ((BfgsVerification.LWhitening.failureFamily D m).g k)\n          (BfgsVerification.bfgsStep ((BfgsVerification.LWhitening.failureFamily D m).H k)\n            ((BfgsVerification.LWhitening.failureFamily D m).g k)\n            ((BfgsVerification.LWhitening.failureFamily D m).α k)) <\n      BfgsVerification.dot ((BfgsVerification.LWhitening.failureFamily D m).g (k + 1))\n        (BfgsVerification.bfgsStep ((BfgsVerification.LWhitening.failureFamily D m).H k)\n          ((BfgsVerification.LWhitening.failureFamily D m).g k) ((BfgsVerification.LWhitening.failureFamily D m).α k))","axioms":["propext","Classical.choice","Quot.sound"]}
