BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.commonRateVector_chart","signature":"∀ {d n m : ℕ} (g : BfgsVerification.Vec d → Fin m → BfgsVerification.Vec n) (p : BfgsVerification.Vec d) (i : Fin m),\n  (∀ (j : Fin m), ContDiffAt ℝ 1 (fun x => g x j) p) →\n    (∀ᶠ (x : BfgsVerification.Vec d) in nhds p,\n        (BfgsVerification.ConstantRankFields.differenceMatrix (g x) i).rank =\n          (BfgsVerification.ConstantRankFields.differenceMatrix (g p) i).rank) →\n      0 ∉ affineSpan ℝ (Set.range fun j => BfgsVerification.euclideanVector (g p j)) →\n        ∃ U,\n          IsOpen U ∧\n            p ∈ U ∧\n              ContDiffOn ℝ 1 (fun x => BfgsVerification.ConstantRankFields.commonRateVector (g x) i) U ∧\n                ∀ x ∈ U,\n                  ∀ (j : Fin m),\n                    BfgsVerification.dot (g x j) (BfgsVerification.ConstantRankFields.commonRateVector (g x) i) = 1","axioms":["propext","Classical.choice","Quot.sound"]}
