BFGS_AUDIT {"theorem":"BfgsVerification.AccumulatingKinks.no_quotient_near_knot","signature":"∀ (j : ℕ) {K : Set (BfgsVerification.Vec 1)},\n  K ∈ nhds (BfgsVerification.OneDimensional.embed (BfgsVerification.AccumulatingKinks.knot j)) →\n    ¬BfgsVerification.TransportedCertificate.ScalarQuotientBound BfgsVerification.AccumulatingKinks.coordinateObjective\n        K 0 (1 / 4) (1 / 2) (BfgsVerification.AccumulatingKinks.bandGap j)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineCertificate.inverse_transpose_transpose","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 → ∀ (g : BfgsVerification.Vec n), A⁻¹.transpose.mulVec ((Matrix.transpose A).mulVec g) = g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.matrix_sub","signature":"∀ (x z : BfgsVerification.Vec 3),\n  BfgsVerification.NuclearSymmetric2.matrix (x - z) =\n    BfgsVerification.NuclearSymmetric2.matrix x - BfgsVerification.NuclearSymmetric2.matrix z","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.objectiveGrowth_of_value_limit","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (G ℓ : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        Summable R.d ∧\n          Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧\n            Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop ∧\n              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialPower.seminorm_mixed_powers_radial","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (q : (j : ι) → Seminorm ℝ (BfgsVerification.Vec (m j)))\n      (A : (j : ι) → BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec (m j)) (p : ι → ℝ),\n      (∀ (j : ι), 1 ≤ p j) →\n        ∀ (star : BfgsVerification.Vec n) {U K : Set (BfgsVerification.Vec n)},\n          IsOpen U →\n            BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n              IsCompact K →\n                K ⊆ U →\n                  (∀ x ∈ U, F x = ψ x + ∑ j, (q j) ((A j) (x - star)) ^ p j) →\n                    BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarGeometric.tsum_scale_power._proof_2","signature":"∀ {M : Type u_2} [inst : Monoid M] (a : M) (m n : ℕ), (a ^ m) ^ n = a ^ (m * n)","axioms":[]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_value_sq_le_budget_mul_q","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), L ≤ F (R.x k)) → ∀ (k : ℕ), F (R.x k) ^ 2 ≤ (R.homogeneousPotential 0 - (1 - R.c₁) / R.c₁ * L) * R.q k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.orbit_update","signature":"∀ (k : ℕ),\n  BfgsVerification.SeedOrbit.orbitMetric (k + 1) =\n    BfgsVerification.inverseBFGS (BfgsVerification.SeedOrbit.orbitMetric k)\n      (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k) (BfgsVerification.SeedOrbit.orbitGradient k)\n        (BfgsVerification.SeedOrbit.orbitLength k))\n      (BfgsVerification.SeedOrbit.orbitGradient (k + 1) - BfgsVerification.SeedOrbit.orbitGradient k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuadraticGauge.metric_cauchy_schwarz","signature":"∀ {m : ℕ} {Q : BfgsVerification.Mat m},\n  Matrix.PosSemidef Q →\n    ∀ (x y : BfgsVerification.Vec m),\n      BfgsVerification.dot (Matrix.mulVec Q x) y ^ 2 ≤\n        BfgsVerification.metricEnergy Q x * BfgsVerification.metricEnergy Q y","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.UnexcitedMetric.acceptance_ratios","signature":"∀ (A : ℝ) {σ r ρ : ℝ},\n  σ ^ 2 = 1 →\n    0 < r →\n      0 < ρ →\n        (BfgsVerification.UnexcitedMetric.objective (BfgsVerification.UnexcitedMetric.point σ r) -\n                BfgsVerification.UnexcitedMetric.objective (BfgsVerification.UnexcitedMetric.point (-σ) (ρ * r))) /\n              -BfgsVerification.dot (BfgsVerification.UnexcitedMetric.gradient σ)\n                  (BfgsVerification.bfgsStep (BfgsVerification.UnexcitedMetric.diagonal A ((1 + ρ) / (2 * ρ) * r))\n                    (BfgsVerification.UnexcitedMetric.gradient σ) (2 * ρ)) =\n            (1 - ρ) / (1 + ρ) ∧\n          BfgsVerification.dot (BfgsVerification.UnexcitedMetric.gradient (-σ))\n                (BfgsVerification.bfgsStep (BfgsVerification.UnexcitedMetric.diagonal A ((1 + ρ) / (2 * ρ) * r))\n                  (BfgsVerification.UnexcitedMetric.gradient σ) (2 * ρ)) /\n              BfgsVerification.dot (BfgsVerification.UnexcitedMetric.gradient σ)\n                (BfgsVerification.bfgsStep (BfgsVerification.UnexcitedMetric.diagonal A ((1 + ρ) / (2 * ρ) * r))\n                  (BfgsVerification.UnexcitedMetric.gradient σ) (2 * ρ)) =\n            -1","axioms":["propext","Quot.sound","Classical.choice"]}
