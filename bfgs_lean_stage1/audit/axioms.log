BFGS_AUDIT {"theorem":"BfgsVerification.FrameBounds.gram_trace_add_le","signature":"∀ {n r : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.PosSemidef M →\n    ∀ (V W : Matrix (Fin n) (Fin r) ℝ) (d : ℝ),\n      0 < d →\n        (BfgsVerification.metricGram M (V + W)).trace ≤\n          (1 + d) * (BfgsVerification.metricGram M V).trace + (1 + d⁻¹) * (BfgsVerification.metricGram M W).trace","axioms":["propext","Quot.sound","Classical.choice"]}
