BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.energy_telescope","signature":"∀ {E q a R : ℕ → ℝ},\n  (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n    ∀ (N : ℕ), ∑ k ∈ Finset.range N, a k ^ 2 / q k = E 0 - E N + ∑ k ∈ Finset.range N, R k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.StrictContours.level_mem_frontier","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F → Continuous F → ∀ {ℓ : ℝ}, (∃ y, F y < ℓ) → ∀ {x : E}, F x = ℓ → x ∈ frontier {z | F z ≤ ℓ}","axioms":["propext","Quot.sound","Classical.choice"]}
