BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.unbounded_radial_pairs","signature":"∀ {K : Set (BfgsVerification.Vec 3)},\n  K ∈ nhds BfgsVerification.NuclearSymmetric2.minimizer →\n    ∃ θ η,\n      0 < θ ∧\n        θ < Real.pi ∧\n          0 < η ∧\n            ∀ (C : ℝ),\n              ∃ ε,\n                0 < ε ∧\n                  let P := BfgsVerification.NuclearSymmetric2.trigRotation θ;\n                  P.oldPoint ε ∈ K ∧\n                    P.newPoint ε ∈ K ∧\n                      BfgsVerification.NuclearSymmetric2.objective BfgsVerification.NuclearSymmetric2.minimizer + η ≤\n                          BfgsVerification.NuclearSymmetric2.objective (P.newPoint ε) ∧\n                        BfgsVerification.NuclearSymmetric2.objective (P.newPoint ε) <\n                            BfgsVerification.NuclearSymmetric2.objective (P.oldPoint ε) ∧\n                          HasFDerivAt BfgsVerification.NuclearSymmetric2.objective\n                              (BfgsVerification.gradientFunctional (P.oldGradient ε)) (P.oldPoint ε) ∧\n                            HasFDerivAt BfgsVerification.NuclearSymmetric2.objective\n                                (BfgsVerification.gradientFunctional (P.newGradient ε)) (P.newPoint ε) ∧\n                              0 <\n                                  BfgsVerification.RadialCertificate.secantCurvature (P.oldPoint ε) (P.newPoint ε)\n                                    (P.oldGradient ε) (P.newGradient ε) ∧\n                                C *\n                                    BfgsVerification.RadialCertificate.secantCurvature (P.oldPoint ε) (P.newPoint ε)\n                                      (P.oldGradient ε) (P.newGradient ε) <\n                                  BfgsVerification.RadialCertificate.radialNumerator\n                                      BfgsVerification.NuclearSymmetric2.minimizer (P.newPoint ε) (P.oldGradient ε)\n                                      (P.newGradient ε) ^\n                                    2","axioms":["propext","Classical.choice","Quot.sound"]}
