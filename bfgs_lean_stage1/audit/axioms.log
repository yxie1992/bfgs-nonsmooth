BFGS_AUDIT {"theorem":"BfgsVerification.hessianUpdate","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (y : BfgsVerification.Vec n) {α : ℝ},\n          0 < α →\n            0 < BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) →\n              (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y)⁻¹ =\n                H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g +\n                  (BfgsVerification.dot y (BfgsVerification.bfgsStep H g α))⁻¹ • BfgsVerification.outer y y","axioms":["propext","Classical.choice","Quot.sound"]}
