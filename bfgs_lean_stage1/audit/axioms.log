BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.PiecewiseSmoothPath.mk.injEq","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {S : Set E} {x y : E} (curve : ℝ → E)\n  (continuousOn : ContinuousOn curve (Set.Icc 0 1)) (source : curve 0 = x) (target : curve 1 = y)\n  (mapsTo : Set.MapsTo curve (Set.Icc 0 1) S) (exceptions : Finset ℝ)\n  (smoothAt : ∀ t ∈ Set.Ioo 0 1, t ∉ exceptions → ContDiffAt ℝ (↑⊤) curve t) (curve_1 : ℝ → E)\n  (continuousOn_1 : ContinuousOn curve_1 (Set.Icc 0 1)) (source_1 : curve_1 0 = x) (target_1 : curve_1 1 = y)\n  (mapsTo_1 : Set.MapsTo curve_1 (Set.Icc 0 1) S) (exceptions_1 : Finset ℝ)\n  (smoothAt_1 : ∀ t ∈ Set.Ioo 0 1, t ∉ exceptions_1 → ContDiffAt ℝ (↑⊤) curve_1 t),\n  ({ curve := curve, continuousOn := continuousOn, source := source, target := target, mapsTo := mapsTo,\n        exceptions := exceptions, smoothAt := smoothAt } =\n      { curve := curve_1, continuousOn := continuousOn_1, source := source_1, target := target_1, mapsTo := mapsTo_1,\n        exceptions := exceptions_1, smoothAt := smoothAt_1 }) =\n    (curve = curve_1 ∧ exceptions = exceptions_1)","axioms":["propext","Classical.choice","Quot.sound"]}
