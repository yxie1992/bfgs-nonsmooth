BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.positive_pseudo_index_recurrence._proof_1","signature":"∀ {p q r : Polynomial ℝ},\n  BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex p q =\n      BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex r q →\n    BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex r q +\n          BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex q r =\n        BfgsVerification.RealAlgebraicGeometry.infinityVariation r q →\n      ¬BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex p q =\n            BfgsVerification.RealAlgebraicGeometry.infinityVariation r q -\n              BfgsVerification.RealAlgebraicGeometry.rationalCauchyIndex q r →\n        False","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.maximum_deriv_eq_active","signature":"∀ {ι : Type u_1} {s : Finset ι} (hne : s.Nonempty) {f d : ι → ℝ → ℝ} {U : Set ℝ},\n  (∀ i ∈ s, ∀ x ∈ U, HasDerivAt (f i) (d i x) x) →\n    (∀ x ∈ U,\n        ∀ i ∈ s,\n          ∀ j ∈ s,\n            f i x = BfgsVerification.FiniteMaxRadial.maximum s hne f x →\n              f j x = BfgsVerification.FiniteMaxRadial.maximum s hne f x → d i x = d j x) →\n      ∀ {x : ℝ},\n        x ∈ U →\n          ∀ {i : ι},\n            i ∈ s →\n              f i x = BfgsVerification.FiniteMaxRadial.maximum s hne f x →\n                deriv (BfgsVerification.FiniteMaxRadial.maximum s hne f) x = d i x","axioms":["propext","Classical.choice","Quot.sound"]}
