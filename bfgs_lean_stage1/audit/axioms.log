BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.projected_strong_support_monotonicity","signature":"∀ {n m : ℕ} (P : BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec m) {F : BfgsVerification.Vec n → ℝ}\n  {U : Set (BfgsVerification.Vec n)} {μ : ℝ},\n  (ConvexOn ℝ U fun x => F x - μ / 2 * BfgsVerification.sqNorm (P x)) →\n    ∀ {x z g h : BfgsVerification.Vec n},\n      x ∈ U →\n        z ∈ U →\n          BfgsVerification.Homogeneous.Supports F x g →\n            BfgsVerification.Homogeneous.Supports F z h →\n              μ * BfgsVerification.sqNorm (P (z - x)) ≤ BfgsVerification.dot (h - g) (z - x)","axioms":["propext","Classical.choice","Quot.sound"]}
