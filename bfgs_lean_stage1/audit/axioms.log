BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.fullBFGS_step_of_representation","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ},\n  Differentiable ℝ ψ →\n    ∀ (P : ι → BfgsVerification.AffineKinks.Kink n),\n      (∀ (z : BfgsVerification.Vec n), F z = ψ z + BfgsVerification.AffineKinks.penalty P z) →\n        ConvexOn ℝ Set.univ F →\n          ∀ (x g : BfgsVerification.Vec n) (H : BfgsVerification.Mat n),\n            Matrix.PosDef H →\n              g ≠ 0 →\n                HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                  ∀ {c₁ c₂ : ℝ},\n                    0 < c₁ →\n                      c₁ < c₂ →\n                        c₂ < 1 →\n                          ∀ (L : ℝ),\n                            (∀ (t : ℝ), 0 ≤ t → L ≤ F (x + BfgsVerification.bfgsStep H g t)) →\n                              ∃ α h,\n                                0 < α ∧\n                                  HasFDerivAt F (BfgsVerification.gradientFunctional h)\n                                      (x + BfgsVerification.bfgsStep H g α) ∧\n                                    F (x + BfgsVerification.bfgsStep H g α) <\n                                        F x + c₁ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) ∧\n                                      c₂ * BfgsVerification.dot g (BfgsVerification.bfgsStep H g α) <\n                                        BfgsVerification.dot h (BfgsVerification.bfgsStep H g α)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.tangent_gradientChange","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  {Ω : Set (BfgsVerification.Vec n)} {a : BfgsVerification.Vec n} {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n  (∀ (k : ℕ), R.x k ∈ Ω) →\n    (∀ x ∈ Ω,\n        ∀ (g : BfgsVerification.Vec n),\n          BfgsVerification.Homogeneous.Supports F x g → BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n      ∀ (k : ℕ), BfgsVerification.FixedNormal.tangentProjection a (R.gradientChange k) = A (R.x (k + 1)) - A (R.x k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.eligible_horizontal_sq_le","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i : Fin m} {x z g h : BfgsVerification.Vec 2} {c₁ c₂ : ℝ},\n  0 ≤ c₁ →\n    P.Active i x →\n      BfgsVerification.TransportedCertificate.EligiblePair P.objective c₁ c₂ x z g h →\n        BfgsVerification.Parabolic.Family.horizontalStep x z ^ 2 ≤\n          BfgsVerification.TransportedCertificate.pairDecrease x z g / P.minQuadratic","axioms":["propext","Quot.sound","Classical.choice"]}
