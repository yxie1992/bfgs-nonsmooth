@BfgsVerification.ReciprocalGrowth.hierarchy_reciprocal_growth : ∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},
  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →
    BfgsVerification.ScalarHierarchy.UpperNull δ →
      Filter.Tendsto (BfgsVerification.reciprocalGeometricMean q) Filter.atTop Filter.atTop ∧
        Filter.Tendsto (BfgsVerification.reciprocalMean q) Filter.atTop Filter.atTop
def BfgsVerification.PrincipalMinorHierarchyTarget : Prop :=
∀ (n : ℕ) (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),
  Matrix.PosDef H →
    0 < α →
      let q := BfgsVerification.metricEnergy H g;
      let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;
      0 < q →
        0 < β →
          ∀ (j : ℕ),
            1 ≤ j →
              j ≤ n →
                BfgsVerification.principalSum (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) j ≤
                  BfgsVerification.sqNorm y / (β ^ 2 * q) * BfgsVerification.principalSum H (j + 1) +
                    α / β * BfgsVerification.principalSum H j
def BfgsVerification.ReciprocalGrowthTarget : Prop :=
∀ (n : ℕ) (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Filter.Tendsto R.d Filter.atTop (nhds 0) →
            Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧
              Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop
def BfgsVerification.SuperquadraticReciprocalTarget : Prop :=
∀ (n : ℕ) (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Summable R.d → Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
structure BfgsVerification.FullBFGSRun (n : ℕ) : Type
number of parameters: 1
fields:
  BfgsVerification.FullBFGSRun.H : ℕ → BfgsVerification.Mat n
  BfgsVerification.FullBFGSRun.g : ℕ → BfgsVerification.Vec n
  BfgsVerification.FullBFGSRun.α : ℕ → ℝ
  BfgsVerification.FullBFGSRun.positive_definite : ∀ (k : ℕ), Matrix.PosDef (self.H k)
  BfgsVerification.FullBFGSRun.alpha_pos : ∀ (k : ℕ), 0 < self.α k
  BfgsVerification.FullBFGSRun.energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (self.H k) (self.g k)
  BfgsVerification.FullBFGSRun.curvature_pos : ∀ (k : ℕ),
      0 < BfgsVerification.dot (self.g (k + 1) - self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
  BfgsVerification.FullBFGSRun.update : ∀ (k : ℕ),
      self.H (k + 1) =
        BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))
          (self.g (k + 1) - self.g k)
constructor:
  BfgsVerification.FullBFGSRun.mk {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)
    (positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)) (alpha_pos : ∀ (k : ℕ), 0 < α k)
    (energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k))
    (curvature_pos :
      ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))
    (update :
      ∀ (k : ℕ),
        H (k + 1) =
          BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)) :
    BfgsVerification.FullBFGSRun n
def BfgsVerification.principalSum : {n : ℕ} → BfgsVerification.Mat n → ℕ → ℝ :=
fun {n} H j => ∑ I ∈ Finset.powersetCard j Finset.univ, (Matrix.submatrix H (fun i => ↑i) fun i => ↑i).det
def BfgsVerification.inverseBFGS : {n : ℕ} →
  BfgsVerification.Mat n → BfgsVerification.Vec n → BfgsVerification.Vec n → BfgsVerification.Mat n :=
fun {n} H s y =>
  let t := BfgsVerification.dot y s;
  (1 - t⁻¹ • BfgsVerification.outer s y) * H * (1 - t⁻¹ • BfgsVerification.outer y s) + t⁻¹ • BfgsVerification.outer s s
def BfgsVerification.FullBFGSRun.q : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => BfgsVerification.metricEnergy (R.H k) (R.g k)
def BfgsVerification.FullBFGSRun.d : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => R.α k * R.q k
def BfgsVerification.FullBFGSRun.beta : {n : ℕ} → BfgsVerification.FullBFGSRun n → ℕ → ℝ :=
fun {n} R k => -BfgsVerification.dot (R.g (k + 1) - R.g k) (Matrix.mulVec (R.H k) (R.g k)) / R.q k
@BfgsVerification.finiteHorizon : ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          Summable R.d →
            ∀ (J m : ℕ),
              0 < m →
                ∀ (η : ℝ),
                  0 < η →
                    let D := ∑' (i : ℕ), R.d (J + i);
                    let V :=
                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)
                        (BfgsVerification.principalSum (R.H J));
                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤
                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹
@BfgsVerification.fullBFGS_normalizedHierarchy : ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),
  0 < G →
    0 < c →
      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →
        (∀ (k : ℕ), c ≤ R.beta k) →
          BfgsVerification.ScalarHierarchy.NormalizedHierarchy n (fun k => BfgsVerification.principalSum (R.H k)) R.q
            (fun k => R.d k / c) (4 * G ^ 2 / c ^ 2) (G ^ 2)

