BFGS_AUDIT {"theorem":"BfgsVerification.FiniteRayLineSearch.finite_nondifferentiability_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (x p g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n        BfgsVerification.dot g p < 0 →\n          ∀ {c₁ c₂ : ℝ},\n            0 < c₁ →\n              c₁ < c₂ →\n                c₂ < 1 →\n                  ∀ (L : ℝ),\n                    (∀ (t : ℝ), 0 ≤ t → L ≤ F (x + t • p)) →\n                      {t | 0 < t ∧ ¬DifferentiableAt ℝ F (x + t • p)}.Finite →\n                        ∃ t h,\n                          0 < t ∧\n                            HasFDerivAt F (BfgsVerification.gradientFunctional h) (x + t • p) ∧\n                              F (x + t • p) < F x + c₁ * BfgsVerification.dot g (t • p) ∧\n                                c₂ * BfgsVerification.dot g (t • p) < BfgsVerification.dot h (t • p)","axioms":["propext","Quot.sound","Classical.choice"]}
