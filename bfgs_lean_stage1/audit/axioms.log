BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.common_component_energy_step","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (v : BfgsVerification.Vec n) (k : ℕ),\n  BfgsVerification.dot v (R.g k) = 1 →\n    BfgsVerification.dot v (R.g (k + 1)) = 1 →\n      BfgsVerification.metricEnergy (R.H (k + 1))⁻¹ v = BfgsVerification.metricEnergy (R.H k)⁻¹ v - (R.q k)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.supportingError_le_curvature","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x z g h : BfgsVerification.Vec n},\n      HasFDerivAt F (BfgsVerification.gradientFunctional h) z →\n        BfgsVerification.RadialCertificate.supportingError F x g z ≤\n          BfgsVerification.RadialCertificate.secantCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_referenceCorrection_le_pairing","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (k : ℕ), R.referenceCorrection 0 k ≤ BfgsVerification.dot (R.gradientChange k) (R.x (k + 1))","axioms":["propext","Quot.sound","Classical.choice"]}
