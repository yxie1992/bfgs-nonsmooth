BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace_annihilated_le","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (g : BfgsVerification.Vec n) (q : ℝ),\n  0 ≤ q →\n    ∀ (W : Matrix (Fin n) (Fin r) ℝ),\n      (BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g) W).trace ≤\n        (BfgsVerification.metricGram B W).trace","axioms":["propext","Quot.sound","Classical.choice"]}
