BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_normalized_lower","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (D : ℝ),\n            0 < D →\n              ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                BfgsVerification.QuantitativeGrowth.normalizedLower\n                    (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / D) (E J)) D n m ≤\n                  (∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹) / (↑m + 1) ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.objective_gap","signature":"∀ (x : BfgsVerification.Vec 3),\n  BfgsVerification.sqNorm (x - BfgsVerification.NuclearSymmetric2.minimizer) / 2 ≤\n    BfgsVerification.NuclearSymmetric2.objective x -\n      BfgsVerification.NuclearSymmetric2.objective BfgsVerification.NuclearSymmetric2.minimizer","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.TrialCertificate.decision","signature":"∀ {c d r : ℝ} {j : Fin 3} {a : ℝ} {i : Fin 3} {accept : Bool},\n  BfgsVerification.SeedOrbit.TrialCertificate c d r j a i accept →\n    if accept = true then\n      BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d i) (BfgsVerification.SeedOrbit.trial c d r j a) <\n        BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j) (BfgsVerification.SeedOrbit.point c d r j) +\n          1 / 3 *\n            BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j)\n              (a • BfgsVerification.SeedOrbit.direction c d r j)\n    else\n      BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d j) (BfgsVerification.SeedOrbit.point c d r j) <\n        BfgsVerification.dot (BfgsVerification.SeedOrbit.gradient c d i) (BfgsVerification.SeedOrbit.trial c d r j a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.ProfileActive.eq_1","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) (i : Fin m) (ξ : ℝ),\n  P.ProfileActive i ξ = ∀ (j : Fin m), P.profile j ξ ≤ P.profile i ξ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.armijo","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  F (self.x (k + 1)) ≤\n    F (self.x k) +\n      self.c₁ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.quotient_cancellation","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i : Fin m} {x z : BfgsVerification.Vec 2},\n  P.Active i x →\n    P.objective x ≠ 0 →\n      BfgsVerification.Parabolic.Family.stepDeterminant x z ≠ 0 →\n        BfgsVerification.Parabolic.Family.quotientMultiplier x z - 1 +\n            P.a i * x 0 / P.objective x * BfgsVerification.Parabolic.Family.horizontalStep x z =\n          -x 1 * BfgsVerification.Parabolic.Family.horizontalStep x z *\n              BfgsVerification.TransportedCertificate.pairDecrease x z (P.branchGradient i x) /\n            (P.objective x * BfgsVerification.Parabolic.Family.stepDeterminant x z)","axioms":["propext","Quot.sound","Classical.choice"]}
