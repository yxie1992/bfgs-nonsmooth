BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.det_one_add_smul_eq_sum_principal","signature":"∀ {ι : Type u_1} {R : Type u_2} [inst : Fintype ι] [inst_1 : DecidableEq ι] [inst_2 : CommRing R] (t : R)\n  (M : Matrix ι ι R), (1 + t • M).det = ∑ I, t ^ I.card * (M.submatrix (fun i => ↑i) fun i => ↑i).det","axioms":["propext","Quot.sound","Classical.choice"]}
