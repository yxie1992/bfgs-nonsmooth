BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_add_kernel","signature":"∀ {n r : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.IsSymm M →\n    ∀ {s : BfgsVerification.Vec n},\n      Matrix.mulVec M s = 0 →\n        ∀ (V : Matrix (Fin n) (Fin r) ℝ) (b : BfgsVerification.Vec r),\n          BfgsVerification.metricGram M (V + BfgsVerification.EnergyIdentities.rectOuter s b) =\n            BfgsVerification.metricGram M V","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.finiteMaxLinear_active_supports","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty) {x a : BfgsVerification.Vec n},\n  a ∈ A →\n    BfgsVerification.Homogeneous.finiteMaxLinear A hA x = BfgsVerification.dot a x →\n      BfgsVerification.Homogeneous.Supports (BfgsVerification.Homogeneous.finiteMaxLinear A hA) x a","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.homogeneous_value_zero_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  BfgsVerification.Homogeneous.PositiveDegreeOne F →\n    ∀ (L : ℝ), (∀ (k : ℕ), L ≤ F (R.x k)) → Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
