BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.orderedRealRoot_matching","signature":"∀ (p q : Polynomial ℝ),\n  p ≠ 0 →\n    ∀ (δ : ℝ),\n      (∀ b ∈ p.roots.toFinset,\n          ∀ c ∈ p.roots.toFinset, b ≠ c → Disjoint (Set.Icc (b - δ) (b + δ)) (Set.Icc (c - δ) (c + δ))) →\n        (∀ t ∈ q.roots.toFinset, ∃ b ∈ p.roots.toFinset, t ∈ Set.Icc (b - δ) (b + δ)) →\n          (∀ b ∈ p.roots.toFinset,\n              BfgsVerification.RealAlgebraicGeometry.rootWeightIn q (Set.Icc (b - δ) (b + δ)) ≤\n                Polynomial.rootMultiplicity b p) →\n            q.roots.toFinset.card = p.roots.toFinset.card →\n              q.roots.card = p.roots.card →\n                ∀ {k : ℕ},\n                  k < p.roots.toFinset.card →\n                    BfgsVerification.RealAlgebraicGeometry.orderedRealRoot q k ∈\n                        Set.Icc (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot p k - δ)\n                          (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot p k + δ) ∧\n                      Polynomial.rootMultiplicity (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot q k) q =\n                        Polynomial.rootMultiplicity (BfgsVerification.RealAlgebraicGeometry.orderedRealRoot p k) p","axioms":["propext","Classical.choice","Quot.sound"]}
