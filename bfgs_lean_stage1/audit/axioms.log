BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.exists_uniform_secant_bound","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {K : Set (BfgsVerification.Vec 2)},\n  IsCompact K →\n    ∀ {c₁ c₂ : ℝ},\n      0 ≤ c₁ →\n        c₂ < 1 →\n          ∃ C,\n            0 < C ∧\n              ∀ x ∈ K,\n                ∀ z ∈ K,\n                  ∀ (g h : BfgsVerification.Vec 2),\n                    BfgsVerification.TransportedCertificate.EligiblePair P.objective c₁ c₂ x z g h →\n                      BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ 1 →\n                        BfgsVerification.dot (h - g) (BfgsVerification.Parabolic.Family.radialDirection z) ^ 2 ≤\n                          C * BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
