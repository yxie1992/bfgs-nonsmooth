BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.hasBandCertificates_restrict","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K K' : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ : ℝ},\n  BfgsVerification.TransportedCertificate.HasBandCertificates F K fstar c₁ c₂ →\n    K' ⊆ K → BfgsVerification.TransportedCertificate.HasBandCertificates F K' fstar c₁ c₂","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.compact_objective_tendsto_min_of_quadratic_corrections","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xstar : BfgsVerification.Vec n),\n  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →\n    IsCompact R.initialSublevel →\n      ∀ (C : ℝ),\n        (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection xstar k ≤ C * ↑N ^ 2) →\n          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))","axioms":["propext","Quot.sound","Classical.choice"]}
