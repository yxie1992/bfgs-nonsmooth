BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.composite_support_projection","signature":"∀ {n : ℕ} {F ψ : BfgsVerification.Vec n → ℝ} {h : ℝ → ℝ},\n  ConvexOn ℝ Set.univ h →\n    ∀ {Ω : Set (BfgsVerification.Vec n)},\n      IsOpen Ω →\n        ∀ {a : BfgsVerification.Vec n},\n          BfgsVerification.sqNorm a = 1 →\n            ∀ (b : ℝ),\n              (∀ y ∈ Ω, F y = ψ y + h (BfgsVerification.FixedNormal.normalCoordinate a b y)) →\n                ∀ {x g p : BfgsVerification.Vec n},\n                  x ∈ Ω →\n                    BfgsVerification.Homogeneous.Supports F x g →\n                      HasFDerivAt ψ (BfgsVerification.gradientFunctional p) x →\n                        BfgsVerification.FixedNormal.tangentProjection a g =\n                          BfgsVerification.FixedNormal.tangentProjection a p","axioms":["propext","Classical.choice","Quot.sound"]}
