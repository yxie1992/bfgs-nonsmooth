BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_trace_update","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ) (k : ℕ),\n  (BfgsVerification.metricGram (R.hessian (k + 1)) U).trace =\n    (BfgsVerification.metricGram (R.hessian k) U).trace - BfgsVerification.sqNorm (U.transpose.mulVec (R.g k)) / R.q k +\n      BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) / R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
