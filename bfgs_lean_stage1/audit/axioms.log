BFGS_AUDIT {"theorem":"BfgsVerification.AffineCertificate.transform._proof_4","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.det A ≠ 0 →\n    ∀ (b : BfgsVerification.Vec n) {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)}\n      {fstar c₁ c₂ η : ℝ} (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η)\n      (x z g h : BfgsVerification.Vec n),\n      x ∈\n          BfgsVerification.TransportedCertificate.positiveBand (BfgsVerification.AffineCertificate.objective A b F)\n            (BfgsVerification.AffineCertificate.forward A b '' K) fstar η →\n        z ∈\n            BfgsVerification.TransportedCertificate.positiveBand (BfgsVerification.AffineCertificate.objective A b F)\n              (BfgsVerification.AffineCertificate.forward A b '' K) fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair (BfgsVerification.AffineCertificate.objective A b F) c₁\n              c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n              ((1 + C.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        BfgsVerification.AffineCertificate.field A b C.W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      BfgsVerification.AffineCertificate.field A b C.W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
