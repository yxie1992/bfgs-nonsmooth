BFGS_AUDIT {"theorem":"BfgsVerification.principal_product_augmented_sum_le","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ lam i) →\n    ∀ (y : BfgsVerification.Vec n) (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ, (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \\ I, lam k * y k ^ 2 ≤\n        BfgsVerification.sqNorm y * ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ, ∏ i ∈ J, lam i","axioms":["propext","Quot.sound","Classical.choice"]}
