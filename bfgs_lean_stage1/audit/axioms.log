BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.exists_composite_tangent_secant","signature":"∀ {n : ℕ} {F ψ : BfgsVerification.Vec n → ℝ} {h : ℝ → ℝ} {Ω K : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    ConvexOn ℝ Ω ψ →\n      BfgsVerification.CenteredSmoothSublinear.LocallyC11On Ω ψ →\n        ConvexOn ℝ Set.univ h →\n          ∀ {a : BfgsVerification.Vec n},\n            BfgsVerification.sqNorm a = 1 →\n              ∀ (b : ℝ),\n                (∀ x ∈ Ω, F x = ψ x + h (BfgsVerification.FixedNormal.normalCoordinate a b x)) →\n                  IsCompact K →\n                    K ⊆ Ω →\n                      ∃ L,\n                        0 < L ∧\n                          ∀ x ∈ K,\n                            ∀ z ∈ K,\n                              ∀ (g g' : BfgsVerification.Vec n),\n                                BfgsVerification.Homogeneous.Supports F x g →\n                                  BfgsVerification.Homogeneous.Supports F z g' →\n                                    BfgsVerification.sqNorm\n                                        (BfgsVerification.FixedNormal.tangentProjection a (g' - g)) ≤\n                                      L * BfgsVerification.dot (g' - g) (z - x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.residual_energy_le","signature":"∀ {n r p : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B →\n    ∀ (g : BfgsVerification.Vec n) (q : ℝ),\n      0 ≤ q →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (W : Matrix (Fin n) (Fin p) ℝ),\n              U * U.transpose * W = W →\n                (BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g) W).trace ≤\n                  BfgsVerification.SmoothSubspace.frobSq W * (BfgsVerification.metricGram B U).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.radial_contraction_identities","signature":"∀ {n : ℕ} (a x : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.RadialCertificate.secantCurvature x ((1 - t) • x) (BfgsVerification.NormalSpike.positiveGradient a x)\n        (BfgsVerification.NormalSpike.positiveGradient a ((1 - t) • x)) =\n      t *\n        BfgsVerification.dot\n          (BfgsVerification.NormalSpike.positiveGradient a x -\n            BfgsVerification.NormalSpike.positiveGradient a ((1 - t) • x))\n          x ∧\n    BfgsVerification.RadialCertificate.radialNumerator 0 ((1 - t) • x)\n        (BfgsVerification.NormalSpike.positiveGradient a x)\n        (BfgsVerification.NormalSpike.positiveGradient a ((1 - t) • x)) =\n      -(1 - t) *\n        BfgsVerification.dot\n          (BfgsVerification.NormalSpike.positiveGradient a x -\n            BfgsVerification.NormalSpike.positiveGradient a ((1 - t) • x))\n          x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineKinks.local_quantile_basin","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (a : ι → BfgsVerification.Vec n) (b τ : ι → ℝ) {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n          ∀ {star : BfgsVerification.Vec n},\n            star ∈ U →\n              (∀ x ∈ U,\n                  F x =\n                    ψ x + ∑ i, BfgsVerification.AffineKinks.quantileLoss (τ i) (BfgsVerification.dot (a i) x - b i)) →\n                (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                  (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                    ∃ δ,\n                      0 < δ ∧\n                        ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                          F (R.x 0) ≤ F star + δ →\n                            (∀ (k : ℕ), R.x k ∈ U) ∧\n                              Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
