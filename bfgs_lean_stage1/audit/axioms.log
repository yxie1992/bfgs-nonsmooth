BFGS_AUDIT {"theorem":"BfgsVerification.LocalStableOrbit.sequenceMap._proof_1","signature":"∀ {S : Type u_1} {U : Type u_2} [inst : NormedAddCommGroup S] [inst_1 : NormedSpace ℝ S] [inst_2 : NormedAddCommGroup U]\n  [inst_3 : NormedSpace ℝ U] (A : S →L[ℝ] S) (B : U →L[ℝ] U) (N : S × U → S × U) (a : S)\n  (w : BfgsVerification.LocalStableOrbit.Sequence S U),\n  Continuous fun n => (BfgsVerification.LocalStableOrbit.stablePart A N a w n, B ((w (n + 1)).2 - (N (w n)).2))","axioms":["propext","Classical.choice","Quot.sound"]}
