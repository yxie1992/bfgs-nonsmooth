BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.mk.injEq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (convex : ConvexOn ℝ Set.univ F) (x : ℕ → BfgsVerification.Vec n)\n  (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ) (c₁ c₂ : ℝ) (c₁_pos : 0 < c₁)\n  (c₁_lt_c₂ : c₁ < c₂) (c₂_lt_one : c₂ < 1) (initial_posDef : Matrix.PosDef (H 0)) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (gradient_nonzero : ∀ (k : ℕ), g k ≠ 0)\n  (hasGradient : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g k)) (x k))\n  (step : ∀ (k : ℕ), x (k + 1) = x k + BfgsVerification.bfgsStep (H k) (g k) (α k))\n  (update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k))\n  (armijo :\n    ∀ (k : ℕ), F (x (k + 1)) ≤ F (x k) + c₁ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (weak_wolfe :\n    ∀ (k : ℕ),\n      c₂ * BfgsVerification.dot (g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) ≤\n        BfgsVerification.dot (g (k + 1)) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (convex_1 : ConvexOn ℝ Set.univ F) (x_1 : ℕ → BfgsVerification.Vec n) (H_1 : ℕ → BfgsVerification.Mat n)\n  (g_1 : ℕ → BfgsVerification.Vec n) (α_1 : ℕ → ℝ) (c₁_1 c₂_1 : ℝ) (c₁_pos_1 : 0 < c₁_1) (c₁_lt_c₂_1 : c₁_1 < c₂_1)\n  (c₂_lt_one_1 : c₂_1 < 1) (initial_posDef_1 : Matrix.PosDef (H_1 0)) (alpha_pos_1 : ∀ (k : ℕ), 0 < α_1 k)\n  (gradient_nonzero_1 : ∀ (k : ℕ), g_1 k ≠ 0)\n  (hasGradient_1 : ∀ (k : ℕ), HasFDerivAt F (BfgsVerification.gradientFunctional (g_1 k)) (x_1 k))\n  (step_1 : ∀ (k : ℕ), x_1 (k + 1) = x_1 k + BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k))\n  (update_1 :\n    ∀ (k : ℕ),\n      H_1 (k + 1) =\n        BfgsVerification.inverseBFGS (H_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) (g_1 (k + 1) - g_1 k))\n  (armijo_1 :\n    ∀ (k : ℕ),\n      F (x_1 (k + 1)) ≤\n        F (x_1 k) + c₁_1 * BfgsVerification.dot (g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)))\n  (weak_wolfe_1 :\n    ∀ (k : ℕ),\n      c₂_1 * BfgsVerification.dot (g_1 k) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k)) ≤\n        BfgsVerification.dot (g_1 (k + 1)) (BfgsVerification.bfgsStep (H_1 k) (g_1 k) (α_1 k))),\n  ({ convex := convex, x := x, H := H, g := g, α := α, c₁ := c₁, c₂ := c₂, c₁_pos := c₁_pos, c₁_lt_c₂ := c₁_lt_c₂,\n        c₂_lt_one := c₂_lt_one, initial_posDef := initial_posDef, alpha_pos := alpha_pos,\n        gradient_nonzero := gradient_nonzero, hasGradient := hasGradient, step := step, update := update,\n        armijo := armijo, weak_wolfe := weak_wolfe } =\n      { convex := convex_1, x := x_1, H := H_1, g := g_1, α := α_1, c₁ := c₁_1, c₂ := c₂_1, c₁_pos := c₁_pos_1,\n        c₁_lt_c₂ := c₁_lt_c₂_1, c₂_lt_one := c₂_lt_one_1, initial_posDef := initial_posDef_1, alpha_pos := alpha_pos_1,\n        gradient_nonzero := gradient_nonzero_1, hasGradient := hasGradient_1, step := step_1, update := update_1,\n        armijo := armijo_1, weak_wolfe := weak_wolfe_1 }) =\n    (x = x_1 ∧ H = H_1 ∧ g = g_1 ∧ α = α_1 ∧ c₁ = c₁_1 ∧ c₂ = c₂_1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sum_transformed_coordinate_grams","signature":"∀ {n : ℕ} (H U : BfgsVerification.Mat n),\n  Matrix.transpose U * U = 1 →\n    ∀ (j : ℕ),\n      ∑ I ∈ Finset.powersetCard j Finset.univ,\n          (BfgsVerification.metricGram H (U * BfgsVerification.coordinateMatrix I)).det =\n        BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_residual_budget","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (C : ℝ) (k : ℕ) (W : Matrix (Fin n) (Fin p) ℝ),\n          U * U.transpose * W = W →\n            BfgsVerification.SmoothSubspace.frobSq W ≤ C * R.d k →\n              (BfgsVerification.metricGram (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) W).trace ≤\n                C * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_pos","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H → ∀ {g : BfgsVerification.Vec n}, g ≠ 0 → 0 < BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.dot.eq_1","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n), BfgsVerification.dot x y = ∑ i, x i * y i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.radial_lower_bound","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {xStar : E} {r ω : ℝ},\n      0 < r →\n        (∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar) →\n          ∀ {x : E}, r ≤ dist x xStar → dist x xStar / r * ω ≤ F x - F xStar","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_3","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ), R.g (J + k) ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.curvature_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (1 - R.c₂) * R.d k ≤ BfgsVerification.dot (R.g (k + 1) - R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.diagonal_coordinate_gram_det","signature":"∀ {n : ℕ} (lam : Fin n → ℝ),\n  (∀ (i : Fin n), 0 < lam i) →\n    ∀ (y : BfgsVerification.Vec n) (I : Finset (Fin n)),\n      (BfgsVerification.metricGram (Matrix.diagonal lam)\n            ((Matrix.replicateCol Unit y).fromCols (BfgsVerification.coordinateMatrix I))).det =\n        (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \\ I, lam k * y k ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_fixed_tail_lower_eventually._proof_2","signature":"∀ (J M N : ℕ), N ≥ J + (max M 1 + 1) → ¬0 < N - (J + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.coefficient_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k j : ℕ), 0 ≤ E k j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.gradientFunctional._proof_3","signature":"ContinuousConstSMul ℝ ℝ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  self.x (k + 1) = self.x k + BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.reciprocal_sum_ge_exp","signature":"∀ (q : ℕ → ℝ) (m : ℕ) (L : ℝ),\n  0 < m →\n    (∀ (i : ℕ), 0 < q i) →\n      ∑ i ∈ Finset.range m, Real.log (q i) ≤ L → ↑m * Real.exp (-L / ↑m) ≤ ∑ i ∈ Finset.range m, (q i)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.summable_predicted_decreases_of_value_limit","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (ℓ : ℝ),\n  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) → Summable R.d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_normalized_lower","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    (∀ (k : ℕ), 0 ≤ δ k) →\n      ∀ (J m : ℕ),\n        0 < m →\n          ∀ (D : ℝ),\n            0 < D →\n              ∑ i ∈ Finset.range m, δ (J + i) ≤ D →\n                BfgsVerification.QuantitativeGrowth.normalizedLower\n                    (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / D) (E J)) D n m ≤\n                  (∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹) / (↑m + 1) ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.armijo","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  F (self.x (k + 1)) ≤\n    F (self.x k) +\n      self.c₁ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.annihilatedMatrix_posSemidef","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 → Matrix.PosSemidef (H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.objectiveGrowth_of_value_limit","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (G ℓ : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        Summable R.d ∧\n          Filter.Tendsto (BfgsVerification.reciprocalGeometricMean R.q) Filter.atTop Filter.atTop ∧\n            Filter.Tendsto (BfgsVerification.reciprocalMean R.q) Filter.atTop Filter.atTop ∧\n              Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (R.q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclideanOpNorm._proof_1","signature":"∀ {r : ℕ}, ContinuousAdd (EuclideanSpace ℝ (Fin r))","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.transformed_coordinateMatrix_injective","signature":"∀ {n : ℕ} (U : BfgsVerification.Mat n),\n  Matrix.transpose U * U = 1 →\n    ∀ (I : Finset (Fin n)), Function.Injective (U * BfgsVerification.coordinateMatrix I).mulVec","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.principalSum_top","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n), BfgsVerification.principalSum H n = Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.curvature_eq_alpha_beta_q","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  BfgsVerification.metricEnergy H g ≠ 0 →\n    BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) =\n      α * (-BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g) *\n        BfgsVerification.metricEnergy H g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.update","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  self.H (k + 1) =\n    BfgsVerification.inverseBFGS (self.H k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))\n      (self.g (k + 1) - self.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclidean_norm_sq","signature":"∀ {n : ℕ} (x : EuclideanSpace ℝ (Fin n)), ‖x‖ ^ 2 = BfgsVerification.sqNorm fun i => x i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.mul_outer","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n),\n  A * BfgsVerification.outer a b = BfgsVerification.outer (Matrix.mulVec A a) b","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.objectiveFiniteHorizon_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (G L : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      (∀ (k : ℕ), L ≤ F (R.x k)) → BfgsVerification.ObjectiveFiniteHorizonBound R G","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.sum_log_le_of_sum_le","signature":"∀ (x : ℕ → ℝ) (m : ℕ) (B : ℝ),\n  (∀ (i : ℕ), 0 < x i) →\n    0 < B → ∑ i ∈ Finset.range m, x i ≤ ↑m * B → ∑ i ∈ Finset.range m, Real.log (x i) ≤ ↑m * Real.log B","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_nonneg","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  0 ≤ r → (∀ (j : ℕ), 0 ≤ e j) → 0 ≤ BfgsVerification.ScalarHierarchy.weightedPotential n r e","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.dimension_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ}, BfgsVerification.AdmissibleBFGSRun n F → 0 < n","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.gram_numerator_identity","signature":"∀ (Δ q u r z κ w : ℝ), q * (Δ * (r - z)) - Δ * ((q - u) * (r - z) - (κ - w) ^ 2) = Δ * ((κ - w) ^ 2 + u * (r - z))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameBounds.trace_outer","signature":"∀ {r : ℕ} (v : BfgsVerification.Vec r), Matrix.trace (BfgsVerification.outer v v) = BfgsVerification.sqNorm v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.finite_budget_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → ∀ (J N : ℕ), ∑ i ∈ Finset.range N, R.d (J + i) ≤ (F (R.x J) - L) / R.c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.iterate_mem_initialSublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  R.x k ∈ R.initialSublevel","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} {J r : ℕ}\n  {V : ℕ → Matrix (Fin n) (Fin r) ℝ} {T P : ℕ → BfgsVerification.Mat r} {b : ℕ → BfgsVerification.Vec r} {m K L C : ℝ}\n  {m_pos : 0 < m} {K_pos : 0 < K} {L_nonneg : 0 ≤ L} {invertible : ∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0}\n  {product : ∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k}\n  {transport :\n    ∀ (k : ℕ), J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)}\n  {visible : ∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))}\n  {correction :\n    ∀ (k : ℕ), J ≤ k → BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C}\n  {product_bound :\n    ∀ (k : ℕ),\n      J ≤ k →\n        ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v}\n  {inverse_bound :\n    ∀ (k : ℕ),\n      J ≤ k → ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v}\n  {J_1 r_1 : ℕ} {V_1 : ℕ → Matrix (Fin n) (Fin r_1) ℝ} {T_1 P_1 : ℕ → BfgsVerification.Mat r_1}\n  {b_1 : ℕ → BfgsVerification.Vec r_1} {m_1 K_1 L_1 C_1 : ℝ} {m_pos_1 : 0 < m_1} {K_pos_1 : 0 < K_1}\n  {L_nonneg_1 : 0 ≤ L_1} {invertible_1 : ∀ (k : ℕ), J_1 ≤ k → Matrix.det (P_1 k) ≠ 0}\n  {product_1 : ∀ (k : ℕ), J_1 ≤ k → P_1 (k + 1) = P_1 k * T_1 k}\n  {transport_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k → V_1 (k + 1) = V_1 k * T_1 k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b_1 k)}\n  {visible_1 : ∀ (k : ℕ), J_1 ≤ k → m_1 ≤ BfgsVerification.sqNorm ((V_1 k).transpose.mulVec (R.g k))}\n  {correction_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k → BfgsVerification.sqNorm ((V_1 (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C_1}\n  {product_bound_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k →\n        ∀ (v : Fin r_1 → ℝ),\n          BfgsVerification.sqNorm ((Matrix.transpose (P_1 k)).mulVec v) ≤ K_1 * BfgsVerification.sqNorm v}\n  {inverse_bound_1 :\n    ∀ (k : ℕ),\n      J_1 ≤ k →\n        ∀ (v : Fin r_1 → ℝ), BfgsVerification.sqNorm ((P_1 k)⁻¹.transpose.mulVec v) ≤ L_1 * BfgsVerification.sqNorm v},\n  { J := J, r := r, V := V, T := T, P := P, b := b, m := m, K := K, L := L, C := C, m_pos := m_pos, K_pos := K_pos,\n        L_nonneg := L_nonneg, invertible := invertible, product := product, transport := transport, visible := visible,\n        correction := correction, product_bound := product_bound, inverse_bound := inverse_bound } =\n      { J := J_1, r := r_1, V := V_1, T := T_1, P := P_1, b := b_1, m := m_1, K := K_1, L := L_1, C := C_1,\n        m_pos := m_pos_1, K_pos := K_pos_1, L_nonneg := L_nonneg_1, invertible := invertible_1, product := product_1,\n        transport := transport_1, visible := visible_1, correction := correction_1, product_bound := product_bound_1,\n        inverse_bound := inverse_bound_1 } →\n    J = J_1 ∧ r = r_1 ∧ HEq V V_1 ∧ HEq T T_1 ∧ HEq P P_1 ∧ HEq b b_1 ∧ m = m_1 ∧ K = K_1 ∧ L = L_1 ∧ C = C_1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.compressed_inverseBFGS_bound_generic","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (H : BfgsVerification.Mat n)\n  (Z : Matrix (Fin n) ι ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.PosDef H →\n    Function.Injective Z.mulVec →\n      0 < α →\n        0 < BfgsVerification.metricEnergy H g →\n          0 < -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g →\n            let q := BfgsVerification.metricEnergy H g;\n            let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n            (BfgsVerification.metricGram (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) Z).det ≤\n              (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det / (β ^ 2 * q) +\n                α / β * (BfgsVerification.metricGram H Z).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.energy_add_kernel","signature":"∀ {n : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.IsSymm M →\n    ∀ {s : BfgsVerification.Vec n},\n      Matrix.mulVec M s = 0 →\n        ∀ (r : BfgsVerification.Vec n), BfgsVerification.metricEnergy M (r + s) = BfgsVerification.metricEnergy M r","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_supporting_inequality","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x g : BfgsVerification.Vec n},\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n        ∀ (y : BfgsVerification.Vec n), BfgsVerification.dot g (y - x) ≤ F y - F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.rectOuter.eq_1","signature":"∀ {n r : ℕ} (s : BfgsVerification.Vec n) (b : BfgsVerification.Vec r) (i : Fin n) (j : Fin r),\n  BfgsVerification.EnergyIdentities.rectOuter s b i j = s i * b j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.predicted_decrease_bounds","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  R.c₁ * R.d k ≤ F (R.x k) - F (R.x (k + 1)) ∧ F (R.x k) - F (R.x (k + 1)) ≤ R.d k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.scaled_outer_posSemidef","signature":"∀ {n : ℕ} (g : BfgsVerification.Vec n) (a : ℝ), 0 ≤ a → Matrix.PosSemidef (a • BfgsVerification.outer g g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.convergence_of_quadratic_corrections_unique_minimizer","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xStar : BfgsVerification.Vec n),\n  (∀ (x : BfgsVerification.Vec n), F xStar ≤ F x) →\n    (∀ (x : BfgsVerification.Vec n), F x = F xStar → x = xStar) →\n      ∀ (C : ℝ),\n        (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection xStar k ≤ C * ↑N ^ 2) →\n          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xStar)) ∧\n            Filter.Tendsto R.x Filter.atTop (nhds xStar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.outer.eq_1","signature":"∀ {n : ℕ} (x y : BfgsVerification.Vec n) (i j : Fin n), BfgsVerification.outer x y i j = x i * y j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.outer_mul","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n),\n  BfgsVerification.outer a b * A = BfgsVerification.outer a ((Matrix.transpose A).mulVec b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.product","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ), self.J ≤ k → self.P (k + 1) = self.P k * self.T k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.segment_value_lower","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ) (a b : ℝ),\n  a + b = 1 → F (R.x k) - b * R.d k ≤ F (a • R.x k + b • R.x (k + 1))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_tail_criterion","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ} (J : ℕ)\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k) →\n      (∀ (k : ℕ),\n          J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (m K L C : ℝ),\n          0 < m →\n            0 < K →\n              0 ≤ L →\n                (∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                  (∀ (k : ℕ),\n                      J ≤ k →\n                        BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤\n                          C) →\n                    (∀ (k : ℕ),\n                        J ≤ k →\n                          ∀ (v : Fin r → ℝ),\n                            BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤\n                              K * BfgsVerification.sqNorm v) →\n                      (∀ (k : ℕ),\n                          J ≤ k →\n                            ∀ (v : Fin r → ℝ),\n                              BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →\n                        ∀ (G : ℝ),\n                          0 < G →\n                            (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n                              Filter.Tendsto R.d Filter.atTop (nhds 0) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.cluster_pair_segment_constant._proof_1","signature":"∀ {R : Type v} [inst : Mul R] [inst_1 : Add R] [inst_2 : RightDistribClass R] (a b c : R), a * c + b * c = (a + b) * c","axioms":[]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.residual_energy_le","signature":"∀ {n r p : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B →\n    ∀ (g : BfgsVerification.Vec n) (q : ℝ),\n      0 ≤ q →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (W : Matrix (Fin n) (Fin p) ℝ),\n              U * U.transpose * W = W →\n                (BfgsVerification.metricGram (B - q⁻¹ • BfgsVerification.outer g g) W).trace ≤\n                  BfgsVerification.SmoothSubspace.frobSq W * (BfgsVerification.metricGram B U).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.gram_trace_nonneg","signature":"∀ {n r : ℕ} {B : BfgsVerification.Mat n},\n  Matrix.PosSemidef B → ∀ (V : Matrix (Fin n) (Fin r) ℝ), 0 ≤ (BfgsVerification.metricGram B V).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.gram_trace","signature":"∀ {n r : ℕ} (B : BfgsVerification.Mat n) (W : Matrix (Fin n) (Fin r) ℝ),\n  (BfgsVerification.metricGram B W).trace = ∑ j, BfgsVerification.metricEnergy B fun i => W i j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.energy_sub_matrix","signature":"∀ {n : ℕ} (B C : BfgsVerification.Mat n) (x : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy (B - C) x = BfgsVerification.metricEnergy B x - BfgsVerification.metricEnergy C x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_potentials_force_log_growth._proof_1","signature":"∀ (J : ℕ), ℕ → ∀ (N : ℕ), J + 1 ≤ N → ¬0 < N → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameNorms.euclideanOpNorm._proof_4","signature":"∀ {r : ℕ}, CompleteSpace (EuclideanSpace ℝ (Fin r))","axioms":["Quot.sound","propext","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_two","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        let a := Z.transpose.mulVec (Matrix.mulVec H g);\n        let b := Z.transpose.mulVec (Matrix.mulVec H y);\n        let A := BfgsVerification.metricGram H Z;\n        (BfgsVerification.metricGram H (Matrix.fromCols (fun i k => ![g i, y i] k) Z)).det =\n          A.det *\n            ((BfgsVerification.metricEnergy H g - BfgsVerification.dot a (A⁻¹.mulVec a)) *\n                (BfgsVerification.metricEnergy H y - BfgsVerification.dot b (A⁻¹.mulVec b)) -\n              (BfgsVerification.dot g (Matrix.mulVec H y) - BfgsVerification.dot a (A⁻¹.mulVec b)) ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.rank_one_increment_upper_bound","signature":"∀ (α β q Δ u : ℝ), 0 ≤ α → 0 < β → 0 < q → 0 ≤ Δ → u ≤ q → α / (β * q) * Δ * u ≤ α / β * Δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one","signature":"∀ {n j : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricEnergy H y -\n              BfgsVerification.dot (Z.transpose.mulVec (Matrix.mulVec H y))\n                ((BfgsVerification.metricGram H Z)⁻¹.mulVec (Z.transpose.mulVec (Matrix.mulVec H y))))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.moving_frame_criterion","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r),\n  (∀ (k : ℕ), Matrix.det (P k) ≠ 0) →\n    (∀ (k : ℕ), P (k + 1) = P k * T k) →\n      (∀ (k : ℕ), V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k)) →\n        ∀ (m K L C : ℝ),\n          0 < m →\n            0 < K →\n              0 ≤ L →\n                (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                  (∀ (k : ℕ),\n                      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C) →\n                    (∀ (k : ℕ) (v : Fin r → ℝ),\n                        BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v) →\n                      (∀ (k : ℕ) (v : Fin r → ℝ),\n                          BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v) →\n                        ∀ (G : ℝ),\n                          0 < G →\n                            (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n                              Filter.Tendsto R.d Filter.atTop (nhds 0) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.smooth_subspace_trace_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  (U : Matrix (Fin n) (Fin r) ℝ) (L : ℝ),\n  (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n    ∀ (k : ℕ),\n      (BfgsVerification.metricGram (R.hessian (k + 1)) U).trace ≤\n        (BfgsVerification.metricGram (R.hessian k) U).trace + L","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r p : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ) (orthonormal : U.transpose * U = 1) (L m C₀ C_T C_R : ℝ) (m_pos : 0 < m)\n  (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p) (b : ℕ → BfgsVerification.Vec p)\n  (smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k)\n  (visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k)))\n  (correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k)\n  (transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k)\n  (operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k))\n  (residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k)\n  (residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k),\n  sizeOf\n      { J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n    1 + sizeOf J + sizeOf r + sizeOf p + sizeOf orthonormal + sizeOf L + sizeOf m + sizeOf C₀ + sizeOf C_T +\n        sizeOf C_R +\n      sizeOf m_pos","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.projected_compression","signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (v y : BfgsVerification.Vec n) (κ : ℝ),\n  Matrix.IsSymm H →\n    Z.transpose * ((1 - κ⁻¹ • BfgsVerification.outer v y) * H * (1 - κ⁻¹ • BfgsVerification.outer v y).transpose) * Z =\n      BfgsVerification.CompressionDeterminant.compression (Z.transpose * H * Z) (Z.transpose.mulVec v)\n        (Z.transpose.mulVec (Matrix.mulVec H y)) κ (BfgsVerification.dot y (Matrix.mulVec H y))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.sqNorm.eq_1","signature":"∀ {n : ℕ} (x : BfgsVerification.Vec n), BfgsVerification.sqNorm x = ∑ i, x i ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.hierarchy_reciprocal_growth","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C →\n    BfgsVerification.ScalarHierarchy.UpperNull δ →\n      Filter.Tendsto (BfgsVerification.reciprocalGeometricMean q) Filter.atTop Filter.atTop ∧\n        Filter.Tendsto (BfgsVerification.reciprocalMean q) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_incompatible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 ≤ L →\n                0 < m →\n                  0 ≤ C₀ →\n                    0 ≤ C_T →\n                      0 ≤ C_R →\n                        (∀ (k : ℕ),\n                            BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n                          ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                            (b : ℕ → BfgsVerification.Vec p),\n                            (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k))) →\n                              (∀ (k : ℕ),\n                                  BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) ≤\n                                    C₀ * R.curvature k) →\n                                (∀ (k : ℕ),\n                                    V (k + 1) =\n                                      V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k) +\n                                        Z k) →\n                                  (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * R.d k)) →\n                                    (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                                      (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * R.d k) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.compact_objective_tendsto_min_of_quadratic_corrections","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xstar : BfgsVerification.Vec n),\n  (∀ (z : BfgsVerification.Vec n), F xstar ≤ F z) →\n    IsCompact R.initialSublevel →\n      ∀ (C : ℝ),\n        (∀ᶠ (N : ℕ) in Filter.atTop, ∑ k ∈ Finset.range N, R.referenceCorrection xstar k ≤ C * ↑N ^ 2) →\n          Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar))","axioms":["propext","Quot.sound","Classical.choice"]}
