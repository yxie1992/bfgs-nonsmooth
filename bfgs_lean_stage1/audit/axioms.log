BFGS_AUDIT {"theorem":"BfgsVerification.LFlatten.Data.mk.injEq","signature":"∀ {μ c₁ c₂ : ℝ} (state : ℕ → BfgsVerification.LNormalizedReturn.State)\n  (scale_pos : ∀ (m : ℕ), 0 < BfgsVerification.LNormalizedReturn.scale (state m))\n  (conditions : ∀ (m : ℕ), BfgsVerification.LNormalizedOracle.Conditions μ c₁ c₂ (state m))\n  (next : ∀ (m : ℕ), state (m + 1) = BfgsVerification.LNormalizedReturn.returnMap μ (state m))\n  (state_1 : ℕ → BfgsVerification.LNormalizedReturn.State)\n  (scale_pos_1 : ∀ (m : ℕ), 0 < BfgsVerification.LNormalizedReturn.scale (state_1 m))\n  (conditions_1 : ∀ (m : ℕ), BfgsVerification.LNormalizedOracle.Conditions μ c₁ c₂ (state_1 m))\n  (next_1 : ∀ (m : ℕ), state_1 (m + 1) = BfgsVerification.LNormalizedReturn.returnMap μ (state_1 m)),\n  ({ state := state, scale_pos := scale_pos, conditions := conditions, next := next } =\n      { state := state_1, scale_pos := scale_pos_1, conditions := conditions_1, next := next_1 }) =\n    (state = state_1)","axioms":["propext","Classical.choice","Quot.sound"]}
