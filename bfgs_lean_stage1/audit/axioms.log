BFGS_AUDIT {"theorem":"BfgsVerification.LReturnSpectrum.actual_spectral_contract","signature":"∀ (μ : ℝ),\n  ∃ ls lu,\n    (38 / 1000 < ls ∧ ls < 39 / 1000) ∧\n      (1564 / 1000 < lu ∧ lu < 1565 / 1000) ∧\n        ∃ E,\n          (∀ (w : BfgsVerification.LBlockSplitting.Coordinates), E w 4 = w.1 1) ∧\n            (∀ (w : BfgsVerification.LBlockSplitting.Coordinates),\n                (fderiv ℝ (BfgsVerification.LNormalizedReturn.returnMap μ) BfgsVerification.LNormalizedReturn.seed)\n                    (E w) =\n                  E\n                    ((BfgsVerification.LBlockSplitting.diagonalMap ![ls, BfgsVerification.SeedOrbit.seedRatio]) w.1,\n                      (BfgsVerification.LBlockSplitting.diagonalMap\n                          ![BfgsVerification.SeedOrbit.seedRatio⁻¹, BfgsVerification.SeedOrbit.seedRatio⁻¹, lu])\n                        w.2)) ∧\n              (↑(fderiv ℝ (BfgsVerification.LNormalizedReturn.returnMap μ)\n                      BfgsVerification.LNormalizedReturn.seed)).charpoly =\n                (Polynomial.X - Polynomial.C BfgsVerification.SeedOrbit.seedRatio⁻¹) ^ 2 *\n                      (Polynomial.X - Polynomial.C ls) *\n                    (Polynomial.X - Polynomial.C lu) *\n                  (Polynomial.X - Polynomial.C BfgsVerification.SeedOrbit.seedRatio)","axioms":["propext","Classical.choice","Quot.sound"]}
