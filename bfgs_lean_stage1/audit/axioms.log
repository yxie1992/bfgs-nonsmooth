BFGS_AUDIT {"theorem":"BfgsVerification.Localization.low_sublevel_subset_ball","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {xStar : E} {r ω a : ℝ},\n      0 < r →\n        0 ≤ ω →\n          (∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar) → a - F xStar < ω → {x | F x ≤ a} ⊆ Metric.ball xStar r","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_secant_identities","signature":"∀ {n : ℕ} (star x g h : BfgsVerification.Vec n) (t : ℝ),\n  BfgsVerification.RadialCertificate.secantCurvature x (BfgsVerification.RadialCertificate.inwardPoint star x t) g h =\n      t * BfgsVerification.dot (g - h) (x - star) ∧\n    BfgsVerification.RadialCertificate.radialNumerator star (BfgsVerification.RadialCertificate.inwardPoint star x t) g\n        h =\n      -(1 - t) * BfgsVerification.dot (g - h) (x - star)","axioms":["propext","Quot.sound","Classical.choice"]}
