BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_det","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (s y : BfgsVerification.Vec n),\n      BfgsVerification.dot y s ≠ 0 →\n        Matrix.det (BfgsVerification.inverseBFGS H s y) =\n          BfgsVerification.dot s (Matrix.mulVec H⁻¹ s) / BfgsVerification.dot y s * Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.normalize._proof_9","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (C : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  0 < c₁ →\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ C.δ →\n              Real.exp (C.L / c₁ * (F z - fstar)) *\n                  (1 + C.L * BfgsVerification.TransportedCertificate.pairDecrease x z g) ≤\n                (1 + 0 * BfgsVerification.TransportedCertificate.pairDecrease x z g) *\n                  Real.exp (C.L / c₁ * (F x - fstar))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.objective_value_limit_of_lower_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → ∃ ℓ, Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.mk.injEq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (W : BfgsVerification.Vec n → BfgsVerification.Mat n) (Ψ : BfgsVerification.Vec n → ℝ) (m C L δ ψlo ψhi : ℝ)\n  (m_pos : 0 < m) (L_nonneg : 0 ≤ L) (delta_pos : 0 < δ)\n  (potential_bounds : ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, ψlo ≤ Ψ x ∧ Ψ x ≤ ψhi)\n  (positive_semidefinite :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W x))\n  (visibility :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m ≤ BfgsVerification.metricEnergy (W x) g)\n  (secant :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              BfgsVerification.metricEnergy (W z) (h - g) ≤\n                C * BfgsVerification.TransportedCertificate.pairCurvature x z g h)\n  (transport :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ →\n              (Real.exp (L * BfgsVerification.TransportedCertificate.pairDecrease x z g + Ψ x - Ψ z) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef)\n  (W_1 : BfgsVerification.Vec n → BfgsVerification.Mat n) (Ψ_1 : BfgsVerification.Vec n → ℝ)\n  (m_1 C_1 L_1 δ_1 ψlo_1 ψhi_1 : ℝ) (m_pos_1 : 0 < m_1) (L_nonneg_1 : 0 ≤ L_1) (delta_pos_1 : 0 < δ_1)\n  (potential_bounds_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η, ψlo_1 ≤ Ψ_1 x ∧ Ψ_1 x ≤ ψhi_1)\n  (positive_semidefinite_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      DifferentiableAt ℝ F x → Matrix.PosSemidef (W_1 x))\n  (visibility_1 :\n    ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n      ∀ (g : BfgsVerification.Vec n),\n        HasFDerivAt F (BfgsVerification.gradientFunctional g) x → m_1 ≤ BfgsVerification.metricEnergy (W_1 x) g)\n  (secant_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              BfgsVerification.metricEnergy (W_1 z) (h - g) ≤\n                C_1 * BfgsVerification.TransportedCertificate.pairCurvature x z g h)\n  (transport_1 :\n    ∀ (x z g h : BfgsVerification.Vec n),\n      x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n        z ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η →\n          BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n            BfgsVerification.TransportedCertificate.pairDecrease x z g ≤ δ_1 →\n              (Real.exp (L_1 * BfgsVerification.TransportedCertificate.pairDecrease x z g + Ψ_1 x - Ψ_1 z) •\n                    (BfgsVerification.TransportedCertificate.stepProjector\n                          (BfgsVerification.TransportedCertificate.pairStep x z) *\n                        W_1 x *\n                      BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z)) -\n                  BfgsVerification.TransportedCertificate.stepProjector\n                        (BfgsVerification.TransportedCertificate.pairStep x z) *\n                      W_1 z *\n                    BfgsVerification.TransportedCertificate.stepProjector\n                      (BfgsVerification.TransportedCertificate.pairStep x z)).PosSemidef),\n  ({ W := W, Ψ := Ψ, m := m, C := C, L := L, δ := δ, ψlo := ψlo, ψhi := ψhi, m_pos := m_pos, L_nonneg := L_nonneg,\n        delta_pos := delta_pos, potential_bounds := potential_bounds, positive_semidefinite := positive_semidefinite,\n        visibility := visibility, secant := secant, transport := transport } =\n      { W := W_1, Ψ := Ψ_1, m := m_1, C := C_1, L := L_1, δ := δ_1, ψlo := ψlo_1, ψhi := ψhi_1, m_pos := m_pos_1,\n        L_nonneg := L_nonneg_1, delta_pos := delta_pos_1, potential_bounds := potential_bounds_1,\n        positive_semidefinite := positive_semidefinite_1, visibility := visibility_1, secant := secant_1,\n        transport := transport_1 }) =\n    (W = W_1 ∧ Ψ = Ψ_1 ∧ m = m_1 ∧ C = C_1 ∧ L = L_1 ∧ δ = δ_1 ∧ ψlo = ψlo_1 ∧ ψhi = ψhi_1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    ∀ (g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
