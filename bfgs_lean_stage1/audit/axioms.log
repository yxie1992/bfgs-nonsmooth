BFGS_AUDIT {"theorem":"BfgsVerification.ConstantRankFields.RateChart.mk.inj","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ} {f : Fin m → BfgsVerification.Vec n → ℝ} {p : BfgsVerification.Vec n}\n  {radius : ℝ} {radius_pos : 0 < radius} {field : BfgsVerification.Vec n → BfgsVerification.Vec n}\n  {fieldC1 : ContDiffOn ℝ 1 field (Metric.ball p radius)}\n  {originalPairing :\n    ∀ x ∈ Metric.ball p radius,\n      ∀ j ∈ BfgsVerification.ConvexSubdifferential.activeIndices F f p,\n        BfgsVerification.dot (BfgsVerification.coordinateGradient (f j) x) (field x) = 1}\n  {supportsPairing :\n    ∀ x ∈ Metric.ball p radius,\n      ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x, BfgsVerification.dot a (field x) = 1}\n  {activeSubset :\n    ∀ x ∈ Metric.ball p radius,\n      BfgsVerification.ConvexSubdifferential.activeIndices F f x ⊆\n        BfgsVerification.ConvexSubdifferential.activeIndices F f p}\n  {representation : ∀ x ∈ Metric.ball p radius, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x}\n  {branchC2 : ∀ x ∈ Metric.ball p radius, ∀ (j : Fin m), ContDiffAt ℝ 2 (f j) x}\n  {branchConvex : ∀ (j : Fin m), ConvexOn ℝ (Metric.ball p radius) (f j)} {radius_1 : ℝ} {radius_pos_1 : 0 < radius_1}\n  {field_1 : BfgsVerification.Vec n → BfgsVerification.Vec n}\n  {fieldC1_1 : ContDiffOn ℝ 1 field_1 (Metric.ball p radius_1)}\n  {originalPairing_1 :\n    ∀ x ∈ Metric.ball p radius_1,\n      ∀ j ∈ BfgsVerification.ConvexSubdifferential.activeIndices F f p,\n        BfgsVerification.dot (BfgsVerification.coordinateGradient (f j) x) (field_1 x) = 1}\n  {supportsPairing_1 :\n    ∀ x ∈ Metric.ball p radius_1,\n      ∀ a ∈ BfgsVerification.ConvexSubdifferential.subdifferential F x, BfgsVerification.dot a (field_1 x) = 1}\n  {activeSubset_1 :\n    ∀ x ∈ Metric.ball p radius_1,\n      BfgsVerification.ConvexSubdifferential.activeIndices F f x ⊆\n        BfgsVerification.ConvexSubdifferential.activeIndices F f p}\n  {representation_1 : ∀ x ∈ Metric.ball p radius_1, BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x}\n  {branchC2_1 : ∀ x ∈ Metric.ball p radius_1, ∀ (j : Fin m), ContDiffAt ℝ 2 (f j) x}\n  {branchConvex_1 : ∀ (j : Fin m), ConvexOn ℝ (Metric.ball p radius_1) (f j)},\n  { radius := radius, radius_pos := radius_pos, field := field, fieldC1 := fieldC1, originalPairing := originalPairing,\n        supportsPairing := supportsPairing, activeSubset := activeSubset, representation := representation,\n        branchC2 := branchC2, branchConvex := branchConvex } =\n      { radius := radius_1, radius_pos := radius_pos_1, field := field_1, fieldC1 := fieldC1_1,\n        originalPairing := originalPairing_1, supportsPairing := supportsPairing_1, activeSubset := activeSubset_1,\n        representation := representation_1, branchC2 := branchC2_1, branchConvex := branchConvex_1 } →\n    radius = radius_1 ∧ field = field_1","axioms":["propext","Classical.choice","Quot.sound"]}
