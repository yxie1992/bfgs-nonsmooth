BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.inverse_dot_symm","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.IsSymm A →\n    ∀ (a b : BfgsVerification.Vec n),\n      BfgsVerification.dot b (Matrix.mulVec A⁻¹ a) = BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append","signature":"∀ {n : ℕ} {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [inst_2 : DecidableEq ι]\n  [inst_3 : DecidableEq κ] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (Y : Matrix (Fin n) ι ℝ) (Z : Matrix (Fin n) κ ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H (Y.fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricGram H Y -\n                Y.transpose * H * Z * (BfgsVerification.metricGram H Z)⁻¹ * (Z.transpose * H * Y)).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.finiteHorizon_of_principalMinorHierarchy","signature":"BfgsVerification.PrincipalMinorHierarchyTarget →\n  ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n    0 < G →\n      0 < c →\n        (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n          (∀ (k : ℕ), c ≤ R.beta k) →\n            Summable R.d →\n              ∀ (J m : ℕ),\n                0 < m →\n                  ∀ (η : ℝ),\n                    0 < η →\n                      let D := ∑' (i : ℕ), R.d (J + i);\n                      let V :=\n                        BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                          (BfgsVerification.principalSum (R.H J));\n                      ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                        ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_potentials_force_log_growth","signature":"∀ (q : ℕ → ℝ) (C : ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    0 < C →\n      (∀ (A : ℝ),\n          0 < A →\n            ∃ J V, (∀ (k : ℕ), 0 < V k) ∧ (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) ∧ ∀ (k : ℕ), q k ≤ C * V k) →\n        Filter.Tendsto (BfgsVerification.ReciprocalGrowth.logReciprocalMean q) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
