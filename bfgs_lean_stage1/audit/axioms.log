BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.beta_ge_of_weakWolfe","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (k : ℕ) (c₂ : ℝ),\n  c₂ * BfgsVerification.dot (R.g k) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)) ≤\n      BfgsVerification.dot (R.g (k + 1)) (BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)) →\n    1 - c₂ ≤ R.beta k","axioms":["propext","Quot.sound","Classical.choice"]}
