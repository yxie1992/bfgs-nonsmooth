BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.inverse_energy_nonneg","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (v : BfgsVerification.Vec n) (k : ℕ),\n  0 ≤ BfgsVerification.metricEnergy (R.H k)⁻¹ v","axioms":["propext","Quot.sound","Classical.choice"]}
