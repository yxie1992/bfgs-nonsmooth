def BfgsVerification.LBlockSplitting.BlockForm : (BfgsVerification.LBlockSplitting.State →L[ℝ]
    BfgsVerification.LBlockSplitting.State) →
  ℝ →
    ℝ →
      ℝ →
        ℝ →
          ℝ →
            ℝ →
              BfgsVerification.Vec 2 →
                BfgsVerification.Vec 2 → BfgsVerification.Vec 2 → BfgsVerification.Vec 2 → Prop :=
fun F alpha rho a b c d p q h k =>
  ∀ (w : BfgsVerification.LBlockSplitting.State),
    F w =
      ![alpha * w 0 + p 0 * w 2 + q 0 * w 3 + h 0 * w 4, alpha * w 1 + p 1 * w 2 + q 1 * w 3 + h 1 * w 4,
        a * w 2 + b * w 3 + k 0 * w 4, c * w 2 + d * w 3 + k 1 * w 4, rho * w 4]
theorem BfgsVerification.LBlockSplitting.block_splitting : ∀
  {F : BfgsVerification.LBlockSplitting.State →L[ℝ] BfgsVerification.LBlockSplitting.State} {rho a b c d ls lu : ℝ}
  {p q h k : BfgsVerification.Vec 2},
  BfgsVerification.LBlockSplitting.BlockForm F rho⁻¹ rho a b c d p q h k →
    0 < rho →
      rho < 1 →
        0 < ls →
          ls < rho →
            1 < lu →
              lu < rho⁻¹ →
                b ≠ 0 →
                  (ls - a) * (ls - d) = b * c →
                    (lu - a) * (lu - d) = b * c →
                      ∃ E,
                        (∀ (w : BfgsVerification.LBlockSplitting.Coordinates), E w 4 = w.1 1) ∧
                          ∃ A L, ‖A‖ < 1 ∧ ‖↑L.symm‖ < 1 ∧ F.comp ↑E = (↑E).comp (A.prodMap ↑L) :=
fun {F} {rho a b c d ls lu} {p q h k} hF hr0 hr1 hs0 hsr hu1 hua hb hsroot huroot =>
  let_fun hra := lt_trans hr1 ((one_lt_inv₀ hr0).mpr hr1);
  let_fun hs1 := LT.lt.trans hsr hr1;
  let_fun hslu := LT.lt.trans hs1 hu1;
  let_fun hsrho := ne_of_lt hsr;
  let_fun hrulu := ne_of_lt (LT.lt.trans hr1 hu1);
  let_fun hdet :=
    Eq.mpr
      (id
        (congrArg (fun _a => _a ≠ 0)
          (BfgsVerification.LBlockSplitting.characteristic_factorization hsroot huroot (ne_of_lt hslu) rho)))
      (mul_ne_zero (sub_ne_zero.mpr (Ne.symm hsrho)) (sub_ne_zero.mpr hrulu));
  Exists.casesOn (BfgsVerification.LBlockSplitting.scale_shape_exists k hdet) fun u h_1 =>
    Exists.casesOn h_1 fun v h_2 =>
      And.casesOn h_2 fun hue hve =>
        let vs := BfgsVerification.LBlockSplitting.shapeEigen rho⁻¹ a b p q ls;
        let vu := BfgsVerification.LBlockSplitting.shapeEigen rho⁻¹ a b p q lu;
        let vr := BfgsVerification.LBlockSplitting.scaleEigen rho⁻¹ rho u v p q h;
        let E :=
          BfgsVerification.LBlockSplitting.basisEquiv hb (sub_ne_zero.mpr (ne_of_gt hslu)) rfl rfl rfl rfl rfl rfl rfl;
        let A := BfgsVerification.LBlockSplitting.diagonalMap ![ls, rho];
        let_fun hd := fun i =>
          List.Mem.casesOn (motive := fun a x =>
            List.finRange (Nat.succ 2) = a → HEq (Fintype.complete i) x → ![rho⁻¹, rho⁻¹, lu] i ≠ 0)
            (Fintype.complete i)
            (fun as h =>
              List.noConfusion h fun head_eq =>
                Eq.ndrec (motive := fun i =>
                  ∀ (this : i ∈ Fintype.elems),
                    (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_of_lt (Nat.le_refl (Nat.succ 2))⟩
                          ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨2, Nat.le_refl (Nat.succ 2)⟩ []) =
                        as →
                      HEq this (List.Mem.head as) → ![rho⁻¹, rho⁻¹, lu] i ≠ 0)
                  (fun this tail_eq =>
                    Eq.ndrec (motive := fun as =>
                      HEq this (List.Mem.head as) →
                        ![rho⁻¹, rho⁻¹, lu] ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl (Nat.succ 2)))⟩) ≠
                          0)
                      (fun h =>
                        of_eq_true
                          (Eq.trans (congrArg Not (Eq.trans _proof_15✝ (eq_false (LT.lt.ne' hr0)))) not_false_eq_true))
                      tail_eq)
                  head_eq (Fintype.complete i))
            (fun b {as} a h =>
              List.noConfusion h fun head_eq =>
                Eq.ndrec (motive := fun b =>
                  (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_of_lt (Nat.le_refl (Nat.succ 2))⟩
                        ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨2, Nat.le_refl (Nat.succ 2)⟩ []) =
                      as →
                    HEq (Fintype.complete i) (List.Mem.tail b a) → ![rho⁻¹, rho⁻¹, lu] i ≠ 0)
                  (fun tail_eq =>
                    Eq.ndrec (motive := fun {as} =>
                      ∀ (a : List.Mem i as),
                        HEq (Fintype.complete i)
                            (List.Mem.tail ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl (Nat.succ 2)))⟩)
                              a) →
                          ![rho⁻¹, rho⁻¹, lu] i ≠ 0)
                      (fun a h =>
                        List.Mem.casesOn (motive := fun a_1 x => ⋯ → ⋯) a (fun as h => List.noConfusion h ⋯)
                          (fun b {as} a_1 => ⋯)
                          (Eq.refl
                            ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_of_lt (Nat.le_refl (Nat.succ 2))⟩
                              ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨2, Nat.le_refl (Nat.succ 2)⟩ [])))
                          (HEq.refl a))
                      tail_eq a)
                  head_eq)
            (Eq.refl (List.finRange (Nat.succ 2))) (HEq.refl (Fintype.complete i));
        let L := BfgsVerification.LBlockSplitting.diagonalEquiv ![rho⁻¹, rho⁻¹, lu] hd;
        Exists.intro E
          ⟨fun w => BfgsVerification.LBlockSplitting.basisMap_scale rfl rfl rfl w,
            Exists.intro A
              (Exists.intro L
                ⟨BfgsVerification.LBlockSplitting.stable_diagonal_contraction hs0 hs1 hr0 hr1,
                  ⟨BfgsVerification.LBlockSplitting.unstable_diagonal_inverse_contraction hr0 hr1 hu1 hd,
                    ContinuousLinearMap.ext fun w =>
                      BfgsVerification.LBlockSplitting.basis_diagonal
                        (BfgsVerification.LBlockSplitting.shape_eigen hF
                          (sub_ne_zero.mpr (ne_of_lt (LT.lt.trans hsr hra))) hsroot)
                        (BfgsVerification.LBlockSplitting.scale_eigen hF (sub_ne_zero.mpr (ne_of_lt hra)) hue hve)
                        (BfgsVerification.LBlockSplitting.shape_eigen hF (sub_ne_zero.mpr (ne_of_lt hua)) huroot)
                        (BfgsVerification.LBlockSplitting.block_point_zero hF)
                        (BfgsVerification.LBlockSplitting.block_point_one hF) w⟩⟩)⟩
theorem BfgsVerification.LBlockSplitting.positive_orbit_of_block : ∀
  {T : BfgsVerification.LBlockSplitting.State → BfgsVerification.LBlockSplitting.State}
  {P : BfgsVerification.LBlockSplitting.State}
  {F : BfgsVerification.LBlockSplitting.State →L[ℝ] BfgsVerification.LBlockSplitting.State},
  T P = P →
    HasStrictFDerivAt T F P →
      P 4 = 0 →
        ∀ {rho a b c d ls lu : ℝ} {p q h k : BfgsVerification.Vec 2},
          BfgsVerification.LBlockSplitting.BlockForm F rho⁻¹ rho a b c d p q h k →
            0 < rho →
              rho < 1 →
                0 < ls →
                  ls < rho →
                    1 < lu →
                      lu < rho⁻¹ →
                        b ≠ 0 →
                          (ls - a) * (ls - d) = b * c →
                            (lu - a) * (lu - d) = b * c →
                              ∀ V ∈ nhds P,
                                ∃ w,
                                  (∀ (n : ℕ), w n ∈ V) ∧
                                    Filter.Tendsto w Filter.atTop (nhds P) ∧
                                      0 < w 0 4 ∧ ∀ (n : ℕ), w (n + 1) = T (w n) :=
fun {T} {P} {F} hfix hderiv hP {rho a b c d ls lu} {p q h k} hF hr0 hr1 hs0 hsr hu1 hua hb hsroot huroot V hV =>
  Exists.casesOn (BfgsVerification.LBlockSplitting.block_splitting hF hr0 hr1 hs0 hsr hu1 hua hb hsroot huroot)
    fun E h =>
    And.casesOn h fun hscale right =>
      Exists.casesOn right fun A h =>
        Exists.casesOn h fun L h =>
          And.casesOn h fun hA right =>
            And.casesOn right fun hL hconj =>
              BfgsVerification.LBlockSplitting.positive_orbit_of_splitting hfix hderiv hP E hscale A L hA hL hconj V hV
def BfgsVerification.SpatialCanonicalWarningTarget : Prop :=
Matrix.PosDef BfgsVerification.SpatialQuadraticWarning.Q ∧
  ConvexOn ℝ Set.univ BfgsVerification.SpatialQuadraticWarning.objective ∧
    (∀ (N : WithTop ℕ∞), ContDiff ℝ N BfgsVerification.SpatialQuadraticWarning.objective) ∧
      (∀ (x : BfgsVerification.Vec 3),
          HasFDerivAt BfgsVerification.SpatialQuadraticWarning.objective
            (BfgsVerification.gradientFunctional (BfgsVerification.SpatialQuadraticWarning.gradient x)) x) ∧
        ∀ (ε : ℝ),
          0 < ε →
            ε < 1 / 10 →
              BfgsVerification.TransportedCertificate.EligiblePair BfgsVerification.SpatialQuadraticWarning.objective
                  (1 / 4) (1 / 2) BfgsVerification.SpatialQuadraticWarning.base
                  (BfgsVerification.SpatialQuadraticWarning.next ε)
                  (BfgsVerification.SpatialQuadraticWarning.gradient BfgsVerification.SpatialQuadraticWarning.base)
                  (BfgsVerification.SpatialQuadraticWarning.gradient
                    (BfgsVerification.SpatialQuadraticWarning.next ε)) ∧
                BfgsVerification.TransportedCertificate.pairDecrease BfgsVerification.SpatialQuadraticWarning.base
                      (BfgsVerification.SpatialQuadraticWarning.next ε)
                      (BfgsVerification.SpatialQuadraticWarning.gradient
                        BfgsVerification.SpatialQuadraticWarning.base) =
                    ε ^ 2 ∧
                  BfgsVerification.TransportedCertificate.pairCurvature BfgsVerification.SpatialQuadraticWarning.base
                        (BfgsVerification.SpatialQuadraticWarning.next ε)
                        (BfgsVerification.SpatialQuadraticWarning.gradient
                          BfgsVerification.SpatialQuadraticWarning.base)
                        (BfgsVerification.SpatialQuadraticWarning.gradient
                          (BfgsVerification.SpatialQuadraticWarning.next ε)) =
                      ε ^ 2 * (ε ^ 2 + 2 * ε + 4) / 3 ∧
                    Matrix.det
                          (BfgsVerification.SpatialQuadraticWarning.tripleColumns
                            (BfgsVerification.SpatialQuadraticWarning.gradient
                              BfgsVerification.SpatialQuadraticWarning.base)
                            (BfgsVerification.SpatialQuadraticWarning.step ε)
                            (BfgsVerification.SpatialQuadraticWarning.change ε)) =
                        4 / 3 * ε ^ 2 * (1 + ε) ∧
                      (∃ H,
                          Matrix.PosDef H ∧
                            BfgsVerification.bfgsStep H
                                  (BfgsVerification.SpatialQuadraticWarning.gradient
                                    BfgsVerification.SpatialQuadraticWarning.base)
                                  1 =
                                BfgsVerification.SpatialQuadraticWarning.step ε ∧
                              BfgsVerification.metricEnergy H
                                  (BfgsVerification.SpatialQuadraticWarning.gradient
                                    BfgsVerification.SpatialQuadraticWarning.base) =
                                ε ^ 2) ∧
                        (∀ (N : WithTop ℕ∞),
                            ContDiffAt ℝ N BfgsVerification.SpatialQuadraticWarning.canonicalField
                                BfgsVerification.SpatialQuadraticWarning.base ∧
                              ContDiffAt ℝ N BfgsVerification.SpatialQuadraticWarning.canonicalField
                                (BfgsVerification.SpatialQuadraticWarning.next ε)) ∧
                          (BfgsVerification.dot
                                  (BfgsVerification.SpatialQuadraticWarning.gradient
                                    BfgsVerification.SpatialQuadraticWarning.base)
                                  (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                    BfgsVerification.SpatialQuadraticWarning.base) =
                                1 ∧
                              BfgsVerification.dot
                                  (BfgsVerification.SpatialQuadraticWarning.gradient
                                    (BfgsVerification.SpatialQuadraticWarning.next ε))
                                  (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                    (BfgsVerification.SpatialQuadraticWarning.next ε)) =
                                1) ∧
                            BfgsVerification.SpatialQuadraticWarning.canonicalField
                                  (BfgsVerification.SpatialQuadraticWarning.next ε) ∉
                                Submodule.span ℝ
                                  {BfgsVerification.SpatialQuadraticWarning.canonicalField
                                      BfgsVerification.SpatialQuadraticWarning.base,
                                    BfgsVerification.SpatialQuadraticWarning.step ε} ∧
                              ∀ (a : ℝ),
                                ¬(a •
                                        (BfgsVerification.TransportedCertificate.stepProjector
                                              (BfgsVerification.SpatialQuadraticWarning.step ε) *
                                            BfgsVerification.outer
                                              (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                                BfgsVerification.SpatialQuadraticWarning.base)
                                              (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                                BfgsVerification.SpatialQuadraticWarning.base) *
                                          BfgsVerification.TransportedCertificate.stepProjector
                                            (BfgsVerification.SpatialQuadraticWarning.step ε)) -
                                      BfgsVerification.TransportedCertificate.stepProjector
                                            (BfgsVerification.SpatialQuadraticWarning.step ε) *
                                          BfgsVerification.outer
                                            (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                              (BfgsVerification.SpatialQuadraticWarning.next ε))
                                            (BfgsVerification.SpatialQuadraticWarning.canonicalField
                                              (BfgsVerification.SpatialQuadraticWarning.next ε)) *
                                        BfgsVerification.TransportedCertificate.stepProjector
                                          (BfgsVerification.SpatialQuadraticWarning.step ε)).PosSemidef
