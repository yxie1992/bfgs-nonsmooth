BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.finite_sample_identity_certificate","signature":"∀ {n r : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ},\n  c₂ < 1 →\n    ∀ (x g : Fin r → BfgsVerification.Vec n),\n      (∀ (i : Fin r), g i ≠ 0) →\n        ∀ (P : Finset (Fin r × Fin r)),\n          (∀ p ∈ P, BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ (x p.1) (x p.2) (g p.1) (g p.2)) →\n            ∃ m C,\n              Matrix.PosSemidef 1 ∧\n                0 < m ∧\n                  0 ≤ C ∧\n                    (∀ (i : Fin r), m ≤ BfgsVerification.metricEnergy 1 (g i)) ∧\n                      (∀ p ∈ P,\n                          BfgsVerification.metricEnergy 1 (g p.2 - g p.1) ≤\n                            C * BfgsVerification.TransportedCertificate.pairCurvature (x p.1) (x p.2) (g p.1) (g p.2)) ∧\n                        ∀ (s : BfgsVerification.Vec n),\n                          (BfgsVerification.TransportedCertificate.stepProjector s * 1 *\n                                Matrix.transpose (BfgsVerification.TransportedCertificate.stepProjector s) -\n                              BfgsVerification.TransportedCertificate.stepProjector s * 1 *\n                                Matrix.transpose (BfgsVerification.TransportedCertificate.stepProjector s)).PosSemidef","axioms":["propext","Quot.sound","Classical.choice"]}
