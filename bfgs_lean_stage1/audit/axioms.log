def BfgsVerification.argmin.{u_1} : {E : Type u_1} → (E → ℝ) → Set E :=
fun {E} F => {x | ∀ (y : E), F x ≤ F y}
def BfgsVerification.euclideanVector : {n : ℕ} → BfgsVerification.Vec n → EuclideanSpace ℝ (Fin n) :=
fun {n} => ⇑(WithLp.equiv 2 (BfgsVerification.Vec n)).symm
def BfgsVerification.euclideanSolutionDistance : {n : ℕ} → (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → ℝ :=
fun {n} F x =>
  Metric.infDist (BfgsVerification.euclideanVector x) (BfgsVerification.euclideanVector '' BfgsVerification.argmin F)
