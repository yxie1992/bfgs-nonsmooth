BFGS_AUDIT {"theorem":"BfgsVerification.SeedEmbedding.trial_predicates","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {p : BfgsVerification.Vec 2} {t A : ℝ},\n  BfgsVerification.SeedEmbedding.OracleData F p t A →\n    0 < t →\n      ∀ (k : ℕ) (q : Fin 9),\n        BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n          ∀ (c₁ c₂ : ℝ),\n            (BfgsVerification.DeterministicLineSearch.Armijo F (BfgsVerification.SeedEmbedding.point p t k)\n                  (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                    (BfgsVerification.SeedEmbedding.gradient t k) 1)\n                  (BfgsVerification.SeedEmbedding.gradient t k) c₁ (BfgsVerification.SeedOrbit.trialLength q) ↔\n                BfgsVerification.DeterministicLineSearch.Armijo\n                  (BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC\n                    BfgsVerification.SeedOrbit.seedD)\n                  (BfgsVerification.SeedOrbit.orbitPoint k)\n                  (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                    (BfgsVerification.SeedOrbit.orbitGradient k) 1)\n                  (BfgsVerification.SeedOrbit.orbitGradient k) c₁ (BfgsVerification.SeedOrbit.trialLength q)) ∧\n              (BfgsVerification.DeterministicLineSearch.Wolfe F (BfgsVerification.SeedEmbedding.point p t k)\n                  (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                    (BfgsVerification.SeedEmbedding.gradient t k) 1)\n                  (BfgsVerification.SeedEmbedding.gradient t k) c₂ (BfgsVerification.SeedOrbit.trialLength q) ↔\n                BfgsVerification.DeterministicLineSearch.Wolfe\n                  (BfgsVerification.SeedOrbit.objective BfgsVerification.SeedOrbit.seedC\n                    BfgsVerification.SeedOrbit.seedD)\n                  (BfgsVerification.SeedOrbit.orbitPoint k)\n                  (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                    (BfgsVerification.SeedOrbit.orbitGradient k) 1)\n                  (BfgsVerification.SeedOrbit.orbitGradient k) c₂ (BfgsVerification.SeedOrbit.trialLength q))","axioms":["propext","Classical.choice","Quot.sound"]}
