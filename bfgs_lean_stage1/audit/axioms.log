BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.correction","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ),\n  self.J ≤ k → BfgsVerification.sqNorm ((self.V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ self.C","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.injEq","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r p : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ) (orthonormal : U.transpose * U = 1) (L m C₀ C_T C_R : ℝ) (m_pos : 0 < m)\n  (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p) (b : ℕ → BfgsVerification.Vec p)\n  (smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k)\n  (visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k)))\n  (correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k)\n  (transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k)\n  (operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k))\n  (residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k)\n  (residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) (J_1 r_1 p_1 : ℕ)\n  (U_1 : Matrix (Fin n) (Fin r_1) ℝ) (orthonormal_1 : U_1.transpose * U_1 = 1) (L_1 m_1 C₀_1 C_T_1 C_R_1 : ℝ)\n  (m_pos_1 : 0 < m_1) (V_1 Z_1 : ℕ → Matrix (Fin n) (Fin p_1) ℝ) (T_1 : ℕ → BfgsVerification.Mat p_1)\n  (b_1 : ℕ → BfgsVerification.Vec p_1)\n  (smooth_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U_1.transpose.mulVec ((R.shift J_1).gradientChange k)) ≤ L_1 * (R.shift J_1).curvature k)\n  (visible_1 : ∀ (k : ℕ), m_1 ≤ BfgsVerification.sqNorm ((V_1 k).transpose.mulVec ((R.shift J_1).g k)))\n  (correction_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V_1 (k + 1)).transpose.mulVec ((R.shift J_1).gradientChange k)) ≤\n        C₀_1 * (R.shift J_1).curvature k)\n  (transport_1 :\n    ∀ (k : ℕ),\n      V_1 (k + 1) =\n        V_1 k * T_1 k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J_1).displacement k) (b_1 k) + Z_1 k)\n  (operator_bound_1 : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T_1 k) (1 + C_T_1 * (R.shift J_1).d k))\n  (residual_range_1 : ∀ (k : ℕ), U_1 * U_1.transpose * Z_1 k = Z_1 k)\n  (residual_size_1 : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z_1 k) ≤ C_R_1 * (R.shift J_1).d k),\n  ({ J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n      { J := J_1, r := r_1, p := p_1, U := U_1, orthonormal := orthonormal_1, L := L_1, m := m_1, C₀ := C₀_1,\n        C_T := C_T_1, C_R := C_R_1, m_pos := m_pos_1, V := V_1, Z := Z_1, T := T_1, b := b_1, smooth := smooth_1,\n        visible := visible_1, correction := correction_1, transport := transport_1, operator_bound := operator_bound_1,\n        residual_range := residual_range_1, residual_size := residual_size_1 }) =\n    (J = J_1 ∧\n      r = r_1 ∧\n        p = p_1 ∧\n          HEq U U_1 ∧\n            L = L_1 ∧ m = m_1 ∧ C₀ = C₀_1 ∧ C_T = C_T_1 ∧ C_R = C_R_1 ∧ HEq V V_1 ∧ HEq Z Z_1 ∧ HEq T T_1 ∧ HEq b b_1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.det_rank_two._proof_1","signature":"∀ {ι : Type u_1} {α : Type u_3} [inst : NonUnitalNonAssocSemiring α] (s : Finset ι) (f : ι → α) (a : α),\n  ∑ i ∈ s, a * f i = a * ∑ i ∈ s, f i","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_step_det","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (g y : BfgsVerification.Vec n) (α : ℝ),\n      BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) ≠ 0 →\n        Matrix.det (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y) =\n          α ^ 2 * BfgsVerification.metricEnergy H g / BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) *\n            Matrix.det H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.trace_pos_of_posDef","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n}, Matrix.PosDef H → 0 < n → 0 < Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.inverse_dot_symm","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n),\n  Matrix.IsSymm A →\n    ∀ (a b : BfgsVerification.Vec n),\n      BfgsVerification.dot b (Matrix.mulVec A⁻¹ a) = BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append","signature":"∀ {n : ℕ} {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [inst_2 : DecidableEq ι]\n  [inst_3 : DecidableEq κ] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (Y : Matrix (Fin n) ι ℝ) (Z : Matrix (Fin n) κ ℝ),\n      Function.Injective Z.mulVec →\n        (BfgsVerification.metricGram H (Y.fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricGram H Y -\n                Y.transpose * H * Z * (BfgsVerification.metricGram H Z)⁻¹ * (Z.transpose * H * Y)).det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.finiteHorizon_of_principalMinorHierarchy","signature":"BfgsVerification.PrincipalMinorHierarchyTarget →\n  ∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n    0 < G →\n      0 < c →\n        (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n          (∀ (k : ℕ), c ≤ R.beta k) →\n            Summable R.d →\n              ∀ (J m : ℕ),\n                0 < m →\n                  ∀ (η : ℝ),\n                    0 < η →\n                      let D := ∑' (i : ℕ), R.d (J + i);\n                      let V :=\n                        BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                          (BfgsVerification.principalSum (R.H J));\n                      ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                        ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.annihilated_hessian_mul_displacement","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  Matrix.mulVec (R.hessian k - (R.q k)⁻¹ • BfgsVerification.outer (R.g k) (R.g k)) (R.displacement k) = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_potentials_force_log_growth","signature":"∀ (q : ℕ → ℝ) (C : ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    0 < C →\n      (∀ (A : ℝ),\n          0 < A →\n            ∃ J V, (∀ (k : ℕ), 0 < V k) ∧ (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) ∧ ∀ (k : ℕ), q k ≤ C * V k) →\n        Filter.Tendsto (BfgsVerification.ReciprocalGrowth.logReciprocalMean q) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
