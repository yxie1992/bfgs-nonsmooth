BFGS_AUDIT {"theorem":"BfgsVerification.DScalar.positive_small_bounds","signature":"∀ {b x : ℝ},\n  2 ≤ b →\n    b ≤ 34 →\n      0 < x →\n        x ≤ b →\n          0 ≤ BfgsVerification.DScalar.phi b x ∧\n            BfgsVerification.DScalar.phi b x ≤ (x / (b * BfgsVerification.DScalarGeometric.theta)) ^ 3 ∧\n              0 ≤ BfgsVerification.DScalar.phiFirst b x ∧\n                BfgsVerification.DScalar.phiFirst b x ≤ (x / (b * BfgsVerification.DScalarGeometric.theta)) ^ 2 ∧\n                  0 ≤ BfgsVerification.DScalar.phiSecond b x ∧\n                    BfgsVerification.DScalar.phiSecond b x ≤\n                      102 / b * (x / (b * BfgsVerification.DScalarGeometric.theta))","axioms":["propext","Classical.choice","Quot.sound"]}
