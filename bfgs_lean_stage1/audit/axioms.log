BFGS_AUDIT {"theorem":"BfgsVerification.DScalar.upper_threshold_identity","signature":"∀ (b : ℝ) (n : ℕ),\n  b * BfgsVerification.DScalarGeometric.scale n *\n      (BfgsVerification.DScalarGeometric.theta +\n        (1 - BfgsVerification.DScalarGeometric.theta) *\n          (BfgsVerification.DScalarRamp.center b - BfgsVerification.DScalarRamp.epsilon)) =\n    (b + BfgsVerification.DScalarRamp.upperLength b) * BfgsVerification.DScalarGeometric.scale (n + 1)","axioms":["propext","Classical.choice","Quot.sound"]}
