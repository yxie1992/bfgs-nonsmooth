BFGS_AUDIT {"theorem":"BfgsVerification.annihilatedMatrix_projection","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g =\n          (1 - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g (Matrix.mulVec H g)) * H⁻¹ *\n            (1 - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g (Matrix.mulVec H g)).transpose","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.projection_fixed_iff","signature":"∀ {n r : ℕ} (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 → ∀ (v : BfgsVerification.Vec n), (U * U.transpose).mulVec v = v ↔ ∃ a, U.mulVec a = v","axioms":["propext","Quot.sound","Classical.choice"]}
