BFGS_AUDIT {"theorem":"BfgsVerification.AffineWhitening.uniform_locality","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (hA : Matrix.det A ≠ 0) {F : BfgsVerification.Vec n → ℝ}\n  (R : ℕ → BfgsVerification.AdmissibleBFGSRun n F) {ι : Type u_1} (length : ι → ℝ) (allowed : ℕ → ι → Prop),\n  (∀ U ∈ nhds 0,\n      ∃ N,\n        ∀ m ≥ N,\n          ∀ (k : ℕ),\n            (R m).x k ∈ U ∧\n              ∀ (q : ι), allowed k q → (R m).x k + length q • BfgsVerification.bfgsStep ((R m).H k) ((R m).g k) 1 ∈ U) →\n    ∀ U ∈ nhds 0,\n      ∃ N,\n        ∀ m ≥ N,\n          ∀ (k : ℕ),\n            (BfgsVerification.AffineWhitening.run A hA (R m)).x k ∈ U ∧\n              ∀ (q : ι),\n                allowed k q →\n                  (BfgsVerification.AffineWhitening.run A hA (R m)).x k +\n                      length q •\n                        BfgsVerification.bfgsStep ((BfgsVerification.AffineWhitening.run A hA (R m)).H k)\n                          ((BfgsVerification.AffineWhitening.run A hA (R m)).g k) 1 ∈\n                    U","axioms":["propext","Classical.choice","Quot.sound"]}
