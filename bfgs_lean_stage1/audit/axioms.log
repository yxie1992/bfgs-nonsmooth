BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.nonzero_fiber_root_stratum_chart","signature":"∀ {n : ℕ} (p : MvPolynomial (Option (Fin n)) ℝ) (a : BfgsVerification.Vec n) (b : ℝ),\n  BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p a ≠ 0 →\n    Polynomial.eval b (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p a) = 0 →\n      ∃ m,\n        m = Polynomial.rootMultiplicity b (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p a) ∧\n          0 < m ∧\n            m ≤ MvPolynomial.degreeOf none p ∧\n              ∃ g r δ,\n                0 < r ∧\n                  0 < δ ∧\n                    g a = b ∧\n                      ContDiffOn ℝ (↑⊤) g (Metric.ball a r) ∧\n                        (∀ x ∈ Metric.ball a r,\n                            dist (g x) b < δ ∧\n                              ∀ (t : ℝ),\n                                dist t b < δ →\n                                  (BfgsVerification.RealAlgebraicGeometry.parameterEval\n                                        (BfgsVerification.RealAlgebraicGeometry.verticalDerivative p (m - 1)) (x, t) =\n                                      0 ↔\n                                    t = g x)) ∧\n                          (∀ x ∈ Metric.ball a r,\n                              ∀ (t : ℝ),\n                                dist t b < δ →\n                                  BfgsVerification.RealAlgebraicGeometry.parameterPoint x t ∈\n                                      BfgsVerification.RealAlgebraicGeometry.multiplicityStratum p m →\n                                    t = g x) ∧\n                            BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n                              {v | (fun i => v (some i)) ∈ Metric.ball a r ∧ v none = g fun i => v (some i)}","axioms":["propext","Classical.choice","Quot.sound"]}
