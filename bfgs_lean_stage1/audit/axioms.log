BFGS_AUDIT {"theorem":"BfgsVerification.AffineWhitening.hessian_bounds_whitening","signature":"∀ {n : ℕ} [inst : NeZero n] (H : BfgsVerification.Mat n) (hH : Matrix.PosDef H) (F : BfgsVerification.Vec n → ℝ)\n  (x : BfgsVerification.Vec n),\n  DifferentiableAt ℝ (fderiv ℝ F) (Matrix.mulVec (BfgsVerification.AffineWhitening.squareRoot H hH) x) →\n    ∀ (μ L : ℝ),\n      0 ≤ μ →\n        0 ≤ L →\n          (∀ (v : BfgsVerification.Vec n),\n              μ * BfgsVerification.sqNorm v ≤\n                  BfgsVerification.metricEnergy\n                    (BfgsVerification.RadialHessian.matrix F\n                      (Matrix.mulVec (BfgsVerification.AffineWhitening.squareRoot H hH) x))\n                    v ∧\n                BfgsVerification.metricEnergy\n                    (BfgsVerification.RadialHessian.matrix F\n                      (Matrix.mulVec (BfgsVerification.AffineWhitening.squareRoot H hH) x))\n                    v ≤\n                  L * BfgsVerification.sqNorm v) →\n            ∀ (v : BfgsVerification.Vec n),\n              μ * BfgsVerification.AffineWhitening.minEigenvalue H ⋯ * BfgsVerification.sqNorm v ≤\n                  BfgsVerification.metricEnergy\n                    (BfgsVerification.RadialHessian.matrix\n                      (BfgsVerification.AffineWhitening.objective (BfgsVerification.AffineWhitening.squareRoot H hH) F)\n                      x)\n                    v ∧\n                BfgsVerification.metricEnergy\n                    (BfgsVerification.RadialHessian.matrix\n                      (BfgsVerification.AffineWhitening.objective (BfgsVerification.AffineWhitening.squareRoot H hH) F)\n                      x)\n                    v ≤\n                  L * BfgsVerification.AffineWhitening.maxEigenvalue H ⋯ * BfgsVerification.sqNorm v","axioms":["propext","Classical.choice","Quot.sound"]}
