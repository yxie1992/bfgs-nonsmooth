BFGS_AUDIT {"theorem":"BfgsVerification.ParabolicRadialBoundary.radial_quotient","signature":"∀ (u ε : ℝ),\n  BfgsVerification.RadialCertificate.radialNumerator 0 (BfgsVerification.ParabolicRadialBoundary.newPoint u ε)\n          (BfgsVerification.ParabolicRadialBoundary.oldGradient u)\n          (BfgsVerification.ParabolicRadialBoundary.newGradient u) ^\n        2 /\n      BfgsVerification.TransportedCertificate.pairCurvature (BfgsVerification.ParabolicRadialBoundary.oldPoint u ε)\n        (BfgsVerification.ParabolicRadialBoundary.newPoint u ε) (BfgsVerification.ParabolicRadialBoundary.oldGradient u)\n        (BfgsVerification.ParabolicRadialBoundary.newGradient u) =\n    (u ^ 2 - ε) ^ 2 / (3 * ε)","axioms":["propext","Classical.choice","Quot.sound"]}
