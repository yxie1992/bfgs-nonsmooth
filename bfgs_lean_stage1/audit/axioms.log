BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.reciprocal_sum_ge_exp","signature":"∀ (q : ℕ → ℝ) (m : ℕ) (L : ℝ),\n  0 < m →\n    (∀ (i : ℕ), 0 < q i) →\n      ∑ i ∈ Finset.range m, Real.log (q i) ≤ L → ↑m * Real.exp (-L / ↑m) ≤ ∑ i ∈ Finset.range m, (q i)⁻¹","axioms":["propext","Quot.sound","Classical.choice"]}
