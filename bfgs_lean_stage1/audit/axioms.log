BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.curvature","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec n},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    (1 - c₂) * BfgsVerification.TransportedCertificate.pairDecrease x z g ≤\n      BfgsVerification.TransportedCertificate.pairCurvature x z g h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frame_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (k : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (V W Z : Matrix (Fin n) (Fin p) ℝ) (T : BfgsVerification.Mat p) (b : BfgsVerification.Vec p)\n          (m C₀ C_T C_R : ℝ),\n          0 ≤ C_T →\n            m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)) →\n              BfgsVerification.sqNorm (W.transpose.mulVec (R.gradientChange k)) ≤ C₀ * R.curvature k →\n                W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b + Z →\n                  BfgsVerification.FrameBounds.OperatorSqBound T (1 + C_T * R.d k) →\n                    U * U.transpose * Z = Z →\n                      BfgsVerification.SmoothSubspace.frobSq Z ≤ C_R * R.d k →\n                        (BfgsVerification.metricGram (R.hessian (k + 1)) W).trace ≤\n                          (1 + R.d k) * (1 + C_T * R.d k) *\n                                ((BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k) +\n                              (1 + (R.d k)⁻¹) *\n                                (C_R * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)) +\n                            C₀","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.outer_mulVec","signature":"∀ {n : ℕ} (u v x : BfgsVerification.Vec n), Matrix.mulVec (BfgsVerification.outer u v) x = BfgsVerification.dot v x • u","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.scalar_curvature","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec 1},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    c₂ < 1 → 0 < |h 0 - g 0| ∧ BfgsVerification.TransportedCertificate.pairCurvature x z g h = |h 0 - g 0| * |z 0 - x 0|","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.projected_transport_iff_perpendicular","signature":"∀ {n : ℕ} (W Z : BfgsVerification.Mat n),\n  Matrix.IsSymm W →\n    Matrix.IsSymm Z →\n      ∀ (s : BfgsVerification.Vec n) (a : ℝ),\n        (a •\n                (BfgsVerification.TransportedCertificate.stepProjector s * W *\n                  BfgsVerification.TransportedCertificate.stepProjector s) -\n              BfgsVerification.TransportedCertificate.stepProjector s * Z *\n                BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef ↔\n          ∀ (v : BfgsVerification.Vec n),\n            BfgsVerification.dot v s = 0 → BfgsVerification.metricEnergy Z v ≤ a * BfgsVerification.metricEnergy W v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.PotentialBandCertificate.positive_semidefinite","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.PotentialBandCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    DifferentiableAt ℝ F x → Matrix.PosSemidef (self.W x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Homogeneous.tiltedSlope.eq_1","signature":"∀ {n : ℕ} (b : BfgsVerification.Vec n), BfgsVerification.Homogeneous.tiltedSlope b = Fin.cons 1 b","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.hessianUpdate","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (y : BfgsVerification.Vec n) {α : ℝ},\n          0 < α →\n            0 < BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) →\n              (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y)⁻¹ =\n                H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g +\n                  (BfgsVerification.dot y (BfgsVerification.bfgsStep H g α))⁻¹ • BfgsVerification.outer y y","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.compact_sqNorm_radius","signature":"∀ {n : ℕ} {K : Set (BfgsVerification.Vec n)},\n  IsCompact K → ∀ (star : BfgsVerification.Vec n), ∃ R, 0 < R ∧ ∀ x ∈ K, BfgsVerification.sqNorm (x - star) ≤ R ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.weak_wolfe","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  self.c₂ * BfgsVerification.dot (self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k)) ≤\n    BfgsVerification.dot (self.g (k + 1)) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
