BFGS_AUDIT {"theorem":"BfgsVerification.CenteredSmoothSublinear.bregman_lower_of_descent","signature":"∀ {n : ℕ} (ψ : BfgsVerification.Vec n → ℝ) (p q x y : BfgsVerification.Vec n) (L : ℝ),\n  0 < L →\n    BfgsVerification.dot p (y - L⁻¹ • (q - p) - x) ≤ ψ (y - L⁻¹ • (q - p)) - ψ x →\n      ψ (y - L⁻¹ • (q - p)) - ψ y - BfgsVerification.dot q (-L⁻¹ • (q - p)) ≤\n          L / 2 * BfgsVerification.sqNorm (-L⁻¹ • (q - p)) →\n        BfgsVerification.sqNorm (q - p) ≤ 2 * L * (ψ y - ψ x - BfgsVerification.dot p (y - x))","axioms":["propext","Classical.choice","Quot.sound"]}
