def BfgsVerification.DScalar.phi : ℝ → ℝ → ℝ :=
fun b x => BfgsVerification.DScalar.positivePart b x + BfgsVerification.DScalarNegative.negative x
def BfgsVerification.DScalar.positivePart : ℝ → ℝ → ℝ :=
fun b x => ∑' (n : ℕ), BfgsVerification.DScalar.component b n x
def BfgsVerification.DScalar.component : ℝ → ℕ → ℝ → ℝ :=
fun b n x =>
  b * BfgsVerification.DScalarGeometric.scale n ^ 3 * (1 - BfgsVerification.DScalarGeometric.theta) *
      (1 - BfgsVerification.DScalarGeometric.theta ^ 2) *
    BfgsVerification.DScalarRamp.primitive b
      (BfgsVerification.DScalarGeometric.coordinate b (BfgsVerification.DScalarGeometric.scale n) x)
def BfgsVerification.DScalarRamp.primitive : ℝ → ℝ → ℝ :=
fun b x =>
  2 * BfgsVerification.DScalarRamp.epsilon *
    BfgsVerification.DScalarRamp.unitPrimitive (BfgsVerification.DScalarRamp.rampCoordinate b x)
def BfgsVerification.DScalarNegative.negative : ℝ → ℝ :=
BfgsVerification.DScalarRamp.join 0
  (BfgsVerification.DScalarRamp.join (-1) BfgsVerification.DScalarNegative.quadratic fun x => -x ^ 3) fun x => 0
def BfgsVerification.CenteredSpectral.objective : {m n : ℕ} → BfgsVerification.Vec (m * n) → ℝ :=
fun {m n} x => ‖BfgsVerification.CenteredSpectral.matrix x‖
def BfgsVerification.CenteredSpectral.matrix : {m n : ℕ} → BfgsVerification.Vec (m * n) → Matrix (Fin m) (Fin n) ℝ :=
fun {m n} x i j => x (finProdFinEquiv (i, j))
def BfgsVerification.NormalSpike.sourcePrimitive : ℝ → ℝ :=
fun v => if 0 < v then ∫ (t : ℝ) in 0 ..v, (v - t) * BfgsVerification.NormalSpike.density t else 0
def BfgsVerification.NormalSpike.objective : {n : ℕ} → BfgsVerification.Vec n → BfgsVerification.Vec n → ℝ :=
fun {n} a x =>
  BfgsVerification.NormalSpike.quadratic x + BfgsVerification.NormalSpike.normalPenalty (BfgsVerification.dot a x)

