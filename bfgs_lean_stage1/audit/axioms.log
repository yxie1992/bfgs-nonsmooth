BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.referenceCorrection_nonneg","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n)\n  (k : ℕ), 0 ≤ R.referenceCorrection xstar k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.outer_transpose","signature":"∀ {n : ℕ} (u v : BfgsVerification.Vec n), Matrix.transpose (BfgsVerification.outer u v) = BfgsVerification.outer v u","axioms":["propext","Quot.sound","Classical.choice"]}
