BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.projected_subspace_accepted_identities","signature":"∀ {n r : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (A : Matrix (Fin r) (Fin n) ℝ),\n  BfgsVerification.AffineProjection.FullRowRank A →\n    ∀ (gbar : ℕ → BfgsVerification.Vec r),\n      (∀ (k : ℕ), A.transpose.mulVec (gbar k) = R.g k) →\n        ∀ (k : ℕ),\n          Matrix.PosDef (BfgsVerification.AffineProjection.compress A (R.H k)) ∧\n            A.mulVec (R.x (k + 1)) =\n                A.mulVec (R.x k) +\n                  BfgsVerification.bfgsStep (BfgsVerification.AffineProjection.compress A (R.H k)) (gbar k) (R.α k) ∧\n              F (R.x (k + 1)) ≤\n                  F (R.x k) +\n                    R.c₁ *\n                      BfgsVerification.dot (gbar k)\n                        (BfgsVerification.bfgsStep (BfgsVerification.AffineProjection.compress A (R.H k)) (gbar k)\n                          (R.α k)) ∧\n                R.c₂ *\n                    BfgsVerification.dot (gbar k)\n                      (BfgsVerification.bfgsStep (BfgsVerification.AffineProjection.compress A (R.H k)) (gbar k)\n                        (R.α k)) ≤\n                  BfgsVerification.dot (gbar (k + 1))\n                    (BfgsVerification.bfgsStep (BfgsVerification.AffineProjection.compress A (R.H k)) (gbar k) (R.α k))","axioms":["propext","Classical.choice","Quot.sound"]}
