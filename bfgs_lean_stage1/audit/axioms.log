BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.quadratic_forall_nonpositive_semialgebraic","signature":"∀ {σ : Type u_1} [inst : Finite σ] (a b c : MvPolynomial σ ℝ),\n  BfgsVerification.RealAlgebraicGeometry.IsSemialgebraic\n    {x |\n      ∀ (t : ℝ),\n        BfgsVerification.RealAlgebraicGeometry.quadraticValue ((MvPolynomial.eval x) a) ((MvPolynomial.eval x) b)\n            ((MvPolynomial.eval x) c) t ≤\n          0}","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ k ∈ Finset.range (m + 1), Real.log (q (J + k)) ≤ Real.log C + Real.log (V J) + ↑m * Real.log A","axioms":["propext","Classical.choice","Quot.sound"]}
