          ∃ xstar,
            Filter.Tendsto R.x Filter.atTop (nhds xstar) ∧ BfgsVerification.Homogeneous.finiteMaxLinear A hA xstar = 0
@BfgsVerification.AdmissibleBFGSRun.maxLinear_relativeInterior_complete : ∀ {n r : ℕ}
  (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)
  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA)),
  BfgsVerification.Homogeneous.RelativeInteriorZero A →
    ∀ (U : Matrix (Fin n) (Fin r) ℝ),
      U.transpose * U = 1 →
        (∀ (x : BfgsVerification.Vec n), x ∈ Submodule.span ℝ ↑A ↔ ∃ z, U.mulVec z = x) →
          Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) ∧
            Filter.Tendsto R.x Filter.atTop
                (nhds (BfgsVerification.AffineProjection.fiberPoint U.transpose (R.H 0) (R.x 0) 0)) ∧
              BfgsVerification.Homogeneous.finiteMaxLinear A hA
                    (BfgsVerification.AffineProjection.fiberPoint U.transpose (R.H 0) (R.x 0) 0) =
                  0 ∧
                (∀ (x : BfgsVerification.Vec n),
                    BfgsVerification.Homogeneous.finiteMaxLinear A hA x = 0 ↔ U.transpose.mulVec x = 0) ∧
                  ∀ (x : BfgsVerification.Vec n),
                    BfgsVerification.Homogeneous.finiteMaxLinear A hA x = 0 →
                      BfgsVerification.metricEnergy (R.H 0)⁻¹
                            (BfgsVerification.AffineProjection.fiberPoint U.transpose (R.H 0) (R.x 0) 0 - R.x 0) ≤
                          BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) ∧
                        (BfgsVerification.metricEnergy (R.H 0)⁻¹ (x - R.x 0) =
                            BfgsVerification.metricEnergy (R.H 0)⁻¹
                              (BfgsVerification.AffineProjection.fiberPoint U.transpose (R.H 0) (R.x 0) 0 - R.x 0) ↔
                          x = BfgsVerification.AffineProjection.fiberPoint U.transpose (R.H 0) (R.x 0) 0)
@BfgsVerification.AdmissibleBFGSRun.maxLinear_recurrent_relativeInterior_convergence : ∀ {n r : ℕ}
  (A B : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty),
  B.Nonempty →
