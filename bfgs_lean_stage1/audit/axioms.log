BFGS_AUDIT {"theorem":"BfgsVerification.SeedEmbedding.NonStrict.trial_accept","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {p : BfgsVerification.Vec 2} {t A c₁ c₂ : ℝ},\n  BfgsVerification.SeedEmbedding.OracleData F p t A →\n    0 < t →\n      0 < c₁ →\n        c₁ ≤ 1 / 3 →\n          0 < c₂ →\n            ∀ (k : ℕ) (q : Fin 9),\n              BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →\n                BfgsVerification.SeedOrbit.trialAccept q = true →\n                  BfgsVerification.NonStrictLineSearch.Armijo F (BfgsVerification.SeedEmbedding.point p t k)\n                      (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                        (BfgsVerification.SeedEmbedding.gradient t k) 1)\n                      (BfgsVerification.SeedEmbedding.gradient t k) c₁ (BfgsVerification.SeedOrbit.trialLength q) ∧\n                    BfgsVerification.NonStrictLineSearch.Wolfe F (BfgsVerification.SeedEmbedding.point p t k)\n                      (BfgsVerification.bfgsStep (BfgsVerification.SeedOrbit.orbitMetric k)\n                        (BfgsVerification.SeedEmbedding.gradient t k) 1)\n                      (BfgsVerification.SeedEmbedding.gradient t k) c₂ (BfgsVerification.SeedOrbit.trialLength q)","axioms":["propext","Classical.choice","Quot.sound"]}
