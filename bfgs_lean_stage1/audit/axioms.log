BFGS_AUDIT {"theorem":"BfgsVerification.DScalar.positiveSlope_interval","signature":"∀ {b x : ℝ},\n  2 ≤ b →\n    b ≤ 34 →\n      ∀ (m : ℕ),\n        b * BfgsVerification.DScalarGeometric.theta * BfgsVerification.DScalarGeometric.scale m ≤ x →\n          x ≤ b * BfgsVerification.DScalarGeometric.scale m →\n            BfgsVerification.DScalar.positiveSlope b x =\n              BfgsVerification.DScalarGeometric.scale m ^ 2 *\n                (BfgsVerification.DScalarGeometric.theta ^ 2 +\n                  (1 - BfgsVerification.DScalarGeometric.theta ^ 2) *\n                    BfgsVerification.DScalarRamp.ramp b\n                      (BfgsVerification.DScalarGeometric.coordinate b (BfgsVerification.DScalarGeometric.scale m) x))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.local_parallel_interfaces_convergence_basin","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n        (∀ (z : BfgsVerification.Vec n), F z = F star → z = star) →\n          ∀ {Ω : Set (BfgsVerification.Vec n)},\n            IsOpen Ω →\n              star ∈ Ω →\n                ∀ {μ : ℝ},\n                  0 < μ →\n                    BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n                      ∀ {a : BfgsVerification.Vec n},\n                        BfgsVerification.sqNorm a = 1 →\n                          ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n                            (∀ x ∈ Ω,\n                                ∀ (g : BfgsVerification.Vec n),\n                                  BfgsVerification.Homogeneous.Supports F x g →\n                                    BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n                              ∀ {L : NNReal},\n                                LipschitzOnWith L A Ω →\n                                  ∀ {E : Set ℝ},\n                                    IsClosed E →\n                                      BfgsVerification.CenteredSmoothSublinear.LocallyC11On\n                                          (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →\n                                        (∀ p ∈ Ω,\n                                            BfgsVerification.FixedNormal.normalCoordinate a b p ∈ E →\n                                              ¬DifferentiableAt ℝ F p) →\n                                          (∀ p ∈ Ω,\n                                              0 ∈\n                                                  affineSpan ℝ\n                                                    (BfgsVerification.ConvexSubdifferential.subdifferential F p) →\n                                                BfgsVerification.Homogeneous.Supports F p 0) →\n                                            ∃ ε,\n                                              0 < ε ∧\n                                                ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                                                  F (R.x 0) < F star + ε →\n                                                    Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                                      Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Quot.sound","Classical.choice"]}
