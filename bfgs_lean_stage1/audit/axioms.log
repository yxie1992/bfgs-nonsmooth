BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.fiberPolynomial_degree_semialgebraic._proof_4","signature":"∀ {n : ℕ} (p : MvPolynomial (Option (Fin n)) ℝ) (x : BfgsVerification.Vec n) (k : ℕ),\n  (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p x ≠ 0 ∧\n      (BfgsVerification.RealAlgebraicGeometry.fiberPolynomial p x).natDegree = k) =\n    ((MvPolynomial.eval x) (BfgsVerification.RealAlgebraicGeometry.fiberCoefficient p k) ≠ 0 ∧\n      ∀ j ∈ {x ∈ Finset.range (MvPolynomial.degreeOf none p + 1) | k < x},\n        (MvPolynomial.eval x) (BfgsVerification.RealAlgebraicGeometry.fiberCoefficient p j) = 0)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedEmbedding.NonStrict.fromMetric_exact","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {p : BfgsVerification.Vec 2} {t A c₁ c₂ : ℝ},\n  BfgsVerification.SeedEmbedding.OracleData F p t A →\n    0 < t →\n      0 < c₁ →\n        c₁ ≤ 1 / 3 →\n          0 < c₂ →\n            ∀ (k : ℕ),\n              BfgsVerification.NonStrictLineSearch.fromMetric F (BfgsVerification.SeedEmbedding.point p t k)\n                  (BfgsVerification.SeedOrbit.orbitMetric k) c₁ c₂ 5 =\n                (some (BfgsVerification.SeedOrbit.orbitLength k),\n                  BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k))","axioms":["propext","Classical.choice","Quot.sound"]}
