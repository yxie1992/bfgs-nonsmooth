BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.ConvexCornerChart.mk.injEq","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {x : BfgsVerification.Vec 2}\n  (toCornerChart : BfgsVerification.PlanarCornerCharts.CornerChart F x) (region : Set (BfgsVerification.Vec 2))\n  (region_open : IsOpen region) (point_mem : x ∈ region)\n  (branch_convex : ∀ (i : Fin 2), ConvexOn ℝ region (toCornerChart.branches i))\n  (branch_C2 : ∀ (i : Fin 2), ContDiffOn ℝ 2 (toCornerChart.branches i) region)\n  (representation : ∀ z ∈ region, IsGreatest (Set.range fun i => toCornerChart.branches i z) (F z))\n  (independent :\n    BfgsVerification.HomogeneousPlanar.pairDet (BfgsVerification.coordinateGradient (toCornerChart.branches 0) x)\n        (BfgsVerification.coordinateGradient (toCornerChart.branches 1) x) ≠\n      0)\n  (inverse :\n    ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,\n      (∀ (i : Fin 2), toCornerChart.branches i z = toCornerChart.branches 0 z) →\n        z = toCornerChart.curve (toCornerChart.branches 0 z))\n  (toCornerChart_1 : BfgsVerification.PlanarCornerCharts.CornerChart F x) (region_1 : Set (BfgsVerification.Vec 2))\n  (region_open_1 : IsOpen region_1) (point_mem_1 : x ∈ region_1)\n  (branch_convex_1 : ∀ (i : Fin 2), ConvexOn ℝ region_1 (toCornerChart_1.branches i))\n  (branch_C2_1 : ∀ (i : Fin 2), ContDiffOn ℝ 2 (toCornerChart_1.branches i) region_1)\n  (representation_1 : ∀ z ∈ region_1, IsGreatest (Set.range fun i => toCornerChart_1.branches i z) (F z))\n  (independent_1 :\n    BfgsVerification.HomogeneousPlanar.pairDet (BfgsVerification.coordinateGradient (toCornerChart_1.branches 0) x)\n        (BfgsVerification.coordinateGradient (toCornerChart_1.branches 1) x) ≠\n      0)\n  (inverse_1 :\n    ∀ᶠ (z : BfgsVerification.Vec 2) in nhds x,\n      (∀ (i : Fin 2), toCornerChart_1.branches i z = toCornerChart_1.branches 0 z) →\n        z = toCornerChart_1.curve (toCornerChart_1.branches 0 z)),\n  ({ toCornerChart := toCornerChart, region := region, region_open := region_open, point_mem := point_mem,\n        branch_convex := branch_convex, branch_C2 := branch_C2, representation := representation,\n        independent := independent, inverse := inverse } =\n      { toCornerChart := toCornerChart_1, region := region_1, region_open := region_open_1, point_mem := point_mem_1,\n        branch_convex := branch_convex_1, branch_C2 := branch_C2_1, representation := representation_1,\n        independent := independent_1, inverse := inverse_1 }) =\n    (toCornerChart = toCornerChart_1 ∧ region = region_1)","axioms":["propext","Classical.choice","Quot.sound"]}
