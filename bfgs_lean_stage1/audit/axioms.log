BFGS_AUDIT {"theorem":"BfgsVerification.NonStrictLineSearch.search_armijo_reject","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {x p g : BfgsVerification.Vec n} {c₁ c₂ a l : ℝ} {h : Option ℝ} (fuel : ℕ),\n  ¬BfgsVerification.NonStrictLineSearch.Armijo F x p g c₁ a →\n    BfgsVerification.NonStrictLineSearch.search F x p g c₁ c₂ (fuel + 1) l h a =\n      let r := BfgsVerification.NonStrictLineSearch.search F x p g c₁ c₂ fuel l (some a) ((l + a) / 2);\n      (r.1, a :: r.2)","axioms":["propext","Classical.choice","Quot.sound"]}
