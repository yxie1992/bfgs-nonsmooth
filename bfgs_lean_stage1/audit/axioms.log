BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.maximum_deriv_centered_bound","signature":"∀ {ι : Type u_1} {s : Finset ι} (hne : s.Nonempty) {f d : ι → ℝ → ℝ} {U : Set ℝ} {L : NNReal},\n  (∀ i ∈ s, ∀ x ∈ U, HasDerivAt (f i) (d i x) x) →\n    (∀ x ∈ U,\n        ∀ i ∈ s,\n          ∀ j ∈ s,\n            f i x = BfgsVerification.FiniteMaxRadial.maximum s hne f x →\n              f j x = BfgsVerification.FiniteMaxRadial.maximum s hne f x → d i x = d j x) →\n      (∀ i ∈ s, LipschitzOnWith L (d i) U) →\n        ∀ {x : ℝ},\n          x ∈ U →\n            ∀ᶠ (z : ℝ) in nhds x,\n              z ∈ U →\n                ‖deriv (BfgsVerification.FiniteMaxRadial.maximum s hne f) z -\n                      deriv (BfgsVerification.FiniteMaxRadial.maximum s hne f) x‖ ≤\n                  ↑L * ‖z - x‖","axioms":["propext","Classical.choice","Quot.sound"]}
