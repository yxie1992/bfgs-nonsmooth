BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_mul_le","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ},\n  (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (J N : ℕ), c₁ * ∑ i ∈ Finset.range N, d (J + i) ≤ f J - f (J + N)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.sqNorm_projection","signature":"∀ {n r : ℕ} (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (v : BfgsVerification.Vec n),\n      BfgsVerification.sqNorm ((U * U.transpose).mulVec v) = BfgsVerification.sqNorm (U.transpose.mulVec v)","axioms":["propext","Quot.sound","Classical.choice"]}
