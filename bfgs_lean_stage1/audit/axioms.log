BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxHessian.finiteMax_actual_hessian_bounds","signature":"∀ {n m : ℕ} {F : BfgsVerification.Vec n → ℝ} {f : Fin m → BfgsVerification.Vec n → ℝ}\n  {g : Fin m → BfgsVerification.Vec n → BfgsVerification.Vec n} {x : BfgsVerification.Vec n} {μ L : ℝ},\n  0 ≤ L →\n    ConvexOn ℝ Set.univ F →\n      BfgsVerification.FixedNormal.EuclideanStrongConvexOn Set.univ μ F →\n        BfgsVerification.ConvexSubdifferential.LocalFiniteMax F f x →\n          (∀ (i : Fin m) (z : BfgsVerification.Vec n),\n              HasFDerivAt (f i) (BfgsVerification.gradientFunctional (g i z)) z) →\n            (∀ (i : Fin m) (z w : BfgsVerification.Vec n),\n                BfgsVerification.sqNorm (g i z - g i w) ≤ L ^ 2 * BfgsVerification.sqNorm (z - w)) →\n              (∀ᶠ (z : BfgsVerification.Vec n) in nhds x, DifferentiableAt ℝ F z) →\n                DifferentiableAt ℝ (fderiv ℝ F) x →\n                  Matrix.IsSymm (BfgsVerification.RadialHessian.matrix F x) ∧\n                    ∀ (v : BfgsVerification.Vec n),\n                      μ * BfgsVerification.sqNorm v ≤\n                          BfgsVerification.dot v (Matrix.mulVec (BfgsVerification.RadialHessian.matrix F x) v) ∧\n                        BfgsVerification.dot v (Matrix.mulVec (BfgsVerification.RadialHessian.matrix F x) v) ≤\n                          L * BfgsVerification.sqNorm v","axioms":["propext","Classical.choice","Quot.sound"]}
