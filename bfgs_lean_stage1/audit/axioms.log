BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frame_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (k : ℕ)\n  (U : Matrix (Fin n) (Fin r) ℝ),\n  U.transpose * U = 1 →\n    ∀ (L : ℝ),\n      (∀ (k : ℕ), BfgsVerification.sqNorm (U.transpose.mulVec (R.gradientChange k)) ≤ L * R.curvature k) →\n        ∀ (V W Z : Matrix (Fin n) (Fin p) ℝ) (T : BfgsVerification.Mat p) (b : BfgsVerification.Vec p)\n          (m C₀ C_T C_R : ℝ),\n          0 ≤ C_T →\n            m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)) →\n              BfgsVerification.sqNorm (W.transpose.mulVec (R.gradientChange k)) ≤ C₀ * R.curvature k →\n                W = V * T + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) b + Z →\n                  BfgsVerification.FrameBounds.OperatorSqBound T (1 + C_T * R.d k) →\n                    U * U.transpose * Z = Z →\n                      BfgsVerification.SmoothSubspace.frobSq Z ≤ C_R * R.d k →\n                        (BfgsVerification.metricGram (R.hessian (k + 1)) W).trace ≤\n                          (1 + R.d k) * (1 + C_T * R.d k) *\n                                ((BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k) +\n                              (1 + (R.d k)⁻¹) *\n                                (C_R * R.d k * ((BfgsVerification.metricGram (R.hessian 0) U).trace + L * ↑k)) +\n                            C₀","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AccessibleJumpGeometry.visible_tangent_projection_ne_zero","signature":"∀ {n : ℕ} {α : Type u_1} (W : BfgsVerification.Mat n) (g : α → BfgsVerification.Vec n),\n  (∀ (i j : α), Matrix.mulVec W (g i - g j) = 0) →\n    ∀ (i : α),\n      0 < BfgsVerification.metricEnergy W (g i) →\n        (BfgsVerification.AccessibleJumpGeometry.tangentSpace fun j =>\n                BfgsVerification.euclideanVector (g j)).orthogonalProjection\n            (BfgsVerification.euclideanVector (g i)) ≠\n          0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.affine_limit_lift_tail","signature":"∀ {n r : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (A : Matrix (Fin r) (Fin n) ℝ),\n  BfgsVerification.AffineProjection.FullRowRank A →\n    ∀ (J : ℕ) (gbar : ℕ → BfgsVerification.Vec r),\n      (∀ (k : ℕ), A.transpose.mulVec (gbar k) = R.g (J + k)) →\n        ∀ (zstar : BfgsVerification.Vec r),\n          Filter.Tendsto (fun k => A.mulVec (R.x (J + k))) Filter.atTop (nhds zstar) →\n            Filter.Tendsto R.x Filter.atTop\n              (nhds (R.x J + (BfgsVerification.AffineProjection.lift A (R.H J)).mulVec (zstar - A.mulVec (R.x J))))","axioms":["propext","Quot.sound","Classical.choice"]}
