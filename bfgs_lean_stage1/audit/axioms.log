BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.tangent_zero_on_minimizer_plane","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {U : Set (BfgsVerification.Vec n)} {μ : ℝ},\n      0 < μ →\n        BfgsVerification.FixedNormal.EuclideanStrongConvexOn U μ F →\n          ∀ {star p a : BfgsVerification.Vec n},\n            star ∈ U →\n              p ∈ U →\n                (∀ (z : BfgsVerification.Vec n), F star ≤ F z) →\n                  BfgsVerification.dot a p = BfgsVerification.dot a star →\n                    (∀ (g : BfgsVerification.Vec n),\n                        BfgsVerification.Homogeneous.Supports F p g →\n                          BfgsVerification.FixedNormal.tangentProjection a g = 0) →\n                      p = star","axioms":["propext","Classical.choice","Quot.sound"]}
