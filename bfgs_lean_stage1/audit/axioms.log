BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.EligiblePair.scalar_curvature","signature":"∀ {F : BfgsVerification.Vec 1 → ℝ} {c₁ c₂ : ℝ} {x z g h : BfgsVerification.Vec 1},\n  BfgsVerification.TransportedCertificate.EligiblePair F c₁ c₂ x z g h →\n    c₂ < 1 → 0 < |h 0 - g 0| ∧ BfgsVerification.TransportedCertificate.pairCurvature x z g h = |h 0 - g 0| * |z 0 - x 0|","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.scaledMoment_partial","signature":"∀ {a v : ℝ},\n  0 < a →\n    v ∈ Set.Icc (a - a ^ 5) (a + a ^ 5) →\n      BfgsVerification.NormalSpike.scaledMoment a v =\n        a ^ 3 * (BfgsVerification.NormalSpike.massPoly ((v - a) / a ^ 5) + 8 / 15) +\n          a ^ 7 * (BfgsVerification.NormalSpike.momentPoly ((v - a) / a ^ 5) - 1 / 6)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AffineProjection.gradient_in_image","signature":"∀ {n r : ℕ} (A : Matrix (Fin r) (Fin n) ℝ) (J : Matrix (Fin n) (Fin r) ℝ),\n  A * J = 1 →\n    ∀ (F : BfgsVerification.Vec r → ℝ) (x g : BfgsVerification.Vec n),\n      HasFDerivAt (fun z => F (A.mulVec z)) (BfgsVerification.gradientFunctional g) x →\n        A.transpose.mulVec (J.transpose.mulVec g) = g","axioms":["propext","Quot.sound","Classical.choice"]}
