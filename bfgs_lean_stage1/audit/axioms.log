BFGS_AUDIT {"theorem":"BfgsVerification.ResidualBudget.residual_recurrence_incompatible","signature":"∀ {E q u : ℕ → ℝ} {m C : ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ u k) →\n        Summable u →\n          0 < m →\n            0 ≤ C →\n              (∀ (k : ℕ), E (k + 1) ≤ (1 + u k) * (E k - m / q k) + C * (↑k + 1)) →\n                Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, (q k)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_5","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J k : ℕ),\n  R.x (J + k + 1) = R.x (J + k) + BfgsVerification.bfgsStep (R.H (J + k)) (R.g (J + k)) (R.α (J + k))","axioms":["propext","Quot.sound","Classical.choice"]}
