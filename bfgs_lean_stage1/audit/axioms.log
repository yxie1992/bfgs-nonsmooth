BFGS_AUDIT {"theorem":"BfgsVerification.ScalarCounterexamples.shifted_no_band_certificate","signature":"¬Nonempty\n    (BfgsVerification.TransportedCertificate.BandCertificate BfgsVerification.ScalarCounterexamples.shiftedObjective\n      {x | BfgsVerification.ScalarCounterexamples.shiftedObjective x ≤ 3}\n      (BfgsVerification.ScalarCounterexamples.shiftedObjective (BfgsVerification.OneDimensional.embed (-1))) (1 / 4)\n      (1 / 2) (1 / 4))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.inward_value_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (star : BfgsVerification.Vec n),\n      (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n        ∀ (x : BfgsVerification.Vec n) {t : ℝ},\n          0 ≤ t → t ≤ 1 → F (BfgsVerification.RadialCertificate.inwardPoint star x t) ≤ F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.scaledMass_monotone","signature":"∀ {a : ℝ}, 0 < a → Monotone (BfgsVerification.NormalSpike.scaledMass a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ConvexCellRadial.incident_neighborhood","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] (P V : ι → Set (BfgsVerification.Vec n)),\n  (∀ (i : ι), IsClosed (P i)) →\n    (∀ (i : ι), IsOpen (V i)) →\n      ∀ {U : Set (BfgsVerification.Vec n)},\n        IsOpen U →\n          ∀ {star : BfgsVerification.Vec n},\n            star ∈ U →\n              (∀ (i : ι), U ∩ P i ⊆ V i) →\n                ∃ ε,\n                  0 < ε ∧\n                    Metric.ball star ε ⊆ U ∧\n                      (∀ (i : ι), ∀ x ∈ Metric.ball star ε, x ∈ P i → star ∈ P i) ∧\n                        ∀ (i : ι), star ∈ P i → Metric.ball star ε ⊆ V i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalar.slopeComponent_nonpos","signature":"∀ {b x : ℝ}, 2 ≤ b → b ≤ 34 → x ≤ 0 → ∀ (n : ℕ), BfgsVerification.DScalar.slopeComponent b n x = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.exists_essential_negative_slope","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m), ∃ i, P.Essential i ∧ P.b i < 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.lipschitz_sqNorm_bound","signature":"∀ {n : ℕ} {A : BfgsVerification.Vec n → BfgsVerification.Vec n} {L : NNReal} {U : Set (BfgsVerification.Vec n)},\n  LipschitzOnWith L A U →\n    ∀ {x z : BfgsVerification.Vec n},\n      x ∈ U → z ∈ U → BfgsVerification.sqNorm (A z - A x) ≤ ↑n * ↑L ^ 2 * BfgsVerification.sqNorm (z - x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuadraticGauge.dot_split","signature":"∀ {m p : ℕ} (x y : BfgsVerification.Vec (m + p)),\n  BfgsVerification.dot x y =\n    BfgsVerification.dot (BfgsVerification.QuadraticGauge.left x) (BfgsVerification.QuadraticGauge.left y) +\n      BfgsVerification.dot (BfgsVerification.QuadraticGauge.right x) (BfgsVerification.QuadraticGauge.right y)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NuclearSymmetric2.Rotation.pair_gradients","signature":"∀ (P : BfgsVerification.NuclearSymmetric2.Rotation) {ε : ℝ},\n  0 < ε →\n    HasFDerivAt BfgsVerification.NuclearSymmetric2.objective (BfgsVerification.gradientFunctional (P.oldGradient ε))\n        (P.oldPoint ε) ∧\n      HasFDerivAt BfgsVerification.NuclearSymmetric2.objective (BfgsVerification.gradientFunctional (P.newGradient ε))\n        (P.newPoint ε)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedCycle.gamma_sixteenth","signature":"∀ {c d : ℝ},\n  BfgsVerification.AlgebraicSeed.U c d ≠ 0 →\n    BfgsVerification.AlgebraicSeed.R c d ≠ 0 →\n      BfgsVerification.AlgebraicSeed.Y c d ≠ 0 →\n        16 * BfgsVerification.AlgebraicSeed.V c d * BfgsVerification.AlgebraicSeed.T c d *\n                BfgsVerification.AlgebraicSeed.K c d -\n              BfgsVerification.AlgebraicSeed.R c d * BfgsVerification.AlgebraicSeed.U c d *\n                BfgsVerification.AlgebraicSeed.Y c d =\n            0 →\n          BfgsVerification.SeedCycle.gamma c d = 1 / 16","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.TransportedCertificate.BandCertificate.visibility","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {K : Set (BfgsVerification.Vec n)} {fstar c₁ c₂ η : ℝ}\n  (self : BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η),\n  ∀ x ∈ BfgsVerification.TransportedCertificate.positiveBand F K fstar η,\n    ∀ (g : BfgsVerification.Vec n),\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x → self.m ≤ BfgsVerification.metricEnergy (self.W x) g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarNegative.second_continuous","signature":"Continuous BfgsVerification.DScalarNegative.second","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DScalarRamp.primitive_eq_zero","signature":"∀ {b x : ℝ},\n  x ≤ BfgsVerification.DScalarRamp.center b - BfgsVerification.DScalarRamp.epsilon →\n    BfgsVerification.DScalarRamp.primitive b x = 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.orbit_secant_factor","signature":"∀ (k : ℕ),\n  BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.SeedOrbit.orbitPoint k)\n      (BfgsVerification.SeedOrbit.orbitPoint (k + 1)) (BfgsVerification.SeedOrbit.orbitGradient k)\n      (BfgsVerification.SeedOrbit.orbitGradient (k + 1)) =\n    BfgsVerification.SeedOrbit.orbitScale k *\n      BfgsVerification.SeedOrbit.coerciveSecantFactor (BfgsVerification.SeedOrbit.phase k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.potential_difference_on_cell","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i : Fin m} {v w : ℝ},\n  v ∈ P.envelopeCell i → w ∈ P.envelopeCell i → P.envelopePotential v - P.envelopePotential w = -P.b i / 2 * (v - w)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.maxLinear_fixed_line_convergence","signature":"∀ {n : ℕ} (A : Finset (BfgsVerification.Vec n)) (hA : A.Nonempty)\n  (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.Homogeneous.finiteMaxLinear A hA))\n  (a : BfgsVerification.Vec n),\n  a ≠ 0 →\n    (∀ (k : ℕ), ∃ c, R.g k = c • a) →\n      Filter.Tendsto (fun k => BfgsVerification.Homogeneous.finiteMaxLinear A hA (R.x k)) Filter.atTop (nhds 0) →\n        Filter.Tendsto R.x Filter.atTop\n          (nhds\n            (BfgsVerification.AffineProjection.fiberPoint (BfgsVerification.HomogeneousBlock.lineMatrix a) (R.H 0)\n              (R.x 0) 0))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AccumulatingKinks.knot_add","signature":"∀ (j k : ℕ), BfgsVerification.AccumulatingKinks.knot (k + j) = BfgsVerification.AccumulatingKinks.knot j * (1 / 4) ^ k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.eventually_fixed_normal_frame_secant","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r : ℕ}\n  {Ω : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    IsCompact R.initialSublevel →\n      R.initialSublevel ⊆ Ω →\n        ∀ {μ : ℝ},\n          0 < μ →\n            BfgsVerification.FixedNormal.EuclideanStrongConvexOn Ω μ F →\n              ∀ {a : BfgsVerification.Vec n},\n                BfgsVerification.sqNorm a = 1 →\n                  ∀ (b : ℝ) {A : BfgsVerification.Vec n → BfgsVerification.Vec n},\n                    (∀ x ∈ Ω,\n                        ∀ (g : BfgsVerification.Vec n),\n                          BfgsVerification.Homogeneous.Supports F x g →\n                            BfgsVerification.FixedNormal.tangentProjection a g = A x) →\n                      ∀ {L : NNReal},\n                        LipschitzOnWith L A Ω →\n                          ∀ {E : Set ℝ},\n                            IsClosed E →\n                              BfgsVerification.CenteredSmoothSublinear.LocallyC11On\n                                  (BfgsVerification.FixedNormal.regularRegion Ω a b E) F →\n                                ∀ {τ : ℝ → ℝ},\n                                  (∀ (t : ℝ), 0 ≤ τ t ∧ τ t ≤ 1) →\n                                    ∀ {δ : ℝ},\n                                      0 < δ →\n                                        (∀ (t e : ℝ), e ∈ E → |t - e| ≤ δ → τ t = 0) →\n                                          ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n                                            U.transpose * U = 1 →\n                                              (∀ (v : Fin n → ℝ),\n                                                  (U * U.transpose).mulVec v =\n                                                    BfgsVerification.FixedNormal.tangentProjection a v) →\n                                                ∃ C,\n                                                  0 ≤ C ∧\n                                                    ∀ᶠ (k : ℕ) in Filter.atTop,\n                                                      BfgsVerification.sqNorm\n                                                          ((BfgsVerification.FixedNormal.cutoffFrame U a\n                                                                  (τ\n                                                                    (BfgsVerification.FixedNormal.normalCoordinate a b\n                                                                      (R.x (k + 1))))).transpose.mulVec\n                                                            (R.gradientChange k)) ≤\n                                                        C * R.curvature k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedOrbit.coercive_unique_optimizer","signature":"∀ {x : BfgsVerification.Vec 2},\n  BfgsVerification.SeedOrbit.coerciveObjective x = -1 → x = BfgsVerification.SeedOrbit.coerciveOptimizer","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.valueCorrectionBudget_step","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n)\n  (C : ℝ) (N : ℕ),\n  R.valueCorrectionBudget star C (N + 1) = R.valueCorrectionBudget star C N + C * (F (R.x (N + 1)) - F star)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.tail_budget_le","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (L : ℝ),\n  (∀ (k : ℕ), L ≤ F (R.x k)) → ∀ (J : ℕ), ∑' (i : ℕ), R.d (J + i) ≤ (F (R.x J) - L) / R.c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SeedCycle.rho_difference","signature":"∀ {c d : ℝ},\n  BfgsVerification.AlgebraicSeed.U c d ≠ 0 →\n    BfgsVerification.AlgebraicSeed.V c d ≠ 0 →\n      BfgsVerification.AlgebraicSeed.U c d + 129 ≠ 0 →\n        BfgsVerification.AlgebraicSeed.R c d ≠ 0 →\n          BfgsVerification.AlgebraicSeed.Y c d ≠ 0 →\n            BfgsVerification.SeedCycle.rhoTilde c d - BfgsVerification.AlgebraicSeed.ratio c d =\n              2064 * BfgsVerification.AlgebraicSeed.R c d /\n                  (BfgsVerification.AlgebraicSeed.V c d * (BfgsVerification.AlgebraicSeed.U c d + 129)) *\n                (BfgsVerification.SeedCycle.gamma c d - 1 / 16)","axioms":["propext","Quot.sound","Classical.choice"]}
