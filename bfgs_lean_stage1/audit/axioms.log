BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.cutoffResidual.eq_1","signature":"∀ {n r : ℕ} (a s : BfgsVerification.Vec n) (β : ℝ),\n  BfgsVerification.FixedNormal.cutoffResidual a s β =\n    BfgsVerification.EnergyIdentities.rectOuter (BfgsVerification.FixedNormal.tangentProjection a s)\n      (BfgsVerification.FixedNormal.normalCoefficient (-β))","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.radial_correction_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (star : BfgsVerification.Vec n)\n  {K : Set (BfgsVerification.Vec n)},\n  (∀ (k : ℕ), R.x k ∈ K) →\n    ∀ (η C : ℝ),\n      (∀ (k : ℕ), F star + η ≤ F (R.x k)) →\n        (∀ (x z g h : BfgsVerification.Vec n),\n            x ∈ K →\n              z ∈ K →\n                F star + η ≤ F z →\n                  F z ≤ F x →\n                    HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                      HasFDerivAt F (BfgsVerification.gradientFunctional h) z →\n                        0 < BfgsVerification.RadialCertificate.secantCurvature x z g h →\n                          BfgsVerification.RadialCertificate.radialNumerator star z g h ^ 2 ≤\n                            C * BfgsVerification.RadialCertificate.secantCurvature x z g h) →\n          ∀ (k : ℕ), R.referenceCorrection star k ≤ C","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FiniteMaxRadial.local_finite_max_basin","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] (hne : Finset.univ.Nonempty) {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (f : ι → BfgsVerification.Vec n → ℝ) {U : Set (BfgsVerification.Vec n)},\n      IsOpen U →\n        (∀ (i : ι), ContDiffOn ℝ 2 (f i) U) →\n          ∀ {star : BfgsVerification.Vec n},\n            star ∈ U →\n              (∀ w ∈ U, F w = Finset.univ.sup' hne fun i => f i w) →\n                (∀ w ∈ U,\n                    ∀ (i j : ι),\n                      f i w = F w → f j w = F w → (fderiv ℝ (f i) w) (w - star) = (fderiv ℝ (f j) w) (w - star)) →\n                  (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                    (∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                      ∃ δ,\n                        0 < δ ∧\n                          ∀ (R : BfgsVerification.AdmissibleBFGSRun n F),\n                            F (R.x 0) ≤ F star + δ →\n                              (∀ (k : ℕ), R.x k ∈ U) ∧\n                                Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                  Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Parabolic.Family.adjacent_calibration","signature":"∀ {m : ℕ} (P : BfgsVerification.Parabolic.Family m) {i j : Fin m},\n  P.Adjacent i j → P.calibration j - P.calibration i = -(P.a j - P.a i) / (2 * P.profile i (P.breakpoint i j))","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RidgeSupersession.midpoint_below_level","signature":"∀ {a b : ℝ → ℝ},\n  StrictConvexOn ℝ Set.univ a →\n    StrictConvexOn ℝ Set.univ b →\n      ∀ {p q : ℝ},\n        0 < p →\n          0 < q →\n            ∀ {x y : BfgsVerification.Vec 2},\n              x ≠ y →\n                ∀ {level : ℝ},\n                  BfgsVerification.RidgeSupersession.objective a b p q x ≤ level →\n                    BfgsVerification.RidgeSupersession.objective a b p q y ≤ level →\n                      BfgsVerification.RidgeSupersession.objective a b p q ((1 / 2) • x + (1 / 2) • y) < level","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.PiecewiseSmoothConnected.open_band","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {S : Set E},\n  BfgsVerification.RealAlgebraicGeometry.PiecewiseSmoothConnected S →\n    ∀ {a b : E → ℝ},\n      ContDiffOn ℝ (↑⊤) a S →\n        ContDiffOn ℝ (↑⊤) b S →\n          (∀ x ∈ S, a x < b x) →\n            BfgsVerification.RealAlgebraicGeometry.PiecewiseSmoothConnected {z | z.1 ∈ S ∧ a z.1 < z.2 ∧ z.2 < b z.1}","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BoundedAnalytic.eval_update","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {n : ℕ} [inst_2 : DecidableEq (Fin n)]\n  (v : Fin n → BoundedContinuousFunction ℕ E) (i : Fin n) (a : BoundedContinuousFunction ℕ E) (k : ℕ),\n  (fun j => (Function.update v i a j) k) = Function.update (fun j => (v j) k) i (a k)","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.semialgebraic_planar_local_basin","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    BfgsVerification.RealAlgebraicGeometry.IsSemialgebraicObjective F →\n      ∀ (star : BfgsVerification.Vec 2),\n        (∀ (z : BfgsVerification.Vec 2), F star ≤ F z) →\n          (∀ (z : BfgsVerification.Vec 2), F z = F star → z = star) →\n            ∀ {Ω : Set (BfgsVerification.Vec 2)},\n              IsOpen Ω →\n                star ∈ Ω →\n                  (∀ p ∈ Ω,\n                      ¬BfgsVerification.AffineCriticalObjective.IsAffineCritical F p →\n                        ContDiffAt ℝ 2 F p ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F p) →\n                    ∀ {b : ℝ},\n                      F star < b →\n                        (∀ (ℓ : ℝ),\n                            F star < ℓ →\n                              ℓ ≤ b →\n                                ∀ (x y : BfgsVerification.Vec 2), segment ℝ x y ⊆ frontier {w | F w ≤ ℓ} → x = y) →\n                          ∃ ε,\n                            0 < ε ∧\n                              ∀ (R : BfgsVerification.AdmissibleBFGSRun 2 F),\n                                F (R.x 0) < F star + ε →\n                                  Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F star)) ∧\n                                    Filter.Tendsto R.x Filter.atTop (nhds star)","axioms":["propext","Classical.choice","Quot.sound"]}
