BFGS_AUDIT {"theorem":"BfgsVerification.ConvexCellRadial.local_cells_inward","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (P V : ι → Set (BfgsVerification.Vec n)) (f : ι → BfgsVerification.Vec n → ℝ),\n      (∀ (i : ι), IsClosed (P i)) →\n        (∀ (i : ι), Convex ℝ (P i)) →\n          (∀ (i : ι), IsOpen (V i)) →\n            (∀ (i : ι), BfgsVerification.CenteredSmoothSublinear.LocallyC11On (V i) (f i)) →\n              ∀ {U : Set (BfgsVerification.Vec n)},\n                IsOpen U →\n                  ∀ {star : BfgsVerification.Vec n},\n                    star ∈ U →\n                      (∀ (i : ι), U ∩ P i ⊆ V i) →\n                        (∀ x ∈ U, ∃ i, x ∈ P i) →\n                          (∀ (i : ι), ∀ x ∈ U, x ∈ P i → F x = f i x) →\n                            ∃ ε,\n                              0 < ε ∧\n                                ∀ (K : Set (BfgsVerification.Vec n)),\n                                  IsCompact K →\n                                    K ⊆ Metric.ball star ε →\n                                      BfgsVerification.RadialCertificate.HasInwardTaylorBounds F K star","axioms":["propext","Classical.choice","Quot.sound"]}
