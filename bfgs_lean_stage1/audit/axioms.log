BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.CornerChart.mk.injEq","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ} {x : BfgsVerification.Vec 2} (branches : Fin 2 → BfgsVerification.Vec 2 → ℝ)\n  (curve : ℝ → BfgsVerification.Vec 2) (localMax : BfgsVerification.ConvexSubdifferential.LocalFiniteMax F branches x)\n  (branchesC2 : ∀ (i : Fin 2), ContDiffAt ℝ 2 (branches i) x) (active : ∀ (i : Fin 2), branches i x = F x)\n  (curveAt : curve (F x) = x) (curveC2 : ContDiffAt ℝ 2 curve (F x))\n  (defining : ∀ᶠ (t : ℝ) in nhds (F x), ∀ (i : Fin 2), branches i (curve t) = t)\n  (commonRate :\n    ∀ (i : Fin 2), BfgsVerification.dot (BfgsVerification.coordinateGradient (branches i) x) (deriv curve (F x)) = 1)\n  (branches_1 : Fin 2 → BfgsVerification.Vec 2 → ℝ) (curve_1 : ℝ → BfgsVerification.Vec 2)\n  (localMax_1 : BfgsVerification.ConvexSubdifferential.LocalFiniteMax F branches_1 x)\n  (branchesC2_1 : ∀ (i : Fin 2), ContDiffAt ℝ 2 (branches_1 i) x) (active_1 : ∀ (i : Fin 2), branches_1 i x = F x)\n  (curveAt_1 : curve_1 (F x) = x) (curveC2_1 : ContDiffAt ℝ 2 curve_1 (F x))\n  (defining_1 : ∀ᶠ (t : ℝ) in nhds (F x), ∀ (i : Fin 2), branches_1 i (curve_1 t) = t)\n  (commonRate_1 :\n    ∀ (i : Fin 2),\n      BfgsVerification.dot (BfgsVerification.coordinateGradient (branches_1 i) x) (deriv curve_1 (F x)) = 1),\n  ({ branches := branches, curve := curve, localMax := localMax, branchesC2 := branchesC2, active := active,\n        curveAt := curveAt, curveC2 := curveC2, defining := defining, commonRate := commonRate } =\n      { branches := branches_1, curve := curve_1, localMax := localMax_1, branchesC2 := branchesC2_1,\n        active := active_1, curveAt := curveAt_1, curveC2 := curveC2_1, defining := defining_1,\n        commonRate := commonRate_1 }) =\n    (branches = branches_1 ∧ curve = curve_1)","axioms":["propext","Classical.choice","Quot.sound"]}
