BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.supportingError_nonneg","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {x g : BfgsVerification.Vec n},\n      HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n        ∀ (z : BfgsVerification.Vec n), 0 ≤ BfgsVerification.RadialCertificate.supportingError F x g z","axioms":["propext","Quot.sound","Classical.choice"]}
