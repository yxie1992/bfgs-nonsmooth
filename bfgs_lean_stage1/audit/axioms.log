BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.exists_real_sign_pattern_iff_queries_and_tails","signature":"∀ {m : ℕ} (q : Fin m → Polynomial ℝ) (σ : Fin m → SignType),\n  (∃ x, ∀ (i : Fin m), SignType.sign (Polynomial.eval x (q i)) = σ i) ↔\n    0 <\n        BfgsVerification.RealAlgebraicGeometry.signQueryExpression\n          (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q) q σ ∨\n      0 <\n          BfgsVerification.RealAlgebraicGeometry.signQueryExpression\n            (Polynomial.derivative (BfgsVerification.RealAlgebraicGeometry.nonzeroFamilyProduct q)) q σ ∨\n        (∀ (i : Fin m), (-1) ^ (q i).natDegree * SignType.sign (q i).leadingCoeff = σ i) ∨\n          ∀ (i : Fin m), SignType.sign (q i).leadingCoeff = σ i","axioms":["propext","Classical.choice","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PlanarCornerCharts.exists_finite_convexCornerCharts","signature":"∀ {F : BfgsVerification.Vec 2 → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {K : Set (BfgsVerification.Vec 2)} {ℓ : ℝ},\n      IsCompact K →\n        (∀ x ∈ K, F x = ℓ) →\n          (∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ BfgsVerification.PlanarCornerCharts.ConvexTwoBranchRegularAt F x) →\n            ∃ m points charts,\n              Function.Injective points ∧\n                (∀ (i : Fin m), points i ∈ K ∧ ¬DifferentiableAt ℝ F (points i)) ∧\n                  ∀ x ∈ K, ContDiffAt ℝ 2 F x ∨ ∃ i, x = points i","axioms":["propext","Classical.choice","Quot.sound"]}
