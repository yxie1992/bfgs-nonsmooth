BFGS_AUDIT {"theorem":"BfgsVerification.ScalarMetricRun.abs_gradient_lower_of_gap","signature":"∀ {f : ℝ → ℝ} (R : BfgsVerification.ScalarMetricRun f),\n  IsCompact R.initialSublevel →\n    ∀ (xStar L : ℝ), 0 < L → (∀ (k : ℕ), L ≤ f (R.x k) - f xStar) → ∃ m, 0 < m ∧ ∀ (k : ℕ), m ≤ |R.g k|","axioms":["propext","Quot.sound","Classical.choice"]}
