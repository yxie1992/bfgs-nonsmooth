BFGS_AUDIT {"theorem":"BfgsVerification.det_nonneg_of_posSemidef","signature":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {H : Matrix ι ι ℝ}, H.PosSemidef → 0 ≤ H.det","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.inverseBFGS_projection_form","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g y : BfgsVerification.Vec n) (α : ℝ),\n  α ≠ 0 →\n    BfgsVerification.metricEnergy H g ≠ 0 →\n      -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g ≠ 0 →\n        let q := BfgsVerification.metricEnergy H g;\n        let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n        let v := Matrix.mulVec H g;\n        BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y =\n          (1 + (β * q)⁻¹ • BfgsVerification.outer v y) * H * (1 + (β * q)⁻¹ • BfgsVerification.outer y v) +\n            (α / (β * q)) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.frame_descent_nonneg","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {p : ℕ} (k : ℕ)\n  (V : Matrix (Fin n) (Fin p) ℝ),\n  ∀ m ≤ BfgsVerification.sqNorm (V.transpose.mulVec (R.g k)),\n    0 ≤ (BfgsVerification.metricGram (R.hessian k) V).trace - m / R.q k","axioms":["propext","Quot.sound","Classical.choice"]}
