BFGS_AUDIT {"theorem":"BfgsVerification.TransformedGauge.objective_eq_zero_iff","signature":"∀ {n : ℕ} {Φ : ℝ → ℝ} {γ : BfgsVerification.Vec n → ℝ},\n  BfgsVerification.TransformedGauge.IncreasingTransform Φ →\n    BfgsVerification.Homogeneous.PositiveDegreeOne γ →\n      Filter.Tendsto γ (Filter.cocompact (BfgsVerification.Vec n)) Filter.atTop →\n        ∀ (star x : BfgsVerification.Vec n), BfgsVerification.TransformedGauge.objective Φ γ star x = 0 ↔ x = star","axioms":["propext","Quot.sound","Classical.choice"]}
