BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.geometricMean_eq_exp_logMean","signature":"∀ (q : ℕ → ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    ∀ (N : ℕ),\n      BfgsVerification.reciprocalGeometricMean q N = Real.exp (BfgsVerification.ReciprocalGrowth.logReciprocalMean q N)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.hessianInvariants","signature":"BfgsVerification.HessianInvariantTarget","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_on_tail_incompatible_source","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (J : ℕ) (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 < m →\n                (∀ (k : ℕ),\n                    BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                      L * (R.shift J).curvature k) →\n                  ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                    (b : ℕ → BfgsVerification.Vec p),\n                    (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))) →\n                      (∀ (k : ℕ),\n                          BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                            C₀ * (R.shift J).curvature k) →\n                        (∀ (k : ℕ),\n                            V (k + 1) =\n                              V k * T k +\n                                  BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) +\n                                Z k) →\n                          (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)) →\n                            (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                              (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) → False","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalSum_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 → ∀ (j : ℕ), BfgsVerification.principalSum (U * H * V) j = BfgsVerification.principalSum H j","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.steps_tendsto_zero_of_strict_contour","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  IsCompact R.initialSublevel →\n    ∀ (ℓ : ℝ),\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        (∃ y, F y < ℓ) →\n          (∀ (x z : BfgsVerification.Vec n), segment ℝ x z ⊆ frontier {w | F w ≤ ℓ} → x = z) →\n            Filter.Tendsto (fun k => BfgsVerification.bfgsStep (R.H k) (R.g k) (R.α k)) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.Localization.gap_outside_ball","signature":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {F : E → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {xStar : E} {r ω : ℝ},\n      0 < r →\n        0 ≤ ω → (∀ (z : E), dist z xStar = r → ω ≤ F z - F xStar) → ∀ {x : E}, r ≤ dist x xStar → ω ≤ F x - F xStar","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.coordinateMatrix_mulVec_at","signature":"∀ {n : ℕ} (I : Finset (Fin n)) (x : { x // x ∈ I } → ℝ) (i : { x // x ∈ I }),\n  (BfgsVerification.coordinateMatrix I).mulVec x ↑i = x i","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.compression.eq_1","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (κ r : ℝ),\n  BfgsVerification.CompressionDeterminant.compression A a b κ r =\n    A - κ⁻¹ • (BfgsVerification.outer a b + BfgsVerification.outer b a) + (r / κ ^ 2) • BfgsVerification.outer a a","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compression_from_gram_relations","signature":"∀ (Δ q u r z κ w D Dy Dgy : ℝ),\n  κ ^ 2 * D = Δ * ((κ - w) ^ 2 + u * (r - z)) →\n    Dy = Δ * (r - z) → Dgy = Δ * ((q - u) * (r - z) - (κ - w) ^ 2) → κ ^ 2 * D = q * Dy - Dgy","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.invertible","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R) (k : ℕ), self.J ≤ k → Matrix.det (self.P k) ≠ 0","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_congruence","signature":"∀ {n : ℕ} (H A : BfgsVerification.Mat n) (x : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy (Matrix.transpose A * H * A) x = BfgsVerification.metricEnergy H (Matrix.mulVec A x)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_add_kernel","signature":"∀ {n r : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.IsSymm M →\n    ∀ {s : BfgsVerification.Vec n},\n      Matrix.mulVec M s = 0 →\n        ∀ (V : Matrix (Fin n) (Fin r) ℝ) (b : BfgsVerification.Vec r),\n          BfgsVerification.metricGram M (V + BfgsVerification.EnergyIdentities.rectOuter s b) =\n            BfgsVerification.metricGram M V","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.energy_pos","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ), 0 < BfgsVerification.metricEnergy (self.H k) (self.g k)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.SmoothSubspace.projection_idempotent","signature":"∀ {n r : ℕ} (U : Matrix (Fin n) (Fin r) ℝ), U.transpose * U = 1 → U * U.transpose * (U * U.transpose) = U * U.transpose","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FrameBounds.gram_trace_add_le","signature":"∀ {n r : ℕ} {M : BfgsVerification.Mat n},\n  Matrix.PosSemidef M →\n    ∀ (V W : Matrix (Fin n) (Fin r) ℝ) (d : ℝ),\n      0 < d →\n        (BfgsVerification.metricGram M (V + W)).trace ≤\n          (1 + d) * (BfgsVerification.metricGram M V).trace + (1 + d⁻¹) * (BfgsVerification.metricGram M W).trace","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.gap_antitone","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F)\n  (xstar : BfgsVerification.Vec n), Antitone fun k => F (R.x k) - F xstar","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.shift_identity","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  r * BfgsVerification.ScalarHierarchy.shiftedPotential n r e + e 1 =\n    BfgsVerification.ScalarHierarchy.weightedPotential n r e + r ^ n * e (n + 1)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.normalized_frame_trace_recurrence._proof_1","signature":"∀ {m : Type u_2} {n : Type u_3} {o : Type u_4} {α : Type v} [inst : NonUnitalSemiring α] [inst_1 : Fintype n]\n  [inst_2 : Fintype o] (v : o → α) (M : Matrix m n α) (N : Matrix n o α), (M * N).mulVec v = M.mulVec (N.mulVec v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.MovingFrame.inverse_transpose_lower","signature":"∀ {r : ℕ} (P : BfgsVerification.Mat r),\n  Matrix.det P ≠ 0 →\n    ∀ (K : ℝ),\n      0 < K →\n        (∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose P).mulVec v) ≤ K * BfgsVerification.sqNorm v) →\n          ∀ (a : BfgsVerification.Vec r),\n            BfgsVerification.sqNorm a / K ≤ BfgsVerification.sqNorm (P⁻¹.transpose.mulVec a)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.alpha_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (self : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ), 0 < self.α k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.gap_tendsto_zero_of_quadratic_budget","signature":"∀ {gap S T : ℕ → ℝ} {E₀ C : ℝ},\n  (∀ (k : ℕ), 0 ≤ gap k) →\n    (∀ (N : ℕ), gap N ^ 2 * S N ≤ E₀ + T N) →\n      Filter.Tendsto (fun N => S N / ↑N ^ 2) Filter.atTop Filter.atTop →\n        (∀ᶠ (N : ℕ) in Filter.atTop, T N ≤ C * ↑N ^ 2) → Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.PrincipalInvariance.principalPolynomial_conjugate","signature":"∀ {n : ℕ} (U V H : BfgsVerification.Mat n),\n  U * V = 1 →\n    BfgsVerification.PrincipalInvariance.principalPolynomial (U * H * V) =\n      BfgsVerification.PrincipalInvariance.principalPolynomial H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.differences_tendsto_zero_of_strict_contour","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  IsCompact R.initialSublevel →\n    ∀ (ℓ : ℝ),\n      Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds ℓ) →\n        (∃ y, F y < ℓ) →\n          (∀ (x z : BfgsVerification.Vec n), segment ℝ x z ⊆ frontier {w | F w ≤ ℓ} → x = z) →\n            Filter.Tendsto (fun k => R.x (k + 1) - R.x k) Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J m : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∑ k ∈ Finset.range (m + 1), Real.log (q (J + k)) ≤ Real.log C + Real.log (V J) + ↑m * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_outer","signature":"∀ {n r : ℕ} (g : BfgsVerification.Vec n) (V : Matrix (Fin n) (Fin r) ℝ),\n  BfgsVerification.metricGram (BfgsVerification.outer g g) V =\n    BfgsVerification.outer (V.transpose.mulVec g) (V.transpose.mulVec g)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.referenceEnergy.eq_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (xstar : BfgsVerification.Vec n)\n  (k : ℕ), R.referenceEnergy xstar k = BfgsVerification.metricEnergy (R.hessian k) (R.x k - xstar)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.mk.sizeOf_spec","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} (J r : ℕ)\n  (V : ℕ → Matrix (Fin n) (Fin r) ℝ) (T P : ℕ → BfgsVerification.Mat r) (b : ℕ → BfgsVerification.Vec r) (m K L C : ℝ)\n  (m_pos : 0 < m) (K_pos : 0 < K) (L_nonneg : 0 ≤ L) (invertible : ∀ (k : ℕ), J ≤ k → Matrix.det (P k) ≠ 0)\n  (product : ∀ (k : ℕ), J ≤ k → P (k + 1) = P k * T k)\n  (transport :\n    ∀ (k : ℕ), J ≤ k → V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter (R.displacement k) (b k))\n  (visible : ∀ (k : ℕ), J ≤ k → m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec (R.g k)))\n  (correction :\n    ∀ (k : ℕ), J ≤ k → BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec (R.gradientChange k)) / R.curvature k ≤ C)\n  (product_bound :\n    ∀ (k : ℕ),\n      J ≤ k →\n        ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((Matrix.transpose (P k)).mulVec v) ≤ K * BfgsVerification.sqNorm v)\n  (inverse_bound :\n    ∀ (k : ℕ),\n      J ≤ k → ∀ (v : Fin r → ℝ), BfgsVerification.sqNorm ((P k)⁻¹.transpose.mulVec v) ≤ L * BfgsVerification.sqNorm v),\n  sizeOf\n      { J := J, r := r, V := V, T := T, P := P, b := b, m := m, K := K, L := L, C := C, m_pos := m_pos, K_pos := K_pos,\n        L_nonneg := L_nonneg, invertible := invertible, product := product, transport := transport, visible := visible,\n        correction := correction, product_bound := product_bound, inverse_bound := inverse_bound } =\n    1 + sizeOf J + sizeOf r + sizeOf m + sizeOf K + sizeOf L + sizeOf C + sizeOf m_pos + sizeOf K_pos + sizeOf L_nonneg","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.BFGSCompression.projection_expansion","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (v y : BfgsVerification.Vec n) (κ : ℝ),\n  Matrix.IsSymm H →\n    (1 - κ⁻¹ • BfgsVerification.outer v y) * H * (1 - κ⁻¹ • BfgsVerification.outer v y).transpose =\n      H - κ⁻¹ • (BfgsVerification.outer v (Matrix.mulVec H y) + BfgsVerification.outer (Matrix.mulVec H y) v) +\n        (BfgsVerification.dot y (Matrix.mulVec H y) / κ ^ 2) • BfgsVerification.outer v v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.convex_boundedBelow_on_compact","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F → ∀ {K : Set (BfgsVerification.Vec n)}, IsCompact K → ∃ b, ∀ x ∈ K, b ≤ F x","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionDeterminant.det_rank_two","signature":"∀ {n : ℕ} (A : BfgsVerification.Mat n) (a b : BfgsVerification.Vec n) (t v : ℝ),\n  IsUnit (Matrix.det A) →\n    Matrix.IsSymm A →\n      Matrix.det (A + t • BfgsVerification.outer a a + v • (BfgsVerification.outer a b + BfgsVerification.outer b a)) =\n        Matrix.det A *\n          ((1 + v * BfgsVerification.dot a (Matrix.mulVec A⁻¹ b)) ^ 2 +\n            BfgsVerification.dot a (Matrix.mulVec A⁻¹ a) * (t - v ^ 2 * BfgsVerification.dot b (Matrix.mulVec A⁻¹ b)))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.energy_gap_tendsto_zero","signature":"∀ {E q a R gap : ℕ → ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ gap k) →\n        Antitone gap →\n          (∀ (k : ℕ), gap k ≤ a k) →\n            (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n              Filter.Tendsto (fun N => ∑ k ∈ Finset.range N, (q k)⁻¹) Filter.atTop Filter.atTop →\n                Filter.Tendsto (fun N => (∑ k ∈ Finset.range N, R k) / ∑ k ∈ Finset.range N, (q k)⁻¹) Filter.atTop\n                    (nhds 0) →\n                  Filter.Tendsto gap Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_fixed_tail_lower_eventually._proof_3","signature":"∀ (J M N : ℕ), N ≥ J + (max M 1 + 1) → 0 < N - (J + 1) → ¬M ≤ N - (J + 1) → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.sum_compressed_bounds","signature":"∀ {ι : Type u_1} [inst : Fintype ι] (Dplus Dy Δ : ι → ℝ) (α β q normY2 eNext eCurrent : ℝ),\n  0 < β →\n    0 < q →\n      (∀ (i : ι), Dplus i ≤ Dy i / (β ^ 2 * q) + α / β * Δ i) →\n        ∑ i, Dy i ≤ normY2 * eNext →\n          ∑ i, Δ i = eCurrent → ∑ i, Dplus i ≤ normY2 / (β ^ 2 * q) * eNext + α / β * eCurrent","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_le","signature":"∀ {f d : ℕ → ℝ} {c₁ : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → ∀ (J N : ℕ), ∑ i ∈ Finset.range N, d (J + i) ≤ (f J - f (J + N)) / c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.mk.inj","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F} {J r p : ℕ}\n  {U : Matrix (Fin n) (Fin r) ℝ} {orthonormal : U.transpose * U = 1} {L m C₀ C_T C_R : ℝ} {m_pos : 0 < m}\n  {V Z : ℕ → Matrix (Fin n) (Fin p) ℝ} {T : ℕ → BfgsVerification.Mat p} {b : ℕ → BfgsVerification.Vec p}\n  {smooth :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤ L * (R.shift J).curvature k}\n  {visible : ∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))}\n  {correction :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n        C₀ * (R.shift J).curvature k}\n  {transport :\n    ∀ (k : ℕ),\n      V (k + 1) = V k * T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) + Z k}\n  {operator_bound : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)}\n  {residual_range : ∀ (k : ℕ), U * U.transpose * Z k = Z k}\n  {residual_size : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k} {J_1 r_1 p_1 : ℕ}\n  {U_1 : Matrix (Fin n) (Fin r_1) ℝ} {orthonormal_1 : U_1.transpose * U_1 = 1} {L_1 m_1 C₀_1 C_T_1 C_R_1 : ℝ}\n  {m_pos_1 : 0 < m_1} {V_1 Z_1 : ℕ → Matrix (Fin n) (Fin p_1) ℝ} {T_1 : ℕ → BfgsVerification.Mat p_1}\n  {b_1 : ℕ → BfgsVerification.Vec p_1}\n  {smooth_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm (U_1.transpose.mulVec ((R.shift J_1).gradientChange k)) ≤ L_1 * (R.shift J_1).curvature k}\n  {visible_1 : ∀ (k : ℕ), m_1 ≤ BfgsVerification.sqNorm ((V_1 k).transpose.mulVec ((R.shift J_1).g k))}\n  {correction_1 :\n    ∀ (k : ℕ),\n      BfgsVerification.sqNorm ((V_1 (k + 1)).transpose.mulVec ((R.shift J_1).gradientChange k)) ≤\n        C₀_1 * (R.shift J_1).curvature k}\n  {transport_1 :\n    ∀ (k : ℕ),\n      V_1 (k + 1) =\n        V_1 k * T_1 k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift J_1).displacement k) (b_1 k) + Z_1 k}\n  {operator_bound_1 : ∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T_1 k) (1 + C_T_1 * (R.shift J_1).d k)}\n  {residual_range_1 : ∀ (k : ℕ), U_1 * U_1.transpose * Z_1 k = Z_1 k}\n  {residual_size_1 : ∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z_1 k) ≤ C_R_1 * (R.shift J_1).d k},\n  { J := J, r := r, p := p, U := U, orthonormal := orthonormal, L := L, m := m, C₀ := C₀, C_T := C_T, C_R := C_R,\n        m_pos := m_pos, V := V, Z := Z, T := T, b := b, smooth := smooth, visible := visible, correction := correction,\n        transport := transport, operator_bound := operator_bound, residual_range := residual_range,\n        residual_size := residual_size } =\n      { J := J_1, r := r_1, p := p_1, U := U_1, orthonormal := orthonormal_1, L := L_1, m := m_1, C₀ := C₀_1,\n        C_T := C_T_1, C_R := C_R_1, m_pos := m_pos_1, V := V_1, Z := Z_1, T := T_1, b := b_1, smooth := smooth_1,\n        visible := visible_1, correction := correction_1, transport := transport_1, operator_bound := operator_bound_1,\n        residual_range := residual_range_1, residual_size := residual_size_1 } →\n    J = J_1 ∧\n      r = r_1 ∧\n        p = p_1 ∧\n          HEq U U_1 ∧\n            L = L_1 ∧ m = m_1 ∧ C₀ = C₀_1 ∧ C_T = C_T_1 ∧ C_R = C_R_1 ∧ HEq V V_1 ∧ HEq Z Z_1 ∧ HEq T T_1 ∧ HEq b b_1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.global_log_product_upper","signature":"∀ (q V : ℕ → ℝ) (A C : ℝ) (J : ℕ),\n  (∀ (k : ℕ), 0 < q k) →\n    (∀ (k : ℕ), 0 < V k) →\n      0 < A →\n        0 < C →\n          (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) →\n            (∀ (k : ℕ), q k ≤ C * V k) →\n              ∃ B, ∀ (N : ℕ), J + 1 ≤ N → ∑ k ∈ Finset.range N, Real.log (q k) ≤ B + ↑N * Real.log A","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.gradientFunctional_apply","signature":"∀ {n : ℕ} (g v : BfgsVerification.Vec n), (BfgsVerification.gradientFunctional g) v = BfgsVerification.dot g v","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyIdentities.gram_sub","signature":"∀ {n r : ℕ} (B C : BfgsVerification.Mat n) (V : Matrix (Fin n) (Fin r) ℝ),\n  BfgsVerification.metricGram (B - C) V = BfgsVerification.metricGram B V - BfgsVerification.metricGram C V","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricEnergy_le_sqNorm_mul_trace","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n),\n  Matrix.PosSemidef H → BfgsVerification.metricEnergy H g ≤ BfgsVerification.sqNorm g * Matrix.trace H","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.fullBFGS_normalizedHierarchy","signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          BfgsVerification.ScalarHierarchy.NormalizedHierarchy n (fun k => BfgsVerification.principalSum (R.H k)) R.q\n            (fun k => R.d k / c) (4 * G ^ 2 / c ^ 2) (G ^ 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.metricGram_det_append_one_generic._proof_2","signature":"∀ {m : Type u_2} {n : Type u_3} {o : Type u_4} {α : Type v} [inst : NonUnitalSemiring α] [inst_1 : Fintype n]\n  [inst_2 : Fintype o] (v : o → α) (M : Matrix m n α) (N : Matrix n o α), (M * N).mulVec v = M.mulVec (N.mulVec v)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ResidualFrameCertificate.transport","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ResidualFrameCertificate R) (k : ℕ),\n  self.V (k + 1) =\n    self.V k * self.T k + BfgsVerification.EnergyIdentities.rectOuter ((R.shift self.J).displacement k) (self.b k) +\n      self.Z k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.EnergyBudget.gap_sq_mul_reciprocal_sum_le","signature":"∀ {E q a R gap : ℕ → ℝ},\n  (∀ (k : ℕ), 0 ≤ E k) →\n    (∀ (k : ℕ), 0 < q k) →\n      (∀ (k : ℕ), 0 ≤ gap k) →\n        Antitone gap →\n          (∀ (k : ℕ), gap k ≤ a k) →\n            (∀ (k : ℕ), E (k + 1) = E k - a k ^ 2 / q k + R k) →\n              ∀ (N : ℕ), gap N ^ 2 * ∑ k ∈ Finset.range N, (q k)⁻¹ ≤ E 0 + ∑ k ∈ Finset.range N, R k","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ExactFrameCertificate.K_pos","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {R : BfgsVerification.AdmissibleBFGSRun n F}\n  (self : BfgsVerification.ExactFrameCertificate R), 0 < self.K","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.dimension_pos","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → 0 < n","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon._proof_1","signature":"∀ (m : ℕ), 0 < m → ¬0 < m + 1 → False","axioms":["propext","Quot.sound"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.summable_predicted_decreases_of_compact_sublevel","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F),\n  IsCompact R.initialSublevel → Summable R.d","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.K_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → 0 ≤ K","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.shift._proof_1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (J : ℕ),\n  Matrix.PosDef (R.H (J + 0))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.mk.sizeOf_spec","signature":"∀ {n : ℕ} (H : ℕ → BfgsVerification.Mat n) (g : ℕ → BfgsVerification.Vec n) (α : ℕ → ℝ)\n  (positive_definite : ∀ (k : ℕ), Matrix.PosDef (H k)) (alpha_pos : ∀ (k : ℕ), 0 < α k)\n  (energy_pos : ∀ (k : ℕ), 0 < BfgsVerification.metricEnergy (H k) (g k))\n  (curvature_pos : ∀ (k : ℕ), 0 < BfgsVerification.dot (g (k + 1) - g k) (BfgsVerification.bfgsStep (H k) (g k) (α k)))\n  (update :\n    ∀ (k : ℕ),\n      H (k + 1) = BfgsVerification.inverseBFGS (H k) (BfgsVerification.bfgsStep (H k) (g k) (α k)) (g (k + 1) - g k)),\n  sizeOf\n      { H := H, g := g, α := α, positive_definite := positive_definite, alpha_pos := alpha_pos,\n        energy_pos := energy_pos, curvature_pos := curvature_pos, update := update } =\n    1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_sum_budget_le","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) →\n      (∀ (k : ℕ), L ≤ f k) → ∀ (J N : ℕ), ∑ i ∈ Finset.range N, d (J + i) ≤ (f J - L) / c₁","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.weighted_step","signature":"∀ (n : ℕ) (e eNext : ℕ → ℝ) (q K η δ : ℝ),\n  0 ≤ K →\n    0 < η →\n      (∀ (j : ℕ), 0 ≤ e j) →\n        e (n + 1) = 0 →\n          (∀ (j : ℕ), 1 ≤ j → j ≤ n → q * eNext j ≤ K * e (j + 1) + δ * e j) →\n            q * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) eNext ≤\n              (η + δ) * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) e","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compression_scalar_identity","signature":"∀ (Δ q u r z κ w : ℝ),\n  Δ / κ ^ 2 * ((κ - w) ^ 2 + u * (r - z)) = (q * (Δ * (r - z)) - Δ * ((q - u) * (r - z) - (κ - w) ^ 2)) / κ ^ 2","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.DescentBudget.armijo_tendsto_zero","signature":"∀ {f d : ℕ → ℝ} {c₁ L : ℝ},\n  0 < c₁ →\n    (∀ (k : ℕ), 0 ≤ d k) →\n      (∀ (k : ℕ), c₁ * d k ≤ f k - f (k + 1)) → (∀ (k : ℕ), L ≤ f k) → Filter.Tendsto d Filter.atTop (nhds 0)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.AdmissibleBFGSRun.objective_strict_decrease","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  F (R.x (k + 1)) < F (R.x k)","axioms":["propext","Quot.sound","Classical.choice"]}
