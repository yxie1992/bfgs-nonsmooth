BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.weighted_logDerivative_negative_pole","signature":"∀ {p q : Polynomial ℝ} {a : ℝ},\n  p ≠ 0 →\n    p.IsRoot a →\n      Polynomial.eval a q < 0 →\n        Filter.Tendsto\n            (fun x => Polynomial.eval x q * Polynomial.eval x (Polynomial.derivative p) / Polynomial.eval x p)\n            (nhdsWithin a (Set.Ioi a)) Filter.atBot ∧\n          Filter.Tendsto\n            (fun x => Polynomial.eval x q * Polynomial.eval x (Polynomial.derivative p) / Polynomial.eval x p)\n            (nhdsWithin a (Set.Iio a)) Filter.atTop","axioms":["propext","Classical.choice","Quot.sound"]}
