BFGS_AUDIT {"theorem":"BfgsVerification.RealAlgebraicGeometry.localCauchyIndex_rational_order","signature":"∀ {p q : Polynomial ℝ},\n  p ≠ 0 →\n    q ≠ 0 →\n      ∀ (a : ℝ),\n        BfgsVerification.RealAlgebraicGeometry.localCauchyIndex (fun x => Polynomial.eval x p / Polynomial.eval x q) a =\n          if\n              Polynomial.rootMultiplicity a p < Polynomial.rootMultiplicity a q ∧\n                Odd (Polynomial.rootMultiplicity a q - Polynomial.rootMultiplicity a p) then\n            ↑(SignType.sign\n                (Polynomial.eval a (BfgsVerification.RealAlgebraicGeometry.rootFactor p a) *\n                  Polynomial.eval a (BfgsVerification.RealAlgebraicGeometry.rootFactor q a)))\n          else 0","axioms":["propext","Classical.choice","Quot.sound"]}
