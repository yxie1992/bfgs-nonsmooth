BFGS_AUDIT {"theorem":"BfgsVerification.EuclideanResidual.exact_decomposition","signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ}\n  (A : (i : ι) → BfgsVerification.Vec n →L[ℝ] EuclideanSpace ℝ (Fin (m i))) (b : (i : ι) → EuclideanSpace ℝ (Fin (m i)))\n  (star x : BfgsVerification.Vec n),\n  ∑ i, ‖BfgsVerification.EuclideanResidual.residual (A i) (b i) x‖ =\n    BfgsVerification.EuclideanResidual.smoothPart A b star x +\n      BfgsVerification.EuclideanResidual.centeredGauge A b star (x - star)","axioms":["propext","Quot.sound","Classical.choice"]}
