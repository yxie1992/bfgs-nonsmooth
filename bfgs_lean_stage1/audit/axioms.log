BFGS_AUDIT {"theorem":"BfgsVerification.ConvexCellRadial.actual_gradients_eq_on_cell","signature":"∀ {n : ℕ} {F f : BfgsVerification.Vec n → ℝ} {P U : Set (BfgsVerification.Vec n)},\n  Convex ℝ P →\n    (interior P).Nonempty →\n      IsOpen U →\n        ∀ {x : BfgsVerification.Vec n},\n          x ∈ P →\n            x ∈ U →\n              (∀ z ∈ U, z ∈ P → F z = f z) →\n                ∀ {g h : BfgsVerification.Vec n},\n                  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n                    HasFDerivAt f (BfgsVerification.gradientFunctional h) x → g = h","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.RadialCertificate.radialNumerator_eq_error_intercepts","signature":"∀ {n : ℕ} (F : BfgsVerification.Vec n → ℝ) (star x z g h : BfgsVerification.Vec n),\n  BfgsVerification.RadialCertificate.radialNumerator star z g h =\n    BfgsVerification.RadialCertificate.supportingError F x g z +\n        BfgsVerification.RadialCertificate.optimizerIntercept F star z h -\n      BfgsVerification.RadialCertificate.optimizerIntercept F star x g","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.NormalSpike.rationalValueOracle.eq_1","signature":"∀ (v : ℚ),\n  BfgsVerification.NormalSpike.rationalValueOracle v =\n    if hv : 0 < v then\n      let N := BfgsVerification.NormalSpike.rationalOracleIndex v hv;\n      ∑ j ∈ Finset.range N,\n            BfgsVerification.NormalSpike.ratScaledPrimitive (BfgsVerification.NormalSpike.ratScale j) v +\n          64 / 45 * BfgsVerification.NormalSpike.ratScale N ^ 2 * v -\n        128 / 105 * BfgsVerification.NormalSpike.ratScale N ^ 3\n    else 0","axioms":["propext","Classical.choice","Quot.sound"]}
