BFGS_AUDIT {"theorem":"BfgsVerification.FixedNormal.exists_smooth_strip_secant_bound","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} {Ω K : Set (BfgsVerification.Vec n)},\n  IsOpen Ω →\n    IsCompact K →\n      K ⊆ Ω →\n        ∀ (a : BfgsVerification.Vec n) (b : ℝ) {E : Set ℝ},\n          IsClosed E →\n            BfgsVerification.CenteredSmoothSublinear.LocallyC11On (BfgsVerification.FixedNormal.regularRegion Ω a b E)\n                F →\n              ∀ {τ : ℝ → ℝ} {δ : ℝ},\n                0 < δ →\n                  (∀ (t e : ℝ), e ∈ E → |t - e| ≤ δ → τ t = 0) →\n                    ∃ C,\n                      0 ≤ C ∧\n                        ∃ ρ,\n                          0 < ρ ∧\n                            ∀ x ∈ K,\n                              ∀ z ∈ K,\n                                τ (BfgsVerification.FixedNormal.normalCoordinate a b z) ≠ 0 →\n                                  ‖z - x‖ < ρ →\n                                    BfgsVerification.sqNorm\n                                        (BfgsVerification.coordinateGradient F z -\n                                          BfgsVerification.coordinateGradient F x) ≤\n                                      C * BfgsVerification.sqNorm (z - x)","axioms":["propext","Classical.choice","Quot.sound"]}
