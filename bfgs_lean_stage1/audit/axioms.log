                                      (BfgsVerification.LNormalizedReturn.scale w •
                                          (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).1 -
                                        BfgsVerification.LNormalizedOracle.physicalPoint μ w j)
                                      (BfgsVerification.coordinateGradient (BfgsVerification.LQuadraticSeed.objective μ)
                                          (BfgsVerification.LNormalizedReturn.scale w •
                                            (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).1) -
                                        BfgsVerification.coordinateGradient
                                          (BfgsVerification.LQuadraticSeed.objective μ)
                                          (BfgsVerification.LNormalizedOracle.physicalPoint μ w j)) =
                                    BfgsVerification.LNormalizedReturn.scale w •
                                      (BfgsVerification.LNormalizedReturn.internal μ w (↑j + 1)).2) ∧
                      (∀ (q : Fin 9),
                          DifferentiableAt ℝ (BfgsVerification.LQuadraticSeed.objective μ)
                            (BfgsVerification.LNormalizedOracle.physicalPoint μ w
                                (BfgsVerification.SeedOrbit.trialPhase q) +
