  BfgsVerification.ScalarMetricRun.armijo : ∀ (k : ℕ),
      f (self.x (k + 1)) ≤ f (self.x k) + self.c₁ * self.g k * (self.x (k + 1) - self.x k)
  BfgsVerification.ScalarMetricRun.weak_wolfe : ∀ (k : ℕ),
      self.c₂ * self.g k * (self.x (k + 1) - self.x k) ≤ self.g (k + 1) * (self.x (k + 1) - self.x k)
