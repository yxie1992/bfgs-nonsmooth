BfgsVerification.DEmbedding.all_actual_trial_values {n : ℕ} (hn : 1 ≤ n) {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3)
  (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ) (q : Fin 9)
