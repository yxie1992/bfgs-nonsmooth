BfgsVerification.LNormalizedReturn.normalized_return_contract (μ : Real) :
  And
    (Eq.{1} (BfgsVerification.LNormalizedReturn.returnMap μ BfgsVerification.LNormalizedReturn.seed)
      BfgsVerification.LNormalizedReturn.seed)
    (And
      (∀ (j : Fin 3),
        LT.lt.{0} 0 (BfgsVerification.LNormalizedReturn.denominator μ BfgsVerification.LNormalizedReturn.seed j))
      (And
        (Eq.{1} (BfgsVerification.LNormalizedReturn.returnFactor μ BfgsVerification.LNormalizedReturn.seed)
          BfgsVerification.SeedOrbit.seedRatio)
        (And
          (∃ U,
            And (IsOpen.{0} U)
              (And (Membership.mem.{0, 0} U BfgsVerification.LNormalizedReturn.seed)
                (And
                  (∀ (w : BfgsVerification.LNormalizedReturn.State),
                    Membership.mem.{0, 0} U w → BfgsVerification.LNormalizedReturn.Regular μ w)
                  (AnalyticOnNhd.{0, 0, 0} Real (BfgsVerification.LNormalizedReturn.returnMap μ) U))))
          (And
            (∀ (v : BfgsVerification.Vec 2),
              Eq.{1}
                ((fderiv.{0, 0, 0} Real (BfgsVerification.LNormalizedReturn.returnMap μ)
                    BfgsVerification.LNormalizedReturn.seed)
                  (BfgsVerification.LNormalizedReturn.pointLift v))
                (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} BfgsVerification.SeedOrbit.seedRatio)
                  (BfgsVerification.LNormalizedReturn.pointLift v)))
            (And
              (∀ (v : BfgsVerification.LNormalizedReturn.State),
                Eq.{1}
                  ((fderiv.{0, 0, 0} Real (BfgsVerification.LNormalizedReturn.returnMap μ)
                      BfgsVerification.LNormalizedReturn.seed)
                    v 4)
                  (HMul.hMul.{0, 0, 0} BfgsVerification.SeedOrbit.seedRatio (v 4)))
              (∀ (w : BfgsVerification.LNormalizedReturn.State),
                Ne.{1} (BfgsVerification.LNormalizedReturn.returnFactor μ w) 0 →
                  And
                    (Eq.{1}
                      (HSMul.hSMul.{0, 0, 0}
                        (BfgsVerification.LNormalizedReturn.scale (BfgsVerification.LNormalizedReturn.returnMap μ w))
                        (BfgsVerification.LNormalizedReturn.point (BfgsVerification.LNormalizedReturn.returnMap μ w)))
                      (HSMul.hSMul.{0, 0, 0} (BfgsVerification.LNormalizedReturn.scale w)
                        (BfgsVerification.LNormalizedReturn.internal μ w 3).1))
                    (Eq.{1}
                      (HSMul.hSMul.{0, 0, 0}
                        (BfgsVerification.LNormalizedReturn.scale (BfgsVerification.LNormalizedReturn.returnMap μ w))
                        (BfgsVerification.LNormalizedReturn.shape (BfgsVerification.LNormalizedReturn.returnMap μ w)))
                      (HSMul.hSMul.{0, 0, 0} (BfgsVerification.LNormalizedReturn.scale w)
                        (BfgsVerification.LNormalizedReturn.internal μ w 3).2))))))))
