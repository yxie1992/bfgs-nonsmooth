def BfgsVerification.TransportedCertificate.HasBandCertificates : {n : ℕ} →
  (BfgsVerification.Vec n → ℝ) → Set (BfgsVerification.Vec n) → ℝ → ℝ → ℝ → Prop :=
fun {n} F K fstar c₁ c₂ =>
  ∀ (η : ℝ),
    0 < η →
      (BfgsVerification.TransportedCertificate.positiveBand F K fstar η).Nonempty →
        Nonempty (BfgsVerification.TransportedCertificate.BandCertificate F K fstar c₁ c₂ η)
@BfgsVerification.AdmissibleBFGSRun.transported_certificate_convergence_on_sublevel : ∀ {n : ℕ}
  {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) (b : ℝ),
  IsCompact {x | F x ≤ b} →
    ∀ (xstar : BfgsVerification.Vec n),
      (∀ (x : BfgsVerification.Vec n), F xstar ≤ F x) →
        F (R.x 0) ≤ b →
          BfgsVerification.TransportedCertificate.HasBandCertificates F {x | F x ≤ b} (F xstar) R.c₁ R.c₂ →
            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (nhds (F xstar)) ∧
              Filter.Tendsto (fun k => Metric.infDist (R.x k) (BfgsVerification.argmin F)) Filter.atTop (nhds 0) ∧
                ((∀ (x : BfgsVerification.Vec n), F x = F xstar → x = xstar) →
                  Filter.Tendsto R.x Filter.atTop (nhds xstar))

