BfgsVerification.SeedOrbit.coercive_intercept_at_active {x : BfgsVerification.Vec 2} {i : Fin 3}
  (h :
    BfgsVerification.SeedOrbit.PointCertificate BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD x i) :
  BfgsVerification.RadialCertificate.optimizerIntercept BfgsVerification.SeedOrbit.coerciveObjective
      BfgsVerification.SeedOrbit.coerciveOptimizer x
      (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i) =
    -1 -
      BfgsVerification.dot
        (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i)
        BfgsVerification.SeedOrbit.coerciveOptimizer
'BfgsVerification.SeedOrbit.coercive_intercept_at_active' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.SeedOrbit.coerciveBranchIntercept : Fin 3 → ℝ
'BfgsVerification.SeedOrbit.coerciveBranchIntercept' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.SeedOrbit.coercive_branch_intercepts (i : Fin 3) :
  -1 -
      BfgsVerification.dot
        (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i)
        BfgsVerification.SeedOrbit.coerciveOptimizer =
    BfgsVerification.SeedOrbit.coerciveBranchIntercept i
'BfgsVerification.SeedOrbit.coercive_branch_intercepts' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.SeedOrbit.coercive_third_intercept_positive : 0 < BfgsVerification.SeedOrbit.coerciveBranchIntercept 2
'BfgsVerification.SeedOrbit.coercive_third_intercept_positive' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
BfgsVerification.SeedOrbit.coercive_orbit_intercepts (k : ℕ) :
  BfgsVerification.RadialCertificate.optimizerIntercept BfgsVerification.SeedOrbit.coerciveObjective
      BfgsVerification.SeedOrbit.coerciveOptimizer (BfgsVerification.SeedOrbit.orbitPoint k)
      (BfgsVerification.SeedOrbit.orbitGradient k) =
    BfgsVerification.SeedOrbit.coerciveBranchIntercept (BfgsVerification.SeedOrbit.phase k)
'BfgsVerification.SeedOrbit.coercive_orbit_intercepts' depends on axioms: [propext, Classical.choice, Quot.sound]
