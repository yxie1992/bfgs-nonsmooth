BfgsVerification.SeedOrbit.orbit_secant_factor (k : ℕ) :
  BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.SeedOrbit.orbitPoint k)
      (BfgsVerification.SeedOrbit.orbitPoint (k + 1)) (BfgsVerification.SeedOrbit.orbitGradient k)
      (BfgsVerification.SeedOrbit.orbitGradient (k + 1)) =
    BfgsVerification.SeedOrbit.orbitScale k *
      BfgsVerification.SeedOrbit.coerciveSecantFactor (BfgsVerification.SeedOrbit.phase k)
'BfgsVerification.SeedOrbit.orbit_secant_factor' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.SeedOrbit.orbit_secant_tendsto_zero :
  Filter.Tendsto
    (fun k =>
      BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.SeedOrbit.orbitPoint k)
        (BfgsVerification.SeedOrbit.orbitPoint (k + 1)) (BfgsVerification.SeedOrbit.orbitGradient k)
        (BfgsVerification.SeedOrbit.orbitGradient (k + 1)))
    Filter.atTop (nhds 0)
'BfgsVerification.SeedOrbit.orbit_secant_tendsto_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.SeedOrbit.coercive_no_radial_bounds :
  ¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.SeedOrbit.coerciveObjective
      {x |
        BfgsVerification.SeedOrbit.coerciveObjective x ≤
          BfgsVerification.SeedOrbit.coerciveObjective (BfgsVerification.SeedOrbit.orbitPoint 0)}
      BfgsVerification.SeedOrbit.coerciveOptimizer
