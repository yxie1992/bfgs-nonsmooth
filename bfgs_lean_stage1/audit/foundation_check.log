    {
      "theorem": "BfgsVerification.metricGram_schur_entry",
      "signature": "\u2200 {n j : \u2115} {\u03b9 : Type u_1} [inst : Fintype \u03b9] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H \u2192\n    \u2200 (Y : Matrix (Fin n) \u03b9 \u211d) (Z : Matrix (Fin n) (Fin j) \u211d) (i k : \u03b9),\n      (BfgsVerification.metricGram H Y -\n            Y.transpose * H * Z * (BfgsVerification.metricGram H Z)\u207b\u00b9 * (Z.transpose * H * Y))\n          i k =\n        BfgsVerification.dot (fun l => Y l i) (Matrix.mulVec H fun l => Y l k) -\n          BfgsVerification.dot (Z.transpose.mulVec (Matrix.mulVec H fun l => Y l i))\n            ((BfgsVerification.metricGram H Z)\u207b\u00b9.mulVec (Z.transpose.mulVec (Matrix.mulVec H fun l => Y l k)))",
