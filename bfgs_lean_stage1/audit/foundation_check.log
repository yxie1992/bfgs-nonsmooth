    {
      "theorem": "BfgsVerification.metricGram_det_append_one_generic",
      "signature": "\u2200 {n : \u2115} {\u03b9 : Type u_1} [inst : Fintype \u03b9] [inst_1 : DecidableEq \u03b9] {H : BfgsVerification.Mat n},\n  Matrix.PosDef H \u2192\n    \u2200 (y : BfgsVerification.Vec n) (Z : Matrix (Fin n) \u03b9 \u211d),\n      Function.Injective Z.mulVec \u2192\n        (BfgsVerification.metricGram H ((Matrix.replicateCol Unit y).fromCols Z)).det =\n          (BfgsVerification.metricGram H Z).det *\n            (BfgsVerification.metricEnergy H y -\n              Z.transpose.mulVec (Matrix.mulVec H y) \u2b1d\u1d65\n                (BfgsVerification.metricGram H Z)\u207b\u00b9.mulVec (Z.transpose.mulVec (Matrix.mulVec H y)))",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/GramSchur.lean"
    },
    {
      "theorem": "BfgsVerification.metricGram_det_append_two",
      "signature": "\u2200 {n j : \u2115} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H \u2192\n    \u2200 (g y : BfgsVerification.Vec n) (Z : Matrix (Fin n) (Fin j) \u211d),\n      Function.Injective Z.mulVec \u2192\n        let a := Z.transpose.mulVec (Matrix.mulVec H g);\n        let b := Z.transpose.mulVec (Matrix.mulVec H y);\n        let A := BfgsVerification.metricGram H Z;\n        (BfgsVerification.metricGram H (Matrix.fromCols (fun i k => ![g i, y i] k) Z)).det =\n          A.det *\n            ((BfgsVerification.metricEnergy H g - BfgsVerification.dot a (A\u207b\u00b9.mulVec a)) *\n                (BfgsVerification.metricEnergy H y - BfgsVerification.dot b (A\u207b\u00b9.mulVec b)) -\n              (BfgsVerification.dot g (Matrix.mulVec H y) - BfgsVerification.dot a (A\u207b\u00b9.mulVec b)) ^ 2)",
      "axioms": [
        "Classical.choice",
        "Quot.sound",
        "propext"
      ],
      "source": "BfgsVerification/GramSchur.lean"
    },
