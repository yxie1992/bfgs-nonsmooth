BfgsVerification.PrincipalInvariance.principalSum_orthogonal_conjugate {n : ℕ} (Q H : BfgsVerification.Mat n)
  (hQ : Q * Matrix.transpose Q = 1) (j : ℕ) :
  BfgsVerification.principalSum (Matrix.transpose Q * H * Q) j = BfgsVerification.principalSum H j
