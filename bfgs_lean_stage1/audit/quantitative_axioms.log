BfgsVerification.QuantitativeGrowth.hierarchy_finite_horizon_rpow {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ}
  (H : BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C) (hδ : ∀ (k : ℕ), 0 ≤ δ k) (J m : ℕ)
  (hm : 0 < m) (η D : ℝ) (hη : 0 < η) (hD : 0 ≤ D) (hbudget : ∑ i ∈ Finset.range m, δ (J + i) ≤ D) :
  ↑(m + 1) * (C * BfgsVerification.ScalarHierarchy.weightedPotential n (K / η) (E J)) ^ (-1 / ↑(m + 1)) *
      (η + D / ↑m) ^ (-↑m / ↑(m + 1)) ≤
    ∑ i ∈ Finset.range (m + 1), (q (J + i))⁻¹
BfgsVerification.QuantitativeGrowth.hierarchy_superquadratic_growth {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ}
  (H : BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C) (hδ : ∀ (k : ℕ), 0 ≤ δ k)
  (hsummable : Summable δ) :
  Filter.Tendsto (fun N => (∑ i ∈ Finset.range N, (q i)⁻¹) / ↑N ^ 2) Filter.atTop Filter.atTop
