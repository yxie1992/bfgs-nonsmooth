UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.EReconstruction.eventually_below_tolerance","signature":"∀ (f : ℕ → ℝ), Filter.Tendsto f Filter.atTop (nhds 0) → ∀ {ε : ℝ}, 0 < ε → ∃ N, ∀ k ≥ N, f k < ε","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.EReconstruction.planar_eventual_printed_tolerance","signature":"∀ (R : BfgsVerification.AdmissibleBFGSRun 2 BfgsVerification.PlanarQuadraticExample.objective),\n  BfgsVerification.PlanarQuadraticExample.objective (R.x 0) < 1 / 100 →\n    ∃ N, ∀ k ≥ N, BfgsVerification.PlanarQuadraticExample.objective (R.x k) < 10 ^ (-45)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.EReconstruction.spike_eventual_printed_tolerance","signature":"∀ {n : ℕ} (a : BfgsVerification.Vec n),\n  BfgsVerification.sqNorm a = 1 →\n    ∀ (R : BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.NormalSpike.objective a)),\n      ∃ N, ∀ k ≥ N, BfgsVerification.NormalSpike.objective a (R.x k) < 10 ^ (-28)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.EReconstruction.inverse_update_secant","signature":"∀ {n : ℕ} (H : BfgsVerification.Mat n) (s y : BfgsVerification.Vec n),\n  BfgsVerification.dot y s ≠ 0 → Matrix.mulVec (BfgsVerification.inverseBFGS H s y) y = s","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.EReconstruction.hessian_update_secant","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (s y : BfgsVerification.Vec n),\n      0 < BfgsVerification.dot y s → Matrix.mulVec (BfgsVerification.inverseBFGS H s y)⁻¹ s = y","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
