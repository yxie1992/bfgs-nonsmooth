UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.objective","signature":"{n : ℕ} → ℝ → ℝ → (BfgsVerification.Vec n → ℝ) → BfgsVerification.Vec n → ℝ","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.convex","signature":"∀ {n : ℕ} (a b : ℝ),\n  0 ≤ a →\n    ∀ {F : BfgsVerification.Vec n → ℝ},\n      ConvexOn ℝ Set.univ F → ConvexOn ℝ Set.univ (BfgsVerification.ObjectiveValueScale.objective a b F)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.gradientFunctional_scale","signature":"∀ {n : ℕ} (a : ℝ) (g : BfgsVerification.Vec n),\n  BfgsVerification.gradientFunctional (a • g) = a • BfgsVerification.gradientFunctional g","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.hasGradient","signature":"∀ {n : ℕ} (a b : ℝ) {F : BfgsVerification.Vec n → ℝ} {x g : BfgsVerification.Vec n},\n  HasFDerivAt F (BfgsVerification.gradientFunctional g) x →\n    HasFDerivAt (BfgsVerification.ObjectiveValueScale.objective a b F) (BfgsVerification.gradientFunctional (a • g)) x","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.step","signature":"∀ {n : ℕ} (a : ℝ),\n  a ≠ 0 →\n    ∀ (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n) (α : ℝ),\n      BfgsVerification.bfgsStep (a⁻¹ • H) (a • g) α = BfgsVerification.bfgsStep H g α","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.update","signature":"∀ {n : ℕ} (a : ℝ),\n  a ≠ 0 →\n    ∀ (H : BfgsVerification.Mat n) (s y : BfgsVerification.Vec n),\n      BfgsVerification.inverseBFGS (a⁻¹ • H) s (a • y) = a⁻¹ • BfgsVerification.inverseBFGS H s y","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.posDef","signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n}, Matrix.PosDef H → ∀ {a : ℝ}, 0 < a → Matrix.PosDef (a • H)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.energy","signature":"∀ {n : ℕ} (a : ℝ),\n  a ≠ 0 →\n    ∀ (H : BfgsVerification.Mat n) (g : BfgsVerification.Vec n),\n      BfgsVerification.metricEnergy (a⁻¹ • H) (a • g) = a * BfgsVerification.metricEnergy H g","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run","signature":"{n : ℕ} →\n  {F : BfgsVerification.Vec n → ℝ} →\n    (a b : ℝ) →\n      0 < a →\n        BfgsVerification.AdmissibleBFGSRun n F →\n          BfgsVerification.AdmissibleBFGSRun n (BfgsVerification.ObjectiveValueScale.objective a b F)","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_x","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).x k = R.x k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_H","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).H k = a⁻¹ • R.H k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_g","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).g k = a • R.g k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_alpha","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).α k = R.α k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_c1","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).c₁ = R.c₁","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_c2","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).c₂ = R.c₂","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_value","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  BfgsVerification.ObjectiveValueScale.objective a b F ((BfgsVerification.ObjectiveValueScale.run a b ha R).x k) =\n    a * F (R.x k) + b","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_q","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).q k = a * R.q k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_d","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).d k = a * R.d k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_displacement","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).displacement k = R.displacement k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_gradientChange","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).gradientChange k = a • R.gradientChange k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.run_curvature","signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (a b : ℝ) (ha : 0 < a) (R : BfgsVerification.AdmissibleBFGSRun n F) (k : ℕ),\n  (BfgsVerification.ObjectiveValueScale.run a b ha R).curvature k = a * R.curvature k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.optimizerIntercept","signature":"∀ {n : ℕ} (a b : ℝ) (F : BfgsVerification.Vec n → ℝ) (star x g : BfgsVerification.Vec n),\n  BfgsVerification.RadialCertificate.optimizerIntercept (BfgsVerification.ObjectiveValueScale.objective a b F) star x\n      (a • g) =\n    a * BfgsVerification.RadialCertificate.optimizerIntercept F star x g","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScale.secantCurvature","signature":"∀ {n : ℕ} (a : ℝ) (x z g h : BfgsVerification.Vec n),\n  BfgsVerification.RadialCertificate.secantCurvature x z (a • g) (a • h) =\n    a * BfgsVerification.RadialCertificate.secantCurvature x z g h","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ObjectiveValueScalingTarget","signature":"Prop","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.objectiveValueScaling","signature":"BfgsVerification.ObjectiveValueScalingTarget","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
