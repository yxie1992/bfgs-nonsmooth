UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.valueScale_mul_gap","signature":"BfgsVerification.ReconstructedFourPiece.valueScale * BfgsVerification.ReconstructedFourPiece.gap = 25 / 4","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.coordinate_det_ne","signature":"Matrix.det BfgsVerification.ReconstructedFourPiece.coordinate ≠ 0","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.coordinate_apply","signature":"∀ (z : BfgsVerification.Vec 2),\n  Matrix.mulVec BfgsVerification.ReconstructedFourPiece.coordinate z = ![z 0, 16 / 5 * z 1]","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.coordinate_optimizer","signature":"Matrix.mulVec BfgsVerification.ReconstructedFourPiece.coordinate BfgsVerification.ReconstructedFourPiece.optimizer =\n  BfgsVerification.SeedOrbit.coerciveOptimizer","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.family","signature":"BfgsVerification.MaxAffine.Family 2 4","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.objective","signature":"BfgsVerification.Vec 2 → ℝ","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.branch_formula","signature":"∀ (i : Fin 4) (z : BfgsVerification.Vec 2),\n  BfgsVerification.ReconstructedFourPiece.family.branch i z =\n    BfgsVerification.ReconstructedFourPiece.valueScale *\n        BfgsVerification.SeedOrbit.coerciveFamily.branch i\n          (Matrix.mulVec BfgsVerification.ReconstructedFourPiece.coordinate z) +\n      (BfgsVerification.ReconstructedFourPiece.valueScale - 1)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.literal_branches","signature":"∀ (i : Fin 4) (z : BfgsVerification.Vec 2),\n  BfgsVerification.ReconstructedFourPiece.family.branch i z =\n    ![BfgsVerification.ReconstructedFourPiece.valueScale * z 0 + BfgsVerification.ReconstructedFourPiece.valueScale - 1,\n        BfgsVerification.ReconstructedFourPiece.valueScale * (-z 0 - 2 / 5 * z 1) +\n            BfgsVerification.ReconstructedFourPiece.valueScale -\n          1,\n        BfgsVerification.ReconstructedFourPiece.valueScale *\n              (BfgsVerification.SeedOrbit.seedC * z 0 + 16 / 5 * BfgsVerification.SeedOrbit.seedD * z 1) +\n            BfgsVerification.ReconstructedFourPiece.valueScale -\n          1,\n        16 / 5 * BfgsVerification.ReconstructedFourPiece.valueScale * z 1 -\n            16 * BfgsVerification.ReconstructedFourPiece.valueScale -\n          1]\n      i","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.objective_formula","signature":"∀ (z : BfgsVerification.Vec 2),\n  BfgsVerification.ReconstructedFourPiece.objective z =\n    BfgsVerification.ReconstructedFourPiece.valueScale *\n        BfgsVerification.SeedOrbit.coerciveObjective\n          (Matrix.mulVec BfgsVerification.ReconstructedFourPiece.coordinate z) +\n      (BfgsVerification.ReconstructedFourPiece.valueScale - 1)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.objective_convex","signature":"ConvexOn ℝ Set.univ BfgsVerification.ReconstructedFourPiece.objective","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.minimum_value","signature":"BfgsVerification.ReconstructedFourPiece.objective BfgsVerification.ReconstructedFourPiece.optimizer = -1","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.lower_bound","signature":"∀ (z : BfgsVerification.Vec 2), -1 ≤ BfgsVerification.ReconstructedFourPiece.objective z","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.unique_optimizer","signature":"∀ {z : BfgsVerification.Vec 2},\n  BfgsVerification.ReconstructedFourPiece.objective z = -1 → z = BfgsVerification.ReconstructedFourPiece.optimizer","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.sublevels_compact","signature":"∀ (a : ℝ), IsCompact {z | BfgsVerification.ReconstructedFourPiece.objective z ≤ a}","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.scaled_branch_intercepts","signature":"∀ (i : Fin 3),\n  BfgsVerification.ReconstructedFourPiece.valueScale * BfgsVerification.SeedOrbit.coerciveBranchIntercept i =\n    ![0, 0, 25 / 4] i","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.branches_at_optimizer","signature":"∀ (i : Fin 3),\n  BfgsVerification.ReconstructedFourPiece.family.branch i.castSucc BfgsVerification.ReconstructedFourPiece.optimizer =\n    ![-1, -1, -29 / 4] i","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.zero_value","signature":"BfgsVerification.ReconstructedFourPiece.objective 0 = BfgsVerification.ReconstructedFourPiece.valueScale - 1","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.limit_not_stationary","signature":"0 ∉ BfgsVerification.ConvexSubdifferential.subdifferential BfgsVerification.ReconstructedFourPiece.objective 0","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point","signature":"ℕ → BfgsVerification.Vec 2","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.gradient","signature":"ℕ → BfgsVerification.Vec 2","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.map_point","signature":"∀ (k : ℕ),\n  Matrix.mulVec BfgsVerification.ReconstructedFourPiece.coordinate (BfgsVerification.ReconstructedFourPiece.point k) =\n    BfgsVerification.SeedOrbit.orbitPoint k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_optimizer","signature":"BfgsVerification.AffineWhitening.point BfgsVerification.ReconstructedFourPiece.coordinate\n    BfgsVerification.SeedOrbit.coerciveOptimizer =\n  BfgsVerification.ReconstructedFourPiece.optimizer","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_tendsto","signature":"Filter.Tendsto BfgsVerification.ReconstructedFourPiece.point Filter.atTop (nhds 0)","isTheorem":true,"axioms":["Quot.sound","propext","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_value","signature":"∀ (k : ℕ),\n  BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point k) =\n    BfgsVerification.ReconstructedFourPiece.valueScale *\n        BfgsVerification.SeedOrbit.coerciveObjective (BfgsVerification.SeedOrbit.orbitPoint k) +\n      (BfgsVerification.ReconstructedFourPiece.valueScale - 1)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_values_tendsto","signature":"Filter.Tendsto\n  (fun k => BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point k))\n  Filter.atTop (nhds (BfgsVerification.ReconstructedFourPiece.valueScale - 1))","isTheorem":true,"axioms":["Quot.sound","propext","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_value_above_limit","signature":"∀ (k : ℕ),\n  BfgsVerification.ReconstructedFourPiece.valueScale - 1 <\n    BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point k)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.family_gradient","signature":"∀ (i : Fin 3),\n  BfgsVerification.ReconstructedFourPiece.family.a i.castSucc =\n    BfgsVerification.ReconstructedFourPiece.valueScale •\n      BfgsVerification.AffineWhitening.gradient BfgsVerification.ReconstructedFourPiece.coordinate\n        (BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC BfgsVerification.SeedOrbit.seedD i)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_strict_active","signature":"∀ (k : ℕ) (j : Fin 4),\n  j ≠ (BfgsVerification.SeedOrbit.phase k).castSucc →\n    BfgsVerification.ReconstructedFourPiece.family.branch j (BfgsVerification.ReconstructedFourPiece.point k) <\n      BfgsVerification.ReconstructedFourPiece.family.branch (BfgsVerification.SeedOrbit.phase k).castSucc\n        (BfgsVerification.ReconstructedFourPiece.point k)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_hasGradient","signature":"∀ (k : ℕ),\n  HasFDerivAt BfgsVerification.ReconstructedFourPiece.objective\n    (BfgsVerification.gradientFunctional (BfgsVerification.ReconstructedFourPiece.gradient k))\n    (BfgsVerification.ReconstructedFourPiece.point k)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_intercepts","signature":"∀ (k : ℕ),\n  BfgsVerification.RadialCertificate.optimizerIntercept BfgsVerification.ReconstructedFourPiece.objective\n      BfgsVerification.ReconstructedFourPiece.optimizer (BfgsVerification.ReconstructedFourPiece.point k)\n      (BfgsVerification.ReconstructedFourPiece.gradient k) =\n    ![0, 0, 25 / 4] (BfgsVerification.SeedOrbit.phase k)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.point_phase_intercepts","signature":"∀ (m : ℕ) (j : Fin 3),\n  BfgsVerification.RadialCertificate.optimizerIntercept BfgsVerification.ReconstructedFourPiece.objective\n      BfgsVerification.ReconstructedFourPiece.optimizer (BfgsVerification.ReconstructedFourPiece.point (3 * m + ↑j))\n      (BfgsVerification.ReconstructedFourPiece.gradient (3 * m + ↑j)) =\n    ![0, 0, 25 / 4] j","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.secant_scale","signature":"∀ (k : ℕ),\n  BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.ReconstructedFourPiece.point k)\n      (BfgsVerification.ReconstructedFourPiece.point (k + 1)) (BfgsVerification.ReconstructedFourPiece.gradient k)\n      (BfgsVerification.ReconstructedFourPiece.gradient (k + 1)) =\n    BfgsVerification.ReconstructedFourPiece.valueScale *\n      BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.SeedOrbit.orbitPoint k)\n        (BfgsVerification.SeedOrbit.orbitPoint (k + 1)) (BfgsVerification.SeedOrbit.orbitGradient k)\n        (BfgsVerification.SeedOrbit.orbitGradient (k + 1))","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.secant_tendsto_zero","signature":"Filter.Tendsto\n  (fun k =>\n    BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.ReconstructedFourPiece.point k)\n      (BfgsVerification.ReconstructedFourPiece.point (k + 1)) (BfgsVerification.ReconstructedFourPiece.gradient k)\n      (BfgsVerification.ReconstructedFourPiece.gradient (k + 1)))\n  Filter.atTop (nhds 0)","isTheorem":true,"axioms":["Quot.sound","propext","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.transportedRun","signature":"{c₁ c₂ : ℝ} →\n  0 < c₁ →\n    c₁ ≤ 1 / 3 →\n      c₁ < c₂ →\n        c₂ < 1 →\n          BfgsVerification.AdmissibleBFGSRun 2\n            (BfgsVerification.ObjectiveValueScale.objective BfgsVerification.ReconstructedFourPiece.valueScale\n              (BfgsVerification.ReconstructedFourPiece.valueScale - 1)\n              (BfgsVerification.AffineWhitening.objective BfgsVerification.ReconstructedFourPiece.coordinate\n                BfgsVerification.SeedOrbit.coerciveObjective))","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.transported_objective","signature":"BfgsVerification.ObjectiveValueScale.objective BfgsVerification.ReconstructedFourPiece.valueScale\n    (BfgsVerification.ReconstructedFourPiece.valueScale - 1)\n    (BfgsVerification.AffineWhitening.objective BfgsVerification.ReconstructedFourPiece.coordinate\n      BfgsVerification.SeedOrbit.coerciveObjective) =\n  BfgsVerification.ReconstructedFourPiece.objective","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.run","signature":"{c₁ c₂ : ℝ} →\n  0 < c₁ →\n    c₁ ≤ 1 / 3 →\n      c₁ < c₂ → c₂ < 1 → BfgsVerification.AdmissibleBFGSRun 2 BfgsVerification.ReconstructedFourPiece.objective","isTheorem":false,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.run_x","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ),\n  (BfgsVerification.ReconstructedFourPiece.run hc₁ hc₁' hc hc₂).x k = BfgsVerification.ReconstructedFourPiece.point k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.run_g","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ),\n  (BfgsVerification.ReconstructedFourPiece.run hc₁ hc₁' hc hc₂).g k = BfgsVerification.ReconstructedFourPiece.gradient k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.run_H","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ),\n  (BfgsVerification.ReconstructedFourPiece.run hc₁ hc₁' hc hc₂).H k =\n    BfgsVerification.ReconstructedFourPiece.valueScale⁻¹ •\n      BfgsVerification.AffineWhitening.metric BfgsVerification.ReconstructedFourPiece.coordinate\n        (BfgsVerification.SeedOrbit.orbitMetric k)","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.run_alpha","signature":"∀ {c₁ c₂ : ℝ} (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (k : ℕ),\n  (BfgsVerification.ReconstructedFourPiece.run hc₁ hc₁' hc hc₂).α k = BfgsVerification.SeedOrbit.orbitLength k","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.secant_pos","signature":"∀ (k : ℕ),\n  0 <\n    BfgsVerification.RadialCertificate.secantCurvature (BfgsVerification.ReconstructedFourPiece.point k)\n      (BfgsVerification.ReconstructedFourPiece.point (k + 1)) (BfgsVerification.ReconstructedFourPiece.gradient k)\n      (BfgsVerification.ReconstructedFourPiece.gradient (k + 1))","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.no_intercept_bounds","signature":"¬BfgsVerification.RadialCertificate.HasInterceptBounds BfgsVerification.ReconstructedFourPiece.objective\n    {z |\n      BfgsVerification.ReconstructedFourPiece.objective z ≤\n        BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point 0)}\n    BfgsVerification.ReconstructedFourPiece.optimizer","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
UPDATER_ACTUAL_DECL {"theorem":"BfgsVerification.ReconstructedFourPiece.no_radial_bounds","signature":"¬BfgsVerification.RadialCertificate.HasRadialSecantBounds BfgsVerification.ReconstructedFourPiece.objective\n    {z |\n      BfgsVerification.ReconstructedFourPiece.objective z ≤\n        BfgsVerification.ReconstructedFourPiece.objective (BfgsVerification.ReconstructedFourPiece.point 0)}\n    BfgsVerification.ReconstructedFourPiece.optimizer","isTheorem":true,"axioms":["propext","Quot.sound","Classical.choice"]}
