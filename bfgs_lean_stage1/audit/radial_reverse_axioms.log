def BfgsVerification.RadialCertificate.HasRadialSecantBounds : {n : Nat} →
  (BfgsVerification.Vec n → Real) → Set.{0} (BfgsVerification.Vec n) → BfgsVerification.Vec n → Prop :=
fun {n} F K star =>
  ∀ (η : Real),
    LT.lt.{0} 0 η →
      ∃ C,
        ∀ (x z g h : BfgsVerification.Vec n),
          Membership.mem.{0, 0} K x →
            Membership.mem.{0, 0} K z →
              LE.le.{0} (HAdd.hAdd.{0, 0, 0} (F star) η) (F z) →
                LE.le.{0} (F z) (F x) →
                  HasFDerivAt.{0, 0, 0} F (BfgsVerification.gradientFunctional g) x →
                    HasFDerivAt.{0, 0, 0} F (BfgsVerification.gradientFunctional h) z →
                      LT.lt.{0} 0 (BfgsVerification.RadialCertificate.secantCurvature x z g h) →
                        LE.le.{0}
                          (HPow.hPow.{0, 0, 0} (BfgsVerification.RadialCertificate.radialNumerator star z g h) 2)
                          (HMul.hMul.{0, 0, 0} C (BfgsVerification.RadialCertificate.secantCurvature x z g h))
