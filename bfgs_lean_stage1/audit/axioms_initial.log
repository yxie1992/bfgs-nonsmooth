BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.trace_pos","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k : ℕ), 0 < E k 1","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ReciprocalGrowth.tail_potentials_force_log_growth","signature":"∀ (q : ℕ → ℝ) (C : ℝ),\n  (∀ (k : ℕ), 0 < q k) →\n    0 < C →\n      (∀ (A : ℝ),\n          0 < A →\n            ∃ J V, (∀ (k : ℕ), 0 < V k) ∧ (∀ (k : ℕ), J ≤ k → q k * V (k + 1) ≤ A * V k) ∧ ∀ (k : ℕ), q k ≤ C * V k) →\n        Filter.Tendsto (BfgsVerification.ReciprocalGrowth.logReciprocalMean q) Filter.atTop Filter.atTop","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.NormalizedHierarchy.coefficient_nonneg","signature":"∀ {n : ℕ} {E : ℕ → ℕ → ℝ} {q δ : ℕ → ℝ} {K C : ℝ},\n  BfgsVerification.ScalarHierarchy.NormalizedHierarchy n E q δ K C → ∀ (k j : ℕ), 0 ≤ E k j","axioms":["propext","Quot.sound","Classical.choice"]}
