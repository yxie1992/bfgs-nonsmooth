BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.shiftedPotential.eq_1","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  BfgsVerification.ScalarHierarchy.shiftedPotential n r e = ∑ j ∈ Finset.range n, r ^ j * e (j + 2)","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.upperNull_of_tendsto","signature":"∀ {δ : ℕ → ℝ}, Filter.Tendsto δ Filter.atTop (nhds 0) → BfgsVerification.ScalarHierarchy.UpperNull δ","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.FullBFGSRun.curvature_pos","signature":"∀ {n : ℕ} (self : BfgsVerification.FullBFGSRun n) (k : ℕ),\n  0 < BfgsVerification.dot (self.g (k + 1) - self.g k) (BfgsVerification.bfgsStep (self.H k) (self.g k) (self.α k))","axioms":["propext","Quot.sound","Classical.choice"]}
BFGS_AUDIT {"theorem":"BfgsVerification.CompressionAlgebra.compressed_update_bound","signature":"∀ (α β q Δ u D Dy Dgy Dplus : ℝ),\n  0 ≤ α →\n    0 < β →\n      0 < q →\n        0 ≤ Δ →\n          u ≤ q →\n            0 ≤ Dgy →\n              β ^ 2 * q ^ 2 * D = q * Dy - Dgy → Dplus = D + α / (β * q) * Δ * u → Dplus ≤ Dy / (β ^ 2 * q) + α / β * Δ","axioms":["propext","Quot.sound","Classical.choice"]}
