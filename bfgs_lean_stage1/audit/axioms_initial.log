BFGS_AUDIT {"theorem":"BfgsVerification.ScalarHierarchy.first_le_weighted","signature":"∀ (n : ℕ) (r : ℝ) (e : ℕ → ℝ),\n  0 < n → 0 ≤ r → (∀ (j : ℕ), 0 ≤ e j) → e 1 ≤ BfgsVerification.ScalarHierarchy.weightedPotential n r e","axioms":["propext","Quot.sound","Classical.choice"]}
