            BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) =
                BfgsVerification.DScalarGeometric.scale n ^ 3 ∧
              0 < BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) ∧
                0 ∉
                    BfgsVerification.ConvexSubdifferential.subdifferential BfgsVerification.DEmbedding.objective
                      (BfgsVerification.DEmbedding.center n) ∧
                  Filter.Tendsto
                    (fun t =>
                      (BfgsVerification.DEmbedding.objective
                            (BfgsVerification.DEmbedding.center n + t • BfgsVerification.DEmbedding.descentDirection) -
                          BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n)) /
                        t)
                    (nhdsWithin 0 (Set.Ioi 0)) (nhds (-BfgsVerification.DScalarGeometric.scale n ^ 2))) ∧
        (∀ V ∈ nhds 0,
            ∀ᶠ (n : ℕ) in Filter.atTop,
              (∀ (k : ℕ),
                  BfgsVerification.SeedEmbedding.point (BfgsVerification.DEmbedding.center n)
                      (BfgsVerification.DScalarGeometric.scale n ^ 2) k ∈
                    V) ∧
                ∀ (k : ℕ) (q : Fin 9),
                  BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →
                    BfgsVerification.DEmbedding.center n +
                        BfgsVerification.DScalarGeometric.scale n ^ 2 • BfgsVerification.SeedEmbedding.trialPoint k q ∈
                      V) ∧
          ∀ (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hc₁' : c₁ ≤ 1 / 3) (hc : c₁ < c₂) (hc₂ : c₂ < 1) (n : ℕ) (hn : 1 ≤ n),
            let R := BfgsVerification.DEmbedding.run hn c₁ c₂ hc₁ hc₁' hc hc₂;
            R.H 0 = 1 ∧
              (∀ (k : ℕ), Matrix.PosDef (R.H k)) ∧
                Filter.Tendsto R.x Filter.atTop (nhds (BfgsVerification.DEmbedding.center n)) ∧
                  Filter.Tendsto (fun k => BfgsVerification.DEmbedding.objective (R.x k)) Filter.atTop
                      (nhds (BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n))) ∧
                    (∀ (k : ℕ),
                        BfgsVerification.DEmbedding.objective (BfgsVerification.DEmbedding.center n) <
                          BfgsVerification.DEmbedding.objective (R.x k)) ∧
                      (∀ (k : ℕ),
                          BfgsVerification.DEmbedding.objective (R.x (k + 1)) <
                            BfgsVerification.DEmbedding.objective (R.x k)) ∧
                        (∀ (k : ℕ),
                            BfgsVerification.DeterministicLineSearch.fromMetric BfgsVerification.DEmbedding.objective
                                (R.x k) (R.H k) c₁ c₂ 5 =
                              (some (R.α k),
                                BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k))) ∧
                          (∀ (k : ℕ),
                              (BfgsVerification.SeedOrbit.trialHistory (BfgsVerification.SeedOrbit.phase k)).length ≤
                                5) ∧
                            (∀ (k : ℕ) (q : Fin 9),
                                BfgsVerification.SeedOrbit.trialPhase q = BfgsVerification.SeedOrbit.phase k →
                                  HasFDerivAt BfgsVerification.DEmbedding.objective
                                    (BfgsVerification.gradientFunctional
                                      (BfgsVerification.DScalarGeometric.scale n ^ 2 •
                                        BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC
                                          BfgsVerification.SeedOrbit.seedD (BfgsVerification.SeedOrbit.trialActive q)))
                                    (R.x k +
                                      BfgsVerification.SeedOrbit.trialLength q •
                                        BfgsVerification.bfgsStep (R.H k) (R.g k) 1)) ∧
                              ∀ (m : ℕ) (j : Fin 3),
                                R.x (3 * m + ↑j) =
                                    BfgsVerification.DEmbedding.center n +
                                      BfgsVerification.DScalarGeometric.scale n ^ 2 •
                                        BfgsVerification.SeedOrbit.seedRatio ^ m •
                                          BfgsVerification.SeedOrbit.point BfgsVerification.SeedOrbit.seedC
                                            BfgsVerification.SeedOrbit.seedD BfgsVerification.SeedOrbit.seedRatio j ∧
                                  R.H (3 * m + ↑j) =
                                      BfgsVerification.SeedOrbit.seedRatio ^ m •
                                        BfgsVerification.SeedOrbit.metric BfgsVerification.SeedOrbit.seedC
                                          BfgsVerification.SeedOrbit.seedD j ∧
                                    R.g (3 * m + ↑j) =
                                        BfgsVerification.DScalarGeometric.scale n ^ 2 •
                                          BfgsVerification.SeedOrbit.gradient BfgsVerification.SeedOrbit.seedC
                                            BfgsVerification.SeedOrbit.seedD j ∧
                                      R.α (3 * m + ↑j) = BfgsVerification.SeedOrbit.length j
'BfgsVerification.DEmbedding.deterministic_embedding_failure' depends on axioms: [propext, Classical.choice, Quot.sound]
