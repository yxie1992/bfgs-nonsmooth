@exists_distinct_supports_of_not_differentiableAt : ∀ {n : ℕ} {F : Vec n → ℝ},
  ConvexOn ℝ univ F →
    ∀ {x : Vec n}, ¬DifferentiableAt ℝ F x → ∃ g ∈ subdifferential F x, ∃ h ∈ subdifferential F x, g ≠ h
@isClosed_graph : ∀ {n : ℕ} {F : Vec n → ℝ}, Continuous F → IsClosed {p | p.2 ∈ subdifferential F p.1}
