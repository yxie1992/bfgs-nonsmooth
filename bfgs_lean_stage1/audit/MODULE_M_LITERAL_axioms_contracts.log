@BfgsVerification.insert_product_sum_eq : ∀ {n : ℕ} (lam : Fin n → ℝ) (j : ℕ) (k : Fin n),
  ∑ I ∈ {I ∈ Finset.powersetCard j Finset.univ | k ∉ I}, lam k * ∏ i ∈ I, lam i =
    ∑ J ∈ {J ∈ Finset.powersetCard (j + 1) Finset.univ | k ∈ J}, ∏ i ∈ J, lam i
'BfgsVerification.insert_product_sum_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@BfgsVerification.principal_product_augmented_sum_eq : ∀ {n : ℕ} (lam : Fin n → ℝ) (y : BfgsVerification.Vec n) (j : ℕ),
  ∑ I ∈ Finset.powersetCard j Finset.univ, (∏ i ∈ I, lam i) * ∑ k ∈ Finset.univ \ I, lam k * y k ^ 2 =
    ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ, (∏ i ∈ J, lam i) * ∑ k ∈ J, y k ^ 2
'BfgsVerification.principal_product_augmented_sum_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@BfgsVerification.diagonal_coordinate_gram_sum_eq : ∀ {n : ℕ} (lam : Fin n → ℝ),
  (∀ (i : Fin n), 0 < lam i) →
    ∀ (y : BfgsVerification.Vec n) (j : ℕ),
      ∑ I ∈ Finset.powersetCard j Finset.univ,
          (BfgsVerification.metricGram (Matrix.diagonal lam)
              ((Matrix.replicateCol Unit y).fromCols (BfgsVerification.coordinateMatrix I))).det =
        ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ, (∏ i ∈ J, lam i) * ∑ k ∈ J, y k ^ 2
'BfgsVerification.diagonal_coordinate_gram_sum_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@BfgsVerification.orthogonal_coordinate_gram_sum_eq : ∀ {n : ℕ} (H U : BfgsVerification.Mat n)
  (lam : BfgsVerification.Vec n),
  U * Matrix.transpose U = 1 →
    Matrix.transpose U * H * U = Matrix.diagonal lam →
      (∀ (i : Fin n), 0 < lam i) →
        ∀ (y : BfgsVerification.Vec n) (j : ℕ),
          ∑ I ∈ Finset.powersetCard j Finset.univ,
              (BfgsVerification.metricGram H
                  ((Matrix.replicateCol Unit y).fromCols (U * BfgsVerification.coordinateMatrix I))).det =
            ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ,
              (∏ i ∈ J, lam i) * ∑ k ∈ J, (Matrix.transpose U).mulVec y k ^ 2
'BfgsVerification.orthogonal_coordinate_gram_sum_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
BfgsVerification.PrincipalGramSumIdentityTarget : Prop
'BfgsVerification.PrincipalGramSumIdentityTarget' depends on axioms: [propext, Classical.choice, Quot.sound]
@BfgsVerification.principalGramSumIdentity : BfgsVerification.PrincipalGramSumIdentityTarget
'BfgsVerification.principalGramSumIdentity' depends on axioms: [propext, Classical.choice, Quot.sound]
def BfgsVerification.PrincipalGramSumIdentityTarget : Prop :=
∀ {n : ℕ} (H : BfgsVerification.Mat n),
  Matrix.PosDef H →
    ∃ U lam,
      Matrix.transpose U * U = 1 ∧
        U * Matrix.transpose U = 1 ∧
          Matrix.transpose U * H * U = Matrix.diagonal lam ∧
            (∀ (i : Fin n), 0 < lam i) ∧
              ∀ (y : BfgsVerification.Vec n) (j : ℕ),
                ∑ I ∈ Finset.powersetCard j Finset.univ,
                    (BfgsVerification.metricGram H
                        ((Matrix.replicateCol Unit y).fromCols (U * BfgsVerification.coordinateMatrix I))).det =
                  ∑ J ∈ Finset.powersetCard (j + 1) Finset.univ,
                    (∏ i ∈ J, lam i) * ∑ k ∈ J, (Matrix.transpose U).mulVec y k ^ 2
EXACT_TARGET_OK BfgsVerification.principalGramSumIdentity
