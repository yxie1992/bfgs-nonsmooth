E19_CHECK {"theorem":"BfgsVerification.TransportedCertificate.projected_transport_trace","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} (M : BfgsVerification.Mat n),\n  Matrix.PosSemidef M →\n    ∀ (s : BfgsVerification.Vec n),\n      Matrix.mulVec M s = 0 →\n        ∀ (W Z : BfgsVerification.Mat n) (a : ℝ),\n          (a •\n                  (BfgsVerification.TransportedCertificate.stepProjector s * W *\n                    BfgsVerification.TransportedCertificate.stepProjector s) -\n                BfgsVerification.TransportedCertificate.stepProjector s * Z *\n                  BfgsVerification.TransportedCertificate.stepProjector s).PosSemidef →\n            (M * Z).trace ≤ a * (M * W).trace","contract":"EJob14.Contract05","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.TransportedCertificate.projected_energy","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} (W : BfgsVerification.Mat n) (s v : BfgsVerification.Vec n),\n  BfgsVerification.metricEnergy\n      (BfgsVerification.TransportedCertificate.stepProjector s * W *\n        BfgsVerification.TransportedCertificate.stepProjector s)\n      v =\n    BfgsVerification.metricEnergy W (Matrix.mulVec (BfgsVerification.TransportedCertificate.stepProjector s) v)","contract":"EJob14.Contract06","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.TransportedCertificate.value_weight_transport","strict_definitional_type_check":true,"signature":"∀ {L c₁ d fx fz fstar : ℝ},\n  0 ≤ L → 0 < c₁ → c₁ * d ≤ fx - fz → Real.exp (L / c₁ * (fz - fstar)) * (1 + L * d) ≤ Real.exp (L / c₁ * (fx - fstar))","contract":"EJob14.Contract07","axioms":["propext","Quot.sound","Classical.choice"]}
