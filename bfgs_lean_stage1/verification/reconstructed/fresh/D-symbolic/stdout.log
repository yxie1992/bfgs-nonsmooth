E19_CHECK {"theorem":"BfgsVerification.PlanarUpdate.inverse_formula","strict_definitional_type_check":true,"signature":"∀ (H : BfgsVerification.Mat 2) (s y : BfgsVerification.Vec 2),\n  BfgsVerification.dot y s ≠ 0 →\n    BfgsVerification.inverseBFGS H s y =\n      (BfgsVerification.dot (BfgsVerification.PlanarUpdate.perp s)\n              (Matrix.mulVec H (BfgsVerification.PlanarUpdate.perp s)) /\n            BfgsVerification.dot y s ^ 2) •\n          BfgsVerification.outer (BfgsVerification.PlanarUpdate.perp y) (BfgsVerification.PlanarUpdate.perp y) +\n        (BfgsVerification.dot y s)⁻¹ • BfgsVerification.outer s s","contract":"EJob02.Contract01","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.hessianUpdate","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ {g : BfgsVerification.Vec n},\n      g ≠ 0 →\n        ∀ (y : BfgsVerification.Vec n) {α : ℝ},\n          0 < α →\n            0 < BfgsVerification.dot y (BfgsVerification.bfgsStep H g α) →\n              (BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y)⁻¹ =\n                H⁻¹ - (BfgsVerification.metricEnergy H g)⁻¹ • BfgsVerification.outer g g +\n                  (BfgsVerification.dot y (BfgsVerification.bfgsStep H g α))⁻¹ • BfgsVerification.outer y y","contract":"EJob02.Contract02","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.SeedCycle.source_cycle","strict_definitional_type_check":true,"signature":"BfgsVerification.SeedCycle.update\n    (BfgsVerification.SeedCycle.update\n      (BfgsVerification.SeedCycle.update 1 BfgsVerification.SeedCycle.g0 BfgsVerification.SeedCycle.g1 1)\n      BfgsVerification.SeedCycle.g1\n      (BfgsVerification.SeedCycle.g2 (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1))\n      (1 / 4))\n    (BfgsVerification.SeedCycle.g2 (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1))\n    BfgsVerification.SeedCycle.g0 (1 / 16) =\n  BfgsVerification.AlgebraicSeed.ratio (BfgsVerification.AlgebraicSeed.root 0) (BfgsVerification.AlgebraicSeed.root 1) •\n    1","contract":"EJob02.Contract03","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.inverseBFGS_det","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {H : BfgsVerification.Mat n},\n  Matrix.PosDef H →\n    ∀ (s y : BfgsVerification.Vec n),\n      BfgsVerification.dot y s ≠ 0 →\n        Matrix.det (BfgsVerification.inverseBFGS H s y) =\n          BfgsVerification.dot s (Matrix.mulVec H⁻¹ s) / BfgsVerification.dot y s * Matrix.det H","contract":"EJob02.Contract04","axioms":["propext","Quot.sound","Classical.choice"]}
