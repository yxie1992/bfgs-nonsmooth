E19_CHECK {"theorem":"BfgsVerification.BFGSCompression.inverseBFGS_compression","strict_definitional_type_check":true,"signature":"∀ {n m : ℕ} (H : BfgsVerification.Mat n) (Z : Matrix (Fin n) (Fin m) ℝ) (g y : BfgsVerification.Vec n) (α : ℝ),\n  Matrix.IsSymm H →\n    α ≠ 0 →\n      BfgsVerification.metricEnergy H g ≠ 0 →\n        -BfgsVerification.dot y (Matrix.mulVec H g) / BfgsVerification.metricEnergy H g ≠ 0 →\n          let q := BfgsVerification.metricEnergy H g;\n          let β := -BfgsVerification.dot y (Matrix.mulVec H g) / q;\n          Z.transpose * BfgsVerification.inverseBFGS H (BfgsVerification.bfgsStep H g α) y * Z =\n            BfgsVerification.CompressionDeterminant.compression (Z.transpose * H * Z)\n                (Z.transpose.mulVec (Matrix.mulVec H g)) (Z.transpose.mulVec (Matrix.mulVec H y)) (-β * q)\n                (BfgsVerification.dot y (Matrix.mulVec H y)) +\n              (α / (β * q)) •\n                BfgsVerification.outer (Z.transpose.mulVec (Matrix.mulVec H g)) (Z.transpose.mulVec (Matrix.mulVec H g))","contract":"EJob08.Contract06","axioms":["propext","Quot.sound","Classical.choice"]}
