E19_CHECK {"theorem":"BfgsVerification.RadialPower.mixed_linear_powers_radial","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {m : ι → ℕ} {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ (γ : (j : ι) → BfgsVerification.Vec (m j) → ℝ),\n      (∀ (j : ι), ConvexOn ℝ Set.univ (γ j)) →\n        (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (γ j)) →\n          (∀ (j : ι) (x : BfgsVerification.Vec (m j)), 0 ≤ γ j x) →\n            ∀ (A : (j : ι) → BfgsVerification.Vec n →ₗ[ℝ] BfgsVerification.Vec (m j)) (p : ι → ℝ),\n              (∀ (j : ι), 1 ≤ p j) →\n                ∀ (star : BfgsVerification.Vec n) {U K : Set (BfgsVerification.Vec n)},\n                  IsOpen U →\n                    BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n                      IsCompact K →\n                        K ⊆ U →\n                          (∀ x ∈ U, F x = ψ x + ∑ j, γ j ((A j) (x - star)) ^ p j) →\n                            BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star","contract":"EJob10.Contract02","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.RadialPower.mixed_powers_radial","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ},\n  ConvexOn ℝ Set.univ F →\n    ∀ {Γ : ι → BfgsVerification.Vec n → ℝ},\n      (∀ (j : ι), ConvexOn ℝ Set.univ (Γ j)) →\n        (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (Γ j)) →\n          (∀ (j : ι) (x : BfgsVerification.Vec n), 0 ≤ Γ j x) →\n            ∀ (p : ι → ℝ),\n              (∀ (j : ι), 1 ≤ p j) →\n                ∀ (star : BfgsVerification.Vec n) {U K : Set (BfgsVerification.Vec n)},\n                  IsOpen U →\n                    BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n                      IsCompact K →\n                        K ⊆ U →\n                          (∀ x ∈ U, F x = ψ x + BfgsVerification.RadialPower.sumObjective Γ p star x) →\n                            BfgsVerification.RadialCertificate.HasRadialSecantBounds F K star","contract":"EJob10.Contract03","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.AdmissibleBFGSRun.mixed_powers_convergence","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {F ψ : BfgsVerification.Vec n → ℝ}\n  (R : BfgsVerification.AdmissibleBFGSRun n F) {Γ : ι → BfgsVerification.Vec n → ℝ},\n  (∀ (j : ι), ConvexOn ℝ Set.univ (Γ j)) →\n    (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (Γ j)) →\n      (∀ (j : ι) (x : BfgsVerification.Vec n), 0 ≤ Γ j x) →\n        ∀ (p : ι → ℝ),\n          (∀ (j : ι), 1 ≤ p j) →\n            ∀ (star : BfgsVerification.Vec n),\n              (∀ (x : BfgsVerification.Vec n), F star ≤ F x) →\n                ∀ {U : Set (BfgsVerification.Vec n)},\n                  IsOpen U →\n                    BfgsVerification.CenteredSmoothSublinear.LocallyC11On U ψ →\n                      IsCompact R.initialSublevel →\n                        R.initialSublevel ⊆ U →\n                          (∀ x ∈ U, F x = ψ x + BfgsVerification.RadialPower.sumObjective Γ p star x) →\n                            Filter.Tendsto (fun k => F (R.x k)) Filter.atTop (𝓝 (F star)) ∧\n                              Filter.Tendsto (fun k => BfgsVerification.euclideanSolutionDistance F (R.x k))\n                                  Filter.atTop (𝓝 0) ∧\n                                ((∀ (x : BfgsVerification.Vec n), F x = F star → x = star) →\n                                  Filter.Tendsto R.x Filter.atTop (𝓝 star))","contract":"EJob10.Contract04","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.RadialPower.sumObjective_inward","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {ι : Type u_1} [inst : Fintype ι] {Γ : ι → BfgsVerification.Vec n → ℝ},\n  (∀ (j : ι), BfgsVerification.Homogeneous.PositiveDegreeOne (Γ j)) →\n    (∀ (j : ι) (x : BfgsVerification.Vec n), 0 ≤ Γ j x) →\n      ∀ (p : ι → ℝ) (star x : BfgsVerification.Vec n) {t : ℝ},\n        t ≤ 1 →\n          BfgsVerification.RadialPower.sumObjective Γ p star (BfgsVerification.RadialCertificate.inwardPoint star x t) =\n            ∑ j,\n              BfgsVerification.RadialPower.profile (p j) t * BfgsVerification.RadialPower.powered (Γ j) (p j) (x - star)","contract":"EJob10.Contract05","axioms":["propext","Quot.sound","Classical.choice"]}
