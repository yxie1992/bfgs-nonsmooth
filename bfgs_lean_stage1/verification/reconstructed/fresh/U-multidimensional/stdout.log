E19_CHECK {"theorem":"BfgsVerification.AdmissibleBFGSRun.residual_frames_on_tail_incompatible_source","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} {F : BfgsVerification.Vec n → ℝ} (R : BfgsVerification.AdmissibleBFGSRun n F) {r p : ℕ} (J : ℕ) (G : ℝ),\n  0 < G →\n    (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n      Summable R.d →\n        ∀ (U : Matrix (Fin n) (Fin r) ℝ),\n          U.transpose * U = 1 →\n            ∀ (L m C₀ C_T C_R : ℝ),\n              0 < m →\n                (∀ (k : ℕ),\n                    BfgsVerification.sqNorm (U.transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                      L * (R.shift J).curvature k) →\n                  ∀ (V Z : ℕ → Matrix (Fin n) (Fin p) ℝ) (T : ℕ → BfgsVerification.Mat p)\n                    (b : ℕ → BfgsVerification.Vec p),\n                    (∀ (k : ℕ), m ≤ BfgsVerification.sqNorm ((V k).transpose.mulVec ((R.shift J).g k))) →\n                      (∀ (k : ℕ),\n                          BfgsVerification.sqNorm ((V (k + 1)).transpose.mulVec ((R.shift J).gradientChange k)) ≤\n                            C₀ * (R.shift J).curvature k) →\n                        (∀ (k : ℕ),\n                            V (k + 1) =\n                              V k * T k +\n                                  BfgsVerification.EnergyIdentities.rectOuter ((R.shift J).displacement k) (b k) +\n                                Z k) →\n                          (∀ (k : ℕ), BfgsVerification.FrameBounds.OperatorSqBound (T k) (1 + C_T * (R.shift J).d k)) →\n                            (∀ (k : ℕ), U * U.transpose * Z k = Z k) →\n                              (∀ (k : ℕ), BfgsVerification.SmoothSubspace.frobSq (Z k) ≤ C_R * (R.shift J).d k) → False","contract":"EJob16.Contract02","axioms":["propext","Quot.sound","Classical.choice"]}
E19_CHECK {"theorem":"BfgsVerification.finiteHorizon","strict_definitional_type_check":true,"signature":"∀ {n : ℕ} (R : BfgsVerification.FullBFGSRun n) (G c : ℝ),\n  0 < G →\n    0 < c →\n      (∀ (k : ℕ), BfgsVerification.sqNorm (R.g k) ≤ G ^ 2) →\n        (∀ (k : ℕ), c ≤ R.beta k) →\n          Summable R.d →\n            ∀ (J m : ℕ),\n              0 < m →\n                ∀ (η : ℝ),\n                  0 < η →\n                    let D := ∑' (i : ℕ), R.d (J + i);\n                    let V :=\n                      BfgsVerification.ScalarHierarchy.weightedPotential n (4 * G ^ 2 / c ^ 2 / η)\n                        (BfgsVerification.principalSum (R.H J));\n                    ↑(m + 1) * (G ^ 2 * V) ^ (-1 / ↑(m + 1)) * (η + D / (c * ↑m)) ^ (-↑m / ↑(m + 1)) ≤\n                      ∑ i ∈ Finset.range (m + 1), (R.q (J + i))⁻¹","contract":"EJob16.Contract03","axioms":["propext","Quot.sound","Classical.choice"]}
